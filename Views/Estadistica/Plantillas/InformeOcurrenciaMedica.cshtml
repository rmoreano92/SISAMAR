<body style="background: transparent; width:698px; height:1015px; position:relative;" class="pt-2">

    @if (ViewBag.CodigoQR != null)
    {
        <img class="qr-code" src="@String.Format("data:image/png;base64,{0}", Convert.ToBase64String(ViewBag.CodigoQR))" />
    }

    <div class="fw-bold m-0 text-center" style="font-size: 12px">LIBRO DE OCURRENCIAS MÉDICAS EN LA GUARDIA HOSPITALARIA</div>

    <div class="row mt-2">
        <div class="col-4">
            <div class="p-1"><b>FECHA:</b> @ViewBag.FechaOcurrencia</div>
        </div>
        <div class="col-4">
            <div class="p-1"><b>GUARDIA:</b> @ViewBag.Turno</div>
        </div>
        <div class="col-4">
            <div class="border border-secondary p-1 ms-auto text-center" style="width: 120px;"><b>FOLIO N°:</b> @ViewBag.NroFolio</div>
        </div>
    </div>
    <div class="row">
        <div class="col-12">
            <div class="p-1"><b>JEFE DE EQUIPO:</b> Dr. (a) @ViewBag.JefeGuardiaSaliente</div>
        </div>
    </div>

    <div class="row mt-2">
        <div class="col-4 p-1">
            <div class="card border-secondary">
                <div class="card-header border-secondary">
                    GINECO-OBSTETRAS
                </div>
                <div class="card-block">
                    <div class="px-1 m-0">
                        @foreach (System.Data.DataRow row in ViewBag.Medicos.Rows)
                        {
                            @if (@row["IdCargomedico"].ToString() == "1")
                            {
                                <div>@row["NombreMedico"]</div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-4 p-1">
            <div class="card border-secondary">
                <div class="card-header border-secondary">
                    NEONATÓLOGOS
                </div>
                <div class="card-block">
                    <div class="px-1 m-0">
                        @foreach (System.Data.DataRow row in ViewBag.Medicos.Rows)
                        {
                            @if (@row["IdCargomedico"].ToString() == "2")
                            {
                                <div>@row["NombreMedico"]</div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-4 p-1">
            <div class="card border-secondary">
                <div class="card-header border-secondary">
                    ANESTESIÓLOGOS
                </div>
                <div class="card-block">
                    <div class="px-1 m-0">
                        @foreach (System.Data.DataRow row in ViewBag.Medicos.Rows)
                        {
                            @if (@row["IdCargomedico"].ToString() == "3")
                            {
                                <div>@row["NombreMedico"]</div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-4 p-1">
            <div class="card border-secondary">
                <div class="card-header border-secondary">
                    INTENSIVISTAS
                </div>
                <div class="card-block">
                    <div class="px-1 m-0">
                        @foreach (System.Data.DataRow row in ViewBag.Medicos.Rows)
                        {
                            @if (@row["IdCargomedico"].ToString() == "4")
                            {
                                <div>@row["NombreMedico"]</div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-4 p-1">
            <div class="card border-secondary">
                <div class="card-header border-secondary">
                    RESIDENTES
                </div>
                <div class="card-block">
                    <div class="px-1 m-0">
                        @foreach (System.Data.DataRow row in ViewBag.Medicos.Rows)
                        {
                            @if (@row["IdCargomedico"].ToString() == "5")
                            {
                                <div>@row["NombreMedico"]</div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-2">
        <div class="col-4 p-1">
            <div><b>Muertes Maternas: </b>@ViewBag.MuertesMaternas</div>
            <div class="fw-bold mt-1">Comentarios: </div>
            <div class="white-space border border-secondary p-1" style="min-height:40px;">@ViewBag.DMuertesMaternas</div>
        </div>
        <div class="col-4 p-1">
            <div><b>Eventos Adversos: </b>@ViewBag.EventosAdversos</div>
            <div class="fw-bold mt-1">Comentarios: </div>
            <div class="white-space border border-secondary p-1" style="min-height:40px;">@ViewBag.DEventosAdversos</div>
        </div>
        <div class="col-4 p-1">
            <div><b>Pacientes Críticos: </b>@ViewBag.PacientesCriticos</div>
            <div class="fw-bold mt-1">Comentarios: </div>
            <div class="white-space border border-secondary p-1" style="min-height:40px;">@ViewBag.DPacientesCriticos</div>
        </div>
    </div>

    <div class="row mt-2">
        <div class="col-4 p-1">
            <div><b>Reinterve. Quirurgicas: </b>@ViewBag.ReintervencionesQx</div>
