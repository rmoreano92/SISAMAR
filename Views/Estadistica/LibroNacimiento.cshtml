@section Css
    {
    <!-- plugin css -->
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/chosen/css/chosen.css" />
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/bootstrap-datetimepicker/css/bootstrap-datetimepicker.min.css" />
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/radio_css/css/radiobox.min.css" />
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/css/pages/radio_checkbox.css" />
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/jquery-validation-engine/css/validationEngine.jquery.css" />
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/bootstrapvalidator/css/bootstrapValidator.min.css" />
    <!--Page level styles-->
}
@using CapaEntidades
<header class="head">
    <div class="main-bar row">
        <div class="col-lg-6 col-md-4 col-sm-4">
            <h4 class="nav_top_align">
                <i class="fa-solid fa-book mr-1"></i>
                Libro de Nacimientos @*- @ViewBag.Area*@
            </h4>
        </div>
        <div class="col-lg-6 col-md-8 col-sm-8">
            <ol class="breadcrumb float-xs-right nav_breadcrumb_top_align">
                <li class="breadcrumb-item">
                    <a href="index1.html">
                        <i class="fa fa-home" data-pack="default" data-tags=""></i> Home
                    </a>
                </li>
                <li class="breadcrumb-item">
                    <a href="#">@ViewBag.Area</a>
                </li>
                <li class="breadcrumb-item active">Regisro de Recién Nacido</li>
            </ol>
        </div>
    </div>
</header>

<div class="row m-0">
    <div class="col-sm-12">
        <ul class="nav nav-tabs" id="myTab" role="tablist">
            <li class="nav-item" role="presentation">
                <a href="#" class="nav-link nav-link-custom active" id="TabBusqueda" data-toggle="tab" data-target="#TabPanelBusqueda" role="tab" aria-controls="TabPanelBusqueda" aria-selected="true">Busqueda</a>
            </li>
            <li class="nav-item m-0" role="presentation">
                <a href="#" class="nav-link nav-link-custom" id="TabRegistro" data-toggle="tab" data-target="#TabPanelRegistro" role="tab" aria-controls="TabPanelRegistro" aria-selected="false" style="display:none;">Registro RN</a>
            </li>
        </ul>
        <div class="tab-content border p-1" id="myTabContent">

            <!--=============================================Panel Busqueda==================================================================-->
            <div class="tab-pane fade active in" id="TabPanelBusqueda" role="tabpanel" aria-labelledby="TabBusqueda">
                <input hidden="hidden" id="idGrupo" name="idGrupo" type="text" class="form-control" value="@ViewBag.Vista">
                <input hidden="hidden" id="idServicio" name="idServicio" type="text" class="form-control" value="@ViewBag.Servicio">

                <div class="row">
                    <div class="col-lg-12 mb-2">
                        <div class="card">
                            <div class="card-block pb-0">
                                <div class="row mt-1">
                                    <div class="col-md-2" style="max-width: 160px">
                                        <label for="txtLibroFiltro">Nro Libro</label>
                                        <input id="txtLibroFiltro" type="text" class="form-control form-control-sm solo-numero search" min="0" autocomplete="off">
                                    </div>
                                    <div class="col-md-2" style="max-width: 160px">
                                        <label for="txtFolioFiltro">Nro Folio</label>
                                        <input id="txtFolioFiltro" type="text" class="form-control form-control-sm solo-numero search" min="0" autocomplete="off">
                                    </div>
                                    <div class="col-md-2" style="max-width: 160px">
                                        <label for="txtAnioFiltro">Año</label>
                                        <input id="txtAnioFiltro" type="text" class="form-control form-control-sm solo-numero search" min="0" autocomplete="off">
                                    </div>
                                    <div class="col-md-2" style="max-width: 160px">
                                        <label for="txtMesFiltro">Mes</label>
                                        <input id="txtMesFiltro" type="text" class="form-control form-control-sm solo-numero search" min="0" autocomplete="off">
                                    </div>
                                    @*<div class="col-md-2" style="max-width: 160px">
                                        <label for="txtNroCuentaFiltro">Nro.Cuenta</label>
                                        <input id="txtNroCuentaFiltro" type="text" class="form-control form-control-sm solo-numero" min="0" autocomplete="off">
                                    </div>
                                    <div class="col-md-2" style="max-width: 160px">
                                        <label for="txtDniFiltro">DNI</label>
                                        <input id="txtDniFiltro" type="text" class="form-control form-control-sm solo-numero search" min="0" autocomplete="off">
                                    </div>*@
                                    <div class="col-md-2" style="max-width: 160px">
                                        <label for="txtNroHistoriaMadreFiltro">Nro.Historia Madre</label>
                                        <input id="txtNroHistoriaMadreFiltro" type="text" class="form-control form-control-sm solo-numero search" min="0" autocomplete="off">
                                    </div>
                                    <div class="col-md-2">
                                        <label for="txtApPaternoMadreFiltro">Ap.Paterno Madre</label>
                                        <input id="txtApPaternoMadreFiltro" type="text" class="form-control form-control-sm search">
                                    </div>
                                    @*<div class="col-md-2" style="max-width: 160px">
                                        <label for="txtDniMadreFiltro">DNI Madre</label>
                                        <input id="txtDniMadreFiltro" type="text" class="form-control form-control-sm solo-numero search" min="0" autocomplete="off">
                                    </div>*@
                                    <div class="col-md-2" style="max-width: 150px">
                                        <label for="txtFechaFiltro">Fecha Nac</label>
                                        <div class="input-group form-group input-group-sm">
                                            <input type="text" class="form-control form_val_popup_dp3 search" placeholder="dd/mm/yyyy" data-date-format="dd/mm/yyyy" id="txtFechaFiltro" autocomplete="off">
                                            <span class="input-group-addon">
                                                <i class="fa fa-calendar "></i>
                                            </span>
                                        </div>
                                    </div>
                                    <div class="col-md-2 d-flex align-items-end mb-1" style="height: 50px;">
                                        <div>
                                            <button id="btnFiltroBuscar" type="button" class="btn btn-sm btn-primary mr-1" style="padding-left: 2rem !important; padding-right: 2rem !important;">Buscar</button>
                                            <button id="btnFiltroLimpiar" type="button" class="btn btn-sm btn-secondary" style="padding-left: 2rem !important; padding-right: 2rem !important;">Limpiar</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-12">
                        <div class="row">
                            <div class="col-lg-12">
                                @{
                                    if (@ViewBag.Agregar)
                                    {
                                        <button class="btn btn-success layout_btn_prevent" id="btnAgregarLibroNacimiento">Agregar</button>
                                    }
                                    if (@ViewBag.Modificar)
                                    {
                                        <button class="btn btn-info layout_btn_prevent" id="btnModificarLibroNacimiento">Modificar</button>
                                    }
                                    if (@ViewBag.Eliminar)
                                    {
                                        <button class="btn btn-danger layout_btn_prevent" id="btnEliminarLibroNacimiento">Eliminar</button>
                                    }
                                    if (@ViewBag.Consultar)
                                    {
                                        <button class="btn btn-warning layout_btn_prevent" id="btnConsultarLibroNacimiento">Consultar</button>
                                    }
                                }
                            </div>
                            @*<div class="col-lg-4 text-xs-center">
                                @{
                                    if (@ViewBag.Agregar)
                                    {
                                        <button class="btn btn-success layout_btn_prevent" onclick="" id="btnAgregarLibroNacimiento">Paciente Sin Historia</button>
                                    }
                                }
                            </div>
                            <div class="col-lg-4">
                                <div class="text-sm-right">
                                    <button class="btn btn-success layout_btn_prevent" id="btnReporte" data-toggle="modal" style="margin: 2px;" onclick="RegistroRN.AbrirModalReporte();"><i class="fa-solid fa-file-excel mr-1"></i>Reportes</button>
                                </div>
                            </div>*@
                        </div>
                    </div>

                    <div class="col-lg-12">
                        <table id="lstRnHospitalizados" width="100%" class="table table-sm table-bordered table-content-sm" @*data-source="/RecienNacido/ListaAtencionesDelDia?area=Hospitalizacion"*@>
                            <thead style="color: white; background: #434343;">
                                <tr>
                                    <th data-columna="" valign="middle" align="center" width="5%">Libro</th>
                                    <th data-columna="" valign="middle" align="center" width="5%">Folio</th>
                                    <th data-columna="" valign="middle" align="center" width="5%">Año</th>
                                    <th data-columna="" valign="middle" align="center" width="5%">Mes</th>
                                    <th data-columna="nroHistoriaClinica" valign="middle" align="center" width="5%">Historia</th>
                                    <th data-columna="paciente" valign="middle" align="center" width="15%">Paciente</th>
                                    @*<th data-columna="nroDocumento" valign="middle" align="center" width="5%">N° Doc.</th>*@
                                    <th data-columna="fecNac" valign="middle" align="center" width="6%">Fec. Naci.</th>
                                    <th data-columna="sexo" valign="middle" align="center" width="7%">Sexo</th>
                                    <th data-columna="docMadre" valign="middle" align="center" width="7%">Doc. Madre</th>
                                    <th data-columna="madre" valign="middle" align="center" width="15%">Madre</th>
                                    <th data-columna="padre" valign="middle" align="center" width="13%">Padre</th>
                                </tr>
                            </thead>
                            <tbody style="cursor: pointer;"></tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!--=============================================Panel Registro==================================================================-->
            <div class="tab-pane fade" id="TabPanelRegistro" role="tabpanel" aria-labelledby="TabRegistro">
                <partial name="~/Views/Shared/Components/VistasParciales/Estadistica/RegistroLibroNacimiento.cshtml" />
                @*@Html.Partial("~/Views/Shared/Components/VistasParciales/Hospitalizacion/RegistroRecienNacido.cshtml")*@
            </div>

        </div>
    </div>
</div>


