            <div class="col-12 pl-2 pr-2">
                <img src="@ViewBag.ServerFiles/resources//images/ImagenReporteCabecera.png" style="width:100%; height: 60px;" />
            </div>
        </div>

        <div class="row pb-4">
             <div class="col-12 px-3">
                <p class = "m-0 pb-1" style="text-align:center; font-size:12px;">"@ViewBag.NombreDecenio"</p>
