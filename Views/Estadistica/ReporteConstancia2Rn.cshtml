        <div class="row m-l-35 m-r-35">
            <label></label>

        </div>
        <div class="row ms-1 me-1 mb-3">
            <div class="col-8 pe-2" style="text-align:right">
                <h5><strong><u>CONSTANCIA DE NACIMIENTO</u> </strong> </h5>
            </div>
            <div class="col-4 ps-1">
                <h5><strong> @ViewBag.NroConstancia</strong></h5>
            </div>
        </div>


        <div class="row ms-1 me-1 mb-4">
            <div class="col-12">
                <div class="row py-3">
                    <div class="col-3" style="width:130px;">En el asiento N°: </div>
                    <div class="col-1 text-center fw-bold" style="width:120px;">@ViewBag.NroAsiento</div>
                    <div class="col-3" style="width:80px;"> de folio N° </div>
                    <div class="col-1 text-center fw-bold" style="width:120px;">@ViewBag.NroFolio</div>
                    <div class="col-4" style="width:200px;"> del Registro Nacimiento del </div>
                </div>
                <div class="row py-3">
                    <div class="col-10">Instituto Nacional Materno Perinatal (Maternidad de Lima), consta que a horas: </div>
                    <div class="col-2 text-center fw-bold">@ViewBag.HoraNac</div>
                </div>
                <div class="row py-3">
                    <div class="col-1">del @ViewBag.FechaNacString</div>
                    <div class="col-2 text-center fw-bold">@ViewBag.DiaNac</div>
                    <div class="col-1"> de </div>
                    <div class="col-2 text-center fw-bold">@ViewBag.MesNac</div>
                    <div class="col-1"> del </div>
                    <div class="col-2 text-center fw-bold">@ViewBag.AnioNac</div>
                    <div class="col-1"> , </div>
                </div>
                <div class="row py-3">
                    <div class="">nació de la Sra: </div>
                    <div class=" text-center fw-bold" style="width:380px;">@ViewBag.ApPaternoMadre @ViewBag.ApMaternoMadre @ViewBag.NombresMadre</div>
                    <div class="col-1"> de </div>
                    <div class="col-1 text-center fw-bold"> @ViewBag.EdadMadre </div>
                    <div class="col-1"> años </div>
                </div>
                @if(ViewBag.TipoDocMadre != "" && ViewBag.NroDocumentoMadre != ""){
                <div class="row py-3">
                    <div class="col-5">identificada con documento de identidad: </div>
                    <div class="col-7 text-start fw-bold">@ViewBag.TipoDocMadre @ViewBag.NroDocumentoMadre ,</div>                   
                </div>
                }
                <div class="row py-3">
                    <div class="col-4">quien declaró como padre a: </div>
                    @if(ViewBag.AnioNac < 2005){
                        <div class="col-8 text-start fw-bold">@ViewBag.ApPaternoPadre @ViewBag.ApMaternoPadre @ViewBag.NombresPadre</div>
                    } else
                    {
                        <div class="col-8 text-start fw-bold">-- -- --</div>    
                    }                    
                </div>
                <div class="row py-3">
                    <div class="col-12">Con residencia habitual:  @ViewBag.DireccionMadre</div>                    
                </div>
                <div class="row pb-3">
                    <div class="col-12" style="margin-left: 160px;">
