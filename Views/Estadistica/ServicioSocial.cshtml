            </li>
            <li class="nav-item m-0" role="presentation">
                <a href="#" class="nav-link nav-link-custom" id="TabRegistro" data-toggle="tab" data-target="#TabPanelRegistro" role="tab" aria-controls="TabPanelRegistro" aria-selected="false" @*style="display:none;"*@>Registro Atención</a>
            </li>
        </ul>
        <div class="tab-content border pt-1 pl-1 pr-1" id="myTabContent">
            <!--=============================================Panel Busqueda==================================================================-->
            <div class="tab-pane fade active in" id="TabPanelBusqueda" role="tabpanel" aria-labelledby="TabBusqueda">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="card m-t-5">
                            <div class="card-block pb-0">
                                <div class="row mt-1 mb-1">

                                    <div class="col-lg-2">
                                        <div class="input-group input-group-sm">
                                            <label for="txtDniBusqueda" class="form-control-label">N° DNI</label>
                                            <input type="text" autocomplete="off" class="form-control" id="txtDniBusqueda">
                                        </div>
                                    </div>

                                    <div class="col-lg-2">
                                        <div class="input-group input-group-sm">
                                            <label for="txtApellPaternoBusqueda" class="form-control-label">Apell. Paterno</label>
                                            <input type="text" autocomplete="off" class="form-control" id="txtApellPaternoBusqueda">
                                        </div>
                                    </div>

                                    <div class="col-lg-2">
                                        <div class="input-group input-group-sm">
                                            <label for="txtFechaIngresoBusqueda" class="form-control-label">F. Ingreso</label>
                                            <input type="date" autocomplete="off" class="form-control form_val_popup_dp3" placeholder="dd/mm/yyyy" data-date-format="dd/mm/yyyy" id="txtFechaIngresoBusqueda">
                                        </div>
                                    </div>

                                    <div class="col-lg-3">
                                        <div class="input-group">
                                            <label for="cboServicioBusqueda" class="form-control-label">Servicio</label>
                                            <select class="chzn-select" id="cboServicioBusqueda"></select>
                                        </div>
                                    </div>

                                    <div class="col-lg-2 d-flex align-items-end" style="height: 50px;">
                                        <div>
                                            <button class="btn btn-primary btn-sm layout_btn_prevent" style="padding-left: 2rem !important; padding-right: 2rem !important;" id="btnBuscar">Buscar</button>
                                            <button class="btn btn-secondary btn-sm layout_btn_prevent" style="padding-left: 2rem !important; padding-right: 2rem !important;" id="btnLimpiar">Limpiar</button>
                                        </div>
                                    </div>

                                </div>

                            </div>
                        </div>
                    </div>

                    <div class="col-lg-6 pt-2 pb-0">
                        @{
