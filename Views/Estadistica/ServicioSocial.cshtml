                                <button class="btn btn-primary layout_btn_prevent" id="btnAgregarServSocial">Agregar</button>
                            }
                            if (@ViewBag.Modificar)
                            {
                                <button class="btn btn-info layout_btn_prevent" id="btnModificarServSocial">Modificar</button>
                            }
                            @*if (@ViewBag.Eliminar)
                                {
                                <button class="btn btn-danger layout_btn_prevent" id="btnEliminarServSocial">Eliminar</button>
                                }*@
                            if (@ViewBag.Consultar)
                            {
                                <button class="btn btn-warning layout_btn_prevent" id="btnConsultarServSocial">Consultar</button>
                            }
                        }
