<div>
    <div>
        <div>
            @section Css
    {
                <!-- plugin css -->
                <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/chosen/css/chosen.css" />
                <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/bootstrap-datetimepicker/css/bootstrap-datetimepicker.min.css" />
                <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/radio_css/css/radiobox.min.css" />
                <link type="text/css" rel="stylesheet" href="~/AdmiRE/css/pages/radio_checkbox.css" />
                <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/jquery-tagsinput/css/jquery.tagsinput.css" />
                <link type="text/css" rel="stylesheet" href="~/AdmiRE/css/pages/bootstrap.vertical-tabs.css" />



            }
            <header class="head">
                <div class="main-bar row">
                    <div class="col-lg-6 col-md-4 col-sm-4">
                        <h4 class="nav_top_align">
                            <i class="fa fa-th"></i>
                            @ViewBag.Area
                        </h4>
                    </div>
                    <div class="col-lg-6 col-md-8 col-sm-8">
                        <ol class="breadcrumb float-xs-right nav_breadcrumb_top_align">
                            <li class="breadcrumb-item">
                                <a href="index1.html">
                                    <i class="fa fa-home" data-pack="default" data-tags=""></i> Home
                                </a>
                            </li>
                            <li class="breadcrumb-item">
                                <a href="#">@ViewBag.Area</a>
                            </li>
                            <li class="breadcrumb-item active">Migracion HIS</li>
                        </ol>
                    </div>
                </div>
            </header>

            <div class="outer">
                <div class="inner bg-light lter bg-container">
                    <div class="row">
                        <div class="col-xs-12 data_tables">
                            
                            <div class="card m-t-10">
                                <div class="card">
                                    <ul id="clothing-nav" class="nav nav-tabs" role="tablist">

                                        <li class="nav-item">
                                            <a class="nav-link active" href="#farmaciaRece" role="tab" id="farmaciaRece-tab" data-toggle="tab" aria-controls="hats" aria-expanded="true">Migrar Atenciones</a>
                                        </li>


                                        <li class="nav-item">
                                            <a class="nav-link" href="#rayosRece" role="tab" id="rayosRece-tab" data-toggle="tab" aria-controls="hats">Validación de Informacion</a>
                                        </li>

                                        <li class="nav-item">
                                            <a class="nav-link" href="#ecoObstRece" role="tab" id="ecoObstRece-tab" data-toggle="tab" aria-controls="hats">Generar Trama JSON</a>
                                        </li>

                                    </ul>
                                    <div class="card-block">
                                        <div id="clothing-nav-content" class="tab-content fade in active">

                                            <div role="tabpanel" class="tab-pane fade in active" id="farmaciaRece" aria-labelledby="farmaciaRece-tab">
                                                <br>
                                                <div class="row">
                                                    <div class="col-lg-6">
                                                        <div class="row">
                                                            <div class="col-lg-12">
                                                                <div class="row">
                                                                    <div class="col-lg-4">
                                                                        <div class="form-group">
                                                                            <label for="cboServicioAtenciones" class="form-control-label">Servicio</label>
                                                                            <div class="input-group">

                                                                                <select class="chzn-select" id="cboServicioAtenciones">
                                                                                    <option value="1">Consulta Externa</option>
                                                                                    <option value="2">Planificación Familiar</option>
                                                                                    <option value="3">Teleconsulta</option>
                                                                                </select>

                                                                            </div>
                                                                        </div>
                                                                    </div>

                                                                    <div class="col-lg-4">
                                                                        <div class="form-group">
                                                                            <label for="txtFechaIni" class="form-control-label">Fecha Inicial</label>
                                                                            <div class="input-group">

                                                                                <input id="txtFechaIni" autocomplete="off" placeholder="dd/mm/yyyy" data-date-format="dd/mm/yyyy" class=" form-control form-control-sm">

                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-lg-4">
                                                                        <div class="form-group">
                                                                            <label for="txtFechaFin" class="form-control-label">Fecha Fin</label>
                                                                            <div class="input-group">

                                                                                <input id="txtFechaFin" autocomplete="off" placeholder="dd/mm/yyyy" data-date-format="dd/mm/yyyy" class=" form-control form-control-sm">

                                                                            </div>
                                                                        </div>
                                                                    </div>

                                                                </div>
                                                            </div>


                                                        </div>
                                                    </div>
                                                    <div class="col-lg-4">
                                                        <br>
                                                        <button class="btn btn-primary layout_btn_prevent" id="btnBuscar">Buscar</button>
                                                        <button class="btn btn-success layout_btn_prevent" id="btnMigrar">Migrar</button>
                                                        <button class="btn btn-default layout_btn_prevent" id="btnLimpiarFiltro">Limpiar</button>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="col-lg-12">
                                                        <table id="tblAtencionesMigrar" width="100%" class="table table-sm table-content-md table-bordered">
                                                            <thead style="color: white;background: #434343;">
                                                                <tr>

                                                                    <th style="width:20%">IdAtencion</th>
                                                                    <th style="width:10%">Fecha Ingreso</th>
                                                                    <th style="width:10%">Codigo Minsa2020</th>
                                                                    <th style="width:10%">Codigo ServicioHis</th>
                                                                    <th style="width:10%">Apellido Paterno</th>
                                                                    <th style="width:10%">Apellido Materno</th>
                                                                    <th style="width:10%">Nombres</th>
                                                                    <th style="width:10%">Sexo</th>
                                                                    <th style="width:10%">Fecha Nacimiento</th>


                                                                </tr>
                                                            </thead>
                                                            <tbody></tbody>
                                                        </table>
                                                    </div>
                                                </div>

                                            </div>
                                            <div role="tabpanel" class="tab-pane fade" id="rayosRece" aria-labelledby="rayosRece-tab">
                                                <br>
                                                <div class="row">
                                                    <div class="col-lg-12">
                                                        <button class="btn btn-danger layout_btn_prevent" id="btnDepurar">Depurar datos de atenciones</button>
                                                        <button class="btn btn-success layout_btn_prevent" id="btnGeneraReporteDepuracion">Exportar datos de atenciones</button>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="col-lg-12">
                                                        <table id="tblDepurar" width="100%" class="table table-bordered">
                                                            <thead style="color: white;background: #3e6184;">
                                                                <tr>

                                                                    <th style="width:10%">IdAtencion</th>
                                                                    <th style="width:10%">Fecha Atención</th>
                                                                    <th style="width:20%">Doc. Paciente</th>
                                                                    <th style="width:20%">Nro. Historia</th>
                                                                    <th style="width:20%">Error</th>
                                                                    <th style="width:20%">Fecha Migración</th>

                                                                </tr>
                                                            </thead>
                                                            <tbody></tbody>
                                                        </table>
                                                    </div>
                                                </div>
                                            </div>
                                            <div role="tabpanel" class="tab-pane fade" id="ecoObstRece" aria-labelledby="ecoObstRece-tab">
                                                <br>
                                                <div class="row">
                                                    <div class="col-lg-12">

                                                        <button class="btn btn-info layout_btn_prevent" id="btnPendientesJSON">Pendientes de envío</button>
                                                        <button class="btn btn-success layout_btn_prevent" id="btnGenerarJSON">Generar JSON de atenciones</button>
                                                    </div>
                                                </div>
                                                <div class="row" id="divPendientesJson">
                                                    <div class="col-lg-12">
                                                        <table id="tblJsonPendientes" width="100%" class="table table-bordered">
                                                            <thead style="color: white;background: #3e6184;">
                                                                <tr>

                                                                    <th style="width:5%">Id</th>
                                                                    <th style="width:10%">v_Cita_Origen</th>
                                                                    <th style="width:45%">v_Json</th>
                                                                    <th style="width:5%">i_Estado</th>
                                                                    <th style="width:10%">i_Id_Cita</th>
                                                                    <th style="width:10%">v_Descripcion_Respuesta</th>
                                                                    <th style="width:10%">fecha_Registro</th>


                                                                </tr>
                                                            </thead>
                                                            <tbody></tbody>
                                                        </table>
                                                    </div>
                                                </div>
                                            </div>

                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

            @section Scripts
    {
                <script type="text/javascript" src="~/AdmiRE/vendors/chosen/js/chosen.jquery.js"></script>
                <script type="text/javascript" src="~/AdmiRE/vendors/raphael/js/raphael-min.js"></script>
                <script type="text/javascript" src="~/AdmiRE/vendors/justgage/js/justgage.js"></script>
                <script type="text/javascript" src="~/AdmiRE/vendors/d3/js/d3.min.js"></script>
                <script type="text/javascript" src="~/AdmiRE/vendors/c3/js/c3.min.js"></script>
                <script type="text/javascript" src="~/AdmiRE/vendors/jquery-tagsinput/js/jquery.tagsinput.js"></script>
                <script type="text/javascript" src="~/AdmiRE/vendors/bootstrap-datetimepicker/js/bootstrap-datetimepicker.min.js"></script>

                <script type="text/javascript" src=@Href("~/js/Estadistica/Migraciones.js")></script>
                @*<script type="text/javascript" src=@Href("~/js/Facturacion/Facturacion_Lista.js")></script>*@

                <script src="~/AdmiRE/js/date.format.js"></script>

                <script type="text/javascript">
                    $(document).ready(function () {
                        MIGRACIONES.init();

                    });

                </script>

            }

            <style>
                .tab100 {
                    width: 100%
                }

                #clothing-nav-content2 .form-group {
                    margin-bottom: 0 !important;
                }

                #tblPacientesHosp tr.over td {
                    background: #D6E8F8;
                    font-weight: bold;
                }

                /*  .chosen-container chosen-container-single {
                                    width: 100% !important;
                                }*/


                .chosen-container {
                    width: 100% !important;
                }

                .modal-lg {
                    max-width: 1400px !important;
                }
            </style>
        </div>
    </div>
</div>@{
    Layout = "_Layout";
}
