                                                    <button type="button" class="btn btn-sm btn-default" style="padding-left: 2rem !important; padding-right: 2rem !important;" onclick="SolicitudConstanciaRn.LimpiarFiltrosBusqueda();">limpiar</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
