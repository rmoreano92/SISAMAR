@using CapaEntidades
<header class="head">
    <div class="main-bar row">
        <div class="col-lg-6 col-md-4 col-sm-4">
            <h4 class="nav_top_align">
                <i class="fa fa-file-certificate"></i>
                Constancias de Recién Nacido @*- @ViewBag.Area*@
            </h4>
        </div>
        <div class="col-lg-6 col-md-8 col-sm-8">
            <ol class="breadcrumb float-xs-right nav_breadcrumb_top_align">
                <li class="breadcrumb-item">
                    <a href="index1.html">
                        <i class="fa fa-home" data-pack="default" data-tags=""></i> Home
                    </a>
                </li>
                <li class="breadcrumb-item">
                    <a href="#">@ViewBag.Area</a>
                </li>
                <li class="breadcrumb-item active">Constancias de Recién Nacido</li>
            </ol>
        </div>
    </div>
</header>
<div class="outer">
    <div class="inner bg-light lter bg-container">
        <div class="row">
            <div class="col-xs-12 data_tables">
                <div class="card">

                    <input hidden="hidden" id="idGrupo" name="idGrupo" type="text" class="form-control" value="@ViewBag.Vista">
                    <input hidden="hidden" id="idServicio" name="idServicio" type="text" class="form-control" value="@ViewBag.Servicio">
                    <div class="card-block pt-1">
                        <div class="row">
                            <div class="col-lg-12">
                                <div class="card">
                                    <div class="card-block pb-0">
                                        <div class="row mt-1">
                                            <div class="col-md-2" style="max-width: 160px">
                                                <label>Nro.Constancia</label>
                                                <input id="txtNroConstanciaFiltro" class="form-control form-control-sm solo-numero searchConstancia">
                                            </div>
                                            <div class="col-md-3">
                                                <label>Comprobante</label>
                                                <div class="input-group input-group-sm">
                                                    <input id="txtNroDocumentoFiltro" type="text" required class="form-control searchConstancia" placeholder="Correlativo">
                                                    <span class="input-group-addon">-</span>
                                                    <input id="txtNroCorrelativoFiltro" type="text" required class="form-control searchConstancia" placeholder="Nro.Documento">
                                                </div>
                                            </div>
                                            <div class="col-md-2" style="max-width: 160px">
                                                <label>Nro.Historia</label>
                                                <input id="txtNroHistoriaFiltro" class="form-control form-control-sm solo-numero searchConstancia">
                                            </div>
                                            <div class="col-md-2" style="max-width: 150px">
                                                <label>Fecha Reg.</label>
                                                <div class="input-group input-group-sm form-group">
                                                    <input type="text" class="form-control form_val_popup_dp3 searchConstancia" placeholder="dd/mm/yyyy" data-date-format="dd/mm/yyyy" id="txtFechaFiltro" autocomplete="off">
                                                    <span class="input-group-addon">
                                                        <i class="fa fa-calendar "></i>
                                                    </span>
                                                </div>
                                            </div>
                                            <div class="col-md-3 d-flex align-items-end mb-1" style="height: 50px;">
                                                @*<h5>&nbsp;</h5>*@
                                                <div>
                                                    <button type="button" class="btn btn-sm btn-primary" style="padding-left: 2rem !important; padding-right: 2rem !important;" onclick="ConstanciaRn.ListarConstancias();" id="btnBuscarCRN">Buscar</button>&nbsp;&nbsp;
                                                    <button type="button" class="btn btn-sm btn-default" style="padding-left: 2rem !important; padding-right: 2rem !important;" onclick="ConstanciaRn.LimpiarFiltrosBusqueda();">limpiar</button>
                                                </div>
                                            </div>
                                            @*
                        <div class="col-md-2">
                            <h5>&nbsp;</h5>
                            <p>
                                <button type="button" class="btn btn-primary" onclick="ConstanciaRn.ListarConstancias();">
                                    <i class="fa fa-search" aria-hidden="true"></i> Buscar
                                </button>

                                <button type="button" class="btn btn-default" onclick="ConstanciaRn.LimpiarFiltrosBusqueda();">limpiar</button>
                            </p>
                        </div>
                                            *@
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-12 pt-2 pb-0">
                                @{
                                    if (@ViewBag.Agregar)
                                    {
                                        <button class="btn btn-success layout_btn_prevent" onclick="AgregarConstanciaRn();" id="btnAgregar">Agregar</button>
                                    }                                    
                                    if (@ViewBag.Modificar)
                                    {
                                        <button class="btn btn-primary layout_btn_prevent" onclick="ModificarConstanciaRn()" id="btnModificar">Modificar</button>
                                    }
                                    if (@ViewBag.Eliminar)
                                    {
                                        <button class="btn btn-danger layout_btn_prevent" onclick="EliminarConstanciaRn();" id="btnEliminar">Eliminar</button>
                                    }
                                    if (@ViewBag.Consultar)
                                    {
                                        <button class="btn btn-warning layout_btn_prevent" onclick="ConsultarConstanciaRn();" id="btnConsultar">Consultar</button>
                                    }
                                }
                            </div>

                            <div class="col-lg-12">
                                <table id="lstRnConstancias" class="table table-sm table-bordered table-content-sm w-100" data-source="/ConstanciasRN/BuscarConstanciasRn?area=Estadistica">
                                    <thead style="color: white;background: #434343;">
                                        <tr>
                                            <th data-columna="idConstancia" valign="middle" align="center">N° Constancia</th>
                                            <th data-columna="nroHistoria" valign="middle" align="center">N°.Historia</th>
                                            <th data-columna="paciente" valign="middle" align="center">Paciente</th>
                                            <th data-columna="madre" valign="middle" align="center">Madre</th>
                                            <th data-columna="documento" valign="middle" align="center">Comprobante</th>
                                            <th data-columna="fechaNacimiento" valign="middle" align="center">Fecha Nacimiento</th>
                                            <th data-columna="fechaRegistro" valign="middle" align="center">Fecha Registro</th>
                                            <th data-columna="fechaImpresion" valign="middle" align="center">Fecha Impresión</th>
                                            <th data-columna="estadoFirma" valign="middle" align="center">Firma</th>
                                            <th data-columna="accion" valign="middle" align="center">Accion</th>
                                            <th data-columna="base" valign="middle" align="center">base</th>
                                        </tr>
                                    </thead>
                                    <tbody style="cursor: pointer;"></tbody>
                                </table>
                            </div>

                            <div class="text-xs-right">
                                <button class="btn btn-info layout_btn_prevent mt-3 mx-1" id="btnFirmaLote"><i class="fa-light fa-signature mr-1"></i>Firmar Lote</button>
                            </div>
                        </div>                        
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


