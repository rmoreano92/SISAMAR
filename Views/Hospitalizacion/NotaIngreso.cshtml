                <script src="~/AdmiRE/js/date.format.js"></script>

                <script type="text/javascript">
                    $(document).ready(function () {

                        NOTAINGRESO.init();
                        ConsumoServicio.IniciarScript()

                    });

                </script>

            }

            <style>
                .tab100 {
                    width: 100%
                }

                #clothing-nav-content2 .form-group {
                    margin-bottom: 0 !important;
                }

                #tblAtencionEmer tr.over td {
                    background: #D6E8F8;
                    font-weight: bold;
                }

                /*  .chosen-container chosen-container-single {
                                    width: 100% !important;
