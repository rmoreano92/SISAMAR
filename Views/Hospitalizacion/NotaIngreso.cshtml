                                <input hidden="hidden" id="hdIdNumeroSiguiente" name="hdIdNumeroSiguiente" type="text" class="form-control">
                                <input hidden="hidden" id="hdestadoBtn" name="hdestadoBtn" type="text" class="form-control">
                                <input hidden="hidden" type="text" id="hdIdUsuarioActual" class="form-control" value="@ViewBag.idUsuario" />
                                <input hidden="hidden" id="hdNroEvaluacion" name="hdNroEvaluacion" type="text" class="form-control">
                                <div class="card-block">
                                    <div class="row">

                                        <div class="col-lg-12">
                                            <div class="card">
                                                <div class="card-block">
                                                    <div class="row">

                                                        <div class="col-lg-2">
                                                            <div class="form-group m-0">
                                                                <label for="txtNroHistoriaBuscar" class="form-control-label">Historia Clinica</label>
                                                                <input id="txtNroHistoriaBuscar" autocomplete="off" placeholder="" class="form-control form-control-sm search">
                                                            </div>
                                                        </div>
                                                        <div class="col-lg-2">
                                                            <div class="form-group m-0">
                                                                <label for="txtNroCuentaBuscar" class="form-control-label">N° Cuenta</label>
                                                                <input id="txtNroCuentaBuscar" autocomplete="off" placeholder="" class="form-control form-control-sm search">
                                                            </div>
                                                        </div>
                                                        <div class="col-lg-2">
                                                            <div class="form-group m-0">
                                                                <label for="txtNroDniBuscar" class="form-control-label">N° Dni</label>
                                                                <input id="txtNroDniBuscar" autocomplete="off" placeholder="" class="form-control form-control-sm search">
                                                            </div>
                                                        </div>
                                                        <div class="col-lg-2">
                                                            <div class="form-group m-0">
                                                                <label for="txtApPaternoBuscar" class="form-control-label">Apellido Paterno</label>
                                                                <input id="txtApPaternoBuscar" autocomplete="off" placeholder="" class="form-control form-control-sm search">
                                                            </div>
                                                        </div>


                                                    </div>

                                                    <div class="row">
                                                        <div class="col-lg-2">
                                                            <div class="form-group m-0">
                                                                <label for="txtFechaAtencionBuscar" class="form-control-label">Fecha Ingreso</label>
                                                                <div class="input-group input-group-sm">
                                                                    <input id="txtFechaAtencionBuscar" autocomplete="off" placeholder="dd/mm/yyyy" data-date-format="dd/mm/yyyy" class=" form-control form-control-sm search">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-lg-2">
                                                            <div class="form-group m-0">
                                                                <label for="txtFechaTransferencia" class="form-control-label">Fecha Transferencia</label>
                                                                <div class="input-group input-group-sm">
                                                                    <input id="txtFechaTransferencia" autocomplete="off" placeholder="dd/mm/yyyy" data-date-format="dd/mm/yyyy" class=" form-control form-control-sm search">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-lg-3">
                                                            <div class="form-group m-0">
                                                                <label for="cboServicio" class="form-control-label">Servicio</label>
                                                                <select class="chzn-select" id="cboServicio"></select>
                                                            </div>
                                                        </div>
                                                        <div class="col-lg-2">
                                                            <div class="d-flex align-items-end" style="height: 55px;">
                                                                <button class="btn btn-sm btn-primary layout_btn_prevent mr-1" id="btnBuscarPacientes" style="padding-left: 2rem !important; padding-right: 2rem !important;">Buscar</button>
                                                                <button class="btn btn-sm btn-secondary layout_btn_prevent" id="btnLimpiarFiltro" style="padding-left: 2rem !important; padding-right: 2rem !important;">Limpiar</button>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-12 pt-2 pb-0">
                                            @{
                                                if (@ViewBag.Agregar)
                                                {
                                                    <button class="btn btn-success layout_btn_prevent" id="btnAgregarNI">Agregar</button>
                                                }

                                                if (@ViewBag.Consultar)
                                                {
                                                    <button class="btn btn-warning layout_btn_prevent" id="btnConsultarNI">Consultar</button>
                                                }
                                            }
                                        </div>

                                        <div class="col-md-12">

                                            <table id="tblAtencionEmer" width="100%" class="table table-sm table-bordered" style="cursor: default;">
                                                <thead style="color: white;background: #434343;">
                                                    <tr>
                                                        <th style="width:5%">Cuenta</th>
                                                        <th style="width:10%">Ap. Paterno</th>
                                                        <th style="width:10%">Ap. Materno</th>
                                                        <th style="width:10%">Nombres</th>
                                                        <th style="width:5%">Historia</th>
                                                        <th style="width:5%">Fec. Nac.</th>
                                                        <th style="width:10%">Tipo Paciente</th>
                                                        <th style="width:5%">Fec. Ing.</th>
                                                        <th style="width:5%">Hor. Ing.</th>
                                                        <th style="width:10%">Servicio</th>
                                                        <th style="width:5%">Plan</th>
                                                        <th style="width:5%">Cant. Eval.</th>
                                                        <th style="width:10%;text-align:center">Informe</th>

                                                    </tr>
                                                </thead>
                                                <tbody></tbody>
                                            </table>

                                            <!--<table id="tblAtencionEmer" class="table table-sm table-bordered">
                                    <thead style="color: white; background: #434343;">
                                        <tr>-->
                                            @*<th>N° Cuenta</th>
                                        <th>N°. Historia</th>
                                        <th>Apellido Paterno</th>
                                        <th>Apellido Materno</th>
                                        <th>Primer Nombre</th>
                                        <th>Fecha de Nacimiento</th>
                                        <th>Fecha de Ingreso</th>
                                        <th>Hora de Ingreso</th>
                                        <th>F. Egre. Admin</th>
                                        <th>H. Egre. Admin</th>
                                        <th>Servicio Actual</th>
                                        <th>Plan</th>*@

                                            <!--</tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>-->
                                            @*<table id="tblAtencionEmer" width="100%" class="table table-sm table-bordered" style="cursor: default;">
                                            <thead style="color: white;background: #434343;">
                                                <tr>
                                                    <th style="width:5%">Cuenta</th>
                                                    <th style="width:10%">Ap. Paterno</th>
                                                    <th style="width:10%">Ap. Materno</th>
                                                    <th style="width:10%">Nombres</th>
                                                    <th style="width:5%">Historia</th>
                                                    <th style="width:5%">Fec. Nac.</th>
                                                    <th style="width:10%">Tipo Paciente</th>
                                                    <th style="width:5%">Fec. Ing.</th>
                                                    <th style="width:5%">Hor. Ing.</th>
                                                    <th style="width:10%">Servicio</th>
                                                    <th style="width:5%">Plan</th>
                                                    <th style="width:5%">Cant. Eval.</th>
                                                    <th style="width:10%;text-align:center">Informe</th>

                                                </tr>
                                            </thead>
                                            <tbody></tbody>
                                        </table>*@
                                        </div>


                                    </div>



                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div id="partialViewRegistro">

            </div>

            <partial name="~/Views/Shared/Components/VistasParciales/NotaIngresoRegistrar.cshtml" />


            <div data-backdrop="static" style="background-color: rgba(0, 0, 0, 0.46); overflow-y: scroll;" data-keyboard="false" class="modal fade" id="modalSeguimiento" role="dialog" aria-labelledby="modalLabelsuccess">
                <div class="modal-dialog modal-lg" role="document">
                    <div class="modal-content">
                        <div class="modal-header bg-light-blue">
                            <h4 class="modal-title text-white" id="modalLabelsuccess">Seguimiento de Paciente</h4>
                        </div>
                        <div class="modal-body">

                            <div class="row">
                                <div class="col-md-12">
                                    <partial name="~/Views/Shared/Components/VistasParciales/Seguimiento/SeguimientoPaciente.cshtml" />
                                    @*@Html.Partial("~/Views/Shared/Components/VistasParciales/SeguimientoPaciente.cshtml");*@
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button id="btnCerrarSeguimiento" target="_blank" class="btn btn-lg btn-secondary "> Cerrar</button>
                        </div>
                    </div>
                </div>
            </div>


            <div data-backdrop="static" style="overflow-y: scroll;" data-keyboard="false" class="modal fade" id="modalHistorial" role="dialog" aria-labelledby="modalLabelsuccess">
                <div class="modal-dialog modal-lg" role="document">
                    <div class="modal-content">
                        <div class="modal-header bg-primary">
                            <h4 class="modal-title text-white" id="modalLabelsuccess">HISTORIAL DE EVALUACIONES EN HOSPITALIZACIÓN</h4>
                        </div>
                        <div class="modal-body" style="background-color:#b4c6d6">

                            <div class="row">
                                <div class="col-md-12">
                                    <partial name="~/Views/Shared/Components/VistasParciales/HistorialEvaluacionesHospitalizacion.cshtml" />
                                </div>
                            </div>

                        </div>
                        <div class="modal-footer" style="background-color:#ced8e1">
                            <button id="btnCerrarHistorial" target="_blank" class="btn  btn-secondary "> Cerrar</button>
                        </div>
                    </div>
                </div>
            </div>

            <partial name="~/Views/Shared/Components/VistasParciales/ConsumoServicioRegistro.cshtml" />
            <partial name="~/Views/Shared/Components/VistasParciales/Recetas/VisorRecetas.cshtml" />
            @*@Html.Partial("~/Views/Shared/Components/VistasParciales/ConsumoServicioRegistro.cshtml")*@

            @*@Html.Partial("~/Views/Shared/Components/VistasParciales/Recetas/VisorRecetas.cshtml")*@

