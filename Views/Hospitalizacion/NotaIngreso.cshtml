                <script type="text/javascript" src=@Href("~/js/VistasParciales/HistorialEvaluacionesHospitalizacion.js")></script>
                <script type="text/javascript" src=@Href("~/js/VistasParciales/OrdenesYResultados.js")></script>
                <script type="text/javascript" src=@Href("~/js/Facturacion/ConsumoServicioV3.js")></script>

