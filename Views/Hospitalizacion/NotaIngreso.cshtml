                    background-color: rgba(0,0,0, 0);
                    z-index: 100;
                    cursor: not-allowed;
                }

                .btn-sm {
                    padding: 0.4rem 0.5rem !important;
                }

                legend {
                    width: auto !important;
                    padding: 0 5px !important;
                    font-size: 1.2rem !important;
                    margin-left: 5px !important;
                }

                fieldset {
