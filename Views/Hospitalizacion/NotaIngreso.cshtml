                <script type="text/javascript" src=@Href("~/js/Comun/EstablecimientosSaludV2.js")></script>
                <script type="text/javascript" src=@Href("~/js/Emergencia/AdmisionEmergencia.js")></script>
                <script type="text/javascript" src=@Href("~/js/Emergencia/EvaluacionEmergencia.js")></script>

