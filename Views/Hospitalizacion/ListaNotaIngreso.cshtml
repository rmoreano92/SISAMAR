<div>
    <div>
        <div>
            @section Css
    {
                <!-- plugin css -->
                <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/chosen/css/chosen.css" />
                <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/bootstrap-datetimepicker/css/bootstrap-datetimepicker.min.css" />
                <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/radio_css/css/radiobox.min.css" />
                <link type="text/css" rel="stylesheet" href="~/AdmiRE/css/pages/radio_checkbox.css" />
                <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/jquery-tagsinput/css/jquery.tagsinput.css" />
                <link type="text/css" rel="stylesheet" href="~/AdmiRE/css/pages/bootstrap.vertical-tabs.css" />



            }
            <header class="head">
                <div class="main-bar row">
                    <div class="col-lg-6 col-md-4 col-sm-4">
                        <h4 class="nav_top_align">
                            <i class="fa fa-th"></i>
                            @ViewBag.Area
                        </h4>
                    </div>
                    <div class="col-lg-6 col-md-8 col-sm-8">
                        <ol class="breadcrumb float-xs-right nav_breadcrumb_top_align">
                            <li class="breadcrumb-item">
                                <a href="index1.html">
                                    <i class="fa fa-home" data-pack="default" data-tags=""></i> Home
                                </a>
                            </li>
                            <li class="breadcrumb-item">
                                <a href="#">@ViewBag.Area</a>
                            </li>
                            <li class="breadcrumb-item active">Notas de Ingreso</li>
                        </ol>
                    </div>
                </div>
            </header>

            <div class="outer">
                <div class="inner bg-light lter bg-container">
                    <div class="row">
                        <div class="col-xs-12 data_tables">
                            <div class="card">
                                <div class="card-header bg-white">
                                    <i class="fa fa-pencil-square-o"></i> Nota de Ingreso
                                    @{
                                        if (@ViewBag.Consultar)
                                        {
                                            <button class="btn btn-warning layout_btn_prevent" id="btnConsultarNI2">Consultar</button>
                                        }
                                    }
                                </div>
                                <input hidden="hidden" id="idGrupo" name="idGrupo" type="text" class="form-control" value="@ViewBag.Vista">
                                <input hidden="hidden" id="idServicio" name="idServicio" type="text" class="form-control" value="@ViewBag.Servicio">
                                <input hidden="hidden" id="hdIdPaciente" name="hdIdPaciente" type="text" class="form-control">
                                <input hidden="hidden" id="hdIdCuentaAtencion" name="hdIdCuentaAtencion" type="text" class="form-control">
                                <input hidden="hidden" id="hdIdNumero" name="hdIdNumero" type="text" class="form-control">
                                <input hidden="hidden" id="hdIdNumeroSiguiente" name="hdIdNumeroSiguiente" type="text" class="form-control">
                                <input hidden="hidden" id="hdestadoBtn" name="hdestadoBtn" type="text" class="form-control">
                                <input hidden="hidden" id="hditembar" name="hditembar"  value="@ViewBag.itemBar" type="text" class="form-control">
                                <div class="card-block p-t-5">
                                    <div class="row">

                                        <div class="col-lg-12">
                                            <div class="card m-t-5">
                                                <div class="card-block">
                                                    <div class="row">
                                                        <div class="col-lg-10">
                                                            <div class="row">
                                                                <div class="col-lg-8">
                                                                    <div class="row">
                                                                        <div class="col-lg-2">
                                                                            <div class="form-group">
                                                                                <label for="txtHistoria" class="form-control-label">Historia Clinica</label>
                                                                                <div class="input-group">

                                                                                    <input id="txtHistoria" autocomplete="off" placeholder="" class="form-control">

                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                        <div class="col-lg-2">
                                                                            <div class="form-group">
                                                                                <label for="txtNroCuenta" class="form-control-label">N° Cuenta</label>
                                                                                <div class="input-group">

                                                                                    <input id="txtNroCuenta" autocomplete="off" placeholder="" class="form-control">

                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                        <div class="col-lg-2">
                                                                            <div class="form-group">
                                                                                <label for="txtNroDni" class="form-control-label">N° Dni</label>
                                                                                <div class="input-group">

                                                                                    <input id="txtNroDni" autocomplete="off" placeholder="" class="form-control">

                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                        <div class="col-lg-3">
                                                                            <div class="form-group">
                                                                                <label for="txtApPaterno" class="form-control-label">Apellido Paterno</label>
                                                                                <div class="input-group">

                                                                                    <input id="txtApPaterno" autocomplete="off" placeholder="" class="form-control">

                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                        <div class="col-lg-3">
                                                                            <div class="form-group">
                                                                                <label for="txtFechaIngreso" class="form-control-label">Fecha de Registro</label>
                                                                                <div class="input-group">

                                                                                    <input id="txtFechaIngreso" autocomplete="off" placeholder="dd/mm/yyyy" data-date-format="dd/mm/yyyy" class=" form-control">

                                                                                </div>
                                                                            </div>
                                                                        </div>

                                                                    </div>
                                                                </div>
                                                                <div class="col-lg-4">
                                                                    <div class="form-group">
                                                                        <label for="cboServicioAtenciones" class="form-control-label">Servicio</label>
                                                                        <div class="input-group">

                                                                            <select class="chzn-select" id="cboServicioAtenciones"></select>

                                                                        </div>
                                                                    </div>
                                                                </div>

                                                            </div>
                                                        </div>
                                                        <div class="col-lg-2">
                                                            <br>
                                                            <button class="btn btn-primary layout_btn_prevent" id="btnBuscarPacientesEvaluados">Buscar</button>
                                                            <button class="btn btn-default layout_btn_prevent" id="btnLimpiarFiltro">Limpiar</button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <table id="tblPacientesEvalEmgHosp" class="table table-bordered">
                                        <thead style="color: white;background: #3e6184;">
                                            <tr>

                                                <th>N° Cuenta</th>
                                                <th>N°. Historia</th>
                                                <th>Apellido Paterno</th>
                                                <th>Apellido Materno</th>
                                                <th>Primer Nombre</th>
                                                <th>Fecha de Nacimiento</th>
                                                <th>Fecha de Ingreso</th>
                                                <th>Servicio</th>
                                                <th>Nro. Eval</th>
                                                <th>Fecha Eval</th>


                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <partial name="~/Views/Shared/Components/VistasParciales/NotaIngresoRegistrar.cshtml" />
            @*@Html.Partial("~/Views/Shared/Components/VistasParciales/NotaIngresoRegistrar.cshtml")*@
            <div data-backdrop="static" style="overflow-y: scroll;" data-keyboard="false" class="modal fade" id="modalReceta" role="dialog" aria-labelledby="modalLabelsuccess">
                <div class="modal-dialog modal-lg" role="document">
                    <div class="modal-content">
                        <div class="modal-header bg-info">
                            <h4 class="modal-title text-white" id="modalLabelsuccess">Imprime Receta</h4>
                        </div>
                        <div class="modal-body">
                            <div class="card m-t-10">
                                <div class="card">
                                    <ul id="clothing-nav" class="nav nav-tabs" role="tablist">

                                        <li class="nav-item">
                                            <a class="nav-link active" href="#farmaciaRece" role="tab" id="farmaciaRece-tab" data-toggle="tab" aria-controls="hats" aria-expanded="true">Farmacia</a>
                                        </li>


                                        <li class="nav-item">
                                            <a class="nav-link" href="#rayosRece" role="tab" id="rayosRece-tab" data-toggle="tab" aria-controls="hats">Rayos X</a>
                                        </li>

                                        <li class="nav-item">
                                            <a class="nav-link" href="#ecoObstRece" role="tab" id="ecoObstRece-tab" data-toggle="tab" aria-controls="hats">Ecografía Obstetrica</a>
                                        </li>

                                        <li class="nav-item">
                                            <a class="nav-link" href="#ecoGeneRece" role="tab" id="ecoGeneRece-tab" data-toggle="tab" aria-controls="hats">Ecografía General</a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link" href="#anatoPatoRece" role="tab" id="anatoPatoRece-tab" data-toggle="tab" aria-controls="hats">Anat. Patologica</a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link" href="#patoClinicaRece" role="tab" id="patoClinicaRece-tab" data-toggle="tab" aria-controls="hats">Pat. Clinica</a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link" href="#bancoSangreRece" role="tab" id="bancoSangreRece-tab" data-toggle="tab" aria-controls="hats">Banco Sangre</a>
                                        </li>
                                    </ul>
                                    <div class="card-block">
                                        <div id="clothing-nav-content" class="tab-content fade in active">

                                            <div role="tabpanel" class="tab-pane fade in active" id="farmaciaRece" aria-labelledby="farmaciaRece-tab">
                                                <br>
                                                <iframe id="ifrmRecetaFarm"
                                                        title="Inline Frame Example"
                                                        @*width="100%"*@
                                                        height="600"
                                                        src=""></iframe>

                                            </div>
                                            <div role="tabpanel" class="tab-pane fade" id="rayosRece" aria-labelledby="rayosRece-tab">
                                                <br>
                                                <iframe id="ifrmRecetaRx"
                                                        title="Inline Frame Example"
                                                        @*width="100%"*@
                                                        height="600"
                                                        src=""></iframe>
                                            </div>
                                            <div role="tabpanel" class="tab-pane fade" id="ecoObstRece" aria-labelledby="ecoObstRece-tab">
                                                <br>
                                                <iframe id="ifrmRecetaEcoObs"
                                                        title="Inline Frame Example"
                                                        @*width="100%"*@
                                                        height="600"
                                                        src=""></iframe>
                                            </div>
                                            <div role="tabpanel" class="tab-pane fade" id="ecoGeneRece" aria-labelledby="ecoGeneRece-tab">
                                                <br>
                                                <iframe id="ifrmRecetaEcoGene"
                                                        title="Inline Frame Example"
                                                        @*width="100%"*@
                                                        height="600"
                                                        src=""></iframe>
                                            </div>
                                            <div role="tabpanel" class="tab-pane fade" id="anatoPatoRece" aria-labelledby="anatoPatoRece-tab">
                                                <br>
                                                <iframe id="ifrmRecetaAnaPatolg"
                                                        title="Inline Frame Example"
                                                        @*width="100%"*@
                                                        height="600"
                                                        src=""></iframe>
                                            </div>
                                            <div role="tabpanel" class="tab-pane fade" id="patoClinicaRece" aria-labelledby="patoClinicaRece-tab">
                                                <br>
                                                <iframe id="ifrmRecetaPatoClini"
                                                        title="Inline Frame Example"
                                                        @*width="100%"*@
                                                        height="600"
                                                        src=""></iframe>
                                            </div>
                                            <div role="tabpanel" class="tab-pane fade" id="bancoSangreRece" aria-labelledby="bancoSangreRece-tab">
                                                <br>
                                                <iframe id="ifrmRecetaBs"
                                                        title="Inline Frame Example"
                                                        @*width="100%"*@
                                                        height="600"
                                                        src=""></iframe>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>



                            <div class="modal-footer">

                                <button id="btnCerrarRecetas" target="_blank" class="btn  btn-secondary "> Cerrar</button>

                            </div>

                        </div>
                    </div>
                </div>

            </div>
            <div data-backdrop="static" style="overflow-y: scroll;" data-keyboard="false" class="modal fade" id="modalSeguimiento" role="dialog" aria-labelledby="modalLabelsuccess">
                <div class="modal-dialog modal-lg" role="document">
                    <div class="modal-content">
                        <div class="modal-header bg-primary">
                            <h4 class="modal-title text-white" id="modalLabelsuccess">Seguimiento de Paciente</h4>
                        </div>
                        <div class="modal-body" style="background-color:#b4c6d6">

                            <div class="row">
                                <div class="col-md-12">
                                    <partial name="~/Views/Shared/Components/VistasParciales/SeguimientoPaciente.cshtml" />
                                    @*@Html.Partial("~/Views/Shared/Components/VistasParciales/SeguimientoPaciente.cshtml");*@
                                </div>
                            </div>


                        </div>
                        <div class="modal-footer" style="background-color:#ced8e1">

                            <button id="btnCerrarSeguimiento" target="_blank" class="btn  btn-secondary "> Cerrar</button>

                        </div>
                    </div>
                </div>

            </div>
            <partial name="~/Views/Shared/Components/VistasParciales/ConsumoServicioRegistro.cshtml" />
            @*@Html.Partial("~/Views/Shared/Components/VistasParciales/ConsumoServicioRegistro.cshtml")*@
            @section Scripts
    {
                <script type="text/javascript" src="~/AdmiRE/vendors/chosen/js/chosen.jquery.js"></script>
                <script type="text/javascript" src="~/AdmiRE/vendors/raphael/js/raphael-min.js"></script>
                <script type="text/javascript" src="~/AdmiRE/vendors/justgage/js/justgage.js"></script>
                <script type="text/javascript" src="~/AdmiRE/vendors/d3/js/d3.min.js"></script>
                <script type="text/javascript" src="~/AdmiRE/vendors/c3/js/c3.min.js"></script>
                <script type="text/javascript" src="~/AdmiRE/vendors/jquery-tagsinput/js/jquery.tagsinput.js"></script>
                <script type="text/javascript" src="~/AdmiRE/vendors/bootstrap-datetimepicker/js/bootstrap-datetimepicker.min.js"></script>

                <script type="text/javascript" src=@Href("~/js/VistasParciales/Diagnosticos.js")></script>
                <script type="text/javascript" src=@Href("~/js/VistasParciales/Triaje.js")></script>
                <script type="text/javascript" src=@Href("~/js/Hospitalizacion/NotaIngreso.js")></script>
                <script type="text/javascript" src=@Href("~/js/VistasParciales/SeguimientoPaciente.js")></script>
                <script type="text/javascript" src=@Href("~/js/VistasParciales/OrdenesYResultados.js")></script>
                <script type="text/javascript" src=@Href("~/js/Facturacion/ConsumoServicio.js")></script>
                <script type="text/javascript" src=@Href("~/js/VistasParciales/Ordenes.js")></script>
                @*<script type="text/javascript" src=@Href("~/js/Facturacion/Facturacion_Lista.js")></script>*@

                <script src="~/AdmiRE/js/date.format.js"></script>

                <script type="text/javascript">
                    $(document).ready(function () {
                        NOTAINGRESO.init();

                    });

                </script>

            }

            <style>
                .tab100 {
                    width: 100%
                }

                #clothing-nav-content2 .form-group {
                    margin-bottom: 0 !important;
                }

                #tblPacientesHosp tr.over td {
                    background: #D6E8F8;
                    font-weight: bold;
                }

                /*  .chosen-container chosen-container-single {
                                    width: 100% !important;
                                }*/


                .chosen-container {
                    width: 100% !important;
                }

                .modal-lg {
                    max-width: 1400px !important;
                }
            </style>
        </div>
    </div>
</div>