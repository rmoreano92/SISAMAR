<style>


    .CalculatorPane table td{
        display: table-cell;
        line-height: 1.125rem;
        padding: 0.5625rem 0.625rem;
        font-size: .875rem;
        color: #222;
    }

    .SectionHeader {
        background-color: #1F497D;
        font-weight: bold;
        text-align: center;
        color: #FFF !important;
        padding: 5px 0 !important
    }

    .panel {
        border-style: solid;
        border-width: 1px;
        border-color: #d7d7d7;
        margin-bottom: 1.25rem;
        padding: 1.25rem;
        background: #f2f2f2;
    }

    section.ClinCalcRadioSmall input[type="radio"] {
        display: none;
    }

        section.ClinCalcRadioSmall input[type="radio"]:checked + label {
            background: #1f497d;
            color: white;
        }

    section.ClinCalcRadioSmall input[type="radio"]:not(:disabled) ~ label {
        cursor: pointer;
    }

    section.ClinCalcRadioSmall label:first-of-type {
        border-top-left-radius: 4px;
        border-bottom-left-radius: 4px;
    }

    section.ClinCalcRadioSmall label {
        text-align: center;
        background: #fff;
        border: 1px solid #1f497d;
        padding: 0.3em 1em;
        margin: 0;
        margin-right: -0.3em;
        font-weight: bold;
        color: #1f497d;
        position: relative;
    }

    section.ClinCalcRadioSmall input[type="radio"]:checked + label::after {
        content: '';
        position: absolute;
        top: -5px;
        left: 0;
        right: 0;
        margin: 0 auto;
        width: 0;
        height: 0;
        background-clip: padding-box;
        background: #1f497d;
        position: absolute;
        transform: translateX(-50%);
        top: -5px;
        left: 10px;
        height: 10px;
        width: 10px;
        text-align: center;
        border-radius: 50%;
    }

</style>

