                                                                <th style="width: 10%">Fecha Ingreso</th>
                                                                <th style="width: 10%">Nro. Orden</th>
                                                                <th style="width: 10%">Codigo</th>
                                                                <th style="width: 10%">Descripcion</th>
                                                                <th style="width: 10%">Servicio Actual</th>
                                                                <th style="width: 10%">Plan</th>
                                                                <th style="width: 10%">Acciones</th>

                                                            </tr>
                                                        </thead>
                                                        <tbody></tbody>
                                                    </table>
                                                </div>

                                            </div>

                                        </div>
                                        <div role="tabpanel" class="tab-pane fade" id="ceAtencion" aria-labelledby="ceAtencion-tab">

                                            <partial name="~/Views/Shared/Components/VistasParciales/Hospitalizacion/RegistroInterconsultaHo.cshtml" />

                                            <div class="row mt-2">
                                                <div class="col-lg-8">
                                                    <button id="btnImprimeRecetas" target="_blank" class="btn btn-lg  btn-danger float-lg-left mr-1 mb-1"><i class="fa fa-print"></i>&nbsp; Imp. Recetas</button>
                                                    <button id="btnImprimeSeguimiento" target="_blank" class="btn btn-lg  btn-warning  float-lg-left mr-1 mb-1"><i class="fa fa-search"></i>&nbsp; Seguimiento</button>
                                                    <button id="btnCboRefresca" data-toggle="tooltip" data-placement="top" title="Actializa cbox" class="btn btn-lg  btn-success  float-lg-left mb-1"><i class="fa fa-refresh"></i></button>

                                                </div>
                                                <div class="col-lg-4">
                                                    @*<button id="btnImprimeAtencion" target="_blank" class="btn  btn-success float-lg-left"><i class="fa fa-print"></i>&nbsp; Imp. Atencion</button>*@
                                                    <button id="btnCerrarAtencion" type="button" data-dismiss="modal" class="btn btn-lg btn-secondary float-lg-right mr-1 mb-1">Cerrar</button>
                                                    <button id="btnguardar" class="btn btn-lg  btn-info float-lg-right mr-1 mb-1">Guardar</button>
                                                </div>
                                            </div>
                                        </div>

                                    </div>
                                </div>

                            </div>

                            <input type="hidden" value="@ViewBag.idEmpleado" id="idEmpleadotxt" /> @*JDELGADO001*@
                        </div>
                    </div>
                </div>
