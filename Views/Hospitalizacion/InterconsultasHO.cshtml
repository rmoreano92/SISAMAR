                                                                        <div class="col-lg-9">
                                                                            <div class="row">

                                                                                <div class="col-lg-2">
                                                                                    <div class="form-group">
                                                                                        <label for="txtHistoria" class="form-control-label">Historia Clinica</label>
                                                                                        <div class="input-group input-group-sm">
                                                                                            <input id="txtHistoria" autocomplete="off" placeholder="" class="form-control">
                                                                                        </div>
                                                                                    </div>
                                                                                </div>
                                                                                <div class="col-lg-2">
                                                                                    <div class="form-group">
                                                                                        <label for="txtNroCuenta" class="form-control-label">N° Orden</label>
                                                                                        <div class="input-group input-group-sm">
                                                                                            <input id="txtNroReceta" autocomplete="off" placeholder="" class="form-control">
                                                                                        </div>
                                                                                    </div>
                                                                                </div>
                                                                                <div class="col-lg-2">
                                                                                    <div class="form-group">
                                                                                        <label for="txtNroDni" class="form-control-label">N° Dni</label>
                                                                                        <div class="input-group input-group-sm">
                                                                                            <input id="txtNroDni" autocomplete="off" placeholder="" class="form-control">
                                                                                        </div>
                                                                                    </div>
                                                                                </div>
                                                                                <div class="col-lg-3">
                                                                                    <div class="form-group">
                                                                                        <label for="txtApPaterno" class="form-control-label">Apellido Paterno</label>
                                                                                        <div class="input-group input-group-sm">
                                                                                            <input id="txtApPaterno" autocomplete="off" placeholder="" class="form-control">
                                                                                        </div>
                                                                                    </div>
                                                                                </div>
                                                                                <div class="col-lg-3">
                                                                                    <div class="form-group">
                                                                                        <label for="txtFechaIngreso" class="form-control-label">Fecha Ingreso</label>
                                                                                        <div class="input-group  input-group-sm">
                                                                                            <input type="date" id="txtFechaIngreso" autocomplete="off" placeholder="dd/mm/yyyy" data-date-format="dd/mm/yyyy" class="form-control">
                                                                                        </div>
                                                                                    </div>
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                        <div class="col-lg-3">
                                                                            <div class="form-group">
                                                                                <label for="cboServicio" class="form-control-label">Servicio</label>
                                                                                <div class="input-group">
                                                                                    <select class="chzn-select" id="cboServicio"></select>
                                                                                </div>
                                                                            </div>
                                                                        </div>

                                                                    </div>
                                                                </div>
                                                                <div class="col-lg-2">
                                                                    <br>
                                                                    <button class="btn btn-primary layout_btn_prevent" id="btnBuscarPacientes">Buscar</button>
                                                                    <button class="btn btn-default layout_btn_prevent" id="btnLimpiarFiltro">Limpiar</button>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>


                                                <div class="col-lg-6 pt-2 pb-0">
                                                    @{
                                                        if (@ViewBag.Agregar)
                                                        {
                                                            @*<button class="btn btn-primary layout_btn_prevent" id="btnAgregar">Agregar</button>*@
                                                        }
                                                        if (@ViewBag.Modificar)
                                                        {
                                                            <button class="btn btn-info layout_btn_prevent" id="btnModificarAtenciones">Modificar</button>
                                                        }
                                                        if (@ViewBag.Eliminar)
                                                        {
                                                            <button class="btn btn-danger layout_btn_prevent" id="btnEliminarAtenciones">Eliminar</button>
                                                        }
                                                        if (@ViewBag.Consultar)
                                                        {
                                                            <button class="btn btn-warning layout_btn_prevent" id="btnConsultarAtenciones">Consultar</button>
                                                        }
                                                    }
                                                </div>

                                                @* <div class="col-md-6 d-flex align-items-end justify-content-end" style="height: 50px;">
                                                    <label for="" class="titulo mr-1" style=" font-size: medium; color: #0095ff !important;">Parte Diario: </label>
                                                    <div>
                                                        <button class="btn btn-danger layout_btn_prevent" id="btnGeneraParte" title="Genera Parte" data-toggle="tooltip" style="margin: 2px;"><i class="fa fa-pencil"></i></button>
                                                        <button class="btn btn-success layout_btn_prevent" id="btnDescargaParte" title="Imprime Parte Firmado" data-toggle="tooltip" style="margin: 2px;"><i class="fa fa-print"></i></button>
                                                        <button class="btn btn-warning layout_btn_prevent" id="btnDescargaParteSF" title="Visualiza Parte" data-toggle="tooltip" style="margin: 2px;"><i class="fa fa-eye"></i></button>
                                                    </div>
                                                </div> *@

                                                <div class="col-lg-12">
                                                    <table id="tblPacientesHosp" width="100%" class="table table-sm table-bordered">
                                                        <thead style="color: white;background: #434343;">
                                                            <tr>

                                                                <th style="width: 10%">N° Cuenta</th>
                                                                <th style="width: 10%">N°. Historia</th>
                                                                <th style="width: 10%">Apellido Paterno</th>
                                                                <th style="width: 10%">Apellido Materno</th>
