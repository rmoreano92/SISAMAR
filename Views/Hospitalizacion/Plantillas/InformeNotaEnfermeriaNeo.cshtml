<body style="background: transparent; width:698px; height:1015px; position:relative;">

    @if (ViewBag.CodigoQR != null)
    {
        <img class="qr-code" src="@String.Format("data:image/png;base64,{0}", Convert.ToBase64String(ViewBag.CodigoQR))" />
    }

    <div class="position-absolute text-right" style="right:75px; top:25px; font-size: 7px;">
        <span>@ViewBag.FechaImpresion</span><br />
        <span>@ViewBag.Usuario</span>
    </div>

    @if (@ViewBag.NroEvaluacion == 1)
    {
        <div class="w-100 h-100 pb-5">
            <div id="cajaTitulo">
                <p style="" class="fw-bold m-0">
                    DEPARTAMENTO DE ENFERMERIA <br /><br /> NOTAS DE ENFERMERIA <br /> <br />
                    REGISTRO DEL CUIDADO DE ENFERMERÍA DEL RECIÉN NACIDO EN EL SERVICIO DE ATENCIÓN INMEDIATA
                </p>
                <small class="fw-bold" style="color:lightgray">FN-019 AI</small>
            </div>

            <div class="d-flex mb-1" style="font-size: 10px !important;">
                <table class="table table-bordered border-secondary m-0 me-1" style="width: 180px;">
                    <tbody>
                        <tr>
                            <th class="border-secondary text-center fw-bold p-0" style="width:110px;">FECHA ATENCIÓN</th>
                            <td class="border-secondary text-center px-0 px-1" style="width:70px;">
                                @ViewBag.FechaRegistro
                            </td>
                        </tr>
                    </tbody>
                </table>

                <table class="table table-bordered border-secondary m-0 me-1" style="width: 170px;">
                    <tbody>
                        <tr>
                            <th class="border-secondary text-center fw-bold p-0" style="width:110px;">HORA ATENCIÓN</th>
                            <td class="border-secondary text-center px-0 px-1" style="width:60px;">
                                @ViewBag.HoraRegistro
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="card mb-1 border-secondary">
                <div class="card-header border-secondary">I. VALORACIÓN DE ENFERMERÍA</div>
                <div class="card-block">
                    <div>
                        <form>
                            <fieldset class="border border-secondary px-2">
                                <legend class="float-none w-auto font-weight-bold m-0" style="font-size: 8.5px;">
                                    Maniobras
                                    aplicadas durante el parto
                                </legend>
                                <div class="white-space" style="min-height: 20px;">@ViewBag.ManiobraDuranteParto</div>
                            </fieldset>
                        </form>
                    </div>

                    <div class="card mt-1 mb-1 border-secondary">
                        <div class="card-header border-secondary">A. Datos Generales del R.N</div>
                        <div class="card-block">
                            <div class="d-flex mb-1" style="font-size: 10px !important;">
                                <table class="table table-bordered border-secondary m-0 me-1" style="width: 180px;">
                                    <tbody>
                                        <tr>
                                            <th class="border-secondary text-center fw-bold p-0" style="width:100px;">
                                                Fecha
                                                Nacimiento
                                            </th>
                                            <td class="border-secondary text-center px-0 px-1" style="width:80px;">
                                                @ViewBag.FechaNacimiento
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>

                                <table class="table table-bordered border-secondary m-0 me-1" style="width: 100px;">
                                    <tbody>
                                        <tr>
                                            <th class="border-secondary text-center fw-bold p-0" style="width:50px;">
                                                Hora
                                            </th>
                                            <td class="border-secondary text-center px-0 px-1" style="width:50px;">
                                                @ViewBag.HoraNacimiento
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>

                                <table class="table table-bordered border-secondary m-0 me-1" style="width: 120px;">
                                    <tbody>
                                        <tr>
                                            <th class="border-secondary text-center fw-bold p-0" style="width:40px;">
                                                Sexo
                                            </th>
                                            <td class="border-secondary text-center px-0 px-1" style="width:80px;">
                                                @ViewBag.Sexo
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>

                                <table class="table table-bordered border-secondary m-0 me-1" style="width: 200px;">
                                    <tbody>
                                        <tr>
                                            <th class="border-secondary text-center fw-bold p-0" style="width:50px;">
                                                Apgar
                                            </th>
                                            <td class="border-secondary text-center px-0 px-1" style="width:150px;">
                                                @ViewBag.Apgar5
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>

                                <table class="table table-bordered border-secondary m-0 me-1" style="width: 150px;">
                                    <tbody>
                                        <tr>
                                            <th class="border-secondary text-center fw-bold p-0" style="width:100px;">
                                                Edad
                                                gestacional
                                            </th>
                                            <td class="border-secondary text-center px-0 px-1" style="width:50px;">
                                                @ViewBag.EdadGestacional
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>


                    <div style="width: 100%; text-align: center;" class="mt-1">
                        <p style="font-size: 13px;"><strong>DESCRIPCIÓN DE LA CONDICIÓN DEL RN</strong></p>
                    </div>

                    <div class="card mt-1 mb-1 border-secondary">
                        <div class="card-header border-secondary">
                            B. Valoración del R.N.
                        </div>
                        <div class="card-block">

                            <div class="d-flex mb-1" style="font-size: 10px !important;">
                                <table class="table m-0 me-1" style="width: 170px;">
                                    <tbody>
                                        <tr>
                                            <th class="text-left fw-bold p-0" style="width:170px;">
                                                Somatometria:
