                        SELLO Y FIRMA DEL RESPONSABLE<br />
                        <b>@ViewBag.Medico</b>
                    </div>
                </div>
            }

        </div>
    }
    <div class="w-100 pb-1" @(ViewBag.NroEvaluacion == 1 ? "style='page-break-before: always; position:relative;'" : "")>

        @if (@ViewBag.NroEvaluacion != 1)
        {
            <div id="cajaTitulo">
                <p style="" class="fw-bold m-0">
                    DEPARTAMENTO DE ENFERMERIA <br /><br /> NOTAS DE ENFERMERIA <br /> <br />
                    EVALUACIÓN N° @ViewBag.NroEvaluacion
                </p>
                <small class="fw-bold" style="color:lightgray">FN-019 AI</small>
            </div>
        } else
        {
            <div id="cajaTitulo">
                <p style="" class="fw-bold m-0">
                    EVALUACIÓN N° @ViewBag.NroEvaluacion
                </p>
            </div>
        }

        @if (ViewBag.CodigoQR != null)
        {
            <img class="qr-code" src="@String.Format("data:image/png;base64,{0}", Convert.ToBase64String(ViewBag.CodigoQR))" />
        }



        <div class="d-flex mb-1" style="font-size: 10px !important;">
            <table class="table table-bordered border-secondary m-0 me-1" style="width: 180px;">
                <tbody>
                    <tr>
                        <th class="border-secondary text-center fw-bold p-0" style="width:110px;">FECHA ATENCIÓN</th>
                        <td class="border-secondary text-center px-0 px-1" style="width:70px;">
                            @ViewBag.FechaRegistro
                        </td>
                    </tr>
                </tbody>
            </table>

            <table class="table table-bordered border-secondary m-0 me-1" style="width: 170px;">
                <tbody>
                    <tr>
                        <th class="border-secondary text-center fw-bold p-0" style="width:110px;">HORA ATENCIÓN</th>
                        <td class="border-secondary text-center px-0 px-1" style="width:60px;">
                            @ViewBag.HoraRegistro
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="card mb-2 border-secondary">
            <div class="card-header border-secondary">
                Evaluación de cuidado
            </div>
            <div class="card-block">
                <div style="min-height: 70px;">
                    @ViewBag.EvaluacionCuidadoRn
                </div>
            </div>
        </div>


        <div class="card mb-2 border-secondary">
            <div class="card-header border-secondary">
                Evaluación de cuidado en Factor de Riesgo
            </div>
            <div class="card-block">
                <div style="min-height: 70px;">
                    @ViewBag.EvaluacionCuidadoRnFactorRiesgo
                </div>
            </div>
        </div>

        <div class=" ms-auto mt-2 pt-4 mb-2" style="width: 250px;">
            <div class="border-top border-secondary text-center p-1">
                SELLO Y FIRMA DEL RESPONSABLE<br />
                <b>@ViewBag.Medico</b>
            </div>
        </div>
    </div>


</body>



</html>