                                        <tr>
                                            <th class="border-0 p-0 align-middle" width="15"><div class="item @ViewBag.ComplicacionParto"><div class="item-box item-Si"></div></div></th>
                                            <td class="border-0 p-0 align-middle" width="15"><div class="item @ViewBag.ComplicacionParto"><div class="item-box item-No"></div></div></td>
                                            <td class="border-0 pt-1 pb-1" width="150">Complicación del Parto</td>
                                            <td class="border-0 pt-1 pb-1" width="220"><div class="border-bottom border-secondary" style="min-height: 12px;">@ViewBag.ComplicacionPartoDetalle</div></td>
                                        </tr>
                                    </tbody>
                                </table>
                                <table class="table table-bordered border-secondary mb-1">
                                    <tbody>
                                        <tr>
                                            <td class="border-secondary pt-0 pb-0">@ViewBag.RupturaMembranaMinutos</td>
                                            <th style="width:70px;" class="border-secondary p-0 table-active align-middle text-left bg-secondary">Minutos</th>
                                            <td class="border-secondary pt-0 pb-0">@ViewBag.RupturaMembranaHoras</td>
                                            <th style="width:70px;" class="border-secondary p-0 table-active align-middle text-left bg-secondary">Horas</th>
                                            <td class="border-secondary pt-0 pb-0">@ViewBag.RupturaMembranaDias</td>
                                            <th style="width:70px;" class="border-secondary p-0 table-active align-middle text-left bg-secondary">Días</th>                                            
                                        </tr>
                                    </tbody>
                                </table>
                                <table class="table table-bordered border-secondary m-0 me-2 mb-1">
                                    <tbody>
                                        <tr>
                                            <th class="border-secondary text-center fw-bold p-0" width="100">Posición Parto</th>
                                            <td class="border-secondary text-center p-0" height="18">@ViewBag.PosicionParto</td>
                                        </tr>
                                    </tbody>
                                </table>
                                <div class="d-flex">
                                    <div class="mx-2" style="width: 120px;">
                                        <div class="item @ViewBag.ConAcompaniante">
                                            <div class="item-box item-Si"></div>
                                            <div class="item-label">Parto con acompaña.</div>
                                        </div>
                                    </div>
                                    <div class="mx-2" style="width: 120px;">
                                        <div class="item @ViewBag.ConAnalgesia">
                                            <div class="item-box item-Si"></div>
                                            <div class="item-label">Parto con analgesia</div>
                                        </div>
                                    </div>
                                    <div class="mx-2" style="width: 120px;">
                                        <div class="item @ViewBag.ConTrasladoConjunto">
                                            <div class="item-box item-Si"></div>
                                            <div class="item-label">Traslado Conjunto</div>
                                        </div>
                                    </div>
                                </div>
                            </div>                         
                        </div>                        
                    </div>

                    <div class="col-5">
                        <span><strong>Observaciones</strong></span>
                        <div class="white-space" style="min-height: 15px;">@ViewBag.ObservacionesLaborParto</div>
                    </div>
                                                            
                </div>   
                              
            </div>
        </div>

