                            <td class="border-secondary pt-0 pb-0" width="100">@ViewBag.PielaPiel</td>
                        </tr>
                    </tbody>
                </table>
                <table class="table table-bordered border-secondary mb-1">
                    <tbody>
                        <tr>
                            <th class="border-secondary p-0 table-active  text-center bg-secondary">Lact. 1era Hora</th>
                            <td class="border-secondary pt-0 pb-0" width="30">@ViewBag.Lactancia1raHora</td>
                            <th class="border-secondary p-0 table-active  text-center bg-secondary">Serv. Naci.</th>
                            <td class="border-secondary pt-0 pb-0" width="110">@ViewBag.ServicioNacimiento</td>
                            <th class="border-secondary p-0 table-active  text-center bg-secondary">Otra Proced.</th>
                            <td class="border-secondary pt-0 pb-0" width="110">@ViewBag.OtraProcedencia</td>
                            <th class="border-secondary p-0 table-active  text-center bg-secondary">Inmediato</th>
                            <td class="border-secondary pt-0 pb-0" width="30">@ViewBag.Inmediato</td>
                            <th class="border-secondary p-0 table-active  text-center bg-secondary">Reanimacion</th>
                            <td class="border-secondary pt-0 pb-0" width="30">@ViewBag.Reanimacion</td>
                        </tr>
                    </tbody>
                </table>
                <table class="table table-bordered border-secondary mb-1">
                    <tbody>
                        <tr>
                            <th class="border-secondary p-0 table-active  text-center bg-secondary">Apgar 1 min.</th>
                            <td class="border-secondary pt-0 pb-0" width="40">@ViewBag.AlMinuto</td>
                            <th class="border-secondary p-0 table-active  text-center bg-secondary">Apgar 5 min.</th>
                            <td class="border-secondary pt-0 pb-0" width="40">@ViewBag.Alos5Minutos</td>
                            <th class="border-secondary p-0 table-active  text-center bg-secondary">Apgar 10 min.</th>
                            <td class="border-secondary pt-0 pb-0" width="40">@ViewBag.Alos10Minutos</td>
                            <th class="border-secondary p-0 table-active  text-center bg-secondary">Apgar 15 min.</th>
                            <td class="border-secondary pt-0 pb-0" width="40">@ViewBag.Alos15Minutos</td>
                            <th class="border-secondary p-0 table-active  text-center bg-secondary">Apgar 20 min.</th>
                            <td class="border-secondary pt-0 pb-0" width="40">@ViewBag.Alos20Minutos</td>
                        </tr>
                    </tbody>
                </table>
                <table class="table table-bordered border-secondary mb-1">
                    <tbody>
                        <tr>
                            <th class="border-secondary p-0 table-active text-center bg-secondary" width="90">Pato. Neona.</th>
                            <td class="border-secondary pt-0 pb-0" width="40">@ViewBag.PatologiaNeonatal</td>
                            <td class="border-secondary pt-0 pb-0">@ViewBag.PatologiaNeonatalDetalle</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        
