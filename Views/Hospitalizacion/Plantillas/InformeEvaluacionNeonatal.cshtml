<body style="background: transparent; width:698px; height:1015px; padding-bottom:170px; position:relative;">
        
    @if (ViewBag.CodigoQR != null)
    {
        <img class="qr-code" src="@String.Format("data:image/png;base64,{0}", Convert.ToBase64String(ViewBag.CodigoQR))" />
    }

    <div class="position-absolute text-right" style="right:75px; top:5px; font-size: 7px;">
        <span>@ViewBag.FechaImpresion</span><br />
        <span>@ViewBag.Usuario</span>
    </div>

    <div class="w-100 h-100">
        <div id="cajaTitulo">
            ATENCIÓN DE HOSPITALIZACIÓN NEONATAL
        </div>

        <div class="d-flex mb-1">
            <table class="table table-bordered border-secondary m-0 me-2" style="width: 120px;">
                <tbody>
                    <tr>
                        <th class="border-secondary text-center fw-bold p-0" style="width:50px;">FECHA</th>
                        <td class="border-secondary text-center p-0">@ViewBag.FechaEvaluacion</td>
                    </tr>
                </tbody>
            </table>

            <table class="table table-bordered border-secondary m-0" style="width: 100px;">
                <tbody>
                    <tr>
                        <th class="border-secondary text-center fw-bold p-0" style="width:50px;">HORA</th>
                        <td class="border-secondary text-center p-0">@ViewBag.HoraEvaluacion</td>
                    </tr>
                </tbody>
            </table>

        </div>

        

        <!--/////////////////////////ANTECEDENTES PERINATALES, EMBARAZO ACTUAL////////////////////////////////////////////////////////-->
        <div class="card mb-2 border-secondary ">
            <div class="card-header border-secondary">
                ANTECEDENTES PERINATALES, EMBARAZO ACTUAL
            </div>
            <div class="card-block">
                
                <table class="table table-bordered border-secondary mb-2">
                    <tbody>                        
                        <tr>
                            <th style="width:55px;" class="border-secondary p-0 table-active align-middle text-center bg-secondary">PESO</th>
                            <td class="border-secondary pt-0 pb-0">@ViewBag.PesoMadre</td>
                            <th style="width:55px;" class="border-secondary p-0 table-active align-middle text-center bg-secondary">TALLA</th>
                            <td class="border-secondary pt-0 pb-0">@ViewBag.TallaMadre</td>
                            <th style="width:55px;" class="border-secondary p-0 table-active align-middle text-center bg-secondary">GESTA</th>
                            <td class="border-secondary pt-0 pb-0">@ViewBag.Gesta</td>
                            <th style="width:66px;" class="border-secondary p-0 table-active align-middle text-center bg-secondary">PARIDAD</th>
                            <td class="border-secondary pt-0 pb-0">@ViewBag.Paridad</td>
                            <th style="width:45px;" class="border-secondary p-0 table-active align-middle text-center bg-secondary">EG</th>
                            <td class="border-secondary pt-0 pb-0">@ViewBag.EdadGes</td>
                        </tr>
                    </tbody>
                </table>

                <div class="row mb-1">
                    <div class="col-12"><span style="font-size: 11px"><strong>Antecedentes de Riesgo Perinatal</strong></span></div>
                    <div class="col-4">
                        <table class="table m-0" style="background-color: transparent;border: 0;">
                            <tbody class="border-0">
                                <tr>
                                    <th class="border-0 p-0 align-middle" width="15"><div class="item @ViewBag.Peso4000"><div class="item-box item-Si"></div></div></th>
                                    <td class="border-0 pt-1 pb-1" width="90">Peso &#62; 4000gr</td>
                                    <td class="border-0 pt-1 pb-1" width="200"><div class="border-bottom border-secondary" style="min-height: 12px;">@ViewBag.DPeso4000</div></td>
                                </tr>
