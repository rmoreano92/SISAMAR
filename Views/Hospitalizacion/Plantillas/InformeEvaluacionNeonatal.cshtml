                            <td class="border-secondary pt-0 pb-0" width="40">@ViewBag.PerimetroToracico</td>
                        </tr>
                    </tbody>
                </table>
                <table class="table table-bordered border-secondary mb-1">
                    <tbody>
                        <tr>
                            <th class="border-secondary p-0 table-active  text-center  bg-secondary">Edad Gest.</th>
                            <td class="border-secondary pt-0 pb-0" width="40">@ViewBag.EdadGes</td>
