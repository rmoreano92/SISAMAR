            <div class="card-header border-secondary">
                ANTECEDENTES NATALES, LABOR Y PARTO
            </div>
            <div class="card-block">

                <div class="row avoid-break">
                    <div class="col-12">
                        <table class="table table-bordered border-secondary mb-1">
                            <tbody>
                                <tr>
                                    <th style="width:90px;" class="border-secondary p-0 table-active align-middle text-center bg-secondary">F. Inicio Labor</th>
                                    <td class="border-secondary pt-0 pb-0">@ViewBag.FechaInicioLaborParto</td>
                                    <th style="width:90px;" class="border-secondary p-0 table-active align-middle text-center bg-secondary">1er Periodo</th>
                                    <td class="border-secondary pt-0 pb-0">@ViewBag.PrimerPeriodo</td>
                                    <th style="width:90px;" class="border-secondary p-0 table-active align-middle text-center bg-secondary">2do Periodo</th>
                                    <td class="border-secondary pt-0 pb-0">@ViewBag.SegundoPeriodo</td>
                                </tr>
                            </tbody>
                        </table>

                        <table class="table table-bordered border-secondary mb-2">
                            <tbody>
                                <tr>
                                    <th style="width:100px;" class="border-secondary p-0 table-active align-middle text-center bg-secondary">Inicio Labor</th>
                                    <td class="border-secondary pt-0 pb-0">@ViewBag.TipoInicioLaborParto</td>
                                    <th style="width:100px;" class="border-secondary p-0 table-active align-middle text-center bg-secondary">Present. Fetal</th>
                                    <td class="border-secondary pt-0 pb-0">@ViewBag.TipoPresentacionFetal</td>
                                    <th style="width:100px;" class="border-secondary p-0 table-active align-middle text-center bg-secondary">Trabajo Parto</th>
                                    <td class="border-secondary pt-0 pb-0">@ViewBag.TipoDetalleParto</td>
                                </tr>
                                <tr>
                                    <th style="width:100px;" class="border-secondary p-0 table-active align-middle text-center bg-secondary">Detalle Cesárea</th>
                                    <td class="border-secondary pt-0 pb-0">@ViewBag.TipoDetalleCesarea</td>
                                    <th style="width:100px;" class="border-secondary p-0 table-active align-middle text-center bg-secondary">Sufrim. Fetal</th>
                                    <td class="border-secondary pt-0 pb-0">@ViewBag.TipoSufrimientoFetal</td>
                                    <th style="width:100px;" class="border-secondary p-0 table-active align-middle text-center bg-secondary">Tipo Trabajo Parto</th>
                                    <td class="border-secondary pt-0 pb-0">@ViewBag.TipoTrabajoParto</td>
                                </tr>
                                <tr>
                                    <th style="width:100px;" class="border-secondary p-0 table-active align-middle text-center bg-secondary">Anest. Aplicada</th>
                                    <td class="border-secondary pt-0 pb-0">@ViewBag.TipoAnestesiaAplicada</td>
                                    <th style="width:100px;" class="border-secondary p-0 table-active align-middle text-center bg-secondary">Liq. Amniotico</th>
                                    <td class="border-secondary pt-0 pb-0">@ViewBag.TipoLiquidoAmniotico</td>
                                    <th style="width:100px;" class="border-secondary p-0 table-active align-middle text-center bg-secondary">Cordón Umbilical</th>
                                    <td class="border-secondary pt-0 pb-0">@ViewBag.TipoCordonUmbilical</td>
                                </tr>
                                <tr>
                                    <th style="width:100px;" class="border-secondary p-0 table-active align-middle text-center bg-secondary">Placenta</th>
                                    <td class="border-secondary pt-0 pb-0">@ViewBag.TipoPlacenta</td>
                                    <th style="width:100px;" class="border-secondary p-0 table-active align-middle text-center bg-secondary">Medicamentos</th>
                                    <td class="border-secondary pt-0 pb-0">@ViewBag.TipoMedicamentos</td>
                                    <th style="width:100px;" class="border-secondary p-0 table-active align-middle text-center bg-secondary">Lugar Parto</th>
                                    <td class="border-secondary pt-0 pb-0">@ViewBag.TipoLugarParto</td>
                                </tr>
                                <tr>
                                    <th style="width:100px;" class="border-secondary p-0 table-active align-middle text-center bg-secondary">Otros Medicam.</th>
                                    <td class="border-secondary pt-0 pb-0" colspan="5">@ViewBag.OtrosMedicamentos</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="row avoid-break">
                    <div class="col-7">                        
                        <div class="row">
                            <div class="col-12">
                                <table class="table mb-1" style="background-color: transparent;border: 0;">
                                    <thead>
                                        <tr>
                                            <th class="item-cabecera p-0 border-0" width="15">Si</th>
                                            <th class="item-cabecera p-0 border-0" width="15">No</th>
                                            <th class="border-0" width="80"></th>
                                            <th class="border-0" width="360"></th>
                                        </tr>
                                    </thead>
