        <!--/////////////////////////ANTECEDENTES DE NACIMIENTO////////////////////////////////////////////////////////////////////////-->
        <div class="card mb-2 border-secondary avoid-break">
            <div class="card-header border-secondary">
                ANTECEDENTES DE NACIMIENTO
            </div>
            <div class="card-block">
                <table class="table table-bordered border-secondary mb-1">
                    <tbody>
                        <tr>
                            <th class="border-secondary p-0 table-active  text-center  bg-secondary">Fecha Nac.</th>
                            <td class="border-secondary pt-0 pb-0" width="75">@ViewBag.FechaNacimiento</td>
                            <th class="border-secondary p-0 table-active  text-center bg-secondary">Hora Nac.</th>
                            <td class="border-secondary pt-0 pb-0" width="45">@ViewBag.HoraNacimiento</td>
                            <th class="border-secondary p-0 table-active  text-center bg-secondary">Sexo</th>
                            <td class="border-secondary pt-0 pb-0" width="70">@ViewBag.Sexo</td>
                            <th class="border-secondary p-0 table-active  text-center bg-secondary">Tipo Gest.</th>
                            <td class="border-secondary pt-0 pb-0" width="70">@ViewBag.TipoGestacion</td>
