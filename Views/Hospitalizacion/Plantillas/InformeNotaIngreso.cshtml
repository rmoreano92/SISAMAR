        .item {
            display: flex;
            margin-bottom: 0.3rem;
        }

        .item-box {
            width: 15px;
            height: 15px;
            border: 1px solid #535353;
            margin-right: 5px;
        }

        .item-cabecera {
            width: 15px;
            height: 15px;
            margin-right: 5px;
            text-align: center;
        }

        .item-label {
            height: 15px;
            vertical-align: middle;
        }

        .item.Si .item-Si {
            text-align: center;
            vertical-align: middle;
            background-color: yellow;
        }

            .item.Si .item-Si::before {
                font-weight: bold;
                content: "X";
            }

        .item.No .item-No {
            text-align: center;
            vertical-align: middle;
            background-color: yellow;
        }

            .item.No .item-No::before {
                font-weight: bold;
                content: "X";
            }

        .Si .item-Si {
            text-align: center;
            vertical-align: middle;
            background-color: yellow;
        }

            .Si .item-Si::before {
                font-weight: bold;
                content: "X";
            }

        .No .item-No {
            text-align: center;
            vertical-align: middle;
            background-color: yellow;
        }

            .No .item-No::before {
                font-weight: bold;
                content: "X";
            }

        #cajaTitulo {
            width: 50%;
            border: 1px solid black;
            text-align: center;
            padding: 10px;
            font-weight: bold;
            margin-left: auto;
            margin-right: auto;
            box-shadow: 10px 10px #8d8d8d;
            margin-bottom: 20px;
        }

        .subtitulo {
            writing-mode: vertical-lr;
            -webkit-writing-mode: vertical-lr;
            -ms-writing-mode: vertical-lr;
            filter: flipH() flipV();
            margin: 0 auto;
            /*transform: rotate(270deg);*/
        }

        body {
            font-size: 10px;
        }
    </style>
</head>


<body style="background: white; width:793px; height:1122px;position:relative; /*border: 1px solid red;*/" class="">
    @*<body style="background: white">*@
    <img src="~/images/Logo.png" style="width: 80px; position:absolute; top:0;" />
    <table class="table table-bordered border-secondary" style="width: 100px; position:absolute; right: 0; top: 5px; border: none;">
        <tbody>
            <tr style="">
                <td class="border-secondary text-center fw-bold">F</td>
            </tr>
        </tbody>
    </table>

    <h6 style="" id="cajaTitulo">NOTA DE INGRESO  - FO - @*N° @ViewBag.NroEvaluacion*@</h6>

    <div class="d-flex" style="margin-bottom: 3px;">
    </div>

    <table class="table table-bordered border-secondary mb-1">
        <tbody>
            <tr>
                <th class="border-secondary table-active text-center p-0">Fecha</th>
                <th class="border-secondary table-active text-center p-0">Hora</th>
                <th class="border-secondary table-active text-center p-0">Edad</th>
                <th class="border-secondary table-active text-center p-0">Gesta</th>
                <th class="border-secondary table-active text-center p-0">Paridad</th>
                <th class="border-secondary table-active text-center p-0">FUR</th>
                <th class="border-secondary table-active text-center p-0">FPP</th>
                <th class="border-secondary table-active text-center p-0">Origen de servicio</th>
            </tr>
            <tr style="height: 20px">
                <td class="border-secondary align-top">@ViewBag.FechaIngreso</td>
                <td class="border-secondary align-top">@ViewBag.HoraInicioAtencion </td>
                <td class="border-secondary align-top">@ViewBag.Edad</td>
                <td class="border-secondary align-top">@ViewBag.GMotiA</td>
                <td class="border-secondary align-top">@ViewBag.PMotiA</td>
                <td class="border-secondary align-top">@ViewBag.FechaUR</td>
                <td class="border-secondary align-top">@ViewBag.FechaPP</td>
                <td class="border-secondary align-top">@ViewBag.DesServicio</td>
            </tr>
        </tbody>
    </table>

    <table class="table table-bordered border-secondary mb-1">
        <tbody>
            <tr>
                <th class="border-secondary table-active text-center p-0 col-4">MOTIVO DE INGRESO</th>
            </tr>
        </tbody>
    </table>

    <table class="table table-bordered border-secondary mb-1">
        <tbody>
            <tr>
                <th class="border-secondary table-active text-center p-0">MOTIVO DE ATENCIÓN</th>
            </tr>
            <tr style="height: 20px">
                <td class="border-secondary align-top">@ViewBag.EnfermedadA</td>
            </tr>
        </tbody>
    </table>
    <table class="table table-bordered border-secondary mb-1">
        <tbody>
            <tr>
                <th class="border-secondary table-active text-center p-0">SIGNOS Y SINTOMAS</th>
            </tr>
            <tr style="height: 20px">
                <td class="border-secondary align-top">@ViewBag.Sintomas</td>
            </tr>
        </tbody>
    </table>

    <table class="table table-bordered border-secondary mb-1 mt-1">
        <tbody>
            <tr>
                <th class="border-secondary table-active text-center p-0 col-4" colspan="12">ANTECEDENTES OBSTÉTRICOS</th>
            </tr>
            <tr style="height: 20px;">

                <td class="border-secondary align-top" style="width: 5%"><b>FUR</b></td>
                <td class="border-secondary align-top" style="width: 10%">@ViewBag.FechaUR</td>

                <td class="border-secondary align-top" style="width: 5%;"><b>FUE</b></td>
                <td class="border-secondary align-top" style="width: 10%;">@ViewBag.FechaEco</td>

                <td class="border-secondary align-top" style="width: 5%;"><b>FPP</b></td>
                <td class="border-secondary align-top" style="width: 10%;">@ViewBag.FechaPP</td>

                <td class="border-secondary align-top" style="width: 10%;"><b>EG</b></td>
                <td class="border-secondary align-top" style="width: 5%;">@ViewBag.EdadGestacional</td>

                <td class="border-secondary align-top" style="width: 10%;"><b>Semanas</b></td>
                <td class="border-secondary align-top" style="width: 5%;">@ViewBag.EdadGestacional</td>

                <td class="border-secondary align-top" style="width: 10%;"><b>CPN</b></td>
                <td class="border-secondary align-top" style="width: 10%;">@ViewBag.Cnp</td>

            </tr>
        </tbody>
    </table>

    <table class="table table-bordered border-secondary mb-1 mt-1">
        <tbody>
            <tr>
                <th class="border-secondary table-active text-center p-0 col-4" colspan="6">ANTECEDENTES MEDICOS</th>
            </tr>

            <tr style="height: 20px;">

                <td class="border-secondary align-top" style="width: 10%"><b>Medicos</b></td>
                <td class="border-secondary align-top" style="width: 50%" colspan="3">@ViewBag.Antecedentes</td>

            </tr>

            <tr style="height: 20px;">

                <td class="border-secondary align-top" style="width: 10%;"><b>Ram</b></td>
                <td class="border-secondary align-top" style="width: 10%;">@ViewBag.Ram</td>

                <td class="border-secondary align-top" style="width: 15%;"><b>Transfuciones</b></td>
                <td class="border-secondary align-top" style="width: 5%;">@ViewBag.TransfucionSangre</td>

            </tr>
        </tbody>
    </table>

    <table class="table table-bordered border-secondary mb-1 mt-1">
        <tbody>
            <tr>
                <th class="border-secondary table-active text-center p-0" style="width: 20%">ANTECEDENTES QUIRURGICOS</th>
                <td class="border-secondary align-top" style="width: 80%">@ViewBag.AntecedentesQuirurgicos</td>
            </tr>
        </tbody>
    </table>


    <table class="table table-bordered border-secondary mb-1">
        <tbody>
            <tr>
                <th class="border-secondary table-active text-center p-0 col-4">FUNCIONES VITALES</th>
                <th class="border-secondary table-active text-center p-0 col-4">EXAMEN GENERAL</th>
            </tr>
            <tr style="height: 20px;">
                <td class="border-secondary align-top" style="width: 50%;">
                    <b>PA</b> = @ViewBag.TriajePresion mm/Hg - <b>FC</b> = @ViewBag.TriajeFrecuenciaCardiaca /min - <b>FR</b> = @ViewBag.TriajeFrecuenciaRespiratoria /min - <b>T°</b> = @ViewBag.TriajeTemperatura C° - <b>PESO</b> = @ViewBag.TriajePeso Kg - <b>IMC</b> = @ViewBag.imc  <br />
                </td>

                <td class="border-secondary align-top" style="width: 50%;">
                    <b>General y sensorio</b> = @ViewBag.lEstadoGeneral -> @ViewBag.dEstadoGeneral @ViewBag.dEdemas
                    <b>Cardiovascular</b> = @ViewBag.lAparatoCV -> @ViewBag.dAparatoCV @ViewBag.dReflejos
                    <b>Abdomen</b> = @ViewBag.lAbdomen -> @ViewBag.dAbdomen
                    <b>Respiratorio</b> = @ViewBag.lAparatoR -> @ViewBag.dAparatoR
                    <b>Urinario</b> = @ViewBag.lAparatoU -> @ViewBag.dAparatoU
                    <b>Extremidades</b> = @ViewBag.lExtremidades -> @ViewBag.dExtremidades

                </td>
            </tr>
        </tbody>
    </table>

    <table class="table table-bordered border-secondary mb-1 mt-1">
        <tbody>
            <tr>
                <th class="border-secondary table-active text-center p-0 col-4" colspan="12">EXAMEN OBSTÉTRICO</th>
            </tr>
            <tr style="height: 20px;">

                <td class="border-secondary align-top" style="width: 5%"><b>AU</b></td>
                <td class="border-secondary align-top" style="width: 5%">@ViewBag.Lua</td>

                <td class="border-secondary align-top" style="width: 5%;"><b>LCF</b></td>
                <td class="border-secondary align-top" style="width: 5%;">@ViewBag.Llcf</td>

                <td class="border-secondary align-top" style="width: 5%;"><b>DU</b></td>
                <td class="border-secondary align-top" style="width: 5%;">@ViewBag.Ldu</td>

                <td class="border-secondary align-top" style="width: 10%;"><b>Proteinuria</b></td>
                <td class="border-secondary align-top" style="width: 5%;">@ViewBag.Proteinura</td>

                <td class="border-secondary align-top" style="width: 15%;"><b>Mov. Fetales</b></td>
                <td class="border-secondary align-top" style="width: 5%;">@ViewBag.MovFetales</td>

                <td class="border-secondary align-top" style="width: 15%;"><b>Ponderado</b></td>
                <td class="border-secondary align-top" style="width: 5%;">@ViewBag.LPonderado</td>

                <td class="border-secondary align-top" style="width: 15%;"><b>Pelvis Ginecoide</b></td>
                <td class="border-secondary align-top" style="width: 5%;">@ViewBag.LPelvisGinecoide</td>
                
                <td class="border-secondary align-top" style="width: 15%;"><b>Compat.Feto-Pelvica</b></td>
                <td class="border-secondary align-top" style="width: 5%;">@ViewBag.LCompatibilidadF</td>

                <td>@ViewBag.Feto</td>

            </tr>

        </tbody>
    </table>

    <br />

    <table class="table table-bordered border-secondary mb-1">
        <tbody>
            <tr>
                <th class="border-secondary table-active text-center p-0 col-4">TACTO VAGINAL</th>
            </tr>
        </tbody>
    </table>

    <table class="table table-bordered border-secondary mb-1">
        <tbody>
            <tr>
                <th class="border-secondary table-active text-center p-0">Dilatacion</th>
                <th class="border-secondary table-active text-center p-0">Incorporacion</th>
                <th class="border-secondary table-active text-center p-0">Alt. Prsent</th>
                <th class="border-secondary table-active text-center p-0">Varied. Prsent</th>
                <th class="border-secondary table-active text-center p-0">Memb. Rotas</th>
                <th class="border-secondary table-active text-center p-0">Procubito</th>
                <th class="border-secondary table-active text-center p-0">Prolapso</th>
                <th class="border-secondary table-active text-center p-0">Sangrado V.</th>
                <th class="border-secondary table-active text-center p-0">Liquido Amniótico</th>
            </tr>
            <tr style="height: 20px">
                <td class="border-secondary align-top">@ViewBag.lDilatacion  cm</td>
                <td class="border-secondary align-top">@ViewBag.lIncorporacion </td>
                <td class="border-secondary align-top">@ViewBag.lAlPresent</td>
                <td class="border-secondary align-top">@ViewBag.dVarPresent</td>
                <td class="border-secondary align-top">@ViewBag.membranasRotas</td>
                <td class="border-secondary align-top">@ViewBag.lProcubito</td>
                <td class="border-secondary align-top">@ViewBag.lProlapso</td>
                <td class="border-secondary align-top">@ViewBag.dSangradoV</td>
                <td class="border-secondary align-top">@ViewBag.lLiquidoA</td>
            </tr>
        </tbody>
    </table>



    <table class="table table-bordered border-secondary mb-1">
        <tbody>
            <tr>
                <th class="border-secondary table-active text-center p-0 col-4">DIAGNÓSTICO</th>
            </tr>
            <tr style="height: 70px">
                <td class="border-secondary align-top">
                    @{
                        int index = 1;
                    }
                    @foreach (System.Data.DataRow row in ViewBag.DxEvaluacion.Rows)
                    {
                        <span style="font-weight: bold;">DX @index</span>
                        <span>@row["codigoCIE10"] - @row["descripcion"] <b>(@row["tipoDiagnostico"])</b></span>
                        <br />
                        index++;
                    }
                </td>
            </tr>
        </tbody>
    </table>


    <table class="table table-bordered border-secondary mb-1">
        <tbody>
            <tr>
                <th class="border-secondary table-active text-center p-0 col-4">PLAN DE TRABAJO</th>
                <th class="border-secondary table-active text-center p-0 col-4">TRATAMIENTO</th>
            </tr>
            <tr style="height: 20px;">
                <td class="border-secondary align-top" style="width: 50%;">
                    @*@ViewBag.PlandeTrabajo*@
                </td>

                <td class="border-secondary align-top" style="width: 50%;">
                    @ViewBag.Tratamiento
                </td>
            </tr>
        </tbody>
    </table>


    <div class=" ms-auto mt-3 pt-5 mb-2" style="width: 250px;">
        <div class="border-top border-secondary text-center">
            @ViewBag.Medico
        </div>
    </div>


    <table class="table table-bordered border-secondary">
        <tbody>
            <tr>
                <th class="border-secondary table-active text-center p-0">NOMBRES Y APELLIDOS</th>
                <th class="border-secondary table-active text-center p-0" style="background-color: #ebe9e9;">N° HISTORIA</th>
                <th class="border-secondary table-active text-center p-0" style="background-color: #ebe9e9;">N° CUENTA</th>
                <th class="border-secondary table-active text-center p-0" style="background-color: #ebe9e9;">FECHA</th>
                <th class="border-secondary table-active text-center p-0" style="background-color: #ebe9e9;">HORA</th>
            </tr>
            <tr>
                <td class="border-secondary text-center align-top p-1">
                    @ViewBag.Paciente
                </td>
                <td class="border-secondary text-center align-top p-1">
                    @ViewBag.NroHistoriaClinica
                </td>
                <td class="border-secondary text-center align-top p-1">
                    @ViewBag.IdCuentaAtencion
                </td>
                <td class="border-secondary text-center align-top p-1">
                    @ViewBag.fecha
                </td>
                <td class="border-secondary text-center align-top p-1">
                    @ViewBag.HoraInicioAtencion
                </td>
            </tr>
        </tbody>
    </table>





    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-ka7Sk0Gln4gmtz2MlQnikT1wXgYsOg+OMhuP+IlRH9sENBO0LRn5q+8nbTov4+1p" crossorigin="anonymous"></script>
</body>



</html>