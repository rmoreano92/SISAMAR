        .item {
            display: flex;
            margin-bottom: 0.3rem;
        }

        .item-box {
            width: 15px;
            height: 15px;
            border: 1px solid #535353;
            margin-right: 5px;
        }

        .item-cabecera {
            width: 15px;
            height: 15px;
            margin-right: 5px;
            text-align: center;
        }

        .item-label {
            height: 15px;
            vertical-align: middle;
        }

        .item.Si .item-Si {
            text-align: center;
            vertical-align: middle;
            background-color: yellow;
        }

            .item.Si .item-Si::before {
                font-weight: bold;
                content: "X";
            }

        .item.No .item-No {
            text-align: center;
            vertical-align: middle;
            background-color: yellow;
        }

            .item.No .item-No::before {
                font-weight: bold;
                content: "X";
            }

        .Si .item-Si {
            text-align: center;
            vertical-align: middle;
            background-color: yellow;
        }

            .Si .item-Si::before {
                font-weight: bold;
                content: "X";
            }

        .No .item-No {
            text-align: center;
            vertical-align: middle;
            background-color: yellow;
        }

            .No .item-No::before {
                font-weight: bold;
                content: "X";
            }

        #cajaTitulo {
            width: 50%;
            border: 1px solid black;
            text-align: center;
            padding: 10px;
            font-weight: bold;
            margin-left: auto;
            margin-right: auto;
            box-shadow: 10px 10px #8d8d8d;
            margin-bottom: 20px;
        }

        .subtitulo {
            writing-mode: vertical-lr;
            -webkit-writing-mode: vertical-lr;
            -ms-writing-mode: vertical-lr;
            filter: flipH() flipV();
            margin: 0 auto;
            /*transform: rotate(270deg);*/
        }

        body {
            font-size: 10px;
        }
    </style>
</head>


