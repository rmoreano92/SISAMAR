    <table class="table table-bordered border-secondary mb-1 mt-2">
        <tbody>
            <tr>
                <th class="border-secondary text-center p-0" colspan="3"></th>
                <th class="border-secondary text-center bg-success p-0" colspan="6">DATOS DE LA MADRE</th>
                <th class="border-secondary text-center bg-primary p-0" colspan="8">DATOS DEL RN</th>
            </tr>
            <tr>
                <th class="border-secondary table-active text-center" style="font-size: 7px;">#</th>
                <th class="border-secondary table-active text-center" style="font-size: 7px;">N° CUENTA</th>
                <th class="border-secondary table-active text-center" style="font-size: 7px;">DATA</th>
                <th class="border-secondary table-active text-center" style="font-size: 7px;">HISTORIA</th>
                <th class="border-secondary table-active text-center" style="font-size: 7px;">APELLIDOS Y NOMBRES</th>
                <th class="border-secondary table-active text-center" style="font-size: 7px;">EDAD GEST.</th>
                <th class="border-secondary table-active text-center" style="font-size: 7px;">TIPO PARTO</th>
                <th class="border-secondary table-active text-center" style="font-size: 7px;">PARIDAD</th>
                <th class="border-secondary table-active text-center" style="font-size: 7px;">GESTA</th>
                <th class="border-secondary table-active text-center" style="font-size: 7px;">HISTORIA</th>
                <th class="border-secondary table-active text-center" style="font-size: 7px;">CNV</th>
                <th class="border-secondary table-active text-center" style="font-size: 7px;">FEC. NAC.</th>
                <th class="border-secondary table-active text-center" style="font-size: 7px;">HORA. NAC.</th>
                <th class="border-secondary table-active text-center" style="font-size: 7px;">SEXO</th>
                <th class="border-secondary table-active text-center" style="font-size: 7px;">PESO</th>
                <th class="border-secondary table-active text-center" style="font-size: 7px;">APGAR 1</th>
                <th class="border-secondary table-active text-center" style="font-size: 7px;">APGAR 5</th>
                <th class="border-secondary table-active text-center" style="font-size: 7px;">ATENDIDO POR</th>
                <th class="border-secondary table-active text-center" style="font-size: 7px;">RESPONSABLE</th>
                @*<th class="border-secondary table-active text-center p-0 col-4">DIAGNÓSTICO</th>
                    <th class="border-secondary table-active text-center p-0 col-4">DIAGNÓSTICO</th>
                    <th class="border-secondary table-active text-center p-0 col-4">DIAGNÓSTICO</th>*@
            </tr>
            @{
                int index = 1;
            }
            @foreach (System.Data.DataRow row in ViewBag.RegistrosRn.Rows)
            {
                <tr>
                    <td class="border-secondary align-top" style="font-size: 8px;">@index</td>
                    <td class="border-secondary align-top" style="font-size: 8px;">@row["nroCuenta"]</td>
                    <td class="border-secondary align-top" style="font-size: 8px;">@row["origenData"]</td>
                    <td class="border-secondary align-top" style="font-size: 8px;">@row["nroHistoriaMadre"]</td>
                    <td class="border-secondary align-top" style="font-size: 8px;">@row["madre"]</td>
                    <td class="border-secondary align-top" style="font-size: 8px;">@row["edadGestacionalMadre"]</td>
                    <td class="border-secondary align-top" style="font-size: 8px;">@row["tipoPartoMadre"]</td>
                    <td class="border-secondary align-top" style="font-size: 8px;">@row["paridad"]</td>
                    <td class="border-secondary align-top" style="font-size: 8px;">@row["gesta"]</td>
                    <td class="border-secondary align-top" style="font-size: 8px;">@row["nroHistoria"]</td>
                    <td class="border-secondary align-top" style="font-size: 8px;">@row["cnv"]</td>
                    <td class="border-secondary align-top" style="font-size: 8px;">@row["fechaNacimiento"]</td>
                    <td class="border-secondary align-top" style="font-size: 8px;">@row["horaNacimiento"]</td>
                    <td class="border-secondary align-top" style="font-size: 8px;">@row["sexo"]</td>
                    <td class="border-secondary align-top" style="font-size: 8px;">@row["pesoRn"]</td>
                    <td class="border-secondary align-top" style="font-size: 8px;">@row["apgarUno"]</td>
                    <td class="border-secondary align-top" style="font-size: 8px;">@row["apgarCinco"]</td>
                    <td class="border-secondary align-top" style="font-size: 8px;">@row["atendidoPor"]</td>
                    <td class="border-secondary align-top" style="font-size: 8px;">@row["responsable"]</td>

                </tr>

                @*<span style="font-weight: bold;">DX @index</span>*@
                @*<span>@row["codigoCIE10"] - @row["descripcion"] <b>(@row["tipoDiagnostico"])</b></span>
                    <br />*@
                index++;
            }

        </tbody>
    </table>

    @{
        index = index - 1;
    }
    <table class="table table-bordered border-secondary m-0 me-2 mt-3" style="width: 200px;">
        <tbody>
            <tr>
                <th class="border-secondary text-center fw-bold" style="width:100px;">TOTAL REGISTROS</th>
                <td class="border-secondary text-center" style="font-size: 18px;">@index</td>
            </tr>
        </tbody>
    </table>



