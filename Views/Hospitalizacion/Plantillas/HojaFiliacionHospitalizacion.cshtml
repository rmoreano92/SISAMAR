
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Hoja de Evaluación</title>
    @*<link type="text/css" rel="stylesheet" href="~/BootstrapV5.1.3/bootstrap.min.css" integrity="sha384-1BmE4kWBq78iYhFldvKuhfTAU6auU8tT94WrHftjDbrCEXSU1oBoqyl2QvZ6jIW3" crossorigin="anonymous" />*@
    <link type="text/css" rel="stylesheet" href="~/BootstrapV5.1.3/bootstrap.min.css" />
    <link href="~/BootstrapV5.1.3/font.roboto.css" rel="stylesheet">
    <style>
        body {
            font-size: 10px;
            color: black !important;
            font-family: 'Roboto', sans-serif;
            letter-spacing: 0.4px;
        }

        td, th {
           padding: 0 !important;
        }

        .font-sm {
            font-size: 8px;
        }

        .font-md {
            font-size: 11px;
        }

        .font-lg {
            font-size: 12px;
        }

        .table {
            border-color: #607d8b !important;
        }
    </style>
</head>


<body style="background: white;  width: 793px; height: 900px; position: relative;  /*border: 1px solid red;*/">

    <div class="row mt-4" style="width: 95%; margin-left: 15px">
        <div class="col-12 position-relative">
            @*<div class="position-absolute" style="width: 40px; left:0px; top: 0px;">
            <img src="~/images/Logo.png" width="100%" />
            </div>*@

            <div class="row text-center mx-auto" style="width: 95%;">
                <div class="col-12"><span class="fw-bold" style="font-size: 12px;">@ViewBag.NombreInstitucion</span></div>
                <div class="col-12"><span style="font-size: 10px;">@ViewBag.DireccionInstitucion</span></div>
                <div class="col-12"><span style="font-size: 10px;">Telefono: @ViewBag.TelefonoInstitucion</span></div>
            </div>

            <div class="position-absolute text-center" style="width: 100px; right: 0px; top: 0px;">
                <div class="fw-bold w-100" style="font-size: 12px;">@ViewBag.FechaImpresion</div>
            </div>

            @*<div class="position-absolute text-center" style="width: 60px; left: 0px; top: 0px;">
            <div class="fw-bold border border-secondary w-100" style="font-size: 12px;">CUPO: Logo</div>
            </div>*@

            <div class="position-absolute" style="width: 90px; left:0px; top: 0px;">
                <img src="~/images/Logo.png" width="100%" />
            </div>

            <br>
            <br>
            <br>

            <div class="row text-center mx-auto" style="width: 100%;">
                <div class="col-12 my-2"><span class="fw-bold font-md" style="font-size: 25px;">HOJA DE FILIACION DE PACIENTE HOSPITALIZADO</span></div>
            </div>

            <div class="row m-0" style="font-size: 14px">
                <div class="col-12 p-0">
                    <div class="fw-bold" style="padding-left: 5px; ;"> </div>
                </div>
            </div>
            <div class="row m-0" style="height: 30px; line-height: 30px;">
                <div class="col-12 p-0" style="font-size: 14px;"><div class="fw-bold" style="padding-left: 5px; text-align: end;">N° Historia: <span style="font-size: 20px">@ViewBag.NroHistoria</span></div></div>
                <div class="col-12 p-0" style="font-size: 14px;"><div class="fw-bold" style="padding-left: 5px; text-align: end;">N° Cuenta: <span style="font-size: 20px">@ViewBag.NroCuenta</span></div></div>
            </div>

            <br />
            <br />

            <table style="width: 750px; font-size: 18px;">
                <tr>
                    <th width="250px">Apellidos Y Nombres</th>
                    <td width="500px" class="fw-bold">@ViewBag.PacienteNombres</td>
                </tr>
            </table>
            
            <table style="width: 750px; font-size: 15px;">
                <tr>
                    <th width="200px">Edad (@ViewBag.TipoEdad)</th>
                    <td width="250px" class="text-truncate d-block">@ViewBag.Edad @ViewBag.TipoEdad</td>
                    <th width="150px">Sexo</th>
                    <td width="150px" class="text-truncate d-block">@ViewBag.Sexo</td>
                </tr>
            </table>

             <table style="width: 750px; font-size: 15px;">
                <tr>
                    
                    <th width="200px">Fecha Nacimiento</th>
                    <td width="250px" class="text-truncate d-block">@ViewBag.FechaNacimiento</td>
                    <th width="150px">Pais</th>
                    <td width="150px">@ViewBag.NombrePaisNacimiento</td>
                </tr>
            </table>

             <table style="width: 750px; font-size: 15px;">
                <tr>
                    
                    <th width="200px">Estado Civil</th>
                    <td width="250px" class="text-truncate d-block">@ViewBag.EstadoCivilDes</td>
                    <th width="150px">Télefono</th>
                    <td width="150px">@ViewBag.Telefono</td>
                </tr>
            </table>

             <table style="width: 750px; font-size: 15px;">
                <tr>
                    
                    <th width="200px">Direccion</th>
                    <td width="250px" class="">@ViewBag.DireccionDomicilio</td>
                    <th width="150px">N° Documento</th>
                    <td width="150px">@ViewBag.NroDocumento @ViewBag.TipoDocumento</td>
                </tr>
            </table>

            <table style="width: 750px; font-size: 15px;">
                <tr>
                    <th width="200px">Departamento</th>
                    <td width="250px">@ViewBag.NombreDepartamentoDomicilio</td>
                    <th width="150px">Provincia</th>
                    <td width="150px" class="text-truncate d-block">@ViewBag.NombreProvinciaDomicilio</td>
                </tr>
            </table>

            <table style="width: 750px; font-size: 15px;">
                <tr>
                    <th width="200px">Distrito</th>
                    <td width="250px">@ViewBag.NombreDistritoDomicilio</td>
                    <th width="150px">Centro Poblado</th>
                    <td width="150px" class="text-truncate d-block">@ViewBag.NombreCentroPobladoNacimiento</td>
                </tr>
            </table>

            <table style="width: 750px; font-size: 15px;">
                <tr>
                    <th width="200px">Grado Instrucción</th>
                    <td width="250px">@ViewBag.GradoInstruccion</td>
                    <th width="150px">Ocupación</th>
                    <td width="150px" class="text-truncate d-block">@ViewBag.Ocupacion</td>
                </tr>
            </table>

            <table style="width: 750px; font-size: 15px;">
                <tr>
                    <th width="200px">Datos Acompañante</th>
                    <td width="250px">@ViewBag.NombreAcompaniante</td>
                    <th width="150px">Religion</th>
                    <td width="150px" class="text-truncate d-block">@ViewBag.Religion</td>
                </tr>
            </table>

             <table style="width: 750px; font-size: 15px;">
                <tr>
                    <th width="200px">Telefono Acompañante</th>
                    <td width="250px">@ViewBag.TelefonoAcompaniante</td>
                    <th width="150px">N° Cama</th>
                    <td width="150px" class="text-truncate d-block">@ViewBag.Cama</td>
                </tr>
            </table>

            <table style="width: 750px; font-size: 15px;">
                <tr>
                    <th width="200px">Servicio</th>
                    <td width="250px">@ViewBag.ServicioActual</td>
                    <th width="150px">Fecha Alta</th>
                    <td width="150px" class="text-truncate d-block">@ViewBag.FechaEgreso</td>
                </tr>
            </table>

             <table style="width: 750px; font-size: 15px;">
                <tr>
                    <th width="200px">Fecha Ingreso</th>
                    <td width="250px">@ViewBag.FechaCita</td>
                    <th width="150px">Hora Alta</th>
                    <td width="150px" class="text-truncate d-block">@ViewBag.HoraEgreso</td>
                </tr>
            </table>
            
            <table style="width: 750px; font-size: 15px;">
                <tr>
                    <th width="200px">Hora Ingreso</th>
                    <td width="250px">@ViewBag.HoraCita</td>
                    <th width="150px">Plan</th>
                    <td width="150px" class="text-truncate d-block">@ViewBag.FuenteFinanciamiento</td>
                </tr>
            </table>
            
            <table style="width: 750px; font-size: 15px;">
                <tr>
                    <th width="200px">Médico Tratante</th>
                    <td width="550px">@ViewBag.Medico</td>
                </tr>
            </table>
            
            
            <table style="width: 750px; font-size: 15px;">
                <tr>
                    <th width="200px">Origen (Transf)</th>
                    <td width="250px"></td>
                    <th width="150px">Cod. Filiacion</th>
                    <td width="150px" class="text-truncate d-block">@ViewBag.Afiliacion</td>
                </tr>
            </table>

            <hr />
            
            <table style="width: 750px; font-size: 16px;">
                <tr>
                    <th width="750px">DIAGNÓSTICOS</th>
                </tr>
            </table>
            <br />
            <br />
            <br />
            <br />
            <br />
            <br />
            <br />
            <br />
            <br />
            <br />

            <hr />
            <table style="width: 750px; font-size: 16px;">
                <tr>
                    <th width="750px">OPERACIONES</th>
                </tr>
            </table>

            <br />
            <br />
            <br />
            <br />
            <br />
            <br />

            <hr />

            <table style="width: 750px; font-size: 16px;">
                <tr style="height: 120px;">
                    <td width="70px" style="border: 1px solid black;">
                    </td>
                    <td width="115px">

                    </td>
                    <td width="150px" style="border-bottom: 1px solid black; border-style: dashed;">

                    </td>
                    <td width="50px">

                    </td>
                    <td width="150px" style="border-bottom: 1px solid black; border-style: dashed;">

                    </td>
                </tr>
            </table>

            <table style="width: 750px; font-size: 16px;">

                <tr style="text-align: center;">
                    <td width="150px" style="text-align: left;">
                        Huella digital paciente

                    </td>
                    <td width="50px">
                    </td>
                    <td width="150px">
                        Firma admisionista
                    </td>
                    <td width="50px">
                    </td>
                    <td width="150px">
                        Firma del médico tratante
                    </td>
                </tr>
            </table>

            <table style="width: 750px; font-size: 16px;">
                <tr>
                    <td width="750px">
                        Usuario: @ViewBag.Usuario
                    </td>
                </tr>

            </table>
            <hr />

            













            
           



        </div>

    </div>


    <script src="~/BootstrapV5.1.3/bootstrap.bundle.min.js"></script>

</body>



</html>