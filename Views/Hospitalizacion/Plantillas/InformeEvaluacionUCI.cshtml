                                        <span style="font-weight: bold;">Ninguno</span>
                                    }
                                    else
                                    {
                                            @foreach (System.Data.DataRow row in ViewBag.DtCorticoides.Rows)
                                            {
                                                <span style="font-weight: bold;">(@indexCorticoides)</span>
                                                <span>@row["DescripcionIntervencionesItem"] -  <b>Dosis:</b> @row["Dosis"] -  <b>Horario:</b> @row["Horario"] </span>
                                                <br />
                                                indexCorticoides++;
                                            }
                                    }
                                }
                               
                            </div>
                        </div>
                    </div>

                </div>

                <div class="d-flex mt-1 mb-1" style="font-size: 8.5px !important;">
                    <div class="card border-secondary m-0 me-1" style="width: 50%">
                        <div class="card-header border-secondary">
                            Fluidoterapia
                        </div>
                        <div class="card-block">
                            <div style="min-height: 10px;">
                                @{
                                    int indexFluidoterapia = 1;
                                }
                               
                                @{
                                    if (ViewBag.DtFluidoterapia.Rows.Count < 1)
                                    {
                                        <span style="font-weight: bold;">Ninguno</span>
                                    }
                                    else
                                    {
                                            @foreach (System.Data.DataRow row in ViewBag.DtFluidoterapia.Rows)
                                        {
                                            <span style="font-weight: bold;">(@indexFluidoterapia)</span>
                                            <span>@row["DescripcionIntervencionesItem"] - <b>Dosis:</b> @row["Dosis"] - <b>Volumen:</b> @row["Volumen"] </span>
                                            <br />
                                            indexFluidoterapia++;
                                        }
                                    }
                                }
                            </div>
                        </div>
                    </div>

                    <table class="table table-bordered border-secondary m-0 me-1" style="width: 50%;">
                        <tbody>
                            <tr>
                                <th class="border-secondary text-center fw-bold p-0" style="background-color: #ddf5e9; width: 23%;"></th>
                                <th class="border-secondary text-center fw-bold p-0" style="background-color: #ddf5e9; width: 9%;">6h</th>
                                <th class="border-secondary text-center fw-bold p-0" style="background-color: #ddf5e9; width: 9%;">12h</th>
                                <th class="border-secondary text-center fw-bold p-0" style="background-color: #ddf5e9; width: 9%;">24h</th>
                            </tr>
                            <tr>
                                <th class="border-secondary text-center fw-bold p-0" style="background-color: #ddf5e9; width: 23%;">Ingresos fluidos s/vo</th>
                                <td class="border-secondary text-center p-0" style="width: 9%;">@ViewBag.IngresosFluidossvo6h</td>
                                <td class="border-secondary text-center p-0" style="width: 9%;">@ViewBag.IngresosFluidossvo12h</td>
                                <td class="border-secondary text-center p-0" style="width: 9%;">@ViewBag.IngresosFluidossvo24h</td>
                            </tr>
                            <tr>
                                <th class="border-secondary text-center fw-bold p-0" style="background-color: #ddf5e9; width: 23%;">Balance hídrico </th>
                                <td class="border-secondary text-center p-0" style="width: 9%;">@ViewBag.Bh6h </td>
                                <td class="border-secondary text-center p-0" style="width: 9%;">@ViewBag.Bh12h </td>
                                <td class="border-secondary text-center p-0" style="width: 9%;">@ViewBag.Bh24h </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

            </div>
        </div>

        <div class="card mb-2 mt-1 border-secondary">
            <div class="card-header border-secondary">
                EXAMENES AUXILIARES
            </div>
            <div class="card-block">
                <div style="min-height: 30px;">
                    @Html.Raw(ViewBag.ExamenesAuxiliaresUCI)
                </div>
            </div>
        </div>

        <div class="d-flex mb-1">
            <div class="w-50">
                <div class="card border-secondary">

                    <div class="card-header border-secondary">
                        DIAGNÓSTICO
                    </div>
                    <div class="card-block">
                        <div style="min-height: 55px;">
                            @{
                                int indexDx = 1;
                            }
                            @foreach (System.Data.DataRow row in ViewBag.DxEvaluacion.Rows)
                            {
                                <span style="font-weight: bold;">DX @indexDx</span>
                                <span>@row["codigoCIE10"] - @row["descripcion"] <b>(@row["tipoDiagnostico"])</b></span>
                                <br />
                                indexDx++;
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="w-50">
                <div class="card mb-1 border-secondary">

                    <div class="card-header border-secondary">
                        IMPRESIÓN DIAGNÓSTICA
                    </div>
                    <div class="card-block">
                        <div style="min-height: 55px;">
                            @ViewBag.ImpresionDiagnostica
                        </div>
                    </div>
                </div>
            </div>
        </div>



        <div class="d-flex mb-2 ">
            <div class="w-100 border border-secondary">
                <div class="card  border-0">
                    <div class="card-header border-secondary">
                        APRECIACION
                    </div>
                    <div class="card-block  border-0">
                        <div class="white-space  border-0" style="min-height:25px;">@ViewBag.ComentarioApreciacionEvaluacion</div>
                    </div>
                </div>
            </div>
        </div>


        <div class="d-flex mb-2 ">
            <div class="w-100 border border-secondary">
                <div class="card  border-0">
                    <div class="card-header border-secondary">
                        PLAN DE TRABAJO
                    </div>
                    <div class="card-block  border-0">
                        <div class="white-space border-0" style="min-height:25px;">@ViewBag.PlanEvaluacion</div>
                    </div>
                </div>
            </div>
        </div>

        

        <div class=" ms-auto mt-2 pt-4 mb-2" style="width: 250px;">
            <div class="border-top border-secondary text-center p-1">
                SELLO Y FIRMA DEL RESPONSABLE<br />
                <b>@ViewBag.Medico</b>
            </div>
        </div>

        @*<table class="table table-bordered border-secondary m-0">
        <tbody>
        <tr>
        <th class="border-secondary table-active text-center p-0" style="background-color: #ebe9e9;">APELLIDOS Y NOMBRES</th>
        <th class="border-secondary table-active text-center p-0" style="background-color: #ebe9e9;">HISTORIA</th>
        <th class="border-secondary table-active text-center p-0" style="background-color: #ebe9e9;">CUENTA</th>
        <th class="border-secondary table-active text-center p-0" style="background-color: #ebe9e9;">SERVICIO</th>

        </tr>
        <tr>
        <td class="border-secondary text-center align-top p-1">
        @ViewBag.Paciente
        </td>
        <td class="border-secondary text-center align-top p-1">
        @ViewBag.NroHistoriaClinica
        </td>
        <td class="border-secondary text-center align-top p-1">
        @ViewBag.NroCuenta
        </td>
        <td class="border-secondary text-center align-top p-1">
        @ViewBag.Servicio
        </td>
        </tr>
        </tbody>
        </table>*@

        @*<div style="line-height: 10px;font-size: 9px;text-align: justify;" class="mt-2">
        Esta es una copia auténtica imprimible de un documento electrónico almacenado en <b class="">INSTITUTO NACIONAL MATERNO PERINATAL</b>,
        aplicando lo dispuesto por el <b class="">Art. 25 de D.S. 070-2013-PCM</b> y la Tercera Disposición Complementaria Final del <b class="">D.S. 026-2016-PCM</b>.
        Su autenticidad e integridad pueden ser contrastadas a través de la siguiente dirección web: <b class="">https://mgp.gob.pe/verifica</b>
        </div>*@
    </div>


    <div class="w-100 pb-3" style="page-break-before: always; position:relative;">

        <div class="d-flex mb-1" style="font-size: 8.5px !important;">
            <table class="table table-bordered border-secondary m-0 me-2" style="width: 190px;">
                <tbody>
                    <tr>
                        <th class="border-secondary text-center fw-bold p-0" style="width:110px;">FECHA</th>
                        <td class="border-secondary text-center p-0">@ViewBag.FechaEvaluacion</td>
                    </tr>
                </tbody>
            </table>

            <table class="table table-bordered border-secondary m-0" style="width: 190px;">
                <tbody>
                    <tr>
                        <th class="border-secondary text-center fw-bold p-0" style="width:110px;">HORA</th>
                        <td class="border-secondary text-center p-0">@ViewBag.HoraEvaluacion</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="mt-3">
            <div class="card  border-0">
                <div class="card-header text-center">
                    TRATAMIENTO
                </div>

                <div class="d-flex mb-2 ">
                    <div class="w-100 border border-secondary">
                        <div class="card  border-0">
                            <div class="card-block  border-0">
                                <div class="white-space  border-0" style="min-height:25px;">@ViewBag.Tratamiento</div>
                            </div>
                        </div>
                    </div>
                </div>


                <table class="table table-bordered mt-1 w-100">
                    <thead>
                        <tr>
                            <th scope="col">Concepto</th>
                            <th scope="col" style="width: 50px;">Dosis</th>
                            <th scope="col" style="width: 200px;">Frecuencia</th>
                            <th scope="col" style="width: 50px;">Vias</th>
                            @*<th scope="col" style="width: 70px;">Frecuencia</th>*@
                        </tr>
                    </thead>
                    <tbody>
                        @if (ViewBag.DetalleReceta != null)
                        {
                            @foreach (System.Data.DataRow row in ViewBag.DetalleReceta.Rows)
                            {
                                @if (@row["TipoProducto"].ToString() == "0")
                                {
                                    <tr>
                                        <td>@row["Producto"]<br /><span class="fw-bold">Indicaciones: </span></td>
                                        <td>@row["dosis"]</td>
                                        <td>@row["observaciones"]</td>
                                        <td>@row["vias"]</td>
                                    </tr>
                                }
                                
                            }
                        }
                    </tbody>
                </table>
            </div>
            
        </div>
    </div>
</body>



</html>