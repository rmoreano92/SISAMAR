@*<body style="background: white; width:793px; height:1145px; position:relative; /*border: 1px solid red;*/" class="pt-2 m-0">*@
<body style="background: transparent; width:698px; height:1015px; position:relative;">

    @if (ViewBag.CodigoQR != null)
    {
        <img class="qr-code" src="@String.Format("data:image/png;base64,{0}", Convert.ToBase64String(ViewBag.CodigoQR))" />
    }

    <div class="position-absolute text-right" style="right:75px; top:10px; font-size: 7px;">
        <span>@ViewBag.FechaImpresion</span><br />
        <span>@ViewBag.Usuario</span>
    </div>

    <div class="w-100  pb-5">
        <div id="cajaTitulo">
            <p style="" class="fw-bold m-0">ATENCIÓN GINECO-OBSTETRICA EN HOSPITALIZACIÓN</p>
            <small></small>
            @* <small class="fw-bold" style="color:lightgray">FN-000</small> *@
        </div>

        <div class="d-flex mb-2" style="font-size: 10px !important;">
            <table class="table table-bordered border-secondary m-0 me-1" style="width: 180px;">
                <tbody>
                    <tr>
                        <th class="border-secondary text-center fw-bold p-0" style="width:110px;">FECHA ATENCIÓN</th>
                        <td class="border-secondary text-center p-0">@ViewBag.FechaEvaluacion</td>
                    </tr>
                </tbody>
            </table>

            <table class="table table-bordered border-secondary m-0 me-1" style="width: 180px;">
                <tbody>
                    <tr>
                        <th class="border-secondary text-center fw-bold p-0" style="width:110px;">HORA ATENCIÓN</th>
                        <td class="border-secondary text-center p-0">@ViewBag.HoraEvaluacion</td>
                    </tr>
                </tbody>
            </table>

            <table class="table table-bordered border-secondary m-0 me-1" style="width: 120px;">
                <tbody>
                    <tr>
                        <th class="border-secondary text-center fw-bold p-0" style="width:80px;">GLASGOW</th>
                        <td class="border-secondary text-center p-0">@ViewBag.Glasgow</td>
                    </tr>
                </tbody>
            </table>

            <table class="table table-bordered border-secondary m-0 me-1" style="width: 70px;">
                <tbody>
                    <tr>
                        <th class="border-secondary text-center fw-bold p-0" style="width:50px;">SIS</th>
                        <td class="border-secondary text-center p-0">@ViewBag.TieneSis</td>
                    </tr>
                </tbody>
            </table>


            @*<div class="ms-auto" style="font-size: 9px;">
            Impreso por: @ViewBag.Usuario - @ViewBag.FechaImpresion
            </div>*@
        </div>

        <div class="d-flex mb-2" style="font-size: 10px !important;">
            <table class="table table-bordered border-secondary m-0 me-1" style="width: 130px;">
                <tbody>
                    <tr>
                        <th class="border-secondary text-center fw-bold p-0" style="width:60px;">EDAD</th>
                        <td class="border-secondary text-center p-0">@ViewBag.Edad</td>
                    </tr>
                </tbody>
            </table>
            <table class="table table-bordered border-secondary m-0 me-1" style="width: 90px;">
                <tbody>
                    <tr>
                        <th class="border-secondary text-center fw-bold p-0" style="width:30px;">G</th>
                        <td class="border-secondary text-center p-0">@ViewBag.G</td>
                    </tr>
                </tbody>
            </table>

            <table class="table table-bordered border-secondary m-0 me-1" style="width: 90px;">
