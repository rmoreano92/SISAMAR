@using Microsoft.Extensions.Configuration;
@{
    var version = new ConfigurationBuilder().AddJsonFile("appsettings.json").Build().GetValue<string>("Version");
    // var usaLabs = new ConfigurationBuilder().AddJsonFile("appsettings.json").Build().GetValue<string>("Configuraciones:UsaLabs");
}

@section Css
{
    <!-- plugin css -->
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/chosen/css/chosen.css" />
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/bootstrap-datetimepicker/css/bootstrap-datetimepicker.min.css" />
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/radio_css/css/radiobox.min.css" />
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/css/pages/radio_checkbox.css" />
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/jquery-tagsinput/css/jquery.tagsinput.css" />

}

<header class="head">
    <div class="main-bar row">
        <div class="col-lg-6 col-md-4 col-sm-4">
            <h4 class="nav_top_align">
                <i class="fa fa-baby"></i>
                Signos Vitales Recién Nacido
            </h4>
        </div>
        <div class="col-lg-6 col-md-8 col-sm-8">
            <ol class="breadcrumb float-xs-right nav_breadcrumb_top_align">
                <li class="breadcrumb-item">
                    <a href="index1.html">
                        <i class="fa fa-home" data-pack="default" data-tags=""></i> Home
                    </a>
                </li>
                <li class="breadcrumb-item">
                    <a href="#">@ViewBag.Area</a>
                </li>
                <li class="breadcrumb-item active">Triaje</li>
            </ol>
        </div>
    </div>
</header>

<div class="row m-0">
    <div class="col-md-12">
        <ul class="nav nav-tabs" id="myTab" role="tablist">
            <li class="nav-item" role="presentation">
                <a href="#" class="nav-link nav-link-custom active" id="TabBusqueda" data-toggle="tab" data-target="#TabPanelBusqueda" role="tab" aria-controls="TabPanelBusqueda" aria-selected="true">Busqueda</a>
            </li>
            <li class="nav-item m-0" role="presentation">
                <a href="#" class="nav-link nav-link-custom" id="TabRegistro" data-toggle="tab" data-target="#TabPanelRegistro" role="tab" aria-controls="TabPanelRegistro" aria-selected="false" style="display:none;">Registro Triaje Recién Nacido</a>
            </li>
        </ul>
        <div class="tab-content border pt-1 pl-1 pr-1" id="myTabContent">
            <!--=============================================Panel Busqueda==================================================================-->
            <div class="tab-pane fade active in" id="TabPanelBusqueda" role="tabpanel" aria-labelledby="TabBusqueda">
                <div class="row">
                    <div class="col-md-12 mb-2">
                        <div class="card">
                            <div class="card-block pb-1">
                                <div class="row">
                                    <div class="col-md-8">
                                        <div class="row">
                                            <div class="col-lg-2">
                                                <div class="form-group m-0">
                                                    <label for="txtNroTriajeBusq">N° Triaje</label>
                                                    <input id="txtNroTriajeBusq" autocomplete="off" placeholder="" class=" solo-numero form-control form-control-sm search">
                                                </div>
                                            </div>
                                            <div class="col-lg-2">
                                                <div class="form-group m-0">
                                                    <label for="txtNroCuentaBusq">N° Cuenta</label>
                                                    <input id="txtNroCuentaBusq" autocomplete="off" placeholder="" class=" solo-numero form-control form-control-sm search">
                                                </div>
                                            </div>
                                            <div class="col-lg-2">
                                                <div class="form-group m-0">
                                                    <label for="txtNroDniBusq">N° Doc. Madre</label>
                                                    <input id="txtNroDniBusq" autocomplete="off" placeholder="" class=" solo-numero form-control form-control-sm search">
                                                </div>
                                            </div>
                                            <div class="col-lg-2">
                                                <div class="form-group m-0">
                                                    <label for="txtApPaternoBusq">Ap. Paterno Madre</label>
                                                    <input id="txtApPaternoBusq" autocomplete="off" placeholder="" class=" form-control form-control-sm search">
                                                </div>
                                            </div>
                                            <div class="col-lg-2">

                                                <div class="form-group m-0">
                                                    <label for="txtApMaternoBusq">Ap. Materno Madre</label>
                                                    <input id="txtApMaternoBusq" autocomplete="off" placeholder="" class=" form-control form-control-sm search">
                                                </div>
                                            </div>
                                            <div class="col-lg-2">
                                                <div class="form-group m-0">
                                                    <label for="txtFechaTriajeBusq">Fecha Triaje</label>
                                                    <div class="input-group input-group-sm">
                                                        <input type="text" autocomplete="off" class="form-control form_val_popup_dp3 search" placeholder="dd/mm/yyyy" data-date-format="dd/mm/yyyy" id="txtFechaTriajeBusq">
                                                        <span class="input-group-addon">
                                                            <i class="fa fa-calendar "></i>
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>

                                        </div>
                                    </div>
                                    <div class="col-md-4 d-flex align-items-end" style="height: 55px;">
                                        <button class="btn btn-sm btn-primary layout_btn_prevent mr-1" style="padding-left: 2rem !important; padding-right: 2rem !important;" id="btnBuscar">Buscar</button>
                                        <button class="btn btn-sm btn-secondary layout_btn_prevent    " style="padding-left: 2rem !important; padding-right: 2rem !important;" id="btnLimpiar">Limpiar</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-12">
                        @{
                            if (@ViewBag.Agregar)
                            {
                                <button class="btn btn-success layout_btn_prevent" id="btnAgregar">Agregar</button>
                            }
                            if (@ViewBag.Modificar)
                            {
                                <button class="btn btn-info layout_btn_prevent" id="btnModificar">Modificar</button>
                            }
                            if (@ViewBag.Eliminar)
                            {
                                <button class="btn btn-danger layout_btn_prevent" id="btnEliminar">Eliminar</button>
                            }
                            if (@ViewBag.Consultar)
                            {
                                <button class="btn btn-warning layout_btn_prevent" id="btnConsultar">Consultar</button>
                            }
                        }

                        <table id="tblTriajeRn" class="table table-sm table-content-sm table-bordered w-100" style="cursor: default;">
                            <thead style="color: white; background: #434343;">
                                <tr>
                                    <th style="width:7%">N° Triaje</th>
                                    <th style="width:7%">N° Cuenta</th>
                                    <th style="width:7%">N° Historia</th>
                                    <th style="width:18%">Madre</th>
                                    <th style="width:9%">Fec. Nac. Rn</th>
                                    <th style="width:8%">Sexo Rn</th>
                                    <th style="width:8%">Tipo Gest.</th>
                                    <th style="width:6%">Fetos</th>
                                    <th style="width:7%">Gemelar</th>
                                    <th style="width:8%">Condición</th>
                                    <th style="width:8%">Fecha Triaje</th>
                                    <th style="width:7%">Brazalete</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!--=============================================Panel Busqueda==================================================================-->
            <div class="tab-pane fade" id="TabPanelRegistro" role="tabpanel" aria-labelledby="TabRegistro">
                <div id="modulo">
                    <partial name="~/Views/Shared/Components/VistasParciales/Hospitalizacion/TriajeNeonatal/RegistroTriajeRn.cshtml" />
                </div>
            </div>
        </div>

    </div>

</div>
