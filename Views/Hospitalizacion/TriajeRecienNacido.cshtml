@if (ViewBag.PermisoRegistroFiliacionPorRegistroNacimiento > 0)
{
    @*=======================================================MODAL FILIACION RN=========================================================================================== *@
    <div class="modal fade" id="modalRegistroNacimiento" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true" data-backdrop="static">

        <div class="modal-dialog modal-xl">

            <div class="modal-content">
                <div class="modal-header modal-header bg-deep-teal">
                    <h5 class="modal-title text-white" id="tituloRpt">Registro de Nacimiento</h5>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-12">
                            <table id="tblRegistroNacimientos" class="table table-sm table-content-sm table-bordered w-100" style="cursor: default;">
                                <thead style="color: white; background: #434343;">
                                    <tr>
                                        <th style="width:7%">N° Nacimiento</th>
                                        <th style="width:7%">N° Cuenta Madre</th>
                                        <th style="width:7%">N° Historia Madre</th>
                                        <th style="width:20%">Madre</th>
                                        <th style="width:9%">Fec. Nac. Rn</th>
                                        <th style="width:8%">Sexo Rn</th>
                                        <th style="width:9%">Tipo Gest.</th>
                                        <th style="width:7%">Fetos</th>
                                        <th style="width:8%">Gemelar</th>
                                        <th style="width:8%">Opciones</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-teal" id="btnCargarRegistroNacimiento" style="width: 80px;">Cargar</button>
                    <button type="button" class="btn btn-secondary" id="btnCerrarModalRegistroNacimiento" style="width: 80px;">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
    @* ============================================================================================================================================================= *@

}

<iframe id="ifrmReporte"
        title="Inline Frame Example"
        width="100"
        height="600" hidden="hidden"
