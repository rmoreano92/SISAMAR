            color: #e91e63;
            border-color: #E91E63;
            background-color: #E91E631a;
            outline: none;
        }

        .paridad2:focus {
            box-shadow: 1px 1px 5px #E91E63;
            outline: none;
        }

    /*----------------------Paridad 3------------------------------*/
