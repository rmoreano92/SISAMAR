        font-weight: bold;
    }

        .paridad3:hover, .paridad3:focus {
            color: #2196f3;
            border-color: #2196F3;
            background-color: #2196F31a;
            outline: none;
        }

        .paridad3:focus {
            box-shadow: 1px 1px 5px #2196F3;
            outline: none;
        }

    /*-------------------Paridad 4---------------------------------*/
