    <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/bootstrapvalidator/css/bootstrapValidator.min.css" />
    <!--Page level styles-->

    <style>
        /*-------------------Paridad 1---------------------------------*/
        .paridad1 {
        border-width: medium;
        border-color: #009688;
        color: #009688;
        font-weight: bold;
        }

        .paridad1:hover, .paridad1:focus {           
        color: #009688;
        border-color: #009688;
        background-color: #0096881a;
        outline: none;
        }

        .paridad1:focus {           
        box-shadow: 1px 1px 5px #009688;
        outline: none;
        }


        /*--------------------Paridad 2--------------------------------*/
        .paridad2 {
        border-width: medium;
        border-color: #E91E63;
        color: #e91e63;
        font-weight: bold;
        }

        .paridad2:hover, .paridad2:focus {
        color: #e91e63;
        border-color: #E91E63;
        background-color: #E91E631a;
        outline: none;
        }

        .paridad2:focus {
        box-shadow: 1px 1px 5px #E91E63;
        outline: none;
        }

        /*----------------------Paridad 3------------------------------*/
        .paridad3 {
        border-width: medium;
        border-color: #2196F3;
        color: #2196f3;
        font-weight: bold;
        }

        .paridad3:hover, .paridad3:focus {
        color: #2196f3;
        border-color: #2196F3;
        background-color: #2196F31a;
        outline: none;
        }

        .paridad3:focus {
        box-shadow: 1px 1px 5px #2196F3;
        outline: none;
        }

        /*-------------------Paridad 4---------------------------------*/
        .paridad4 {
        border-width: medium;
        border-color: #795548;
        color: #795548;
        font-weight: bold;
        }

        .paridad4:hover, .paridad4:focus {
        color: #795548;
        border-color: #795548;
        background-color: #7955481a;
        outline: none;
        }

        .paridad4:focus {
        box-shadow: 1px 1px 5px #795548;
        outline: none;
        }

        /*-----------------------------------------------------------------------*/
        .align-items-center {
        -webkit-box-align: center !important;
        -ms-flex-align: center !important;
        align-items: center !important;
        }

        .justify-content-between {
        -webkit-box-pack: justify !important;
        -ms-flex-pack: justify !important;
        justify-content: space-between !important;
        }
    </style>
}
