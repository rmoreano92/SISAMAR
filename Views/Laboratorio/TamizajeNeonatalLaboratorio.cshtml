<div data-backdrop="static" data-keyboard="false" class="modal fade" id="modalReporteTamizaje" role="dialog" aria-hidden="false" style="background-color: #00000075;">
    <div class="modal-dialog" style="box-shadow: 0 20px 13px 0 rgb(0, 0, 0);">
        <div class="modal-content">
            <div class="modal-header bg-primary">
                <h4 class="modal-title text-white">Reporte Tamizaje</h4>
            </div>
            <div class="modal-body">

                <div class="row mb-1">

                    <div class="col-lg-4" ">
                        <div class="form-group m-0">
                            <label for="txtFechaInicio" class="form-control-label">Fecha Inicio</label>
                            <div class="input-group input-group-sm m-0">
                                <input type="text" autocomplete="off" class="form-control form_val_popup_dp3" placeholder="dd/mm/yyyy" data-date-format="dd/mm/yyyy" id="txtFechaInicio">
                                <span class="input-group-addon">
                                    <i class="fa fa-calendar "></i>
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <div class="form-group m-0">
                            <label for="txtFechaFin" class="form-control-label">Fecha Fin</label>
                            <div class="input-group input-group-sm m-0">
                                <input type="text" autocomplete="off" class="form-control form_val_popup_dp3" placeholder="dd/mm/yyyy" data-date-format="dd/mm/yyyy" id="txtFechaFin">
                                <span class="input-group-addon">
                                    <i class="fa fa-calendar "></i>
                                </span>
                            </div>
                        </div>
                    </div>


                    <div class="col-lg-2 d-flex align-items-end" style="height: 55px;">
                        <div>
                            <button class="btn btn-success btn-sm layout_btn_prevent" style="padding-left: 2rem !important; padding-right: 2rem !important;" id="btnGenerarRptTamizaje"><i class="fas fa-file-excel mr-1"></i> Descargar</button>
                        </div>
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button" data-dismiss="modal" class="btn btn-secondary">Close</button>
                </div>
            </div>
        </div>
    </div>
</div>

