                                        <div class="col-lg-2" style="max-width: 180px;">
                                            <div class="form-group input-group input-group-sm">
                                                <label for="txtFechaRegistroBusqueda" class="form-label">Fecha Recepción</label>
                                                <input type="text" class="form-control search" id="txtFechaRegistroBusqueda" placeholder="dd/mm/yyyy" data-date-format="dd/mm/yyyy">
                                            </div>
                                        </div>

                                        <div class="col-lg-2" style="max-width: 180px;">
                                            <div class="form-group">
                                                <label for="cboAnioCierreBusqueda" class="">Año Cierre</label>
                                                <select class="chzn-select" id="cboAnioCierreBusqueda" data-placeholder="Seleccione una opción"></select>
                                            </div>
                                        </div>

                                        <div class="col-lg-3">
                                            <div class="form-group">
                                                <label for="cboEstablecimientoBusqueda" class="">Establecimiento Piloto</label>
                                                <select class="chzn-select" id="cboEstablecimientoBusqueda" data-placeholder="Seleccione una opción"></select>
                                            </div>
                                        </div>

                                        <div class="col-lg-2">
                                            <div class="form-group">
                                                <label for="cboNroCierreBusqueda" class="">N° Cierre</label>
                                                <select class="chzn-select" id="cboNroCierreBusqueda" data-placeholder="Seleccione una opción"></select>
                                            </div>
                                        </div>

                                        <div class="col-lg-2" style="max-width: 180px;">
                                            <div class="form-group m-0">
                                                <label for="txtNroEnvioBusqueda" class="form-control-label">N° Envio</label>
                                                <div class="input-group input-group-sm">
                                                    <input type="text" class="form-control bloquear-campos search" id="txtNroEnvioBusqueda">
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-lg-3" style="max-width: 360px;">
                                            <div class="form-group">
                                                <label for="cboEstablecimientoOrigenBusqueda" class="">Establecimiento Origen</label>
                                                <select class="chzn-select" id="cboEstablecimientoOrigenBusqueda" data-placeholder="Seleccione una opción">
                                                    <option value="0">Seleccionar una opción</option>
                                                </select>
                                            </div>
                                        </div>

                                        <div class="col-lg-2" style="max-width: 180px;">
                                            <div class="form-group m-0">
                                                <label for="txtNroDocumentoBusqueda" class="form-control-label">N° Documento RN</label>
                                                <div class="input-group input-group-sm">
                                                    <input type="text" class="form-control bloquear-campos search" id="txtNroDocumentoBusqueda">
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-lg-2" style="max-width: 180px;">
                                            <div class="form-group m-0">
                                                <label for="txtApellidoPaternoBusqueda" class="form-control-label">Apellido Paterno RN</label>
                                                <div class="input-group input-group-sm">
                                                    <input type="text" class="form-control bloquear-campos search" id="txtApellidoPaternoBusqueda">
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-lg-2" style="max-width: 180px;">
                                            <div class="form-group m-0">
                                                <label for="txtApellidoMaternoBusqueda" class="form-control-label">Apellido Materno RN</label>
                                                <div class="input-group input-group-sm">
                                                    <input type="text" class="form-control bloquear-campos search" id="txtApellidoMaternoBusqueda">
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-lg-2" style="max-width: 180px;">
                                            <div class="form-group m-0">
                                                <label for="txtNombresBusqueda" class="form-control-label">Nombres RN</label>
                                                <div class="input-group input-group-sm">
                                                    <input type="text" class="form-control bloquear-campos search" id="txtNombresBusqueda">
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-lg-2" style="max-width: 180px;">
                                            <div class="form-group m-0">
                                                <label for="txtCodigoBarrasBusqueda" class="form-control-label">Codigo de Barras</label>
                                                <div class="input-group input-group-sm">
                                                    <input type="text" class="form-control bloquear-campos search" id="txtCodigoBarrasBusqueda">
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-lg-2" style="max-width: 180px;">
                                            <div class="form-group m-0">
                                                <label for="txtNroCorrelativoBusqueda" class="form-control-label">N° Correlativo</label>
                                                <div class="input-group input-group-sm">
                                                    <input type="text" class="form-control bloquear-campos search" id="txtNroCorrelativoBusqueda">
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-lg-2" style="max-width: 180px;">
                                            <div class="form-group m-0">
                                                <label for="txtApellidoPaternoMadreBusqueda" class="form-control-label">Apellido Paterno Madre</label>
                                                <div class="input-group input-group-sm">
                                                    <input type="text" class="form-control bloquear-campos search" id="txtApellidoPaternoMadreBusqueda">
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-lg-2" style="max-width: 180px;">
                                            <div class="form-group m-0">
                                                <label for="txtApellidoMaternoMadreBusqueda" class="form-control-label">Apellido Materno Madre</label>
                                                <div class="input-group input-group-sm">
                                                    <input type="text" class="form-control bloquear-campos search" id="txtApellidoMaternoMadreBusqueda">
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-lg-2" style="max-width: 180px;">
                                            <div class="form-group m-0">
                                                <label for="txtNombresMadreBusqueda" class="form-control-label">Nombres Madre</label>
                                                <div class="input-group input-group-sm">
                                                    <input type="text" class="form-control bloquear-campos search" id="txtNombresMadreBusqueda">
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-lg-2" style="max-width: 180px;">
                                            <div class="form-group m-0">
                                                <label for="txtNroDocumentoMadreBusquedaPrinc" class="form-control-label">N° Documento MADRE</label>
                                                <div class="input-group input-group-sm">
                                                    <input type="text" class="form-control bloquear-campos solo-numero search" id="txtNroDocumentoMadreBusquedaPrinc">
                                                </div>
                                            </div>
                                        </div>

                                    </div>

                                    <div class="row mt-1">
                                        <div class="col-lg-2" style="max-width: 180px;">
                                            <div class="form-group">
                                                <label for="cboFiltrosEstadosSIS" class="">Estado SIS</label>
                                                <select class="chzn-select" id="cboFiltrosEstadosSIS" data-placeholder="Seleccione una opción">
                                                    <option value="0">Seleccione una opción</option>
                                                    <option value="5">Acreditado</option>
                                                    <option value="6">Migrado</option>
                                                    <option value="7">No Acreditado</option>
                                                    <option value="12">Pendiente</option>
                                                    <option value="14">FUA Físico</option>
                                                </select>
                                            </div>
                                        </div>

                                        <div class="col-lg-2" style="max-width: 180px;">
                                            <div class="form-group">
                                                <label for="cboFiltrosEstadoLaboratorio" class="">Estado Laboratorio</label>
                                                <select class="chzn-select" id="cboFiltrosEstadoLaboratorio" data-placeholder="Seleccione una opción">
                                                    <option value="0">Seleccione una opción</option>
                                                    <option value="8">Aceptado</option>
                                                    <option value="9">Procesado</option>
                                                    <option value="10">Rechazado</option>
                                                    <option value="11">No enviado</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row mt-1">
                                        <div class="col-lg-4 d-flex align-items-end">
                                            <div>
                                                <input type="hidden" id="tipoBusqueda" value="1" />
                                                <button class="btn btn-primary btn-sm layout_btn_prevent" style="padding-left: 2rem !important; padding-right: 2rem !important;" id="btnBuscarAtenciones">Buscar</button>
                                                <button class="btn btn-secondary btn-sm layout_btn_prevent" style="padding-left: 2rem !important; padding-right: 2rem !important;" id="btnLimpiarFiltroAtenciones">Limpiar</button>
                                            </div>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6 pt-2 pb-0">
                        @{
                            if (@ViewBag.Agregar)
                            {
                                <button class="btn btn-primary layout_btn_prevent" id="btnAgregar">Agregar</button>
                            }
                            if (@ViewBag.Modificar)
                            {
                                <button class="btn btn-info layout_btn_prevent" id="btnModificarAtenciones">Modificar</button>
                            }
                            if (@ViewBag.Eliminar)
                            {
                                <button class="btn btn-danger layout_btn_prevent" id="btnEliminarAtenciones">Eliminar</button>
                            }
                            if (@ViewBag.Consultar)
                            {
                                <button class="btn btn-warning layout_btn_prevent" id="btnConsultarAtenciones">Consultar</button>
                            }
                        }
                    </div>

                    @if (@ViewBag.IdUsuario == 22913 || @ViewBag.IdUsuario == 23186 || @ViewBag.IdUsuario == 22371)
                    {

                        <div class="col-md-6 d-flex align-items-end justify-content-end" style="height: 50px;">
                            <div>
                                <button class="btn btn-info layout_btn_prevent" id="btnAbrirModalReporteTamizaje" title="Genera Parte" data-toggle="tooltip" style="margin: 2px;"><i class="fas fa-file-alt"></i> Reporte Tamizaje Neonatal</button>
                            </div>
                        </div>
                    }

                    <div class="col-lg-12 pb-2">

                        <table id="tblAtencion" width="100%" class="table table-sm table-bordered table-content-sm">
                            <thead style="color: white;background: #434343;">
                                <tr>
                                    <th>N° Cuenta</th>
                                    <th>N° H.C.</th>
                                    <th>F. Nacimiento</th>
                                    @*<th style="width:5%">Hora</th>*@
                                    <th>Peso</th>
                                    <th>Talla</th>
                                    <th>Sexo RN</th>
                                    @*<th style="width:5%">Apellido Paterno</th>
                                    <th style="width:5%">Apellido Materno</th>*@
                                    <th>Apellidos y Nombres RN</th>
                                    <th>DNI RN</th>
                                    <th>F.T (Mx)</th>
                                    <th>H.T (Mx)</th>
                                    <th>Codigo SIS</th>
                                    <th>F.Registro</th>
                                    @* <th>Estado</th> *@
                                    <th>U. S.</th>
                                    <th>Laboratorio</th>
                                    <th>Tipo Registro</th>
                                    <th style="width:5%">FUA</th>
                                    <th style="width:5%">Result</th>

                                    @*<th style="width:5%">Telefono</th>*@
                                    @*<th style="width:5%">Fuente</th>
                                    <th style="width:8%; text-align:center">INFORME</th>
                                    <th style="width:8%; text-align:center">RECETAS</th>
                                    <th style="width:8%; text-align:center">PROC</th>
                                    <th style="width:8%; text-align:center">REFCON</th>
                                    <th style="width:8%; text-align:center">FUA</th>*@
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>

                    @*
                    <div class="col-md-12 d-flex align-items-end justify-content-end" style="height: 50px;">
                    <div>
                    <button class="btn btn-info layout_btn_prevent m-1" id="btnFirmaAtencion"><i class="fa-light fa-signature mr-1"></i>Firmar Atencion</button>
                    <button class="btn btn-info layout_btn_prevent m-1" id="btnFirmaLote"><i class="fa-light fa-signature mr-1"></i>Firmar Lote</button>
                    </div>
                    </div>*@

                </div>
            </div>


        </div>
    </div>
</div>



