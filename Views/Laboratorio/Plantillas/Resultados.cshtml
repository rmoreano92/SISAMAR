            padding-right: 3px;
        }

        .card {
            border-color: black !important;
            border-width: 2px;
        }

        .card-header {
            border-bottom: 1px solid black;
        }

        .font-cabecera {
            font-size: 10px !important;
            font-weight: bold !important;
            background-color: lightgrey;
        }

        .font-titulo {
            font-weight: bold !important;
            font-size: 7px !important;
        }

        .font-input {
