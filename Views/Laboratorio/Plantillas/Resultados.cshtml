    <link type="text/css" rel="stylesheet" href="~/AdmiRE/css/custom.css" />
    <link type="text/css" rel="stylesheet" href="~/css/util.css" />
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/select2/css/select2.min.css" />
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/datatables/css/scroller.bootstrap.min.css" />
