<body style="background: white; width: 793px; height: 1122px; position: relative;" class="">
    @*<img src="~/images/LogoSeguroIntegralSalud.png" style="width: 250px; position:absolute; top:0; left: 1rem;" />*@
    <div class="position-absolute text-left" style="right: 0.1rem;">
        <span style="font-size: 10px;"><b>Fecha de Impresión: </b> @ViewBag.FechaImpresion</span> <br />
        <span style="font-size: 10px;"><b> Hora de Impresion: </b> @ViewBag.HoraImpresion</span>
    </div>


    <div class="text-center" style="right:1rem; top: 0.4rem;">
        <span>INSTITUTO NACIONAL MATERNO PERINTAL</span> <br />
        <span style="font-size: 10px;"><b>Jr. Santa Rosa Nro 941 - Cercado de Lima</b></span> <br />
        <span><b>TELEFONO: 013281380</b></span>
    </div>

    <table class="mt-3" style="width: 100%">
        <tr>
            <th style="border: solid #a9a9a9 1px; width: 20%"><b>MEDICO SOLICITANTE: </b></th>
            <td style="border: solid #a9a9a9 1px; width: 80%">@ViewBag.OrdenaPrueba</td>
        </tr>
    </table>


    @*aqui va el foreach*@
    @{
        int index = 0;
    }

    @foreach (System.Data.DataTable rowResultados in ViewBag.Resultados)
    {
        List<string> grupos = new List<string>();

        @foreach (System.Data.DataRow rowResultado in rowResultados.Rows)
        {
            if (!grupos.Contains(rowResultado["Grupo"].ToString()))
            {
                grupos.Add(rowResultado["Grupo"].ToString());
            }
        }

        <div class="mt-3" style="width: 100%; border: solid #565656 1px; padding: 5px">

            <table style="width: 100%; border-bottom: solid #565656 1px">
                <tr>
                    <td style="width: 80%;"><b>Examen:</b> @rowResultados.Rows[0]["NombreCorto"]</td>
                    <td style="width: 20%;"><b>Codigo Ingreso:</b> @rowResultados.Rows[0]["CodigoAP"]</td>
                </tr>
                
                <tr>
                    <td style="width: 80%;"><b>Realiza la Prueba:</b> @rowResultados.Rows[0]["TipoEmpleado"]: @rowResultados.Rows[0]["realiza_prueba"]</td>
                    <td style="width: 20%;"><b>Fecha:</b> @rowResultados.Rows[0]["Fecha"]</td>
                </tr>
            </table>

            @foreach (string rowGrupo in grupos)
            {
                <div class="mt-2" style="width: 100%;">

                    <table class="mb-1" style="width: 100%">
                        <thead style="border: solid #a9a9a9 1px">
                            <tr>
                                <th style="width: 40%;"><b>@rowGrupo</b></th>
                                <th style="width: 30%;"></th>
                                <th style="width: 30%;"><b>Referencias</b></th>
                            </tr>
                        </thead>

                        <tbody style="border: solid #a9a9a9 1px">
                            @foreach (System.Data.DataRow rowResultado in rowResultados.Rows)
                            {
                                if (rowResultado["Grupo"].ToString() == rowGrupo)
                                {
                                    <tr>
                                        <td style="width: 40%;">@rowResultado["Item"]</td>
                                        <td style="width: 30%;">: @rowResultado["valor"]</td>
                                        <td style="width: 30%;">@rowResultado["ValorReferencial"]</td>
                                    </tr>
                                }

                            }
                        </tbody>
                    </table>

                </div>
            }
        
        </div>

        
        index++;
    }

    @*aqui va el foreach*@



</body>
</html>




