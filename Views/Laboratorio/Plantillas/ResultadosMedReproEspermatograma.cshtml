<body style="background: transparent; width:698px; height:1015px; position:relative;/* padding-bottom:200px; */" class="">
    
    <img src="@(ViewBag.IpArchivos)/resources/images/Logo.png" style="width: 90px; position:absolute; top:10px; right: 0px;" />

    @if (ViewBag.CodigoQR != null)
    {
        <img class="qr-code" src="@String.Format("data:image/png;base64,{0}", Convert.ToBase64String(ViewBag.CodigoQR))" />
    }
    
    <div class="text-center" style="margin-top: -10px;">
        <p class="fw-bold m-0" style="font-size: 14px;padding-bottom: 5px;">@ViewBag.NombreInstitucion</p>
        @* <p class="fw-bold m-0" style="font-size: 11px; margin-bottom: 5px;">@ViewBag.DireccionInstitucion</p>
        <p class="fw-bold m-0" style="font-size: 11px;">TELEFONO: @ViewBag.TelefonoInstitucion</p> *@
        <p class="fw-bold m-0" style="font-size: 12px; padding-bottom: 5px;">SERVICIO DE MEDICINA REPRODUCTIVA</p>
        <p class="fw-bold m-0" style="font-size: 16px;">Laboratorio de Andrología</p>
    </div>
    
    @* <div class="position-absolute text-end" style="right:75px; top:25px; font-size: 9px;">
        <div><b>Fecha de Creación:</b></div>
        <span style="margin: 0;">@ViewBag.ResultadoMedRepro["FechaRegistroResultado"]</span>
    </div> *@

    <div class="text-center mb-2">
        <h5 class="fw-bold m-0">ESPERMATOGRAMA</h5>
    </div>

    <div class="position-absolute text-end fw-bold" style="right:10px; top:-15px; font-size: 19px;">
        <span style="margin: 0;">@ViewBag.ResultadoMedRepro["Codigo"]</span>
    </div>
   
    <table class="table-striped" style="width: 100%">
        <thead style="border: solid #a9a9a9 1px">
            <tr>
                <th style="background-color:#c6d7ff;" colspan="4"><b>DATOS PERSONALES</b></th>
            </tr>            
        </thead>

        <tbody style="border: solid #a9a9a9 1px">
            <tr>
                <th style="width: 140px;text-align:left;"><b>Paciente</b></th>
                <td style="width: 350px;text-align:left;">@ViewBag.ResultadoMedRepro["DNombrePaciente"]</td>
                <th style="width: 140px;text-align:left;"><b>Edad</b></th>
                <td style="width: 350px;text-align:left;">@ViewBag.ResultadoMedRepro["DEdadPaciente"] años</td>
            </tr>
            <tr>
                <th style="width: 140px;text-align:left;"><b>Pareja</b></th>
                <td style="width: 350px;text-align:left;">@ViewBag.ResultadoMedRepro["DNombrePareja"]</td>
                <th style="width: 140px;text-align:left;"><b>Edad</b></th>
                <td style="width: 350px;text-align:left;">@ViewBag.ResultadoMedRepro["DEdadPareja"] años</td>
            </tr>
            <tr>
                <th style="width: 140px;text-align:left;"><b>Procedencia</b></th>
                <td style="width: 350px;text-align:left;">@ViewBag.ResultadoMedRepro["Procedencia"]</td>
                <th style="width: 140px;text-align:left;"><b>Médico</b></th>
                <td style="width: 350px;text-align:left;">@ViewBag.ResultadoMedRepro["ProfesionalMedico"]</td>
            </tr>
            
        </tbody>
    </table>

    <table class="table-striped" style="width: 100%">
        <thead style="border: solid #a9a9a9 1px">
            <tr>
                <th style="background-color:#c6d7ff;" colspan="4"><b>DATOS RECOLECCIÓN DE MUESTRA</b></th>
            </tr>            
        </thead>

        <tbody style="border: solid #a9a9a9 1px">
