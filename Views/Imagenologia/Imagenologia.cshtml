<div data-backdrop="static" style="overflow-y: scroll; background-color: rgba(0, 0, 0, 0.46);" data-keyboard="false" class="modal fade" id="modalCodigosApDisponibles" role="dialog" aria-labelledby="modalLabelsuccess">
    <div class="modal-dialog modal-sm" role="document">
        <div class="modal-content">

            <div class="modal-header bg-deep-pink">
                <span class="text-white" style="font-size: 1.28rem;font-weight: 500;letter-spacing: 0.5px;">Códigos AP Disponibles</span>
            </div>

            <div class="modal-body">
                <table id="tblLabCodigosApDisponibles" width="100%" class="table table-sm table-bordered table-content-sm">
                    <thead style="color: white; background: #434343;">
                        <tr>
                            <th valign="middle">Movimiento</th>
                            <th valign="middle">Año</th>
                            <th valign="middle">Tipo</th>
                            <th valign="middle">Numeración</th>
                        </tr>
                    </thead>
                    <tbody style="cursor: pointer;"></tbody>
                </table>
            </div>

            <div class="modal-footer">
                <button id="btnCargarCodigoAp" type="button" class="btn btn-pink" style="width: 100px;"><i class="fa-solid fa-check-double"></i> Cargar</button>
                <button id="btnCancelarCodigoAp" type="button" class="btn btn-secondary" style="width: 100px;">Cerrar</button>
            </div>

        </div>
    </div>

</div>

