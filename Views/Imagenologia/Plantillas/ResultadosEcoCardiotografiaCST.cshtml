<body style="background: transparent; width:698px; height:1015px; position:relative;padding-bottom:130px;" class="">

    <img src="@(ViewBag.ServerArchivosIp)/resources/images/Logo.png" style="width: 90px; position:absolute; top:5px; left: 0px;" />

    @if (ViewBag.CodigoQR != null)
    {
        <img class="qr-code" src="@String.Format("data:image/png;base64,{0}", Convert.ToBase64String(ViewBag.CodigoQR))" />
    }

    <div class="text-center">
        <p class="fw-bold m-0 mb-2" style="font-size: 13px;">@ViewBag.NombreInstitucion</p>
        <p class="fw-bold m-0" style="font-size: 14px; padding-bottom: 6px;">@ViewBag.ServicioRealiza</p>
        <p class="m-0 mb-1" style="font-size: 11px;">@ViewBag.DireccionInstitucion</p>
        <p class="m-0" style="font-size: 11px;">TELEFONO: @ViewBag.TelefonoInstitucion</p>
    </div>

    <div class="position-absolute text-end" style="right:75px; top:50px; font-size: 9px;">
