<body style="background: transparent; width:698px; height:1015px; position:relative;padding-bottom:200px;" class="">

    <img src="@(ViewBag.ServerArchivosIp)/resources/images/Logo.png" style="width: 90px; position:absolute; top:5px; left: 0px;" />

    @if (ViewBag.CodigoQR != null)
    {
        <img class="qr-code" src="@String.Format("data:image/png;base64,{0}", Convert.ToBase64String(ViewBag.CodigoQR))" />
    }

    <div class="text-center">
        <p class="fw-bold m-0 mb-2" style="font-size: 13px;">@ViewBag.NombreInstitucion</p>
        <p class="fw-bold m-0" style="font-size: 14px; padding-bottom: 6px;">@ViewBag.ServicioRealiza</p>
        <p class="m-0 mb-1" style="font-size: 11px;">@ViewBag.DireccionInstitucion</p>
        <p class="m-0" style="font-size: 11px;">TELEFONO: @ViewBag.TelefonoInstitucion</p>
    </div>

    <div class="position-absolute text-end" style="right:75px; top:50px; font-size: 9px;">
        <div><b>Fecha de Creación:</b></div>
        <span style="margin: 0;">@ViewBag.FechaImpresion @ViewBag.HoraImpresion</span>
    </div>

    <table class="mt-3 mb-1" style="width: 100%; padding-top: 10px;">
        <tr>
            <th style="border: solid #a9a9a9 1px; width:90px; text-align: left;"><b>INFORME</b></th>
            <td style="border: solid #a9a9a9 1px;" colspan="6">INFORME ECOGRÁFICO OBSTÉTRICO: ECOCARDIOGRAFÍA</td>
        </tr>
        <tr>
            <th style="border: solid #a9a9a9 1px; width:90px; text-align: left;"><b>MÉDICO</b></th>
            <td style="border: solid #a9a9a9 1px;">@ViewBag.RealizaExamen</td>
            <th style="border: solid #a9a9a9 1px; width:140px; text-align: left;" colspan="2"><b>FECHA EXAMEN</b></th>
            <td style="border: solid #a9a9a9 1px; width:100px;" colspan="2">@ViewBag.FechaResultado</td>
        </tr>
        <tr>
            <th style="border: solid #a9a9a9 1px; width:90px; text-align: left;"><b>PACIENTE</b></th>
            <td style="border: solid #a9a9a9 1px;">@ViewBag.Paciente</td>
            <th style="border: solid #a9a9a9 1px; width:50px; text-align: left;"><b>SEXO</b></th>
            <td style="border: solid #a9a9a9 1px; width:90px;">@ViewBag.Sexo</td>
            <th style="border: solid #a9a9a9 1px; width:130px; text-align: left;"><b>FEC. NACIMIENTO</b></th>
