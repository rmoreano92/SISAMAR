@section Css {
    <!-- plugin css -->
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/chosen/css/chosen.css" />
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/bootstrap-datetimepicker/css/bootstrap-datetimepicker.min.css" />
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/radio_css/css/radiobox.min.css" />
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/css/pages/radio_checkbox.css" />
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/jquery-tagsinput/css/jquery.tagsinput.css" />
}

<header class="head">
    <div class="main-bar row">
        <div class="col-lg-6 col-md-4 col-sm-4">
            <h4 class="nav_top_align">
                <i class="fa fa-hand-holding-medical"></i>
                Registro de Atenciones
            </h4>
        </div>
        <div class="col-lg-6 col-md-8 col-sm-8">
            <ol class="breadcrumb float-xs-right nav_breadcrumb_top_align">
                <li class="breadcrumb-item">
                    <a href="index1.html">
                        <i class="fa fa-home" data-pack="default" data-tags=""></i> Home
                    </a>
                </li>
                <li class="breadcrumb-item">
                    <a href="#">@ViewBag.Area</a>
                </li>
                <li class="breadcrumb-item active">Registro de Atenciones</li>
            </ol>
        </div>
    </div>
</header>

<div class="outer p-t-5">
    <div class="inner bg-light lter bg-container">
        <div class="card">
            <ul id="idlsListAtencion" class="nav nav-tabs" role="tablist">
                <li class="nav-item">
                    <a class="nav-link active" href="#lsAtenciones" role="tab" id="lsAtenciones-tab" data-toggle="tab" aria-controls="lsAtenciones" aria-expanded="true">Lista Atenciones</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link " href="#ceAtencion" role="tab" id="ceAtencion-tab" data-toggle="tab" aria-controls="ceAtencion">Registro de Atencion</a>
                </li>
            </ul>

            <div class="card-block">
                <div id="clothing-nav-content4" class="tab-content pt-1">

                    <div role="tabpanel" class="tab-pane fade in active" id="lsAtenciones" aria-labelledby="lsAtenciones-tab">

                        <div class="card m-t-5">
                            <div class="card-block pb-0">
                                <div class="row mt-1 mb-1">
                                    <div class="col-lg-2" style="max-width: 180px;">
                                        <label for="txtFechaAtencion" class="form-control-label">Fecha de Atención</label>
                                        <div class="input-group input-group-sm">
                                            <input type="text" autocomplete="off" class="form-control form_val_popup_dp3" placeholder="dd/mm/yyyy" data-date-format="dd/mm/yyyy" id="txtFechaAtencion">
                                            <span class="input-group-addon">
                                                <i class="fa fa-calendar "></i>
                                            </span>
                                        </div>
                                    </div>

                                    <div class="col-lg-3">
                                        <label for="cboConsultorio" class="form-control-label">Consultorio</label>
                                        <div class="input-group">
                                            <select class="chzn-select" id="cboConsultorio"></select>
                                        </div>
                                    </div>

                                    <div class="col-lg-2 d-flex align-items-end" style="height: 50px;">
                                        <div>
                                            <button class="btn btn-primary btn-sm layout_btn_prevent" style="padding-left: 2rem !important; padding-right: 2rem !important;" id="btnBuscarAtenciones">Buscar</button>
                                        </div>
                                    </div>

                                    <div class="offset-lg-1 col-lg-4">
                                        <div class="d-flex align-items-end justify-content-end">
                                            <div class="msc-hotline">
                                                <div class="msc-hotline-icon" style="">
                                                    <i class="fa-solid fa-user-doctor"></i>
                                                </div>
                                                <div class="msc-hotline-content m-auto">
                                                    <div class="msc-hotline-title">
                                                        <span id="lblMedicoProgramado"></span>
                                                    </div>
                                                    <div class="msc-hotline-text">Médico Atiende</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-lg-6 pt-2 pb-1">
                                @{
                                    if (@ViewBag.Agregar)
                                    {
                                        @*<button class="btn btn-primary layout_btn_prevent" id="btnAgregar">Agregar</button>*@
                                    }
                                    if (@ViewBag.Modificar)
                                    {
                                        <button class="btn btn-info layout_btn_prevent" id="btnModificarAtenciones">Modificar</button>
                                    }
                                    if (@ViewBag.Eliminar)
                                    {
                                        <button class="btn btn-danger layout_btn_prevent" id="btnEliminarAtenciones">Eliminar</button>
                                    }
                                    if (@ViewBag.Consultar)
                                    {
                                        <button class="btn btn-warning layout_btn_prevent" id="btnConsultarAtenciones">Consultar</button>
                                    }
                                }
                            </div>

                            <div class="col-md-6 d-flex align-items-end justify-content-end" style="height: 50px;">
                                <label for="" class="titulo mr-1" style=" font-size: medium; color: #0095ff !important;">Parte Diario: </label>
                                <div>
                                    <button class="btn btn-danger layout_btn_prevent" id="btnGeneraParte" title="Genera Parte" data-toggle="tooltip" style="margin: 2px;"><i class="fa fa-pencil"></i></button>
                                    <button class="btn btn-success layout_btn_prevent" id="btnDescargaParte" title="Imprime Parte Firmado" data-toggle="tooltip" style="margin: 2px;"><i class="fa fa-print"></i></button>
                                    <button class="btn btn-warning layout_btn_prevent" id="btnDescargaParteSF" title="Visualiza Parte" data-toggle="tooltip" style="margin: 2px;"><i class="fa fa-eye"></i></button>
                                </div>
                            </div>

                            <div class="col-lg-12">
                                <table id="tblAtencion" width="100%" class="table table-sm table-bordered">
                                    <thead style="color: white;background: #434343;">
                                        <tr>
                                            <th style="width:5%;">Cuenta</th>
                                            <th style="width:5%">H. I.</th>
                                            <th style="width:10%">Ap. Paterno</th>
                                            <th style="width:10%">Ap. Materno</th>
                                            <th style="width:10%">Nombres</th>
                                            <th style="width:5%">Historia</th>
                                            <th style="width:5%">Telefono</th>
                                            <th style="width:8%">Plan</th>
                                            <th style="width:7%">Est. Cita</th>
                                            <th style="width:5%">Carnet</th>
                                            <th style="width:10%; text-align:center">Informe</th>
                                            <th style="width:10%; text-align:center">REFCON</th>
                                            <th style="width:10%; text-align:center">FUA</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>

                    </div>

                    <div role="tabpanel" class="tab-pane fade" id="ceAtencion" aria-labelledby="ceAtencion-tab">

                        <div class="row">
                            <div class="col-md-12 mb-1">
                                <partial name="~/Views/Shared/Components/VistasParciales/Paciente/DatosPaciente.cshtml" />
                            </div>

                            <div class="col-md-12 mb-1">
                                <partial id="reconocera" name="~/Views/Shared/Components/VistasParciales/Triaje.cshtml" />
                            </div>
                        </div>

                        <div class="row" id="contenedorChkEsAdolecencia">
                            <div class="col-lg-2">
                                <div class="form-group campo">
                                    <label for="cboClasisifcacion" class="form-control-label">Tipo Atencion</label>
                                    <div class="input-group">
                                        <select class="chzn-select" id="cboTipoAtencionAdolecencia">
                                            <option value="0">Seleccionar Opcion</option>
                                            <option value="1">Prenatal</option>
                                            <option value="2">Ginecología</option>
                                            @*<option value="3">Planificación Familiar</option>*@
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-12 mb-1">

                                <div id="modulo">

                                </div>
                                @*<partial name="~/Views/Shared/Components/VistasParciales/ConsultaExterna/Prenatal/Prenatal.cshtml" />*@
                                @*<partial name="~/Views/Shared/Components/VistasParciales/ConsultaExterna/NinoAltoRiesgo/NinoAltoRiesgo.cshtml" />*@
                            </div>
                        </div>

                        <div class="row mt-2">
                            <div class="col-lg-8">
                                <button id="btnImprimeRecetas" target="_blank" class="btn btn-lg  btn-cyan float-lg-left mr-1 mb-1"><i class="fa fa-note-medical mr-1"></i>Rec. Médicas</button>
                                <button id="btnImprimeSeguimiento" target="_blank" class="btn btn-lg  btn-light-blue  float-lg-left mr-1 mb-1"><i class="fa fa-wheelchair-move mr-1"></i>Seguimiento</button>
                                <button id="btnImprimeSeguimientoCPN" target="_blank" style="display:none" class="btn btn-lg  btn-yellow  float-lg-left mr-1 mb-1"><i class="fa fa-baby mr-1"></i>Seguimiento CPN</button>
                                <button id="btnCboRefresca" data-toggle="tooltip" data-placement="top" title="Actializa cbox" class="btn btn-lg  btn-success  float-lg-left mb-1"><i class="fa fa-refresh"></i></button>

                            </div>
                            <div class="col-lg-4">
                                @*<button id="btnImprimeAtencion" target="_blank" class="btn  btn-success float-lg-left"><i class="fa fa-print"></i>&nbsp; Imp. Atencion</button>*@
                                <button id="btnCerrarAtencion" type="button" data-dismiss="modal" class="btn btn-lg btn-secondary float-lg-right mr-1 mb-1">Cerrar</button>
                                <button id="btnguardar" class="btn btn-lg  btn-info float-lg-right mr-1 mb-1">Guardar</button>
                            </div>
                        </div>

                    </div>

                </div>
            </div>

            @{ if (@ViewBag.Medico)
                {
                    <label for="" class="form-control-label mt-1 text-danger"><b>EL USUARIO ES UN PROFESIONAL DE LA SALUD POR LO TANTO SOLO SE MOSTRARA SUS PACIENTES </b></label>
                }
            }

            <input type="hidden" value="@ViewBag.idEmpleado" id="idEmpleadotxt" /> @*JDELGADO001*@
            

        </div>
    </div>
</div>


<input hidden="hidden" id="codeParte" name="rutaParte" type="text">
<input hidden="hidden" id="statusParte" name="rutaParte" type="text">
<input hidden="hidden" id="hdIdCuentaAtencion" name="idCuentaAtencion" type="text" class="form-control">
<input hidden="hidden" id="idPaciente" name="idPaciente" type="text" class="form-control">
<input hidden="hidden" id="idAtencion" name="idAtencion" type="text" class="form-control">
<input hidden="hidden" id="idDestinoAtencion" name="idAtencion" type="text" class="form-control">
<input hidden="hidden" id="idEnEstablecimiento" name="idEnEstablecimiento" type="text" class="form-control">
<input hidden="hidden" id="idEnServicio" name="idEnServicio" type="text" class="form-control">

<input hidden="hidden" id="hdIdTipoServicio" name="hdIdTipoServicio" type="text" class="form-control">

<div data-backdrop="static" style="background-color: rgba(0, 0, 0, 0.46); overflow-y: scroll;" data-keyboard="false" class="modal fade" id="modalSeguimiento" role="dialog" aria-labelledby="modalLabelsuccess">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header bg-light-blue">
                <h4 class="modal-title text-white" id="modalLabelsuccess">Seguimiento de Paciente</h4>
            </div>
            <div class="modal-body">

                <div class="row">
                    <div class="col-md-12">
                        <partial name="~/Views/Shared/Components/VistasParciales/SeguimientoPaciente.cshtml" />
                        @*@Html.Partial("~/Views/Shared/Components/VistasParciales/SeguimientoPaciente.cshtml");*@
                    </div>
                </div>
            </div>
            <div class="modal-footer">

                <button id="btnCerrarSeguimiento" target="_blank" class="btn btn-lg btn-secondary "> Cerrar</button>

            </div>
        </div>
    </div>
</div>

<partial name="~/Views/Shared/Components/VistasParciales/Recetas/VisorRecetas.cshtml" />

<partial name="~/Views/Shared/Components/VistasParciales/Seguimiento/SeguimientoPacienteCPN.cshtml" />

<partial name="~/Views/Shared/Components/VistasParciales/ConsumoServicioRegistro.cshtml" />
<partial name="~/Views/Shared/Components/VistasParciales/InterconsultaRegistro.cshtml" />

<partial name="~/Views/Shared/Components/VistasParciales/ContraReferenciaRegistro.cshtml" />
<partial name="~/Views/Shared/Components/VistasParciales/ReferenciaRegistro.cshtml" />
<partial name="~/Views/Shared/Components/VistasParciales/EstablecimientoSalud.cshtml" />



@section Scripts
                {
    <script type="text/javascript" src="~/AdmiRE/vendors/chosen/js/chosen.jquery.js"></script>
    <script type="text/javascript" src="~/AdmiRE/vendors/raphael/js/raphael-min.js"></script>
    <script type="text/javascript" src="~/AdmiRE/vendors/justgage/js/justgage.js"></script>
    <script type="text/javascript" src="~/AdmiRE/vendors/d3/js/d3.min.js"></script>
    <script type="text/javascript" src="~/AdmiRE/vendors/c3/js/c3.min.js"></script>
    <script type="text/javascript" src="~/AdmiRE/vendors/jquery-tagsinput/js/jquery.tagsinput.js"></script>
    <script type="text/javascript" src="~/AdmiRE/vendors/bootstrap-datetimepicker/js/bootstrap-datetimepicker.min.js"></script>
    <script type="text/javascript" src="~/AdmiRE/vendors/masked/masked.js"></script>
    <script src="https://momentjs.com/downloads/moment-with-locales.js"></script>
    <script src="~/AdmiRE/js/date.format.js"></script>

    <script type="text/javascript" src=@Href("~/js/ConsultaExterna/AtencionMedicaV2.js")></script>
    <script type="text/javascript" src=@Href("~/js/VistasParciales/Anestesiologia.js")></script>
    <script type="text/javascript" src=@Href("~/js/Comun/Referencia.js")></script>

    <script type="text/javascript" src=@Href("~/js/VistasParciales/SeguimientoPaciente.js")></script>
    <script type="text/javascript" src=@Href("~/js/VistasParciales/Seguimiento/SeguimientoPacienteCPN.js")></script>

    <script type="text/javascript" src=@Href("~/js/VistasParciales/Triaje.js")></script>
    <script type="text/javascript" src=@Href("~/js/VistasParciales/Diagnosticos.js")></script>
    <script type="text/javascript" src=@Href("~/js/Facturacion/ConsumoServicio.js")></script>
    @*<script type="text/javascript" src=@Href("~/js/VistasParciales/Recetas/OrdenesV2.js")></script>*@
    <script type="text/javascript" src=@Href("~/js/VistasParciales/OrdenesYResultados.js")></script>

    <script type="text/javascript" src=@Href("~/js/Comun/CarnetPrenatal.js")></script>

    <script type="text/javascript" src=@Href("~/js/Comun/PermisosGenerales.js")></script>
    <script type="text/javascript" src=@Href("~/js/Comun/Utilitarios.js")></script>
    <script type="text/javascript" src=@Href("~/js/VistasParciales/Recetas/VisorRecetas.js")></script>

    <script type="text/javascript" src=@Href("~/js/Comun/EstablecimientosSalud.js")></script>
    @*<script type="text/javascript" src=@Href("~/js/VistasParciales/Perinatal.js")></script>*@

    <script>
        $(document).ready(() => {
            AtencionMedica.Iniciar()

            ESTABLECIMIENTOSSALUD.init()
        })
    </script>



}

