@*<body style="background: white; width:793px; height:1145px; position:relative; padding-top: 30px; /*border: 1px solid red;*/">*@
<body style="background: transparent; width:698px; height:1015px; padding-bottom:180px; position:relative;">

    @if (ViewBag.CodigoQR != null)
    {
        <img class="qr-code" src="@String.Format("data:image/png;base64,{0}", Convert.ToBase64String(ViewBag.CodigoQR))" />
    }

    <div class="text-center mb-3">
        <p class="fw-bold m-0" style="font-size: 12px;">@ViewBag.nombre</p>
        <p class="fw-bold" style="font-size: 8px; margin-bottom: 5px;">@ViewBag.direccion</p>
        <p class="fw-bold m-0" style="font-size: 8px;">TELEFONO: @ViewBag.telefono</p>
    </div>

    <div class="position-absolute text-end " style="right:75px; top:35px; font-size: 7px;">
        <span>@ViewBag.FechaImpresion</span><br />
        <span>@ViewBag.Usuario</span>
    </div>

    
    @if(@ViewBag.IdEspecialidad == "33")
    {
       <div class="w-100 border border-secondary bg-gray text-center p-2 mb-2"><b>ATENCIÓN PSICOLÓGICA</b> - ­<span>FO­-052</span></div>
    } else
    {
        <div class="w-100 border border-secondary bg-gray text-center p-2 mb-2"><b>CONSULTA EXTERNA ESPECIALIDADES</b> - ­<span>FO­-013</span></div>
    }

    <div class="mb-2">
        <div class="d-flex">
            <div class="w-25 cabecera fw-bold border border-secondary bg-gray p-1">FECHA Y HORA DE CITA</div>
            <div class="w-50 cabecera fw-bold border border-secondary bg-gray p-1">FECHA Y HORA DE ATENCIÓN</div>
            <div class="w-25 cabecera fw-bold border border-secondary bg-gray p-1">EDAD</div>
        </div>
        <div class="d-flex">
            <div class="w-25 cabecera border border-secondary p-1">@ViewBag.FechaIngreso</div>
            <div class="w-50 cabecera border border-secondary p-1">@ViewBag.FechaEgreso</div>
            <div class="w-25 cabecera border border-secondary p-1">@ViewBag.Edad</div>
        </div>
    </div>

    @if(@ViewBag.IdEspecialidad == "33")
    {
        <div class="mb-2">
            <div class="d-flex">
                <div class="w-25 cabecera fw-bold border border-secondary bg-gray p-1">TIPO ATENCIÓN</div>
            </div>
            <div class="d-flex">
                <div class="w-25 cabecera border border-secondary p-1">@ViewBag.ClasificacionTipoAtencion</div>
            </div>
        </div>
    }

    

    <div class="mb-2">
        <div class="w-100 cabecera border border-secondary bg-gray p-1"><b>MOTIVO DE LA CONSULTA</b></div>
        <div class="w-100 cabecera border border-secondary p-1" style="min-height: 30px;">
            <div class="white-space">@ViewBag.CitaMotivo</div>
            @*<textarea class="w-100" id="CitaMotivo">@ViewBag.CitaMotivo</textarea>*@
        </div>
