<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Hoja de Evaluación</title>
    @*<link type="text/css" rel="stylesheet" href="~/BootstrapV5.1.3/bootstrap.min.css" integrity="sha384-1BmE4kWBq78iYhFldvKuhfTAU6auU8tT94WrHftjDbrCEXSU1oBoqyl2QvZ6jIW3" crossorigin="anonymous" />*@
    <link type="text/css" rel="stylesheet" href="~/BootstrapV5.1.3/bootstrap.min.css" />
    <link href="~/BootstrapV5.1.3/font.roboto.css" rel="stylesheet">
    <style>
        body {
            font-size: 10px;
            color: black !important;
            font-family: 'Roboto', sans-serif;
            letter-spacing: 0.4px;
        }

        td, th {
            padding: 0.25rem !important;
        }

        .font-sm {
            font-size: 8px;
        }

        .font-md {
            font-size: 11px;
        }

        .font-lg {
            font-size: 12px;
        }

        .table {
            border-color: #607d8b !important;
        }

        textarea {
            resize: none;
            border: none;
            padding: 0 10px;
            margin: 0;
        }

        .text-center {
            text-align: center;
        }


        .mt-0 {
            margin-top: 0 !important
        }

        .mt-1 {
            margin-top: .25rem !important
        }

        .mt-2 {
            margin-top: .5rem !important
        }

        .mt-3 {
            margin-top: 1rem !important
        }

        .mt-4 {
            margin-top: 1.5rem !important
        }

        .mt-5 {
            margin-top: 3rem !important
        }

        .mt-auto {
            margin-top: auto !important
        }

        .border-bottom {
            border-bottom: 1px solid #000 !important;
        }

        .table {
            width: 100%;
            margin-bottom: 1rem;
            color: #212529;
            vertical-align: top;
            border-color: #dee2e6;
            caption-side: bottom;
            border-collapse: collapse;
        }

            .table th {
                font-weight: bold;
            }

        .table-bordered {
            border: solid 1px #4c4c4c;
        }

            .table-bordered td, .table-bordered th {
                border: solid 1px #4c4c4c;
                padding: 3px 5px;
            }
    </style>
</head>

<body style="background: white;  width: 793px; height: 1100px; position: relative;  border: 1px solid black;">

    <div class="position-absolute" style="width: 90px; left:0px; top: 0px;">
        <img src="~/images/Logo.png" width="100%" />
    </div>

    <div class="position-absolute" style="width: 110px; right:0px; top: 0px;">
        <div class="text-center" style="border: 1px solid black; padding: 5px; margin-top: 10px; margin-right: 10px; font-size: 14px;">
            FO-030
        </div>
    </div>

    <div class="text-center border-bottom" style="padding-bottom: 5px;">
        <h6 class="mt-4 border-bottom" style="display: inline-block;width: 600px;align-items: center; font-size: 19px;">COMPILACIÓN RESULTADOS DE EXÁMENES AUXILIARES</h6>

        <p class="mt-4" style="font-size: 14px;">PEGAR ORDENADAMENTE LOS INFORMES ORIGINALES DE LABORATORIO, PATOLOGIA Y DIAGNÓSTICO POR IMAGENES, DESDE ABAJO HACIA ARRIBA COMENZANDO POR EL ESPACIO N° 1</p>
    </div>

    <div class="border-bottom" style="height: 90px;">
        <p class="" style="font-weight: bold; padding-left: 10px; line-height: 90px; font-size: 14px;">08</p>
    </div>
    <div class="border-bottom" style="height: 90px;">
        <p class="" style="font-weight: bold; padding-left: 10px; line-height: 90px; font-size: 14px;">07</p>
    </div>
    <div class="border-bottom" style="height: 90px;">
        <p class="" style="font-weight: bold; padding-left: 10px; line-height: 90px; font-size: 14px;">06</p>
    </div>
    <div class="border-bottom" style="height: 90px;">
        <p class="" style="font-weight: bold; padding-left: 10px; line-height: 90px; font-size: 14px;">05</p>
    </div>
    <div class="border-bottom" style="height: 90px;">
        <p class="" style="font-weight: bold; padding-left: 10px; line-height: 90px; font-size: 14px;">04</p>
    </div>
    <div class="border-bottom" style="height: 90px;">
        <p class="" style="font-weight: bold; padding-left: 10px; line-height: 90px; font-size: 14px;">03</p>
    </div>
    <div class="border-bottom" style="height: 90px;">
        <p class="" style="font-weight: bold; padding-left: 10px; line-height: 90px; font-size: 14px;">02</p>
    </div>
    <div class="border-bottom" style="height: 90px;">
        <p class="" style="font-weight: bold; padding-left: 10px; line-height: 90px; font-size: 14px;">01</p>
    </div>

    <div class="position-absolute" style="width: 100%; left:0px; bottom: 0px;">
        <table class="table table-bordered border-secondary" style="width: 100%; margin: 0; font-size: 15px;">
            <tr>
                <th class="text-center">PACIENTE</th>
                <th class="text-center">SERVICIO</th>
                <th class="text-center">CUENTA</th>
                <th class="text-center">CAMA</th>
                <th class="text-center">HISTORIA CLÍNICA</th>
            </tr>
            <tr>
                <td class="text-center">@ViewBag.ApellidoPaterno @ViewBag.ApellidoMaterno @ViewBag.Nombres</td>
                <td class="text-center">@ViewBag.ServicioCita</td>
                <td class="text-center">@ViewBag.NroCuenta</td>
                <td class="text-center"></td>
                <td class="text-center">@ViewBag.NroHistoria</td>
            </tr>
        </table>
    </div>
</body>
</html>