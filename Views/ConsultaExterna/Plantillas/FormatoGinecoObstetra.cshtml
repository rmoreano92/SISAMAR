@*<body style="background: white; width:793px; height:1145px; position:relative; padding-top: 30px; border: 1px solid red;">*@
<body style="background: transparent; width:698px; height:1015px; padding-bottom:180px; position:relative;">

    @if (ViewBag.CodigoQR != null)
    {
        <img class="qr-code" src="@String.Format("data:image/png;base64,{0}", Convert.ToBase64String(ViewBag.CodigoQR))" />
    }

    <div class="position-absolute text-end " style="right:75px; top:30px; font-size: 7px;">
        <span>@ViewBag.FechaImpresion</span><br />
        <span>@ViewBag.Usuario</span>
    </div>

   
    <div class="text-center mb-2">
        <p class="fw-bold m-0" style="font-size: 12px;">@ViewBag.nombre</p>
        <p class="fw-bold" style="font-size: 8px; margin-bottom: 5px;">@ViewBag.direccion</p>
        <p class="fw-bold m-0" style="font-size: 8px;">TELEFONO: @ViewBag.telefono</p>
    </div>
    
    <div class="w-100 border border-secondary bg-gray text-center p-2 mb-2"><b>CONSULTA EXTERNA GINECO­OBSTETRICIA</b> - ­<span>FO­-003</span></div>

    <div class="mb-1">
        <div class="d-flex" >
            <div class="cabecera fw-bold border border-secondary bg-gray p-1" style="width: 97px;">FECHA</div>
            <div class="cabecera fw-bold border border-secondary bg-gray p-1" style="width: 97px;">HORA</div>
            <div class="cabecera fw-bold border border-secondary bg-gray p-1" style="width: 97px;">HORA. AT.</div>
            <div class="cabecera fw-bold border border-secondary bg-gray p-1" style="width: 97px;">EDAD</div>
            <div class="cabecera fw-bold border border-secondary bg-gray p-1" style="width: 97px;">GESTA</div>
            <div class="cabecera fw-bold border border-secondary bg-gray p-1" style="width: 97px;">PARIDAD</div>
            <div class="cabecera fw-bold border border-secondary bg-gray p-1" style="width: 97px;">FUR</div>
            <div class="cabecera fw-bold border border-secondary bg-gray p-1" style="width: 97px;">FPP</div>
            <div class="cabecera fw-bold border border-secondary bg-gray p-1" style="width: 97px;">EDAD GEST.</div>
        </div>
        <div class="d-flex">
            <div class="cabecera border border-secondary p-1" style="width: 97px;">@ViewBag.FechaIngreso</div>
            <div class="cabecera border border-secondary p-1" style="width: 97px;">@ViewBag.HoraInicio</div>
            <div class="cabecera border border-secondary p-1" style="width: 97px;">@ViewBag.HoraInicioAtencion</div>
            <div class="cabecera border border-secondary p-1" style="width: 97px;">@ViewBag.Edad</div>
            <div class="cabecera border border-secondary p-1" style="width: 97px;">@ViewBag.Gestas</div>
