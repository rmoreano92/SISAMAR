@section Css
{
    <!-- plugin css -->
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/chosen/css/chosen.css" />
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/bootstrap-datetimepicker/css/bootstrap-datetimepicker.min.css" />
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/radio_css/css/radiobox.min.css" />
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/css/pages/radio_checkbox.css" />
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/jquery-tagsinput/css/jquery.tagsinput.css" />
}


<header class="head">
    <div class="main-bar row">
        <div class="col-lg-6 col-md-4 col-sm-4">
            <h4 class="nav_top_align">
                <i class="fa fa-th"></i>
                @ViewBag.Area
            </h4>
        </div>
        <div class="col-lg-6 col-md-8 col-sm-8">
            <ol class="breadcrumb float-xs-right nav_breadcrumb_top_align">
                <li class="breadcrumb-item">
                    <a href="index1.html">
                        <i class="fa fa-home" data-pack="default" data-tags=""></i> Home
                    </a>
                </li>
                <li class="breadcrumb-item">
                    <a href="#">@ViewBag.Area</a>
                </li>
                <li class="breadcrumb-item active">Inmunizaciones</li>
            </ol>
        </div>
    </div>
</header>

<div class="row m-0">
    <div class="col-sm-12">
        <ul class="nav nav-tabs" id="myTab" role="tablist">
            <li class="nav-item" role="presentation">
                <a href="#" class="nav-link nav-link-custom active" id="TabBusqueda" data-toggle="tab" data-target="#TabPanelBusqueda" role="tab" aria-controls="TabPanelBusqueda" aria-selected="true">Busqueda</a>
            </li>
            <li class="nav-item m-0" role="presentation">
                <a href="#" class="nav-link nav-link-custom" id="TabRegistro" data-toggle="tab" data-target="#TabPanelRegistro" role="tab" aria-controls="TabPanelRegistro" aria-selected="false" style="display:none;">Registro Atención</a>
            </li>
        </ul>
        <div class="tab-content border pt-1 pl-1 pr-1" id="myTabContent">
            <!--=============================================Panel Busqueda==================================================================-->
            <div class="tab-pane fade active in" id="TabPanelBusqueda" role="tabpanel" aria-labelledby="TabBusqueda">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="card">
                            <div class="card-block pb-1">
                                <div class="row">
                                    <div class="col-lg-2" style="max-width: 180px;">
                                        <div class="form-group m-0">
                                            <label for="txtNroCuentaBusqueda" class="form-control-label">N° Cuenta</label>
                                            <div class="input-group input-group-sm">
                                                <input type="text" class="form-control bloquear-campos search" id="txtNroCuentaBusqueda">
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-lg-2" style="max-width: 180px;">
                                        <div class="form-group m-0">
                                            <label for="txtNroHistoriaBusqueda" class="form-control-label">N° Historia</label>
                                            <div class="input-group input-group-sm">
                                                <input type="text" class="form-control bloquear-campos search" id="txtNroHistoriaBusqueda">
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-lg-2" style="max-width: 180px;">
                                        <div class="form-group m-0">
                                            <label for="txtNroApellidoPaternoBusqueda" class="form-control-label">Apellido Paterno</label>
                                            <div class="input-group input-group-sm">
                                                <input type="text" class="form-control bloquear-campos search" id="txtNroApellidoPaternoBusqueda">
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-lg-2" style="max-width: 180px;">
                                        <div class="form-group m-0">
                                            <label for="txtFechaAtencion" class="form-control-label">Fecha de Atención</label>
                                            <div class="input-group input-group-sm m-0">
                                                <input type="text" autocomplete="off" class="form-control form_val_popup_dp3" placeholder="dd/mm/yyyy" data-date-format="dd/mm/yyyy" id="txtFechaAtencion">
                                                <span class="input-group-addon">
                                                    <i class="fa fa-calendar "></i>
                                                </span>
                                            </div>
                                        </div>
                                    </div>


                                    <div class="col-lg-2 d-flex align-items-end" style="height: 55px;">
                                        <div>
                                            <button class="btn btn-primary btn-sm layout_btn_prevent" style="padding-left: 2rem !important; padding-right: 2rem !important;" id="btnBuscarAtenciones">Buscar</button>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6 pt-2 pb-0">
                        @{
                            if (@ViewBag.Agregar)
                            {
                                @*<button class="btn btn-primary layout_btn_prevent" id="btnAgregar">Agregar</button>*@
                            }
                            if (@ViewBag.Modificar)
                            {
                                <button class="btn btn-info layout_btn_prevent" id="btnModificarAtenciones">Modificar</button>
                            }
                            if (@ViewBag.Eliminar)
                            {
                                <button class="btn btn-danger layout_btn_prevent" id="btnEliminarAtenciones">Eliminar</button>
                            }
                            if (@ViewBag.Consultar)
                            {
                                <button class="btn btn-warning layout_btn_prevent" id="btnConsultarAtenciones">Consultar</button>
                            }
                        }
                    </div>

                    <div class="col-md-6 d-flex align-items-end justify-content-end" style="height: 50px;">
                        <label for="" class="titulo mr-1" style=" font-size: medium; color: #0095ff !important;">Parte Diario: </label>
                        <div>
                            <button class="btn btn-info layout_btn_prevent" id="btnGeneraParte" title="Genera Parte" data-toggle="tooltip" style="margin: 2px;"><i class="fa fa-pencil"></i></button>
                            <button class="btn btn-success layout_btn_prevent" id="btnDescargaParte" title="Imprime Parte Firmado" data-toggle="tooltip" style="margin: 2px;"><i class="fa fa-print"></i></button>
                            <button class="btn btn-warning layout_btn_prevent" id="btnDescargaParteSF" title="Visualiza Parte" data-toggle="tooltip" style="margin: 2px;"><i class="fa fa-eye"></i></button>
                        </div>
                    </div>

                    <div class="col-lg-12 pb-2">
                        <table id="tblAtencion" width="100%" class="table table-sm table-bordered">
                            <thead style="color: white;background: #434343;">
                                <tr>
                                    <th style="width:5%;">N° Cuenta</th>
                                    <th style="width:5%">Ap. Paterno</th>
                                    <th style="width:5%">Ap. Materno</th>
                                    <th style="width:5%">1er Nombre</th>
                                    <th style="width:5%">N° Historia</th>
                                    <th style="width:5%">Fecha Nacimiento</th>
                                    <th style="width:6%">Fecha Ing.</th>
                                    <th style="width:7%">Hora Ing.</th>
                                    <th style="width:5%">Fuente</th>
                                    <th style="width:5%">Estado Atencion</th>
                                    <th style="width:5%">FUA</th>
                                    @*<th style="width:5%">Fuente</th>
                                    <th style="width:8%; text-align:center">INFORME</th>
                                    <th style="width:8%; text-align:center">RECETAS</th>
                                    <th style="width:8%; text-align:center">PROC</th>
                                    <th style="width:8%; text-align:center">REFCON</th>
                                    <th style="width:8%; text-align:center">FUA</th>*@
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>


                    <div class="col-md-12 d-flex align-items-end justify-content-end" style="height: 50px;">
                        <div>
                            <button class="btn btn-info layout_btn_prevent m-1" id="btnFirmaAtencion"><i class="fa-light fa-signature mr-1"></i>Firmar Atencion</button>
                            <button class="btn btn-info layout_btn_prevent m-1" id="btnFirmaLote"><i class="fa-light fa-signature mr-1"></i>Firmar Lote</button>
                        </div>
                    </div>

                </div>
            </div>
            <!--=============================================Panel Registro==================================================================-->
            <div class="tab-pane fade" id="TabPanelRegistro" role="tabpanel" aria-labelledby="TabRegistro">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="card  m-t-5">
                            <div class="card-header bg-white">Registro de Inmunizaciones</div>
                            <div class="card-block m-t-5">

                                <div class="row mb-2">

                                    <div class="col-md-4">
                                        <div class="form-group m-0">
                                            <label for="txtDatoPaciente">Paciente</label>
                                            <input type="text" class="form-control form-control-sm" id="txtApellidosNombresPaciente" placeholder="" autocomplete="off" disabled="">
                                        </div>
                                    </div>
                                    <div class="col-md-2">
                                        <div class="form-group m-0">
                                            <label for="txtNroHistoria">N° Historia</label>
                                            <input type="text" class="form-control form-control-sm" id="txtNroHistoria" placeholder="" autocomplete="off" disabled="">
                                        </div>
                                    </div>
                                    <div class="col-md-2">
                                        <div class="form-group m-0">
                                            <label for="cboTipoDocPaciente">Tipo Documento</label>
                                            <div class="input-group input-group-sm">
                                                <select class="chzn-select bloquear" id="cboTipoDocPaciente" disabled></select>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-2">
                                        <div class="form-group m-0">
                                            <label for="txtNroDocumento">N° Documento</label>
                                            <input type="text" class="form-control form-control-sm" id="txtNroDocumento" placeholder="" autocomplete="off" disabled="">
                                        </div>
                                    </div>
                                </div>

                                <div class="card  m-t-5 bg-green">
                                    <div class="card-header bg-white">TUTOR O APODERADO</div>
                                    <div class="card-block m-t-5">

                                        <div class="row">

                                            <div class="col-md-2">
                                                <div class="form-group m-0">
                                                    <label for="cboTipoDocMadre">Tipo Documento</label>
                                                    <div class="input-group input-group-sm">
                                                        <select class="chzn-select bloquear" id="cboTipoDocMadre" disabled></select>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-2">
                                                <div class="form-group m-0">
                                                    <label for="txtNroDocMadre">N° Documento</label>
                                                    <input type="text" class="form-control form-control-sm" id="txtNroDocMadre" placeholder="" autocomplete="off" disabled="">
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="form-group m-0">
                                                    <label for="txtApellidosNombresMadre">Datos Personales</label>
                                                    <input type="text" class="form-control form-control-sm" id="txtApellidosNombresMadre" placeholder="" autocomplete="off" disabled="">
                                                </div>
                                            </div>
                                            @*<div class="col-md-2">
                                            <div class="form-group m-0">
                                            <label for="txtDatoEdad">Parentesco</label>
                                            <input type="text" class="form-control form-control-sm" id="txtDatoEdad" placeholder="" autocomplete="off" disabled="">
                                            </div>
                                            </div>*@

                                        </div>

                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>

                <div class="card  m-t-5 mb-1 bg-green">
                    <div class="card-header bg-white">Calendario Vacunas <b id="lblEdadPaciente" class="ml-1" style="color: orangered"></b></div>
                    <div class="card-block m-t-5">

                        <div class="row">

                            <div class="col-md-12">
                                <table class="table table-sm table-bordered" id="tblVacunas" width="100%">
                                    <thead style="color: white; background: #434343;">
                                        <tr>
                                            <th width="5%">Codigo</th>
                                            <th width="35%">Nombre.</th>
                                            <th width="5%">R.N.</th>
                                            <th width="5%">2 MES(ES)</th>
                                            <th width="5%">4 MES(ES)</th>
                                            <th width="5%">6 MES(ES)</th>
                                            <th width="5%">7 MES(ES)</th>
                                            <th width="5%">8 MES(ES)</th>
                                            <th width="5%">1 AÑO(S)</th>
                                            <th width="10%">1 AÑO(S) 3 MES(ES)</th>
                                            <th width="10%">1 AÑO(S) 6 MES(ES)</th>
                                            <th width="5%">4 AÑO(S)</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>

                        </div>

                    </div>
                </div>

                <div class="row mt-2">
                    <div class="col-lg-12">

                        <button id="btnGuardarAtencion" type="button" data-dismiss="modal" class="btn btn-lg btn-primary float-lg-right mr-1 mb-1">Guardar</button>
                        <button id="btnCerrarAtencion" type="button" data-dismiss="modal" class="btn btn-lg btn-secondary float-lg-right mr-1 mb-1">Cerrar</button>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


