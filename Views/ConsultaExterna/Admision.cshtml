    }
    /*==============Leyenda Estado Cola Cita - inicio ===============*/
    .cola-legend{
        font-size: .78rem;
        color: #6c757d;
        padding-top: .35rem;
        margin-top: .35rem;
        border-top: 1px solid rgba(0,0,0,.08);
    }

    .cola-legend__title{
        margin-right: .6rem;
        font-weight: 600;
        color: #7a7a7a;
    }

    .cola-legend__item{
        display: inline-flex;
        align-items: center;
        margin: 0 .55rem .25rem 0;
        white-space: nowrap;
    }

    .cola-legend__dot{
        width: 10px;
        height: 10px;
        border-radius: 50%;
        display: inline-block;
        margin-right: .35rem;
        box-shadow: inset 0 0 0 1px rgba(0,0,0,.12);
    }

    /* Colores (ajusta si tus chips usan otros tonos) */
    .dot-blue{ background:#4e73df; }
    .dot-info{ background:#36b9cc; }       /* Llegó (cian) */
    .dot-warning{ background:#f6c23e; }    /* Triaje */
    .dot-danger{ background:#e74a3b; }     /* Llamando */
    .dot-primary{ background:#007bff; }
    .dot-success{ background:#1cc88a; }    /* Atendido */
    .dot-secondary{ background:#6c757d; }

    /* Chips (si tu .chip es custom) */
    .chip.info{ background:#36b9cc; }
    .chip.warning{ background:#f6c23e; color:#111; } /* opcional: texto oscuro */
    .chip.danger{ background:#e74a3b; }
    .chip.success{ background:#1cc88a; }
    /*==============Leyenda Estado Cola Cita - fin ===============*/
</style>