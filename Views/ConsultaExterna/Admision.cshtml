@section Css
{
    <!-- plugin css -->
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/chosen/css/chosen.css" />
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/bootstrap-datetimepicker/css/bootstrap-datetimepicker.min.css" />
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/radio_css/css/radiobox.min.css" />
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/css/pages/radio_checkbox.css" />
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/jquery-tagsinput/css/jquery.tagsinput.css" />
}

<header class="head">
    <div class="main-bar row">
        <div class="col-lg-6 col-md-4 col-sm-4">
            <h4 class="nav_top_align">
                <i class="fa fa-th"></i>
                @ViewBag.Area
            </h4>
        </div>
        <div class="col-lg-6 col-md-8 col-sm-8">
            <ol class="breadcrumb float-xs-right nav_breadcrumb_top_align">
                <li class="breadcrumb-item">
                    <a href="index1.html">
                        <i class="fa fa-home" data-pack="default" data-tags=""></i> Home
                    </a>
                </li>
                <li class="breadcrumb-item">
                    <a href="#">@ViewBag.Area</a>
                </li>
                <li class="breadcrumb-item active">Admisión</li>
            </ol>
        </div>
    </div>
</header>

<div class="outer">
    <div class="inner bg-light lter bg-container">
        <div class="row">
            <div class="col-xs-12 data_tables">
                <div class="card">
                    <div class="card-header bg-white">
                        <i class="fa fa-pencil-square-o"></i> Admisión
                    </div>

                    <div class="card-block">
                        <div class="row">
                            <div class="col-lg-12">
                                <div class="card m-t-5">
                                    <div class="card-block">
                                        <div class="row">
                                            <div class="col-lg-8">
                                                <form id="frmAdmisionFiltro" autocomplete="off" onsubmit="return false;">
                                                    <div class="row">

                                                        <div class="col-lg-2">
                                                            <label for="txtNroCuentaBusq" class="form-control-label">N° Cuenta</label>
                                                            <div class="form-group">
                                                                <div class="input-group input-group-sm">
                                                                    <input id="txtNroCuentaBusq" autocomplete="off" placeholder="" class=" solo-numero form-control">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-lg-2">
                                                            <label for="txtNroDniBusq" class="form-control-label">N° Dni</label>
                                                            <div class="form-group">
                                                                <div class="input-group input-group-sm">
                                                                    <input id="txtNroDniBusq" autocomplete="off" placeholder="" class=" solo-numero form-control">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-lg-2">
                                                            <label for="txtNroHistoriaBusq" class="form-control-label">N° Historia</label>
                                                            <div class="form-group">
                                                                <div class="input-group input-group-sm">
                                                                    <input id="txtNroHistoriaBusq" autocomplete="off" placeholder="" class=" solo-numero form-control">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-lg-2">
                                                            <label for="txtApPaternoBusq" class="form-control-label">Apellido Paterno</label>
                                                            <div class="form-group">
                                                                <div class="input-group input-group-sm">
                                                                    <input id="txtApPaternoBusq" autocomplete="off" placeholder="" class=" form-control">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-lg-2">
                                                            <label for="txtApMaternoBusq" class="form-control-label">Apellido Materno</label>
                                                            <div class="form-group">
                                                                <div class="input-group input-group-sm">
                                                                    <input id="txtApMaternoBusq" autocomplete="off" placeholder="" class=" form-control">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-lg-2">
                                                            <label for="txtFechaAdmBusq" class="form-control-label">Fecha Cita</label>
                                                            <div class="input-group input-group-sm">
                                                                <input type="text" autocomplete="off" class="form-control form_val_popup_dp3" placeholder="dd/mm/yyyy" data-date-format="dd/mm/yyyy" id="txtFechaAdmBusq" name="FechaAdmBusq">
                                                                <span class="input-group-addon">
                                                                    <i class="fa fa-calendar "></i>
                                                                </span>
                                                            </div>
                                                        </div>

                                                    </div>
                                                </form>
                                            </div>
                                            <div class="col-lg-2 d-flex align-items-end" style="height: 55px;">
                                                <button class="btn btn-sm btn-primary layout_btn_prevent" style="padding-left: 2rem !important; padding-right: 2rem !important;" id="btnBuscar">Buscar</button>
                                                <button class="btn btn-sm btn-default layout_btn_prevent" style="padding-left: 2rem !important; padding-right: 2rem !important;" id="btnLimpiar">Limpiar</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row mt-2">
                            <div class="col-lg-12">
                                @{
                                                @*if (@ViewBag.Agregar)
                                                {
                                    <button class="btn btn-success layout_btn_prevent" id="btnAgregar">Agregar</button>
                                                }
                                                if (@ViewBag.Modificar)
                                                {
                                    <button class="btn btn-primary layout_btn_prevent" id="btnModificar">Modificar</button>
                                                }*@
                                                @*if (@ViewBag.Eliminar)
                                        {
                                    <button class="btn btn-danger layout_btn_prevent" id="btnEliminar">Eliminar</button>
                                                }*@
                                                @*if (@ViewBag.Consultar)
                                                {
                                    <button class="btn btn-warning layout_btn_prevent" id="btnConsultar">Consultar</button>
                                                }*@
                                                if (@ViewBag.Modificar)
                                                {
                                    <button class="btn btn-success layout_btn_prevent" id="btnLlegoPaciente">Confirmar Llegada</button>
                                                }
                                }

                                <table id="tblTriajeCE" class="table table-sm table-bordered ">
                                    <thead style="color: white; background: #434343;">
                                        <tr >
                                            <th class="text-nowrap">N° Cuenta</th>
                                            <th class="text-nowrap">N° Historia</th>
                                            <th class="text-nowrap">Paciente</th>
                                            <th class="text-nowrap">Ap. Paterno</th>
                                            <th class="text-nowrap">Ap. Materno</th>
                                            <th class="text-nowrap">1er Nombre</th>
                                            <th class="text-nowrap">Estado Cola</th>
                                            <th class="text-nowrap">Consultorio</th>
                                            <th class="text-nowrap">Fecha Cita</th>
                                            <th class="text-nowrap">Hora Cita</th>
                                            <th class="text-nowrap">Ticket</th>
                                            <th class="text-nowrap">Id Cita</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>

                                <div id="leyendaColaCita" class="cola-legend text-center mt-2">
                                    <span class="cola-legend__title">Estados de cola:</span>

                                    <span class="cola-legend__item">
                                        <span class="cola-legend__dot dot-blue"></span> Citado
                                    </span>
                                    <span class="cola-legend__item">
                                      <span class="cola-legend__dot dot-info"></span> Llegó
                                    </span>
                                    <span class="cola-legend__item">
                                      <span class="cola-legend__dot dot-warning"></span> Triaje
                                    </span>
                                    <span class="cola-legend__item">
                                      <span class="cola-legend__dot dot-danger"></span> Llamando
                                    </span>
                                    <span class="cola-legend__item">
                                        <span class="cola-legend__dot dot-primary"></span> En Atención
                                    </span>
                                    <span class="cola-legend__item">
                                      <span class="cola-legend__dot dot-success"></span> Atendido
                                    </span>
                                    <span class="cola-legend__item">
                                        <span class="cola-legend__dot dot-secondary"></span> No se presentó
                                    </span>
                                </div>

                            </div>


                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
