<div data-backdrop="static" style="overflow-y: scroll;" data-keyboard="false" class="modal fade" id="modalTicket" role="dialog" aria-labelledby="modalLabelsuccess">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary">
                <h4 class="modal-title text-white" id="modalLabelsuccess">Cita</h4>
            </div>
            <div class="modal-body" style="background-color:#b4c6d6">

                <iframe id="ifrmTicketCita"
                        title="Inline Frame Example"
                        width="100%"
                        height="600"
                        src=""></iframe>

            </div>
            <div class="modal-footer" style="background-color:#ced8e1">
                <button id="btnCerrarTicket" target="_blank" class="btn btn-secondary "> Cerrar</button>
            </div>
        </div>
    </div>
</div>

<div data-backdrop="static" style="overflow-y: scroll;" data-keyboard="false" class="modal fade" id="modalLlegada" role="dialog" aria-labelledby="modalLabelsuccess">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary">
                <h4 class="modal-title text-white" id="modalLabelsuccess">Registro de Llegada</h4>
            </div>
            <div class="modal-body">
                <partial name="~/Views/ConsultaExterna/AdmisionLlegada.cshtml" />
            </div>
            <div class="modal-footer">

                <button id="btnGuardarLlegada" class="btn btn-success"> Confirmar llegada</button>
                <button id="btnCerrarModalLlegada" target="_blank" class="btn  btn-secondary "> Cerrar</button>

            </div>
        </div>
    </div>

</div>

<iframe id="ifrmReporte"
        title="Inline Frame Example"
        width="100"
        height="600" hidden="hidden"
        src=""></iframe>


