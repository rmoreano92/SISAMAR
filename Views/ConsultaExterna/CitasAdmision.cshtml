            font-size: 11px;
        }

        .context-menu {
            display: flex;
            flex-direction: column;
            position: absolute;
            background-color: #FFFFFF;
            box-sizing: border-box;
            box-shadow: 1px 1px 3px rgba(0, 0, 0, 0.2), 0 0 0 1px #EEEEEE;
            border-radius: 2px;
            white-space: nowrap;
            vertical-align: top;
            overflow: hidden;
            user-select: none;
            animation: 0.1s context-popup;
        }

        .context-menu-options {
            padding: 3px 7px;
            overflow-x: hidden;
            overflow-y: auto;
            flex: 1;
            text-decoration: none;
        }

        .context-menu-option {
            cursor: pointer;
            color: #3e6184;
            margin-bottom: 3px;
            border-bottom: solid #3e61845c 1px;
            text-decoration: none;
        }

            .context-menu-option:hover {
                background-color: rgba(67, 147, 230, .1);
                text-decoration: none;
            }

        .context-menu-option-base {
            position: relative;
            padding: 6px 30px 6px 14px;
            font-size: 11pt;
            font-weight: 300;
            color: #616161;
        }

        .option-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 20px;
            height: 20px;
            margin-right: 5px;
            user-select: none;
        }

        .option-text, .option-arrow {
            display: inline-flex;
            align-items: center;
            user-select: none;
        }

        .option-separator {
            height: 1px;
            border: none;
            border-top: 1px solid #EEEEEE;
        }
    </style>

    <!--Page level styles-->
}

