    <link href="https://fullcalendar.io/releases/fullcalendar/3.10.0/fullcalendar.min.css" rel="stylesheet">

    <style id="compiled-css" type="text/css">

        .day-text {
            font-weight: bold;
            font-size: 12px;
            /* color: red; */
        }

        .day-highlight {
            background-color: #4bb9ff !important;
            color: #fff !important;
        }

        .table tr.over td {
            background: #D6E8F8;
            font-weight: bold;
        }

        .table th, .table td {
            padding: 0.4rem;
            vertical-align: top;
            border-top: 1px solid #eceeef;
            font-size: .85em;
        }

        .fc-basic-view .fc-body .fc-row {
            min-height: 2px;
        }

        .fc button, .fc table, body .fc {
            font-size: .95em;
        }

        table {
            border-collapse: collapse;
            border-spacing: 0;
            margin-bottom: 0.2em;
        }

        .fc-toolbar.fc-header-toolbar {
            margin-bottom: 10px;
        }

        .fc-center h2, .h2 {
            font-size: 1.4rem;
        }

        .chosen-container {
            font-size: 11px;
        }

        .context-menu {
            display: flex;
            flex-direction: column;
            position: absolute;
            background-color: #FFFFFF;
            box-sizing: border-box;
            box-shadow: 1px 1px 3px rgba(0, 0, 0, 0.2), 0 0 0 1px #EEEEEE;
            border-radius: 2px;
            white-space: nowrap;
            vertical-align: top;
            overflow: hidden;
            user-select: none;
            animation: 0.1s context-popup;
        }

        .context-menu-options {
            padding: 3px 7px;
            overflow-x: hidden;
            overflow-y: auto;
            flex: 1;
            text-decoration: none;
        }

        .context-menu-option {
            cursor: pointer;
            color: #3e6184;
            margin-bottom: 3px;
            border-bottom: solid #3e61845c 1px;
            text-decoration: none;
        }

            .context-menu-option:hover {
                background-color: rgba(67, 147, 230, .1);
                text-decoration: none;
            }

        .context-menu-option-base {
            position: relative;
            padding: 6px 30px 6px 14px;
            font-size: 11pt;
            font-weight: 300;
            color: #616161;
        }

        .option-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 20px;
            height: 20px;
            margin-right: 5px;
            user-select: none;
        }

        .option-text, .option-arrow {
            display: inline-flex;
            align-items: center;
            user-select: none;
        }

        .option-separator {
            height: 1px;
            border: none;
            border-top: 1px solid #EEEEEE;
        }
    </style>

    <!--Page level styles-->
}

