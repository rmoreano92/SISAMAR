@using Microsoft.Extensions.Configuration;
@{
    var version = new ConfigurationBuilder().AddJsonFile("appsettings.json").Build().GetValue<string>("Version");
    // var usaLabs = new ConfigurationBuilder().AddJsonFile("appsettings.json").Build().GetValue<string>("Configuraciones:UsaLabs");
}

@* <input id="hdUsaLabs" value="@usaLabs" hidden> *@



@section Css {
    <!-- plugin css -->
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/chosen/css/chosen.css" />
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/bootstrap-datetimepicker/css/bootstrap-datetimepicker.min.css" />
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/radio_css/css/radiobox.min.css" />
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/css/pages/radio_checkbox.css" />
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/jquery-tagsinput/css/jquery.tagsinput.css" />
}

<header class="head">
    <div class="main-bar row">
        <div class="col-lg-6 col-md-4 col-sm-4">
            <h4 class="nav_top_align">
                <i class="fa fa-hand-holding-medical"></i>
                Registro de Atenciones
            </h4>
        </div>
        <div class="col-lg-6 col-md-8 col-sm-8">
            <ol class="breadcrumb float-xs-right nav_breadcrumb_top_align">
                <li class="breadcrumb-item">
                    <a href="index1.html">
                        <i class="fa fa-home" data-pack="default" data-tags=""></i> Home
                    </a>
                </li>
                <li class="breadcrumb-item">
                    <a href="#">@ViewBag.Area</a>
                </li>
                <li class="breadcrumb-item active">Registro de Atenciones</li>
            </ol>
        </div>
    </div>
</header>


<div class="row m-0">
    <div class="col-sm-12">
        <ul class="nav nav-tabs" id="myTab" role="tablist">
            <li class="nav-item" role="presentation">
                <a href="#" class="nav-link nav-link-custom active" id="TabBusqueda" data-toggle="tab" data-target="#TabPanelBusqueda" role="tab" aria-controls="TabPanelBusqueda" aria-selected="true">Busqueda</a>
            </li>
            <li class="nav-item m-0" role="presentation">
                <a href="#" class="nav-link nav-link-custom" id="TabRegistro" data-toggle="tab" data-target="#TabPanelRegistro" role="tab" aria-controls="TabPanelRegistro" aria-selected="false" style="display:none;">Registro Atención</a>
            </li>
        </ul>
        <div class="tab-content border pt-1 pl-1 pr-1" id="myTabContent">
            <!--=============================================Panel Busqueda==================================================================-->
            <div class="tab-pane fade active in" id="TabPanelBusqueda" role="tabpanel" aria-labelledby="TabBusqueda">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="card">
                            <div class="card-block pb-1">
                                <div class="row">
                                    <div class="col-lg-2" style="max-width: 180px;">
                                        <div class="form-group m-0">
                                            <label for="txtFechaAtencion" class="form-control-label">Fecha de Atención</label>
                                            <div class="input-group input-group-sm m-0">
                                                <input type="text" autocomplete="off" class="form-control form_val_popup_dp3" placeholder="dd/mm/yyyy" data-date-format="dd/mm/yyyy" id="txtFechaAtencion">
                                                <span class="input-group-addon">
                                                    <i class="fa fa-calendar "></i>
                                                </span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-lg-3">
                                        <div class="form-group m-0">
                                            <label for="cboConsultorio" class="form-control-label">Consultorio</label>
                                            <select class="chzn-select" id="cboConsultorio" data-placeholder="Seleccione una opción"></select>
                                        </div>
                                    </div>

                                    <div class="col-lg-2 d-flex align-items-end" style="height: 55px;">
                                        <div>
                                            <button class="btn btn-primary btn-sm layout_btn_prevent" style="padding-left: 2rem !important; padding-right: 2rem !important;" id="btnBuscarAtenciones">Buscar</button>
                                        </div>
                                    </div>

                                    <div class="offset-lg-1 col-lg-4 mt-1">
                                        <div class="d-flex align-items-end justify-content-end">
                                            <div class="msc-hotline" style="height:52px;">
                                                <div class="msc-hotline-icon" style="width: 50px; height:50px; min-width: 50px;">
                                                    <i class="fa-solid fa-user-doctor"></i>
                                                </div>
                                                <div class="msc-hotline-content m-auto">
                                                    <div class="msc-hotline-title">
                                                        <span id="lblMedicoProgramado" style="font-size: 12px;"></span>
                                                    </div>
                                                    <div class="msc-hotline-text" style="font-size: 12px;">Médico Atiende</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6 pt-2 pb-0">
                        @{
                            if (@ViewBag.Agregar)
                            {
                                @*<button class="btn btn-primary layout_btn_prevent" id="btnAgregar">Agregar</button>*@
                            }
                            if (@ViewBag.Modificar)
                            {
                                <button class="btn btn-info layout_btn_prevent" id="btnModificarAtenciones">Modificar</button>
                            }
                            if (@ViewBag.Eliminar)
                            {
                                <button class="btn btn-danger layout_btn_prevent" id="btnEliminarAtenciones">Eliminar</button>
                            }
                            if (@ViewBag.Consultar)
                            {
                                <button class="btn btn-warning layout_btn_prevent" id="btnConsultarAtenciones">Consultar</button>
                            }
                            if (@ViewBag.Modificar)
                            {
                                <button class="btn btn-teal layout_btn_prevent" id="btnLlamarPaciente"><i class="fa-solid fa-volume-high"></i></button>
                            }
                        }
                    </div>

                    <div class="col-md-6 d-flex align-items-end justify-content-end" style="height: 50px;">
                        <label for="" class="titulo mr-1" style=" font-size: medium; color: #0095ff !important;">Parte Diario: </label>
                        <div>
                            <button class="btn btn-info layout_btn_prevent" id="btnGeneraParte" title="Genera Parte" data-toggle="tooltip" style="margin: 2px;"><i class="fa fa-pencil"></i></button>
                            <button class="btn btn-success layout_btn_prevent" id="btnDescargaParte" title="Imprime Parte Firmado" data-toggle="tooltip" style="margin: 2px;"><i class="fa fa-print"></i></button>
                            <button class="btn btn-warning layout_btn_prevent" id="btnDescargaParteSF" title="Visualiza Parte" data-toggle="tooltip" style="margin: 2px;"><i class="fa fa-eye"></i></button>
                        </div>
                    </div>

                    <div class="col-lg-12 pb-2">
                        <table id="tblAtencion" width="100%" class="table table-sm table-content-md table-bordered">
                            <thead style="color: white;background: #434343;">
                                <tr>
                                    <th class="text-nowrap">Cuenta</th>
                                    <th class="text-nowrap">H. I.</th>
                                    <th class="text-nowrap">Estado Cola</th>
                                    @*<th style="width:10%">Ap. Paterno</th>
                                    <th style="width:10%">Ap. Materno</th>
                                    <th style="width:10%">Nombres</th>*@
                                    <th class="text-nowrap">Paciente</th>
                                    <th class="text-nowrap">Historia</th>
                                    <th class="text-nowrap">Telefono</th>
                                    <th class="text-nowrap">Plan</th>
                                    <th class="text-nowrap">Est. Cita</th>
                                    <th class="text-nowrap">H.I.Ate.</th>
                                    <th class="text-nowrap">Carnet</th>
                                    <th class="text-nowrap">INFORME</th>
                                    <th class="text-nowrap">Prox. Cita</th>
                                    <th class="text-nowrap">RECETAS</th>
                                    <th class="text-nowrap">REFCON</th>
                                    <th class="text-nowrap">FUA</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>


                    <div class="col-md-12 d-flex align-items-end justify-content-end" style="height: 50px;">
                        <div>
                            <button class="btn btn-info layout_btn_prevent m-1 d-none" id="btnFirmaAtencion"><i class="fa-light fa-signature mr-1"></i>Firmar Atencion</button>
                            <button class="btn btn-info layout_btn_prevent m-1 d-none" id="btnFirmaLote"><i class="fa-light fa-signature mr-1"></i>Firmar Lote</button>
                            <button class="btn btn-info layout_btn_prevent m-1" id="btnFirmaLoteAtenciones"><i class="fa-light fa-signature mr-1"></i>Firmar Lote Atenciones</button>
                            <button class="btn btn-info layout_btn_prevent m-1" id="btnFirmaLoteOtros"><i class="fa-light fa-signature mr-1"></i>Firmar Lote Otros</button>
                        </div>
                    </div>


                    <div class="col-md-12">
                        @{
                            if (@ViewBag.Medico)
                            {
                                <label for="" class="form-control-label mt-1 text-danger"><b>EL USUARIO ES UN PROFESIONAL DE LA SALUD POR LO TANTO SOLO SE MOSTRARA SUS PACIENTES </b></label>
                            }
                        }
                        <input type="hidden" value="@ViewBag.idEmpleado" id="idEmpleadotxt" /> @*JDELGADO001*@
                        <input type="hidden" value="@ViewBag.idMedico" id="idMedicotxt" />
                    </div>
                </div>
            </div>
            <!--=============================================Panel Registro==================================================================-->
            <div class="tab-pane fade" id="TabPanelRegistro" role="tabpanel" aria-labelledby="TabRegistro">
