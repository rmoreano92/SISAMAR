        @if (!string.IsNullOrEmpty(otrosMedicamentos))
        {
            <div class="extras-title">Otros medicamentos</div>
            <table class="proa-table tiny mt-1">
                <tr>
                    <td>@Html.Raw(otrosMedicamentos.Replace("\r\n", "<br />").Replace("\n", "<br />"))</td>
                </tr>
            </table>
        }

*@

    </div>
</body>
</html>