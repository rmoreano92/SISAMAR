                <td>@ViewBag.NombreInstitucion</td>
                <td class="label w-15">Teléfono</td>
                <td>@ViewBag.TelefonoInstitucion</td>
            </tr>
            <tr>
                <td class="label">Dirección</td>
                <td colspan="3">@ViewBag.DireccionInstitucion</td>
            </tr>
            <tr>
                <td class="label">Historia</td>
                <td>@ViewBag.Historia</td>
                <td class="label">Cuenta</td>
                <td>@ViewBag.Cuenta</td>
            </tr>
            <tr>
                <td class="label">Tipo Plan</td>
                <td>@ViewBag.TipoPlan</td>
                <td class="label">Tipo Servicio</td>
                <td>@ViewBag.TipoServicio</td>
            </tr>
            <tr>
                <td class="label">Consultorio</td>
                <td>@ViewBag.Consultorio</td>
                <td class="label">Vigencia</td>
                <td>@fechaVigencia</td>
            </tr>
            <tr>
                <td class="label">Usuario</td>
                <td>@ViewBag.Usuario</td>
                <td class="label">Fecha creación</td>
                <td>@ViewBag.FechaCreacion</td>
            </tr>
        </table>

        <div class="extras-title">Diagnósticos</div>
