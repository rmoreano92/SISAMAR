@*<body class="m-0" style="background: white;  width: 793px; height: 1145px; position: relative; padding-top: 35px; /* border: 1px solid red;*/">*@
<body style="background: white; width:698px; height:1015px; position:relative; /*padding-top: 30px; border: 1px solid red;*/">

    <div class="row w-100" style="padding-top: 60px;">

        @*==================PRIMERA PARTE====================================*@
        <div class="col-6 position-relative px-1">
            @*<div class="position-absolute" style="width: 60px; left:0px;">
                <img src="~/images/Logo.png" style="width: 100%" />
            </div>*@
            
            <div class="text-center">
                <div class=""><span class="fw-bold">@ViewBag.NombreInstitucion</span></div>
                <div class=""><span class="fw-bold">@ViewBag.DireccionInstitucion</span></div>
                <div class=""><span class="fw-bold">Telefono: @ViewBag.TelefonoInstitucion</span></div>
                <div class=" my-2"><span class="fw-bold font-lg">@ViewBag.TituloDoc</span></div>
            </div>

            <div class="text-center" style="margin-left: auto; width: 80px; right:20px; top: 40px;">
                <div class="fw-bold font-md border border-secondary w-100" style="padding:2px;">@ViewBag.TituloNro</div>
                <div class="font-lg border border-secondary w-100" style="padding:2px;">@ViewBag.NroReceta</div>
            </div>

            <div class="row m-0">
                <div class="col-12 p-0">
                    <div class="d-flex py-1">
                        <div style="width: 65px;"><div class="fw-bold">F. Vigencia</div></div>
                        <div class="px-1" style="width: 130px;">@ViewBag.FechaVigencia.Substring(0, 10)</div>
                    </div>

                    <div class="d-flex py-1">
                        <div style="width: 65px;"><div class="fw-bold">Paciente</div></div>
                        <div class="px-1" style="width: 190px;">@ViewBag.Paciente</div>
                        <div style="width: 65px;"><div class="fw-bold">N° H.C</div></div>
                        <div class="px-1" style="width: 70px;">@ViewBag.Historia</div>
                    </div>

                    <div class="d-flex py-1">
                        <div style="width: 65px;"><div class="fw-bold">Tipo Plan</div></div>
                        <div class="px-1" style="width: 100px;">@ViewBag.TipoPlan</div>
                        <div style="width: 35px;"><div class="fw-bold">Edad</div></div>
                        <div class="px-1" style="width: 65px;">@ViewBag.Edad</div>
                        <div style="width: 60px;"><div class="fw-bold">N° Cuenta</div></div>
                        <div class="px-1" style="width: 65px;">@ViewBag.Cuenta</div>
                    </div>

                    <div class="d-flex py-1">
                        <div style="width: 65px;"><div class="fw-bold">Tipo Serv.</div></div>
                        <div class="px-1" style="width: 130px;">@ViewBag.TipoServicio</div>
                        <div style="width: 65px;"><div class="fw-bold">Consultorio</div></div>
                        <div class="px-1" style="width: 130px;">@ViewBag.Consultorio</div>
                    </div>
                </div>
            </div>

            
            <hr class="my-2" />
            <div class="">
                <span class="fw-bold pe-1">Diagnósticos</span>
                <table class="table table-bordered mt-1 w-100">
                    <thead>
                        <tr>
                            <th scope="col" style="width: 60px;">CIE 10</th>
                            <th scope="col">Descripción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (ViewBag.Diagnosticos != null)
                        {
                            @foreach (System.Data.DataRow row in ViewBag.Diagnosticos.Rows)
                            {
                                <tr>
                                    <td>@row["codigoCIE10"]</td>
                                    <td>@row["descripcion"]</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <hr class="my-2" />
            <div class="">
                <table class="table table-bordered mt-1 w-100">
                    <thead>
                        <tr>
                            <th scope="col">Cod.</th>
                            <th scope="col">Concepto</th>
                            <th scope="col" style="width: 50px;">Cant.</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (ViewBag.DetalleReceta != null)
                        {
                            @foreach (System.Data.DataRow row in ViewBag.DetalleReceta.Rows)
                            {
                                <tr>
                                    <td>@row["CodigoProducto"]</td>
                                    <td>@row["NombreProducto"]</td>
                                    <td>@row["CantidadPedida"]</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            @*MGAMERO*@

            @if (!string.IsNullOrEmpty(ViewBag.otrosMedicamentos as string))
            {
                <hr class="my-2" />
                <div>
                    <table class="table table-bordered mt-1 w-100">
                        <thead>
                            <tr>
                                <th scope="col">Otros Medicamentos</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>
                                    @Html.Raw((ViewBag.otrosMedicamentos as string)?.Replace("\r\n", "<br />").Replace("\n", "<br />"))
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            }

            @*MGAMERO*@
                    
            <div class="row mt-3" style="height: 80px;">
                <div class="col-4 position-relative">
                    @if (ViewBag.CodigoQR != null)
                    {
                        <img class="qr-code" src="@String.Format("data:image/png;base64,{0}", Convert.ToBase64String(ViewBag.CodigoQR))" />
                    }
                </div>
                <div class="col-8 text-center">
                    <div class="fw-bold p-1 border-top border-secondary mt-5">@ViewBag.Medico</div>
                </div>
            </div>

            @*MGAMERO*@

            <hr class="my-2" />

            <div class="row">
                <div class="col-12">
                    <div class="font-sm">USUARIO: @ViewBag.Usuario</div>
                    <div class="font-sm">FECHA CREACIÓN: @ViewBag.FechaCreacion</div>
                </div>
            </div>

            <div style="line-height: 10px;font-size: 8px !important;text-align: justify;" class="mt-2">
                Esta es una copia auténtica imprimible de un documento electrónico almacenado en <b class="">@ViewBag.NombreInstitucion</b>,
                aplicando lo dispuesto por el <b class="">Art. 25 de D.S. 070-2013-PCM</b> y la Tercera Disposición Complementaria Final del <b class="">D.S. 026-2016-PCM</b>.
                Su autenticidad e integridad pueden ser contrastadas a través de la siguiente dirección web: <b class="text-primary">https://verifica.gob.pe/verifica</b>
            </div>
        </div>

        @*==================SEGUNDA PARTE====================================*@
        <div class="col-6 position-relative px-1">
            <div class="position-absolute" style="width: 60px; left:0px;">
                <img src="~/images/Logo.png" class="w-100" />
            </div>
            
            <div class="text-center">
                <div class=""><span class="fw-bold">@ViewBag.NombreInstitucion</span></div>
                <div class=""><span class="fw-bold">@ViewBag.DireccionInstitucion</span></div>
                <div class=""><span class="fw-bold">Telefono: @ViewBag.TelefonoInstitucion</span></div>
                <div class=" my-2"><span class="fw-bold font-lg">RECETA MÉDICA</span></div>
            </div>

            <div class="text-center" style="margin-left: auto; width: 80px; right:20px; top: 40px;">
                <div class="fw-bold font-md border border-secondary w-100" style="padding:2px;">@ViewBag.TituloNro</div>
                <div class="font-lg border border-secondary w-100" style="padding:2px;">@ViewBag.NroReceta</div>
            </div>

            <div class="row m-0">
                <div class="col-12 p-0">
                    <div class="d-flex py-1">
                        <div style="width: 65px;"><div class="fw-bold">F. Vigencia</div></div>
                        <div class="px-1" style="width: 130px;">@ViewBag.FechaVigencia.Substring(0, 10)</div>
                    </div>

                    <div class="d-flex py-1">
                        <div style="width: 65px;"><div class="fw-bold">Paciente</div></div>
                        <div class="px-1" style="width: 190px;">@ViewBag.Paciente</div>
                    </div>


                </div>
            </div>

            <hr class="my-2" />

            <div class="mt-3">
                <div class="fw-bold pe-1  text-center">INDICACIONES</div>
                <table class="table table-bordered mt-1 w-100">
                    <thead>
                        <tr>
                            <th scope="col">Concepto</th>
                            <th scope="col" style="width: 50px;">Dosis</th>
                            <th scope="col" style="width: 50px;">Vias</th>
                            @*<th scope="col" style="width: 70px;">Frecuencia</th>*@
                        </tr>
                    </thead>
                    <tbody>
                        @if (ViewBag.DetalleReceta != null)
                        {
                            @foreach (System.Data.DataRow row in ViewBag.DetalleReceta.Rows)
                            {
                                <tr>
                                    <td>@row["Producto"]<br /><span class="fw-bold">Frecuencia: </span>@row["observaciones"]</td>
                                    <td>@row["dosis"]</td>
                                    <td>@row["vias"]</td>
                                    @*<td>@row["observaciones"]</td>*@
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            
            @*RMOREANO*@

            @if (!string.IsNullOrEmpty(ViewBag.otrosMedicamentos as string))
            {
                <hr class="my-2" />
                <div>
                    <table class="table table-bordered mt-1 w-100">
                        <thead>
                            <tr>
                                <th scope="col">Otros Medicamentos</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>
                                    @Html.Raw((ViewBag.otrosMedicamentos as string)?.Replace("\r\n", "<br />").Replace("\n", "<br />"))
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            }

            @*RMOREANO*@
            <div class="row mt-3" style="height: 80px;">
                <div class="col-4 position-relative">
                    @if (ViewBag.CodigoQR != null)
                    {
                        <img class="qr-code" src="@String.Format("data:image/png;base64,{0}", Convert.ToBase64String(ViewBag.CodigoQR))" />
                    }
                </div>
                <div class="col-8 text-center">
                    <div class="fw-bold p-1 border-top border-secondary mt-5">@ViewBag.Medico</div>
                </div>
            </div>

            <div style="line-height: 10px;font-size: 8px !important;text-align: justify;" class="mt-2">
                Esta es una copia auténtica imprimible de un documento electrónico almacenado en <b class="">@ViewBag.NombreInstitucion</b>,
                aplicando lo dispuesto por el <b class="">Art. 25 de D.S. 070-2013-PCM</b> y la Tercera Disposición Complementaria Final del <b class="">D.S. 026-2016-PCM</b>.
                Su autenticidad e integridad pueden ser contrastadas a través de la siguiente dirección web: <b class="text-primary">https://mgp.gob.pe/verifica</b>
            </div>
        </div>

    </div>

    

