    <script src="https://apps.firmaperu.gob.pe/web/clienteweb/firmaperu.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/lib/addComponent.js"></script>
    <script type="text/javascript" src="~/AdmiRE/js/components.js"></script>
    <script type="text/javascript" src="~/js/Comun/FirmaDigitalFirmaPeru.js" asp-append-version="true"></script>
    <div id="addComponent" style="display: none"></div>

    <script>
        $(document).ready(function () {
            //let evento = null;
