@*
    Pagina que se encarga de levantar el servicio de Firma Digital
*@
@{
    Layout = null;
}

<html>
<head>
    <meta charset="utf-8" />
    <title>Servicio Firma Digital</title>
    <link type="text/css" rel="stylesheet" href="~/BootstrapV5.1.3/bootstrap.min.css" />

    <style>
        .bit4id-signReq, .bit4-link, #btnFirmar, #bit4id-status {
            display: none;
        }
    </style>
</head>

<body style="background-color: #e0edf5;">
    <div class="row mx-auto ">
        <div class="col-12">
            <div class="card shadow-lg bg-body rounded mx-auto mt-3" style="border: 1px solid #3f51b5;">
                <div class="card-header h5">
                    <span>Servicio Firma Digital Firma Peru</span>
                    <img src="~/images/icon_sign.png" class="" style="width: 30px; float:right; " alt="Cargando Servicio Firma Digital">
                </div>
                <div class="card-body" style="background: aliceblue;">
                    <div class="row">
                        <div class="col-sm-5">
                            <div class="text-center mb-3">
                                <img src="~/images/loading_gif.gif" class="card-img-top" style="max-width: 90px;" alt="Cargando Servicio Firma Digital"><br />
                                <small class="text-secondary" id="EstadoServicio">Iniciando servicio ...</small>
                            </div>
                        </div>
                        <div class="col-sm-7">
                            <p class="card-text" style="text-align: justify;">
                                Por favor, espere. No cierre esta ventana mientras el servicio de firma digital está en ejecución. La ventana actual se cerrará automáticamente una vez que la firma del documento haya finalizado.
                            </p>
                        </div>
                    </div>
                                        
                    
                </div>
            </div>
        </div>
    </div>


    @*<div class="bit4id-signReq" style="display: none;">
        <div class="bit4id-document">@ViewBag.Document</div>
        <div class="bit4id-documentName">@ViewBag.DocumentName</div>
        <div class="bit4id-documentID">@ViewBag.DocumentID</div>
        <div class="bit4id-image">@ViewBag.Image</div>    
    </div>*@

    <div id="nroFirma" style="display: none;">@ViewBag.IdFirma</div>
    <div id="codigoFirma" style="display: none;">@ViewBag.CodigoFirma</div>
    <div id="parametroFirma" style="display: none;">@ViewBag.ParametroFirma</div>
    <div id="urlInvoker" style="display: none;">@ViewBag.UrlInvoker</div>
    <script id="pdfsJson" type="application/json">@Html.Raw(ViewBag.PdfsJson ?? "[]")</script>
    <script id="firmaParamJson" type="application/json">@Html.Raw(ViewBag.FirmaParamJson ?? "{}")</script>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    @* ==============INTEGRACION FIRMA DIGITAL - FIRMA PERU================== *@
    <script type="text/javascript">
        var finFirmaDigital = 0;
      // <!-- //<![CDATA] -->
      // <!-- Variables y funciones necesarias para el funcionamiento de firma peru -->
      var jqFirmaPeru = jQuery.noConflict(true);

      function signatureInit() {
          $('#EstadoServicio').text("Iniciando servicio ...");

        // Aqui se puede poner un preload       
        //alert("PROCESO INICIADO");       
        //var container = document.getElementById("container");
        //container.innerHTML = "<div class='text-center'><div class='spinner-border' role='status'><span class='sr-only'>oo</span> </div> </div>;";
      }

