
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Hoja de Filiación</title>    
    <link type="text/css" rel="stylesheet" href="@ViewBag.IpServer/BootstrapV5.1.3/bootstrap.min.css" />
    <link type="text/css" rel="stylesheet" href="@ViewBag.IpServer/BootstrapV5.1.3/font.roboto.css">
    <style>
         body {
            font-size: 10px;
            color: black !important;
            /* font-family: 'Roboto', sans-serif; */
            font-family: "Gill Sans Extrabold", Helvetica, sans-serif;
            letter-spacing: 0.4px;
        }

        .border-top {
            border-color: #535353 !important;
        }

        td {
            font-weight: normal !important;
        }
        
       /*  td, th {
            padding: 0.25rem !important;
        } */
