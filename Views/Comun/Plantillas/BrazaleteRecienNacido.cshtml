
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Brazalete Recien Nacido</title>

    <style type="text/css">

        body {
            font-size: 10px;
            color: black !important;
            font-family: helvetica;
            letter-spacing: 0.4px;
            font-weight: 900 !important;
        }

        td, th {
            padding: 0.25rem !important;
        }

        .font-sm {
            font-size: 8px;
        }

        .font-md {
            font-size: 11px;
        }

        .font-lg {
            font-size: 12px;
        }

        .w-100 {
            width: 100%;
        }

        .table {
            border-color: #607d8b !important;
        }

        .break-word {
            word-wrap: break-word;
        }
        /*=====================MI CSS=======================*/
        .d-flex {
            display: flex !important;
        }

        .position-absolute {
            position: absolute;
        }

        .position-relative {
            position: relative;
        }

        .border {
            border: 1px solid #dee2e6 !important;
        }

        .border-secondary {
            border-color: #6c757d !important;
        }

        .w-100 {
            width: 100% !important;
        }

        .my-2 {
            margin-top: 0.5rem !important;
            margin-bottom: 0.5rem !important;
        }

        .mt-2 {
            margin-top: 0.5rem !important;
        }

        .mt-3 {
            margin-top: 0.75rem !important;
        }

        .p-1 {
            padding: 0.25rem !important;
        }

        .mx-auto {
            margin-right: auto !important;
            margin-left: auto !important;
        }

        .mr-auto {
            margin-right: auto !important;
        }

        .fw-bold {
            font-weight: 700 !important;
        }

        .text-center {
            text-align: center;
        }

        .text-left {
            text-align: left;
        }

        .text-right {
            text-align: right;
        }

        .table {
            caption-side: bottom;
            border-collapse: collapse;
        }

        .table-bordered {
            border: solid 1px #4c4c4c;
        }

            .table-bordered td, .table-bordered th {
                border: solid 1px #4c4c4c;
            }

        td, th {
            padding: 0 !important;
        }

        .py-fila {
            padding-bottom: 2px;
            padding-top: 2px;
        }

        /*=================================================*/
        .pulsera {
            margin-left: -45px;
            margin-top: 20px;
        }

        .celda-custom {
            margin: 0 !important;
        }

        .qr-code {
            width: 100%;
        }

    </style>
</head>


<body style="background: white; width:390px;  position:relative; /* border: 1px solid cornflowerblue; */">

    <div class="pulsera">
        <div class="d-flex">
            <div style="width: 60px; padding: 5px;">
                <img src="@ViewBag.IpServer/resources/images/LogoBW.jpg" width="100%" />
            </div>
            <div style="width:200px;">
                <h3 class="celda-custom py-fila">@ViewBag.Apellidos</h3>
                <h3 class="celda-custom py-fila">@ViewBag.Nombres</h3>
                <div class="d-flex py-fila">
                    <h4 class="celda-custom" style="width:180px;">F.N: @ViewBag.FechaNacimiento H.N: @ViewBag.HoraNacimiento</h4>
                    @if (ViewBag.Gemelar != "")
                    {
                        <h4 class="celda-custom" >@ViewBag.Gemelar</h4>
                    }                    
                </div>
                <div class="d-flex py-fila">     
                    <h4 class="celda-custom" style="width:110px;">SEXO: @ViewBag.Sexo</h4>
                    @*
                    @if (ViewBag.TipoDocumento != "" && ViewBag.NroDocumento != "")
                    {
                        <h4 class="celda-custom" style="width:120px; background:red;">@ViewBag.TipoDocumento @ViewBag.NroDocumento</h4>
                    }
                    *@
                    @if (ViewBag.NroHistoria != "0")
                    {
                        <h4 class="celda-custom" >HC: @ViewBag.NroHistoria</h4>
                    }
                </div>
                
                
            </div>
            <div style="width: 70px; ">
                @if (ViewBag.CodigoQRHC != null)
                {
                    <img class="qr-code" src="@String.Format("data:image/png;base64,{0}", Convert.ToBase64String(ViewBag.CodigoQRHC))" />
                }
            </div>
        </div>
    </div>


</body>



</html>