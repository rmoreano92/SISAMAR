@*<body style="background: white; width:793px; height:1145px; position:relative; /*border: 1px solid red;*/" class="pt-2 m-0">*@
<body style="background: transparent; width:698px; height:1015px; position:relative;">

    @if (ViewBag.CodigoQR != null)
    {
        <img class="qr-code" src="@String.Format("data:image/png;base64,{0}", Convert.ToBase64String(ViewBag.CodigoQR))" />
    }

    <img class="position-absolute" src="@ViewBag.ServerFiles/resources/images/Logo.png" style="height: 50px; top:-20px;" />

    <div class="position-absolute text-right" style="right:80px; top:10px; font-size: 7px;">
        <span>@ViewBag.FechaImpresion</span><br />
        <span>@ViewBag.Usuario</span>
    </div>

    @* <div class="w-100 h-100 pb-5">

    </div> *@

    <div id="cajaTitulo">
        <p style="" class="fw-bold m-0">EPICRISIS</p>
        <small></small>
        @* <small class="fw-bold" style="color:lightgray">FN-000</small> *@
    </div>

    <div class="mb-2">
        <table>
            <tbody>
                <tr>
                    <th align="left" width="140" style="text-align: left;">Nro Historia</th>
                    <td width="200">@ViewBag.NroHistoriaClinica</td>
                    <th align="left" width="140" style="text-align: left;">Nro Cuenta</th>
                    <td width="200">@ViewBag.NroCuenta @ViewBag.FuenteFinanciamiento</td>
                </tr>
                <tr>
                    <th align="left" width="140" style="text-align: left;">Apellidos y Nombres</th>
                    <td colspan="3">@ViewBag.Paciente</td>
                </tr>
                <tr>
                    <th align="left" width="140" style="text-align: left;">Fecha</th>
                    <td width="200">@ViewBag.FechaEvaluacion</td>
                    <th align="left" width="140" style="text-align: left;">Edad</th>
                    <td width="200">@ViewBag.Edad</td>
                </tr>
                <tr>
                    <th align="left" width="140" style="text-align: left;">Hora</th>
                    <td width="200">@ViewBag.HoraEvaluacion</td>
                    <th align="left" width="140" style="text-align: left;">Fecha Nacimiento</th>
                    <td width="200">@ViewBag.FechaNacimiento @ViewBag.HoraNacimiento</td>
                </tr>
                <tr>
                    <th align="left" width="140" style="text-align: left;">Consultorio Médico</th>
                    <td width="200">@ViewBag.Servicio</td>
                    <th align="left" width="140" style="text-align: left;">Sexo</th>
                    <td width="200">@ViewBag.Sexo</td>
                </tr>
                <tr>
                    <th align="left" width="140" style="text-align: left;">Médico</th>
                    <td colspan="3">@ViewBag.Medico</td>
                </tr>
                <tr>
                    <th align="left" width="140" style="text-align: left;">Telefono</th>
                    <td colspan="3">@ViewBag.Telefono</td>
                </tr>
                <tr>
                    <th align="left" width="140" style="text-align: left;">Dirección</th>
                    <td colspan="3">@ViewBag.Direccion</td>
                </tr>
                <tr>
                    <th align="left" width="140" style="text-align: left;">Departamento</th>
                    <td width="200">@ViewBag.Departamento</td>
                    <th align="left" width="140" style="text-align: left;">Provincia</th>
                    <td width="200">@ViewBag.Provincia</td>
                </tr>
                <tr>
                    <th align="left" width="140" style="text-align: left;">Distrito</th>
                    <td width="200">@ViewBag.Distrito</td>
                    <th align="left" width="140" style="text-align: left;">Centro Poblado</th>
                    <td width="200">@ViewBag.CentroPoblado</td>
                </tr>
                <tr>
                    <th align="left" width="140" style="text-align: left;">Acompañante</th>
                    <td width="200">@ViewBag.Acompañante</td>
                    <th align="left" width="140" style="text-align: left;">Teléfono Acompañante</th>
                    <td width="200">@ViewBag.TelefonoAcomp</td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="d-flex mb-1" style="font-size: 10px !important;">
        <div>
            <table class="table m-0 mb-1 me-1" style="width: 300px;">
                <tbody>
                    <tr>
                        <th class="text-right fw-bold px-1" style="width:200px;">CÓDIGO ESTABLECIMIENTO</th>
                        <td class="border border-secondary px-1">@ViewBag.CodigoEstablecimiento</td>
                    </tr>
                </tbody>
