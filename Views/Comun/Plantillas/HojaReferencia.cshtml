<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Hoja de Referencia</title>
    @*<link type="text/css" rel="stylesheet" href="~/AdmiRE/css/components.css" />
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/css/custom.css" />
    <link type="text/css" rel="stylesheet" href="~/css/util.css" />
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/select2/css/select2.min.css" />
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/datatables/css/scroller.bootstrap.min.css" />
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/datatables/css/colReorder.bootstrap.min.css" />
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/datatables/css/dataTables.bootstrap.min.css" />
*@
    <style>
        @*==========================CSS BOOTSTRAP====================================*@
        *, ::after, ::before {
            box-sizing: border-box;
        }

        body {
            font-size: 8px;
            color: black !important;
            font-family: helvetica;
            letter-spacing: 0.4px;
            line-height: 8px;
        }
        .white-space {
            white-space: pre-line;
            line-height: 11px !important;
        }
        .position-absolute {
            position: absolute;
        }

        .position-relative {
            position: relative;
        }
        @*==========================================================================*@

        li {
            /*font-size: 15px;*/
        }

        .d-flex {
            display: -webkit-box !important;
            display: -ms-flexbox !important;
            display: flex !important;
        }
        .datos-generales td{
            padding-left:10px;
            padding-right:10px;
        }

        .mr-auto, .mx-auto {
            margin-right: auto !important;
        }

        .ml-auto, .mx-auto {
            margin-left: auto !important;
        }

        .datos {
            /*font-size: 20px;*/
            font-weight: bold;
        }

        table, th, td {
            border: 1px solid black;
            border-collapse: collapse;
            padding-top: 3px;
            padding-bottom: 3px;
        }

        #fecha th {
            padding-left: 10px;
            padding-right: 10px;
            text-align: center;
            background-color: #ebe9e9;
            /*line-height: 10px;*/
        }

        #fecha td {
            padding: 0px 10px;
            text-align: center;
            /*line-height: 10px;*/
        }

        .titulo {
            background-color: #ebe9e9;
            color: black;
            margin-bottom: 10px;
            width: 100%;
            /*line-height: 15px;*/
        }

        .tabla1 td, .tabla1 th {
            padding-left: 5px;
            padding-right: 5px;
            /*font-size: 9px;*/
        }

        .tabla2 td, .tabla2 th {
            padding-left: 5px;
            padding-right: 5px;
            font-size: 7px;
        }

        .miCheckBox {
            padding: 0;
            margin: 0;
            /* font-size: 30px; */
            /*width: 17px;
            height: 17px;*/
            vertical-align: middle;
            text-align: center;
        }

        #cajaTitulo {
            width: 40%;
            border: 1px solid black;
            text-align: center;
            padding: 10px;
            font-weight: bold;
            margin-left: auto;
            margin-right: auto;
            /* box-shadow: 5px 5px #8d8d8d;*/
            margin-bottom: 25px;
            font-size: 11px;
        }
        
        .white-space {
            white-space: pre-line;
            line-height: 11px !important;
        }

        .qr-code {
            position: absolute;
            width: 70px;
            right: 0;
            top: -15px;
        }
    </style>
</head>


@*<body style="background: white; width: 793px; height: 1145px; position: relative; padding-top: 30px; /*border: 1px solid red;*/">*@
<body style="background: white; width:698px; height:1015px; position:relative; /*border: 1px solid red;*/">
    
    @if (ViewBag.CodigoQR != null)
    {
        <img class="qr-code" src="@String.Format("data:image/png;base64,{0}", Convert.ToBase64String(ViewBag.CodigoQR))" />
    }

    <img src="~/images/logo-minsa.png" style="width: 120px; position:absolute; top:0px;" />
        
    <div style="" id="cajaTitulo">
        <p style="font-weight: bold; margin:0;" class="">HOJA DE REFERENCIA INSTITUCIONAL</p>
    </div>

   
    <table class="titulo">
        <tbody>
            <tr>
                <th scope="row" rowspan="2" class="text-left" style="padding-left: 10px;">1.- DATOS GENERALES</th>
            </tr>
        </tbody>
    </table>

    

    <div class="d-flex" style="margin-bottom: 3px;">
        <div style="padding-right: 3px; width: 20%;">
            <table class="tabla1" style="width: 100%;">
                <tbody>
                    <tr>
                        <th scope="row" rowspan="2" style="background-color: #ebe9e9;">FECHA</th>
                        <td class="text-center">Día</td>
                        <td class="text-center">Mes</td>
                        <td class="text-center">Año</td>
                    </tr>
                    <tr>
                        <td class="text-center">@ViewBag.Dia</td>
                        <td class="text-center">@ViewBag.Mes</td>
                        <td class="text-center">@ViewBag.Anio</td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div style="padding-right: 3px; width: 10%;">
            <table class="tabla1" style="width: 100%; height:100%;">
                <tbody>
                    <tr>
                        <th scope="row" rowspan="2" style="background-color: #ebe9e9;">HORA</th>
                        <td rowspan="2" class="text-center">@ViewBag.Hora</td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div style="padding-right: 3px; width: 35%;">
            <table class="tabla1" style="width: 100%;">
                <tbody>
                    <tr>
                        <th scope="row" style="text-align: left;width: 140px;">ENTIDAD ASEGURADORA</th>
                        <td style="text-align: left;">@ViewBag.Financiador</td>
                    </tr>
                    <tr>
                        <th scope="row" style="text-align: left;width: 140px">CÓDIGO DEL ASEGURADO</th>
                        <td style="text-align: left;">@ViewBag.NroAfiliacion</td>
                    </tr>

                </tbody>
            </table>
        </div>
        <div style="width: 35%;">
            <table class="tabla1" style="width: 100%;">
                <tbody>
                    <tr>
                        <th scope="row" style="text-align: left;width: 140px;">NRO. HOJA DE REFERENCIA</th>
                        <td style="text-align: left;font-weight: bold;">@ViewBag.NroHoja</td>
                    </tr>
                    <tr>
                        <th scope="row" style="text-align: left;width: 140px;">NRO. HISTORIA CLÍNICA</th>
                        <td style="text-align: left;">@ViewBag.NroHistoria</td>
                    </tr>

                </tbody>
            </table>
        </div>
    </div>

    <div class="d-flex" style="margin-bottom: 3px;">
        <table style="margin-bottom: 3px; width: 50%;" class="tabla1">
            <tbody>
                <tr>
                    <th scope="row" style="background-color: #ebe9e9;">Código IPRESS</th>
                    <th scope="row" style="background-color: #ebe9e9;">ESTABLECIMIENTO DE SALUD ORIGEN</th>
                </tr>
                <tr>
                    <td>@ViewBag.IpressOrigen</td>
                    <td>@ViewBag.Origen</td>
                </tr>
                <tr>
                    <th scope="row" colspan="2" style="background-color: #ebe9e9;">SERVICIO ORIGEN (UPS)</th>
                </tr>
                <tr>
                    <td colspan="2">@ViewBag.UpsOrigen</td>
                </tr>
            </tbody>
        </table>
        <table style="margin-bottom: 3px; width: 50%;" class="tabla1">
            <tbody>
                <tr>
                    <th scope="row" style="background-color: #ebe9e9;">Código IPRESS</th>
                    <th scope="row" style="background-color: #ebe9e9;">ESTABLECIMIENTO DE SALUD DESTINO</th>
                </tr>
                <tr>
                    <td>@ViewBag.IpressDestino</td>
                    <td>@ViewBag.Destino</td>
                </tr>
                <tr>
                    <th scope="row" colspan="2" style="background-color: #ebe9e9;">SERVICIO DESTINO (UPS)</th>
                </tr>
                <tr>
                    <td colspan="2">@ViewBag.UpsDestino</td>
                </tr>
            </tbody>
        </table>
    </div>

    <table class="titulo">
        <tbody>
            <tr>
                <th scope="row" rowspan="2" class="text-left" style="padding-left: 10px;">2.- IDENTIFICACIÓN DEL PACIENTE</th>
            </tr>
        </tbody>
    </table>

   
    <table style="width: 100%;" class="tabla1">
        <tbody>
            <tr>
                <td scope="row" rowspan="2" style="width: 200px;">
                    @ViewBag.TipoDocumento
                    <br>
                    @ViewBag.NroDocumento
                </td>
                <th scope="row" style="max-width: 100px; text-align:center;">NOMBRE(S)</th>
                <th scope="row" style="max-width: 100px; text-align:center;">APELLIDO PATERNO</th>
                <th scope="row" style="max-width: 100px; text-align:center;">APELLIDO MATERNO</th>
            </tr>
            <tr>
                <td>@ViewBag.Nombres</td>
                <td>@ViewBag.ApPaterno</td>
                <td>@ViewBag.ApMaterno</td>
            </tr>
        </tbody>
    </table>
    <table style="width: 100%;" class="tabla1">
        <tbody>
            <tr>
                <th scope="row" style="max-width: 100px;">FECHA NACIMIENTO</th>
                <td>@ViewBag.FechaNacimiento</td>
                <th scope="row" style="max-width: 100px;">EDAD</th>
                <td>@ViewBag.Edad</td>
                <th scope="row" style="max-width: 100px;">SEXO</th>
                <td>@ViewBag.Sexo</td>
            </tr>
        </tbody>
    </table>
    <table style="margin-bottom: 3px; width: 100%;" class="tabla1">
        <tbody>
            <tr style="background-color: #ebe9e9;">
                <th>DIRECCIÓN</th>
                <th style="max-width: 60px;">DEPARTAMENTO</th>
                <th style="max-width: 60px;">PROVINCIA</th>
                <th style="max-width: 60px;">DISTRITO</th>
            </tr>
            <tr>
                <td>@ViewBag.Domicilio</td>
                <td>@ViewBag.Departamento</td>
                <td>@ViewBag.Provincia</td>
                <td>@ViewBag.Distrito</td>
            </tr>
        </tbody>
    </table>

    @*==================================RESUMEN HISTORIA CLINICA======================================*@
    <table class="titulo">
        <tbody>
            <tr>
                <th scope="row" rowspan="2" class="text-left" style="padding-left: 10px;">3.- RESUMEN DE HISTORIA CLÍNICA</th>
            </tr>
        </tbody>
    </table>
    <table style="width: 100%;" class="tabla1">
        <tbody>
            <tr style="">
                <th scope="row" style="width: 125px;height: 50px" class="text-center">ANAMNESIS</th>
                <td style="vertical-align: top !important;" class="white-space">@ViewBag.Anamnesis</td>
            </tr>
        </tbody>
    </table>
    <table style="width: 100%;" class="tabla1">
        <tbody>
            <tr>
                <th rowspan="2" scope="row" style="width: 125px;" class="text-center">EXÁMEN FÍSICO</th>
                <th class="text-center" style="background-color: #ebe9e9;">(T°)</th>
                <td>@ViewBag.TP</td>
                <th class="text-center" style="background-color: #ebe9e9;">(PA)</th>
                <td>@ViewBag.PA</td>
                <th class="text-center" style="background-color: #ebe9e9;">(FR)</th>
                <td>@ViewBag.FR</td>
                <th class="text-center" style="background-color: #ebe9e9;">(FC)</th>
                <td>@ViewBag.FC</td>
            </tr>
            <tr style="">
                <td colspan="8" style="vertical-align: top !important;height:40px" class="white-space">@ViewBag.ExamenFisico</td>
            </tr>
        </tbody>
    </table>
    <table style="width: 100%;" class="tabla1">
        <tbody>
            <tr>
                <th rowspan="2" scope="row" style="width: 125px;" class="text-center">EXÁMENES AUXILIARES</th>
                <th class="text-center" style="background-color: #ebe9e9;">PROCEDIMIENTOS</th>
                <th class="text-center" style="background-color: #ebe9e9;">PRUEBAS DE LABORATORIO</th>
                <th class="text-center" style="background-color: #ebe9e9;">DIAGNÓSTICOS POR IMÁGENES</th>
            </tr>
            <tr style="">
                <td style="vertical-align: top !important;height: 40px"></td>
                <td style="vertical-align: top !important;height: 40px"></td>
                <td style="vertical-align: top !important;height: 40px"></td>
            </tr>
        </tbody>
    </table>
    <table style="width: 100%;" class="tabla1">
        <tbody>
            <tr style="">
                <th scope="row" style="width: 125px;height: 50px" class="text-center">DIAGNÓSTICO</th>
                <td style="vertical-align: top !important;">
                    @{
                        int index = 1;
                    }
                    @foreach (System.Data.DataRow row in ViewBag.DxEgreso.Rows)
                    {
                        <span style="font-weight: bold;">DX</span>
                        <span style="font-weight: bold;margin: 0px 7px;">@index</span>
                        <span>@row["codigoCIEsinPto"] - @row["descripcion"]</span>
                        <span style="font-weight: bold;float:right; margin-right: 10px;">TIPO: @row["subclasDiagnostico"]</span>
                        <br />
                        index++;
                    }
                </td>
            </tr>
        </tbody>
    </table>
    <table style="margin-bottom: 3px; width: 100%;" class="tabla1">
        <tbody>
            <tr style="">
                <th scope="row" style="width: 125px;height: 50px" class="text-center">TRATAMIENTO REALIZADO</th>
                <td style="vertical-align: top !important;" class="white-space">@ViewBag.Tratamiento</td>
            </tr>
        </tbody>
    </table>

    @*==================================DATOS DE LA REFERENCIA======================================*@
    <table class="titulo">
        <tbody>
            <tr>
                <th scope="row" class="text-left" style="padding-left: 10px;">4.- DATOS DE LA REFERENCIA</th>
            </tr>
        </tbody>
    </table>
    <table style="width: 100%;" class="tabla1">
        <tbody>
            <tr>
                <th scope="row" style="width: 150px; background-color: #ebe9e9;">MOTIVO DE REFERENCIA</th>
                @*<td>@ViewBag.Motivo</td>*@
                <td>
                    @if (ViewBag.Condicion == '1') { <span>NO CAPACIDAD RESOLUTIVA (POR EL NIVEL DEL EESS)</span> }
                    @if (ViewBag.Condicion == '2') { <span>NO CAPACIDAD RESOLUTIVA POR CARECER DE DETERMINADO ESPECIALISTA</span> }
                    @if (ViewBag.Condicion == '3') { <span>NO CAPACIDAD RESOLUTIVA POR CARECER DE DETERMINADO INSUMO</span> }
                    @if (ViewBag.Condicion == '4') { <span>NO CAPACIDAD RESOLUTIVA POR NO CONTAR CON DETERMINADO SERVICIO OPERATIVO</span> }
                    @if (ViewBag.Condicion == '5') { <span>NO CAPACIDAD RESOLUTIVA POR SERVICIO EN REPARACIÓN </span> }
                    @if (ViewBag.Condicion == '6') { <span>NO CAPACIDAD RESOLUTIVA POR SERVICIO SATURADO</span> }
                    @if (ViewBag.Condicion == '7') { <span>POR SER TITULAR ESSALUD</span> }
                    @if (ViewBag.Condicion == '8') { <span>NO CAPACIDAD RESOLUTIVA POR CARECER DE DETERMINADO EQUIPO</span> }
                    @if (ViewBag.Condicion == '9') { <span>NO CAPACIDAD RESOLUTIVA POR CARECER DE DETERMINADO INFRAESTRUCTURA</span> }                    
                </td>
                <th scope="row" style="width: 325px; background-color: #ebe9e9;" class="white-space">NOTAS/OBSERVACIONES</th>
            </tr>
            <tr>
                <th scope="row" style="width: 150px; background-color: #ebe9e9;">DETALLE DEL MOTIVO</th>
                <td class="white-space">@ViewBag.DetalleMotivo</td>
                <td class="white-space">@ViewBag.Observaciones</td>
            </tr>
        </tbody>
    </table>
    <table style="width: 100%;" class="tabla1">
        <tbody>
            <tr>
                <th scope="row" style="width: 250px;">ESPECIALIDAD DEL DESTINO</th>
                <td>@ViewBag.Especialidad</td>
            </tr>
        </tbody>
    </table>
    <table style="margin-bottom: 3px; width: 100%;" class="tabla1">
        <tbody>
            <tr>
                <th style="background-color: #ebe9e9; text-align:center;">CONDICIÓN PACIENTE</th>
                <td style ="width:100px;">
                    @if (ViewBag.Condicion == 1)
                    {
                        <span style="margin: auto;"><input class="miCheckBox" type="checkbox" style="margin-right: 5px;" checked> ESTABLE</span><br /><br />
                    }
                    else
                    {
                        <span style="margin: auto;"><input class="miCheckBox" type="checkbox" style="margin-right: 5px;"> ESTABLE</span><br /><br />
                    }
                    @if (ViewBag.Condicion == 2)
                    {
                        <span style="margin: auto;"><input class="miCheckBox" type="checkbox" style="margin-right: 5px;" checked> MAL ESTADO</span><br /><br />
                    }
                    else
                    {
                        <span style="margin: auto;"><input class="miCheckBox" type="checkbox" style="margin-right: 5px;"> MAL ESTADO</span><br /><br />
                    }
                    @if (ViewBag.Condicion == 3)
                    {
                        <span style="margin: auto;"><input class="miCheckBox" type="checkbox" style="margin-right: 5px;" checked> GRAVE</span><br /><br />
                    }
                    else
                    {
                        <span style="margin: auto;"><input class="miCheckBox" type="checkbox" style="margin-right: 5px;"> GRAVE</span><br />
                    }
                </td>
                <th style="background-color: #ebe9e9; text-align:center;">TIPO DE TRANSPORTE</th>
                <td style="width:100px;">
                    @if (ViewBag.TipoTransporte == 1)
                    {
                        <span style="margin: auto;"><input class="miCheckBox" type="checkbox" style="margin-right: 5px;" checked> TERRESTRE</span><br /><br />
                    }
                    else
                    {
                        <span style="margin: auto;"><input class="miCheckBox" type="checkbox" style="margin-right: 5px;"> TERRESTRE</span><br /><br />
                    }
                    @if (ViewBag.TipoTransporte == 2)
                    {
                        <span style="margin: auto;"><input class="miCheckBox" type="checkbox" style="margin-right: 5px;" checked> AEREO</span><br /><br />
                    }
                    else
                    {
                        <span style="margin: auto;"><input class="miCheckBox" type="checkbox" style="margin-right: 5px;"> AEREO</span><br /><br />
                    }
                    @if (ViewBag.TipoTransporte == 3)
                    {
                        <span style="margin: auto;"><input class="miCheckBox" type="checkbox" style="margin-right: 5px;" checked> FLUVIAL</span><br /><br />
                    }
                    else
                    {
                        <span style="margin: auto;"><input class="miCheckBox" type="checkbox" style="margin-right: 5px;"> FLUVIAL</span><br /><br />
                    }
                    @if (ViewBag.TipoTransporte == 4)
                    {
                        <span style="margin: auto;"><input class="miCheckBox" type="checkbox" style="margin-right: 5px;" checked> MARITIMO</span><br /><br />
                    }
                    else
                    {
                        <span style="margin: auto;"><input class="miCheckBox" type="checkbox" style="margin-right: 5px;"> MARITIMO</span><br />
                    }
                </td>
                <th style="width: 150px; background-color: #ebe9e9; text-align:center;">COORDINACIÓN DE LA REFERENCIA</th>
                <td>
                    <ul class="pl-1">
                        <li style="font-size: 6px; list-style-type: none;" class="p-0">- FECHA EN QUE SERÁ ATENDIDO</li>
                        <li style="font-size: 6px; list-style-type: none;" class="p-0">- HORA EN QUE SERÁ ATENDIDO</li>
                        <li style="font-size: 6px; list-style-type: none;" class="p-0">- NOMBRE DE QUIÉN LO ATENDERÁ</li>
                        <li style="font-size: 6px; list-style-type: none;" class="p-0">- NOMBRE CON QUIÉN COORDINÓ LA ATENCIÓN (ACEPTAR)</li>
                        <li style="font-size: 6px; list-style-type: none;" class="p-0">- NOMBRE QUIÉN COORDINÓ LA REFERENCIA</li>
                    </ul>
                </td>
            </tr>
        </tbody>
    </table>
    <table style="margin-bottom: 3px; width: 100%;" class="tabla1">
        <tbody>
            <tr>
                <th scope="row" style="background-color: #ebe9e9;width:25%;" class="text-center">RESPONSABLE DE LA REF.</th>
                <th scope="row" style="background-color: #ebe9e9;width:25%;" class="text-center">RESPONSABLE DEL EESS</th>
                <th scope="row" style="background-color: #ebe9e9;width:25%;" class="text-center">PERSONAL QUE ACOMPAÑA</th>
                <th scope="row" style="background-color: #ebe9e9;width:25%;" class="text-center">PERSONAL QUE RECIBE</th>
            </tr>
            <tr>
                <th>NOMBRE(S) Y APELLIDOS</th>
                <th>NOMBRE(S) Y APELLIDOS</th>
                <th>NOMBRE(S) Y APELLIDOS</th>
                <th>NOMBRE(S) Y APELLIDOS</th>
            </tr>
            <tr>
                <td style="height:20px;">@ViewBag.Medico</td>
                <td style="height:20px;">@ViewBag.MedicoEESS</td>
                <td style="height:20px;"></td>
                <td style="height:20px;"></td>
            </tr>
            <tr>
                <th style="height:20px; text-align: left;">PROFESIÓN</th>
                <th style="height:20px; text-align: left;">PROFESIÓN</th>
                <th style="height:20px; text-align: left;">PROFESIÓN</th>
                <th style="height:20px; text-align: left;">PROFESIÓN</th>
            </tr>
            <tr>
                <td style="height:20px;">@ViewBag.ProfesionMedico</td>
                <td style="height:20px;">@ViewBag.ProfesionMedicoEESS</td>
                <td style="height:20px;"></td>
                <td style="height:20px;"></td>
            </tr>
            <tr>
                <th style="height:20px;text-align: left;">COLEGIO PROF.</th>
                <th style="height:20px;text-align: left;">COLEGIO PROF.</th>
                <th style="height:20px;text-align: left;">COLEGIO PROF.</th>
                <th style="height:20px;text-align: left;">COLEGIO PROF.</th>
            </tr>
            <tr>
                <td style="height:20px;">@ViewBag.ColegioMedico</td>
                <td style="height:20px;">@ViewBag.ColegioMedicoEESS</td>
                <td style="height:20px;"></td>
                <td style="height:20px;"></td>
            </tr>
            <tr>
                <th style="height:35px;text-align: left;">FIRMA Y SELLO</th>
                <th style="height:35px;text-align: left;">FIRMA Y SELLO</th>
                <th style="height:35px;text-align: left;">FIRMA Y SELLO</th>
                <th style="height:35px;text-align: left;">FIRMA Y SELLO</th>
            </tr>
        </tbody>
    </table>

    <table style="/*margin-bottom: 3px;*/ width: 100%;" class="tabla1 m-0">
        <tbody>
            <tr>
