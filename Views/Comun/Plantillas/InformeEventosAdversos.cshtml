                                        @if (ViewBag.EventoAdversoPrevenible == "0")
                                        {
                                            <i>X</i>
                                        }
                                    </div>
                                    <div class="item-label">NO</div>
                                </div>
                            </div>
                        </div>

                    </div>
                    <div class="card-block">
                        <div style="min-height: 35px;">
                            @ViewBag.ComoPrevenirEventoAdverso
                        </div>
                    </div>
                </div>

                <div class="card mb-2 border-secondary">
                    <div class="card-header border-secondary">
                        DIAGNÓSTICOS
                    </div>
                    <div class="card-block">
                        <div style="min-height: 50px;">
                            @{
                                int index = 1;
                            }
                            @foreach (System.Data.DataRow row in ViewBag.Dx.Rows)
                            {
                            <span style="font-weight: bold;">DX @index</span>
                                <span>@row["codigoCIE10"] - @row["descripcion"] <b>(@row["tipoDiagnostico"])</b></span>
                                <br />
                                index++;
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class=" ms-auto mt-2 pt-4 mb-2" style="width: 250px;">
            <div class="border-top border-secondary text-center p-1">
                SELLO Y FIRMA DEL RESPONSABLE<br />
                <b>@ViewBag.Medico</b>
            </div>
        </div>

    </div>


</body>



</html>