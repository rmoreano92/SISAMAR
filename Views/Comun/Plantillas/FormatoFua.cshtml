        @*======================DIAGNOSTICOS===================================*@
        <div class="col-12 mt-1">
            <div class="card ">
                <div class="card-header font-titulo p-0  text-center bg-titulo">DIAGNÓSTICOS</div>
                <div class="card-body p-0">
                    <table class="w-100 text-center">
                        <tr>
                            <th rowspan="2" class="bg-titulo" width="20px">N°</th>
                            <th rowspan="2" class="bg-titulo">DESCRIPCIÓN</th>
                            <th colspan="4" class="bg-titulo">INGRESO</th>
                            <th colspan="3" class="bg-titulo">EGRESO</th>
                        </tr>
                        <tr>
                            <th class="bg-titulo" width="40px">P</th>
                            <th class="bg-titulo" width="40px">D</th>
                            <th class="bg-titulo" width="40px">R</th>
                            <th class="bg-titulo" width="70px">CIE-10</th>
                            <th class="bg-titulo" width="40px">D</th>
                            <th class="bg-titulo" width="40px">R</th>
                            <th class="bg-titulo" width="70px">CIE-10</th>
                        </tr>
                        @{
                            int index = 0;
                            string tipoDxIE = "";
                            string tipoDx = "";
                        }
                        @foreach (System.Data.DataRow row in ViewBag.Diagnosticos.Rows)
                        {
                            tipoDxIE = row["DxTipoIE"].ToString();
                            tipoDx = row["DxTipoDPR"].ToString();
                            index++;
                            <tr>
                                <td class="font-input2">@index</td>
                                <td class="text-left font-input2">@row["DxNombre"]</td>
                                <td class="font-input2">@if(tipoDxIE == "I" && tipoDx == "P") { <span>X</span> }</td>
                                <td class="font-input2">@if(tipoDxIE == "I" && tipoDx == "D") { <span>X</span> }</td>
                                <td class="font-input2">@if(tipoDxIE == "I" && tipoDx == "R") { <span>X</span> }</td>
                                <td class="font-input2">@if(tipoDxIE == "I") { <span>@row["DxCodigo"]</span> }</td>
                                <td class="font-input2">@if(tipoDxIE == "E" && tipoDx == "D") { <span>X</span> }</td>
                                <td class="font-input2">@if(tipoDxIE == "E" && tipoDx == "R") { <span>X</span> }</td>
                                <td class="font-input2">@if(tipoDxIE == "E") { <span>@row["DxCodigo"]</span> }</td>
                            </tr>                                                        
                        }
                        @while (index <= 5)
                        {
                            <tr class="hd">
                                <td>@index</td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                            </tr>
                            index++;
                        }
                    </table>
                </div>
            </div>
        </div>

