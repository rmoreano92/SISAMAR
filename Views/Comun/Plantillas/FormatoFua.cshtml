@*<body style="background: white; width: 793px; height:1145px; position: relative; padding-top: 35px; /*border: 1px solid red;*/">*@
<body style="background: white; width:698px; height:900px; position:relative; /*border: 1px solid red;*/">
    @*<body style="background: white">*@
    <img src="~/images/LogoSeguroIntegralSalud.png" style="width: 210px; position:absolute; top:35px; left: 1rem;" />
    <div class="position-absolute text-end " style="right:75px; top:30px; font-size: 8px;">
        <span>F.Emisión: @ViewBag.FechaEmision</span><br />
        <span>Cta: @ViewBag.NroCuenta</span>
    </div>
    
    @if (ViewBag.CodigoQR != null)
    {
        <img class="qr-code" src="@String.Format("data:image/png;base64,{0}", Convert.ToBase64String(ViewBag.CodigoQR))" />
    }

    <h6 id="" class="text-center" style="color: black; margin-top:25px;">ANEXO 1</h6>

    <div class="m-0">
        @*======================FORMATO UNICO DE ATENCION FUA===================================*@
        <div class="col-12">
            <div class="card ">
                <div class="card-header font-cabecera p-0  text-center" >FORMATO ÚNICO DE ATENCIÓN - FUA</div>
                <div class="card-body p-0" >
                    <div class="row m-0 p-0">
                        <div class="col-3 m-0 p-0"></div>
                        <div class="col-3 m-0 p-0">
                            <table class="text-center w-100">
                                <tr class="bg-titulo hd">
                                    <th colspan="3">NÚMERO DE FORMATO</th>
                                </tr>
                                <tr>
                                    <td style="font-size: 11px; font-weight: bold;" class="p-1">@ViewBag.FuaDisa</td>
                                    <td style="font-size: 11px; font-weight: bold;" class="p-1">@ViewBag.FuaLote</td>
                                    <td style="font-size: 11px; font-weight: bold;" class="p-1">@ViewBag.FuaNumero</td>
                                </tr>
                            </table>
                        </div>
                        <div class="col-1 m-0 p-0"></div>
                        <div class="col-5 m-0 p-0">
                            <table class="text-center w-100">
                                <tr class="bg-titulo">
                                    <th colspan="4">INSTITUCIÓN EDUCATIVA</th>
                                    <th colspan="2">CÓDIGO</th>
                                </tr>
                                <tr>
                                    <td colspan="4">@ViewBag.FuacolegioCodigo</td>
                                    <td class="hd">@ViewBag.FuacolegioCodigo</td>
                                    <td class="hd"></td>
                                </tr>
                                <tr>
                                    <td style="background-color: #fff; width: 60px;" class="hd"></td>
                                    <td style="width: 60px;"></td>
