@section Css
    {
    <!-- plugin css -->
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/chosen/css/chosen.css" />
    
}

<header class="head">
    <div class="main-bar row">
        <div class="col-lg-6 col-md-4 col-sm-4">
            <h4 class="nav_top_align">
                <i class="fa fa-hospital-user"></i>
                @ViewBag.Modulo
            </h4>
        </div>
        <div class="col-lg-6 col-md-8 col-sm-8">
            <ol class="breadcrumb float-xs-right nav_breadcrumb_top_align">
                <li class="breadcrumb-item">
                    <a href="index1.html">
                        <i class="fa fa-home" data-pack="default" data-tags=""></i> Home
                    </a>
                </li>
                <li class="breadcrumb-item">
                    <a href="#">@ViewBag.Area</a>
                </li>
                <li class="breadcrumb-item active">@ViewBag.Modulo</li>
            </ol>
        </div>
    </div>
</header>

<div class="row m-0">
    <div class="col-sm-12">
        <ul class="nav nav-tabs" id="myTab" role="tablist">
            <li class="nav-item" role="presentation">
                <a href="#" class="nav-link nav-link-custom active" id="TabBusqueda" data-toggle="tab" data-target="#TabPanelBusqueda" role="tab" aria-controls="TabPanelBusqueda" aria-selected="true">Busqueda</a>
            </li>
        </ul>
        <div class="tab-content border pt-1 pl-1 pr-1" id="myTabContent">
            <div class="tab-pane fade active in" id="TabPanelBusqueda" role="tabpanel" aria-labelledby="TabBusqueda">
                <div class="row">
                    <div class="col-lg-12 pb-1">
                        <div class="card">
                            <div class="card-block">                                
                                <div class="row">                                    
                                    <div class="col-md-3">
                                        <div class="form-group m-0">
                                            <label for="cboServicio" class="form-control-label">Servicio</label>
                                            <hidden id="dataCboServicio" data-tipo="@ViewBag.IdTipoServicio"></hidden>
                                            <select class="chzn-select w-100" id="cboServicio" data-placeholder="Seleccione una opción" ></select>
                                        </div>
                                    </div>
                                    <div class="col-md-2">
                                        <div class="d-flex align-items-end" style="height: 55px;">
                                            <button class="btn btn-sm btn-primary layout_btn_prevent mr-1" id="btnBuscarCamas" style="padding-left: 2rem !important; padding-right: 2rem !important;">Buscar</button>                                            
                                        </div>
                                    </div>
                                </div>                                
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-6 pb-1">
                        @{
                            if (@ViewBag.Agregar)
                            {
                                <button class="btn btn-success layout_btn_prevent" id="btnAgregarCama">Agregar</button>
                            }
                            if (@ViewBag.Modificar)
                            {
                                <button class="btn btn-primary layout_btn_prevent" id="btnModificarCama">Modificar</button>
                            }
                            if (@ViewBag.Eliminar)
                            {
                                <button class="btn btn-danger layout_btn_prevent" id="btnEliminarCama">Eliminar</button>
                            }
                            if (@ViewBag.Consultar)
                            {
                                <button class="btn btn-warning layout_btn_prevent" id="btnConsultarCama">Consultar</button>                                
                            }
                        }
                    </div>
                    <div class="col-lg-6 text-sm-right">
                        @if (ViewBag.PermisoLiberaCama > 0)
                        {
                            <button class="btn btn-teal layout_btn_prevent" id="btnLiberarCama"><i class="fa fi fi-ss-bed-empty mr-1"></i>Liberar Cama</button>
                        }
                    </div>
                    
                    <div class="col-lg-12">
                        <table id="tblCamas" width="100%" class="table table-sm table-bordered table-content-sm" style="cursor: default;">
                            <thead style="color: white;background: #434343;">
                                <tr>
                                    <th style="width:10%">Cod. Cama</th>
                                    <th style="width:10%">Estado</th>
                                    <th style="width:15%">Ap. Paterno</th>
                                    <th style="width:15%">Ap. Materno</th>
                                    <th style="width:15%">Primer Nombre</th>
                                    <th style="width:15%">Segundo Nombre</th>
                                    <th style="width:10%">Historia</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>               

            </div>
        </div>
    </div>
</div>


<partial name="~/Views/Shared/Components/VistasParciales/Camas/CamasRegistro.cshtml" /> 


@section Scripts
{
<script type="text/javascript" src="~/AdmiRE/vendors/chosen/js/chosen.jquery.js"></script>
<script type="text/javascript" src="~/AdmiRE/js/moment-with-locales.js"></script>
<script type="text/javascript" src=@Href("~/js/Comun/Camas.js")></script>
}

                            
<style>
.chosen-disabled {
    opacity: 1 !important;
}

.chosen-disabled .chosen-single {
    background: #eceeef !important;
    border-color: rgba(0, 0, 0, 0.15) !important;
}
</style>
