
<div>
    <div>
        <div>
            @section Css
            {
                <!-- plugin css -->
                <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/chosen/css/chosen.css" />
                <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/bootstrap-datetimepicker/css/bootstrap-datetimepicker.min.css" />
                <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/radio_css/css/radiobox.min.css" />
                <link type="text/css" rel="stylesheet" href="~/AdmiRE/css/pages/radio_checkbox.css" />
                <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/jquery-tagsinput/css/jquery.tagsinput.css" />

            }
            <header class="head">
                <div class="main-bar row">
                    <div class="col-lg-6 col-md-4 col-sm-4">
                        <h4 class="nav_top_align">
                            <i class="fa fa-wheelchair"></i>Pacientes
                            @*@ViewBag.Area*@
                        </h4>
                    </div>
                    <div class="col-lg-6 col-md-8 col-sm-8">
                        <ol class="breadcrumb float-xs-right nav_breadcrumb_top_align">
                            <li class="breadcrumb-item">
                                <a href="index1.html">
                                    <i class="fa fa-home" data-pack="default" data-tags=""></i> Home
                                </a>
                            </li>
                            <li class="breadcrumb-item">
                                <a href="#">@ViewBag.Area</a>
                            </li>
                            <li class="breadcrumb-item active">Pacientes</li>
                        </ol>
                    </div>
                </div>
            </header>

            <div class="outer">
                <div class="inner bg-light lter bg-container">
                    <div class="row">
                        <div class="col-xs-12 data_tables">
                            <div class="card">
                                @*<div class="card-header bg-white">
                                <i class="fa fa-pencil-square-o"></i> Pacientes
                            </div>*@
                                <input hidden="hidden" id="idGrupo" name="idGrupo" type="text" class="form-control" value="@ViewBag.Vista">
                                <input hidden="hidden" id="idServicio" name="idServicio" type="text" class="form-control" value="@ViewBag.Servicio">
                                <input hidden="hidden" id="hdIdPaciente" name="hdIdPaciente" type="text" class="form-control">
                                <input hidden="hidden" id="hdIdCuentaAtencion" name="hdIdCuentaAtencion" type="text" class="form-control">
                                <div class="card-block pt-1">
                                    <div class="row">

                                        <div class="col-md-12">
                                            <div class="card m-t-5">
                                                <div class="card-block">
                                                    <div class="row">
                                                        <div class="col-lg-12">
                                                            <div class="row">
                                                                <div class="col-lg-2">
                                                                    <div class="form-group m-0">
                                                                        <label for="txtNroDniBusq" class="form-control-label">N° Dni</label>
                                                                        <div class="input-group input-group-sm">

                                                                            <input id="txtNroDniBusq" autocomplete="off" placeholder="" class=" solo-numero form-control">

                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <div class="col-lg-2">
                                                                    <div class="form-group m-0">
                                                                        <label for="txtNroHistoriaBusq" class="form-control-label">N° Historia</label>
                                                                        <div class="input-group input-group-sm">

                                                                            <input id="txtNroHistoriaBusq" autocomplete="off" placeholder="" class=" solo-numero form-control">

                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <div class="col-lg-2">
                                                                    <div class="form-group m-0">
                                                                        <label for="txtApPaternoBusq" class="form-control-label">Apellido Paterno</label>
                                                                        <div class="input-group input-group-sm">

                                                                            <input id="txtApPaternoBusq" autocomplete="off" placeholder="" class=" form-control">

                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <div class="col-lg-2">
                                                                    <div class="form-group m-0">
                                                                        <label for="txtApMaternoBusq" class="form-control-label">Apellido Materno</label>
                                                                        <div class="input-group input-group-sm">

                                                                            <input id="txtApMaternoBusq" autocomplete="off" placeholder="" class=" form-control">

                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <div class="col-lg-2">
                                                                    <div class="form-group m-0">
                                                                        <label for="txtNombresBusq" class="form-control-label">Nombres</label>
                                                                        <div class="input-group input-group-sm">

                                                                            <input id="txtNombresBusq" autocomplete="off" placeholder="" class=" form-control">

                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <div class="col-lg-2">
                                                                    <div class="d-flex align-items-end" style="height: 55px;">
                                                                        <button class="btn btn-primary layout_btn_prevent mr-1" id="btnBuscar" style="padding-left: 2rem !important; padding-right: 2rem !important;">Buscar</button>
                                                                        <button class="btn btn-default layout_btn_prevent" id="btnLimpiarCS" style="padding-left: 2rem !important; padding-right: 2rem !important;">Limpiar</button>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>

                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-12 pt-2 pb-0">
                                            @{
                                                if (@ViewBag.Agregar)
                                                {
                                                    <button class="btn btn-success layout_btn_prevent" id="btnAgregar">Agregar</button>
                                                }
                                                if (@ViewBag.Modificar)
                                                {
                                                    <button class="btn btn-primary layout_btn_prevent" id="btnModificar">Modificar</button>
                                                }
                                                @*if (@ViewBag.Eliminar)
                                            {
                                                <button class="btn btn-danger layout_btn_prevent" id="btnEliminar">Eliminar</button>
                                            }*@
                                                if (@ViewBag.Consultar)
                                                {
                                                    <button class="btn btn-warning layout_btn_prevent" id="btnConsultar">Consultar</button>
                                                }
                                            }
                                        </div>

                                        <div class="col-md-12">
                                            
                                            <table id="tblPacientes" class="table table-sm table-content-sm table-bordered table-striped w-100">
                                                <thead style="color: white; background: #434343;">
                                                    <tr>
                                                        <th>Apellido Paterno</th>
                                                        <th>Apellido Materno</th>
                                                        <th>1er Nombre</th>
                                                        <th>2do Nombre</th>
                                                        <th>Nro Historia</th>

                                                        <th>Fecha de Nac.</th>
                                                        <th>Ult. Tipo de Serv.</th>
                                                        <th>Ult. Serv. Ing.</th>
                                                        <th>Ult. Fecha. Ing.</th>
                                                        <th>Ult. Fecha. Egr.</th>
                                                    </tr>
                                                </thead>
                                                <tbody></tbody>
                                            </table>
                                        </div>
                                    </div>


                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div data-backdrop="static" style="overflow-y: scroll;" data-keyboard="false" class="modal fade" id="modalPaciente" role="dialog" aria-labelledby="modalLabelsuccess">
                <div class="modal-dialog modal-xxl" role="document">
                    <div class="modal-content">
                        <div class="modal-header bg-primary">
                            <h4 class="modal-title text-white" id="modalLabelsuccess">Registro de Paciente</h4>
                        </div>
                        <div class="modal-body">
                            <partial name="~/Views/Shared/Components/VistasParciales/RegistroPacienteV2.cshtml" />
                        </div>
                        <div class="modal-footer">

                            <button type="button" class="btn btn-success mr-1" id="ImprimeFormatoFiliacionArchivoClinico" style="float: left;"><i class="fa-solid fa-print"></i> <br /> Filiacion Arch. Clínico</button>
                            <button type="button" class="btn btn-indigo mr-1" id="ImprimeBrazalete" style="float: left;"><i class="fa-light fa-rectangle-barcode"></i> <br /> Brazalete</button>
                            <button type="button" class="btn btn-brown" id="GenerarBrazalete" style="float: left;"><i class="fa-light fa-rectangle-barcode"></i> <br /> Brazalete</button>

                            <button id="btnRegistrarPaciente" class="btn btn-lg btn-primary mr-1"> Registrar</button>
                            <button id="btnCerraPaciente" target="_blank" class="btn btn-lg btn-secondary "> Cerrar</button>

                        </div>
                    </div>
                </div>

            </div>


            @section Scripts
            {
                <script type="text/javascript" src="~/AdmiRE/vendors/chosen/js/chosen.jquery.js"></script>
                <script type="text/javascript" src="~/AdmiRE/vendors/raphael/js/raphael-min.js"></script>
                <script type="text/javascript" src="~/AdmiRE/vendors/justgage/js/justgage.js"></script>
                <script type="text/javascript" src="~/AdmiRE/vendors/d3/js/d3.min.js"></script>
                <script type="text/javascript" src="~/AdmiRE/vendors/c3/js/c3.min.js"></script>
                <script type="text/javascript" src="~/AdmiRE/vendors/jquery-tagsinput/js/jquery.tagsinput.js"></script>
                <script type="text/javascript" src="~/AdmiRE/vendors/bootstrap-datetimepicker/js/bootstrap-datetimepicker.min.js"></script>
                <script type="text/javascript" src="~/AdmiRE/vendors/masked/masked.js"></script>


                <script type="text/javascript" src=@Href("~/js/VistasParciales/RegistroPacienteV2.js")></script>
                <script type="text/javascript" src=@Href("~/js/Comun/Paciente.js")></script>



                <script src="~/AdmiRE/js/date.format.js"></script>

                <script type="text/javascript">
                    $(document).ready(function () {
                        // PACIENTE.init();
                        REGISTROPACIENTE.init()

                    })


                    $('.solo-numero').keyup(function () {
                        this.value = (this.value + '').replace(/[^0-9]/g, '');
                    });

                    $('.solo-numero').keydown(function () {
                        this.value = (this.value + '').replace(/[^0-9]/g, '');
                    });

                </script>

            }

            <style>

                #clothing-nav-content2 .form-group {
                    margin-bottom: 0 !important;
                }

                #tblAtencion tr.over td {
                    background: #D6E8F8;
                    font-weight: bold;
                }

                /*  .chosen-container chosen-container-single {
                                    width: 100% !important;
                                }*/


                .chosen-container {
                    width: 100% !important;
                }

                .modal-lg {
                    max-width: 1100px !important;
                }
            </style>
        </div>
    </div>
</div>

<div data-backdrop="static" style="overflow-y: scroll;" data-keyboard="false" class="modal fade" id="modalHojaFiliacion" role="dialog" aria-labelledby="modalLabelsuccess">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary">
                <h4 class="modal-title text-white" id="modalLabelsuccess">Cita</h4>
            </div>
            <div class="modal-body" style="background-color:#b4c6d6">

                <iframe id="ifrmHojaFiliacion"
                        title="Inline Frame Example"
                        width="100%"
                        height="600"
                        src=""></iframe>

            </div>
            <div class="modal-footer" style="background-color:#ced8e1">
                <button id="btnCerrarModalHojaFiliacion" target="_blank" class="btn btn-secondary "> Cerrar</button>
            </div>
        </div>
    </div>
</div>