                                <button id="btnCerrarAtencion" type="button" data-dismiss="modal" class="btn btn-lg btn-secondary float-lg-right mr-1 mb-1">Cerrar</button>
                                <button id="btnguardar" class="btn btn-lg  btn-info float-lg-right mr-1 mb-1">Guardar</button>
                            </div>
                        </div>

                    </div>
