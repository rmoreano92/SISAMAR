</head>


<body style=" width:95%; white; margin-left:20px;margin-right:20px;" id="bdText">

    <div class="row">
        <table style='width: 95%'>
            <tr>
                <td><img src='@ViewBag.Logo' style='height: 50px;' /></td>
                <td style="text-align:center"><h5><b>@ViewBag.Titulo</b></h5></td>
                <td style='text-align:right'><h5>@ViewBag.nroFormato</h5></td>
            </tr>
        </table>
    </div>

    <div style="font-size: 9px;" class="row ">
        @Html.Raw(@ViewBag.Texto)
    </div>

</body>

</html>
