@*<body style="background: white;  width: 793px; height: 1145px; position: relative;  /*border: 1px solid red;*/" >*@
<body style="background: white; width:900px; height:600px; position:relative; margin-top: -35px; /*padding-top: 30px; border: 1px solid red;*/">

    @*<div class="row mt-4" style="width: 35%; margin-left: 15px">*@
    <div class="position-relative" style="width: 270px; margin-left: -40px; page-break-before: always; /*border: 1px solid green;*/">
        <div class="col-12 position-relative">
            @*<div class="position-absolute" style="width: 40px; left:0px; top: 0px;">
            <img src="@ViewBag.Logo" width="100%" />
            </div>*@

            <div class="row text-center mx-auto mb-3" style="width: 95%;">
                <div class="col-12"><span class="fw-bold" style="font-size: 12px;">@ViewBag.Comprobante["EESS_Nombre"]</span></div>
                <div class="col-12"><span class="fw-bold" style="font-size: 12px;">RUC: @ViewBag.Comprobante["EESS_Ruc"]</span></div>
                <div class="col-12"><span style="font-size: 9px;">@ViewBag.Comprobante["EESS_Direccion"]</span></div>
                <div class="col-12"><span style="font-size: 9px;">Telefono: @ViewBag.Comprobante["EESS_Telefono"]</span></div>
            </div>

            <h2 class="w-100 text-center m-0">@ViewBag.Comprobante["DenominacionComprobante"] @ViewBag.Comprobante["NroComprobante"]</h2>
            @* <h2 class="w-100 text-center my-1">@ViewBag.Comprobante["NroComprobante"]</h2> *@

            <hr />

            <table class="table font-md">
                <tr>
                    <th class="text-left" width="90">@ViewBag.Comprobante["EtiquetaRazonSocial"]</th>
                    <td>@ViewBag.Comprobante["RazonSocial"]</td>
                </tr>
                <tr>
                    <th class="text-left">@ViewBag.Comprobante["EtiquetaNroDocumentoIdentidad"]</th>
                    <td>@ViewBag.Comprobante["NroDocumentoIdentidad"]</td>
                </tr>
                <tr>
                    <th class="text-left">Nº Historia</th>
                    <td>@ViewBag.Comprobante["NroHistoriaClinica"]</td>
                </tr>
                <tr>
                    <th class="text-left">Nº Cuenta</th>
                    <td>@ViewBag.Comprobante["IdCuentaAtencion"]</td>
                </tr>
                @if (ViewBag.Comprobante["IdOrdenPagoS"] > 0)
                {
                    <tr>
                        <th class="text-left">Nº Orden Pago</th>
                        <td>@ViewBag.Comprobante["IdOrdenPagoS"]</td>
                    </tr>
                }
                @if (ViewBag.Comprobante["IdOrdenF"] > 0)
                {
                    <tr>
                        <th class="text-left">Nº Orden</th>
                        <td>@ViewBag.Comprobante["IdOrdenF"]</td>
                    </tr>
                }
                @if (ViewBag.Comprobante["IdPreventaF"] > 0)
                {
                    <tr>
                        <th class="text-left">Nº Pre Venta</th>
                        <td>@ViewBag.Comprobante["IdPreventaF"]</td>
                    </tr>
                }
                @if (ViewBag.Comprobante["ServicioS"] != "-")
                {
                    <tr>
                        <th class="text-left">Servicio</th>
                        <td>@ViewBag.Comprobante["ServicioS"]</td>
                    </tr>
                }
                @if (ViewBag.Comprobante["ServicioF"] != "-")
                {
                    <tr>
                        <th class="text-left">Servicio</th>
                        <td>@ViewBag.Comprobante["ServicioF"]</td>
                    </tr>
                }
                @if (ViewBag.Comprobante["MedicoS"] != "-")
                {
                    <tr>
                        <th class="text-left">Médico</th>
                        <td>@ViewBag.Comprobante["MedicoS"]</td>
                    </tr>
                }
                @if (ViewBag.Comprobante["MedicoF"] != "-")
                {
                    <tr>
                        <th class="text-left">Médico</th>
                        <td>@ViewBag.Comprobante["MedicoF"]</td>
                    </tr>
                }
                <tr>
                    <th class="text-left">Dirección:</th>
                    <td>@ViewBag.Comprobante["Direccion"]</td>
                </tr>
                <tr>
                    <th class="text-left">Observaciones:</th>
                    <td>@ViewBag.Comprobante["Observaciones"]</td>
                </tr>
                <tr>
                    <th class="text-left">Fecha Emisión:</th>
                    <td>@ViewBag.Comprobante["FechaHoraEmision"]</td>
                </tr>
            </table>

            <hr />
               
            <table class="table  font-md w-100 mb-2">
                <tr>
                    <th class="text-left border" width="170">Concepto</th>
                    <td class="text-right border" width="30">Cant.</td>
                    <td class="border" align="right">Importe</td>
                </tr>
                @foreach (DataRow drComprobanteDetalle in ViewBag.ComprobanteDetalle.Rows)
                {
                    <tr>
                        <td class="text-left" width="170">@drComprobanteDetalle["Descripcion"]</td>
                        <td class="text-right" width="30">@drComprobanteDetalle["Cantidad"]</td>
                        <td align="right">@drComprobanteDetalle["Total"]</td>
                    </tr>
                }                
            </table>

            <hr />

            <table class="table font-md w-100 mb-2">
                <tr>
                    <th class="text-left" width="90">Gravada</th>
                    <td class="text-left" width="30">@ViewBag.Comprobante["Moneda"]</td>
                    <td align="right">@ViewBag.Comprobante["MontoGravado"]</td>
                </tr>
                <tr>
                    <th class="text-left" width="90">Adelanto</th>
                    <td class="text-left" width="30">@ViewBag.Comprobante["Moneda"]</td>
                    <td align="right">@ViewBag.Comprobante["MontoAdelanto"]</td>
                </tr>
                <tr>
                    <th class="text-left" width="90">Descuento</th>
                    <td class="text-left" width="30">@ViewBag.Comprobante["Moneda"]</td>
                    <td align="right">@ViewBag.Comprobante["MontoDescuento"]</td>
                </tr>
                @* <tr>
                    <th class="text-left" width="90">Inafecta</th>
                    <td class="text-left" width="30">@ViewBag.Comprobante["Moneda"]</td>
                    <td align="right">@ViewBag.Comprobante["MontoInafecto"]</td>
                </tr> *@
                <tr>
                    <th class="text-left" width="90">Subtotal</th>
                    <td class="text-left" width="30">@ViewBag.Comprobante["Moneda"]</td>
                    <td align="right">@ViewBag.Comprobante["MontoSubTotal"]</td>
                </tr>
                <tr>
                    <th class="text-left" width="90">IGV</th>
                    <td class="text-left" width="30">@ViewBag.Comprobante["Moneda"]</td>
                    <td align="right">@ViewBag.Comprobante["MontoIgv"]</td>
                </tr>
                
                <tr>
                    <th class="text-left" width="90">TOTAL</th>
                    <td class="text-left" width="30">@ViewBag.Comprobante["Moneda"]</td>
                    <td align="right">@ViewBag.Comprobante["MontoTotal"]</td>
                </tr>
            </table>
            <hr />

            
            <h3 class="mb-0">@ViewBag.Comprobante["TotalDescripcion"]</h3>
            <div>
                <span class="fw-bold">Caja: </span>
                <span>@ViewBag.Comprobante["Caja"]</span>
            </div>            
            <div>
                <span class="fw-bold">Cajero(a): </span>
                <span>@ViewBag.Comprobante["Cajero"] - @ViewBag.TipoCopia @ViewBag.EsCopia</span>
            </div>
            <div>
                <span class="fw-bold">Impreso por: </span>
                <span>@ViewBag.User</span>
            </div>
            <div>
                <span class="fw-bold">Fecha impresión: </span>
                <span>@ViewBag.FechaImpresion</span>
            </div>

            @if (ViewBag.CodigoQR != null)
            {
                <div class="text-center">
                    <img class="qr-code" src="@String.Format("data:image/png;base64,{0}", Convert.ToBase64String(ViewBag.CodigoQR))" />
                </div>
                
            }

            <hr class="mt-3 mb-3" />

        </div>

    </div>



</body>



</html>