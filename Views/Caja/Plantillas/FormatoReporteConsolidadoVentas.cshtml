
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Registro de Ventas</title>
    <style>
        body {
        font-size: 10px;
        color: black !important;
        font-family: helvetica;
        letter-spacing: 0.4px;
        font-weight: bolder;
        }

        td, th {
        padding: 0.25rem !important;
        }

        .font-sm {
        font-size: 8px;
        }

        .font-md {
        font-size: 11px;
        }

        .font-lg {
        font-size: 12px;
        }

        .table {
        border-color: #607d8b !important;
        }

        /*=====================MI CSS=======================*/
        .d-flex {
        display: flex !important;
        }

        .position-absolute {
        position: absolute;
        }

        .position-relative {
        position: relative;
        }

        .border {
        border: 1px solid #dee2e6 !important;
        }

        .border-secondary {
        border-color: #6c757d !important;
        }

        .w-100 {
        width: 100% !important;
        }

        .h-100 {
        width: 100% !important;
        }

        .my-2 {
        margin-top: 0.5rem !important;
        margin-bottom: 0.5rem !important;
        }

        .my-1 {
        margin-top: 0.25rem !important;
        margin-bottom: 0.25rem !important;
        }

        .mt-2 {
        margin-top: 0.5rem !important;
        }

        .mb-0 {
        margin-bottom: 0 !important;
        }

        .mb-1 {
        margin-bottom: 0.25rem !important;
        }

        .mb-2 {
        margin-bottom: 0.5rem !important;
        }

        .me-2 {
        margin-right: 0.5rem !important;
        }

        .ms-2 {
        margin-left: 0.5rem !important;
        }

        .mt-3 {
        margin-top: 0.75rem !important;
        }

        .mb-3 {
        margin-bottom: 0.75rem !important;
        }

        .mt-4 {
        margin-top: 1rem !important;
        }

        .mb-4 {
        margin-bottom: 1rem !important;
        }

        .m-1 {
        margin: 0.25rem !important;
        }

        .m-2 {
        margin: 0.5rem !important;
        }

        .m-0 {
        margin: 0 !important;
        }

        .p-1 {
        padding: 0.25rem !important;
        }

        .py-2 {
        padding-top: 0.5rem !important;
        padding-bottom: 0.5rem !important;
        }

        .py-1 {
        padding-top: 0.25rem !important;
        padding-bottom: 0.25rem !important;
        }

        .pt-2 {
        padding-top: 0.5rem !important;
        }

        .pb-0 {
        padding-bottom: 0 !important;
        }

        .pb-1 {
        padding-bottom: 0.25rem !important;
        }

        .pb-2 {
        padding-bottom: 0.5rem !important;
        }

        .pe-2 {
        padding-right: 0.5rem !important;
        }

        .ps-2 {
        padding-left: 0.5rem !important;
        }

        .pt-3 {
        padding-top: 0.75rem !important;
        }

        .pb-3 {
        padding-bottom: 0.75rem !important;
        }

        .pt-4 {
        padding-top: 1rem !important;
        }

        .pb-4 {
        padding-bottom: 1rem !important;
        }

        .px-auto {
        margin-right: auto !important;
        margin-left: auto !important;
        }

        .fw-bold {
        font-weight: 700 !important;
        }

        .text-center {
        text-align: center;
        }

        .text-left {
        text-align: left;
        }

        .text-right {
        text-align: right;
        }

        .table {
        caption-side: bottom;
        border-collapse: collapse;
        }

        .table-bordered {
        border: solid 1px #4c4c4c;
        }

        .table-bordered td, .table-bordered th {
        border: solid 1px #4c4c4c;
        }

        .table td {
        font-weight: lighter;
        }
        /*=================================================*/


        .qr-code {
        width: 90px;
        text-align: center;
        margin: auto;
        }

    </style>
</head>


<body style="background: white; width: 780px; height: 1050px; /*position: relative; border: 1px solid red;*/" class="">
    
    <img src="~/images/Logo.png" style="width: 80px; position:absolute; top: 0px;" />
    <table class="table" style="width: 200px; position:absolute; right: 0; top: 0px; border: none;">
        <tbody>
            <tr style="">
                <td class="border-secondary text-right">Usuario: @ViewBag.Usuario</td>
            </tr>
            <tr style="">
                <td class="border-secondary text-right">F. Impresión: @ViewBag.FechaImpresion</td>
            </tr>
        </tbody>
    </table>

    <div class="row text-center mx-auto mb-3" style="width: 95%;">
        <div class="col-12"><span class="fw-bold" style="font-size: 11px;">@ViewBag.NombreInstitucion</span></div>        
        <div class="col-12"><span style="font-size: 9px;">@ViewBag.DireccionInstitucion</span></div>
        <div class="col-12"><span style="font-size: 9px;">Telefono: @ViewBag.TelefonoInstitucion</span></div>
    </div>

    <div class="text-center mt-0 mb-4">
        <h2 class="mb-0">REGISTRO DE VENTAS</h2>
        @if (ViewBag.Cajero != "" && ViewBag.Cajero != null)
        {
            <h5 class="m-0">(Cajero: @ViewBag.Cajero)</h5>
        }
        @if (ViewBag.Caja != "" && ViewBag.Caja != null)
        {
            <h5 class="m-0">(@ViewBag.Caja)</h5>
        }
    </div>
    
    
        
    <div class="d-flex mb-1">
        <table class="table table-bordered border-secondary me-2" style="width: 270px;">
            <tbody>
                <tr>
                    <th class="border-secondary text-left fw-bold" style="width:40px;">Fecha</th>
                    <td class="border-secondary text-left">@ViewBag.Fecha</td>
                </tr>
            </tbody>
        </table>

        <table class="table table-bordered border-secondary me-2" style="width: 280px;">
            <tbody>
                <tr>
                    <th class="border-secondary text-left fw-bold" style="width:120px;">Comprobante de Pago</th>
                    <td class="border-secondary text-left">@ViewBag.TipoComprobante</td>
                </tr>
            </tbody>
        </table>

        <table class="table table-bordered border-secondary me-2" style="width: 170px;">
            <tbody>
                <tr>
                    <th class="border-secondary text-left fw-bold" style="width:20px;">Tipo</th>
                    <td class="border-secondary text-left">@ViewBag.TipoConsumo</td>
                </tr>
            </tbody>
        </table>

    </div>

    <table class="table table-bordered border-secondary w-100  mt-2">
        <tbody>
            <tr>
                @* <th class="border-secondary table-active text-left" style="font-size: 8px;">#</th> *@
                <th class="border-secondary table-active text-left" width="7%" style="font-size: 8px;">F. Emisión</th>
                <th class="border-secondary table-active text-left" width="5%" style="font-size: 8px;">Cajero</th>
                <th class="border-secondary table-active text-left" width="8%" style="font-size: 8px;">Nª Boleta</th>
                <th class="border-secondary table-active text-left" style="font-size: 8px;">Nª HC</th>
                <th class="border-secondary table-active text-left" style="font-size: 8px;">Paciente</th>
                <th class="border-secondary table-active text-left" width="6%" style="font-size: 8px;">Sub Total</th>
                <th class="border-secondary table-active text-left" width="6%" style="font-size: 8px;">Redon.</th>
                <th class="border-secondary table-active text-left" width="6%" style="font-size: 8px;">Anula.</th>
                <th class="border-secondary table-active text-left" width="6%" style="font-size: 8px;">Exone.</th>
                <th class="border-secondary table-active text-left" width="6%" style="font-size: 8px;">Nota Credito</th>
                <th class="border-secondary table-active text-left" width="6%" style="font-size: 8px;">Pago a Cuenta</th>
                <th class="border-secondary table-active text-left" width="6%" style="font-size: 8px;">Total Bruto</th>
                <th class="border-secondary table-active text-left" width="6%" style="font-size: 8px;">IGV</th>
                <th class="border-secondary table-active text-left" width="6%" style="font-size: 8px;">Total Neto</th>
            </tr>
            @{
                int index = 1;
            }
            @foreach (System.Data.DataRow row in ViewBag.RegistrosRpt.Rows)
            {
                <tr>
                    @* <td class="border-secondary align-top" style="font-size: 7px;">@index</td> *@
                    <td class="border-secondary align-top" style="font-size: 8px;">@row["Fecha Emisión"]</td>
                    <td class="border-secondary align-top" style="font-size: 8px;">@row["Cajero"]</td>
                    <td class="border-secondary align-top" style="font-size: 8px;">@row["Nº Boleta"]</td>
                    <td class="border-secondary align-top" style="font-size: 8px;">@row["Nº Historia"]</td>
                    <td class="border-secondary align-top" style="font-size: 8px;">@row["Paciente"]</td>
                    <td class="border-secondary align-top" style="font-size: 8px;">@row["Sub Total"]</td>
                    <td class="border-secondary align-top" style="font-size: 8px;">@row["Redondeo"]</td>
                    <td class="border-secondary align-top" style="font-size: 8px;">@row["Anulado"]</td>
                    <td class="border-secondary align-top" style="font-size: 8px;">@row["Exonerado"]</td>
                    <td class="border-secondary align-top" style="font-size: 8px;">@row["Nota Credito"]</td>
                    <td class="border-secondary align-top" style="font-size: 8px;">@row["Pago a Cuenta"]</td>
                    <td class="border-secondary align-top" style="font-size: 8px;">@row["Total Bruto"]</td>
                    <td class="border-secondary align-top" style="font-size: 8px;">@row["IGV"]</td>
                    <td class="border-secondary align-top" style="font-size: 8px;">@row["Total Neto"]</td>
                </tr>
                index++;
            }
            @foreach (System.Data.DataRow row in ViewBag.TotalRpt.Rows)
            {
                <tr>

                    <td class="border-secondary align-top" style="font-size: 9px;" colspan="5">Cantidad de documentos: @row["Cantidad"]</td>
                    <td class="border-secondary align-top" style="font-size: 8px;">@row["Sub Total"]</td>
                    <td class="border-secondary align-top" style="font-size: 8px;">@row["Redondeo"]</td>
                    <td class="border-secondary align-top" style="font-size: 8px;">@row["Anulado"]</td>
                    <td class="border-secondary align-top" style="font-size: 8px;">@row["Exonerado"]</td>
                    <td class="border-secondary align-top" style="font-size: 8px;">@row["Nota Credito"]</td>
                    <td class="border-secondary align-top" style="font-size: 8px;">@row["Pago a Cuenta"]</td>
                    <td class="border-secondary align-top" style="font-size: 8px;">@row["Total Bruto"]</td>
                    <td class="border-secondary align-top" style="font-size: 8px;">@row["IGV"]</td>
                    <td class="border-secondary align-top" style="font-size: 8px;">@row["Total Neto"]</td>
                </tr>
                index++;
            }

        </tbody>
    </table>

    
</body>



</html>