@using Microsoft.Extensions.Configuration;
@using System.Data
@{
    var version = new ConfigurationBuilder().AddJsonFile("appsettings.json").Build().GetValue<string>("Version");
    // var usaLabs = new ConfigurationBuilder().AddJsonFile("appsettings.json").Build().GetValue<string>("Configuraciones:UsaLabs");
}

@section Css
    {
    <!-- plugin css -->
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/chosen/css/chosen.css" />
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/bootstrap-datetimepicker/css/bootstrap-datetimepicker.min.css" />
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/radio_css/css/radiobox.min.css" />
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/css/pages/radio_checkbox.css" />
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/jquery-tagsinput/css/jquery.tagsinput.css" />
}

<header class="head">
    <div class="main-bar" style="overflow: visible;">
        <div class="row">
            <div class="col-sm-10">
                <div class="d-flex">
                    <div>
                        <h4 class="nav_top_align">
                            <i class="fa fi fi-ss-payment-pos"></i>
                            @*@ViewBag.Area*@
                            Gestion de Caja
                        </h4>
                    </div>
                    <div class="mx-1 border"></div>
                    @if (ViewBag.EstadoCaja == "A")
                    {
                        <div class="">
                            <div class="chip success ml-0 mr-1" style="color: #5e5e5e; background: #fffb80; margin-top: 8px;">
                                <i class="fa fa-cash-register" style="margin-right: 5px;"></i>
                                <span style="text-decoration: underline;">CAJA: </span><span style="font-weight: normal;" id="txtCajaAperturado">@ViewBag.CajaAperturo</span>
                            </div>
                        </div>
                        <div class="">
                            <div class="chip success ml-0 mr-1" style="color: #5e5e5e; background: #80ffd4; margin-top: 8px;">
                                <i class="fa fi fi-ss-user-unlock" style="margin-right: 5px;"></i>
                                <span style="text-decoration: underline;">APERTURADO POR: </span><span style="font-weight: normal;" id="txtAperturadoPor">@ViewBag.CajeroAperturo</span>
                            </div>
                        </div>
                    }
                    <div>
                        @if (ViewBag.EstadoCaja == "C")
                        {
                            <button id="btnAperturaCaja" type="button" class="btn btn-labeled btn-teal" style="margin-top: 8px;">
                                <span class="btn-label">
                                    <i class="fi fi-ss-lock-open-alt"></i>
                                </span>
                                APERTURA
                            </button>
                            @* <button id="btnAperturaCaja" class="btn btn-teal layout_btn_prevent ml-0 mr-1" style="margin-top: 5px;"><i class="fi fi-ss-lock-open-alt"></i> APERTURA</button> *@
                        }
                    </div>
                    <div>
                        @if (ViewBag.EstadoCaja == "A"@*  && ViewBag.CodigoGestionCaja2 != "" *@)
                        {
                            <button id="btCierreCaja" type="button" class="btn btn-labeled btn-brown" style="margin-top: 8px;">
                                <span class="btn-label">
                                    <i class="fi fi-ss-unlock"></i>
                                </span>
                                CIERRE
                            </button>
                            @* <div><input id="txtCodigoGestioncaja2" type="text" value="@ViewBag.CodigoGestionCaja2" hidden /></div> *@
                            @* <button id="btCierreCaja" class="btn btn-brown layout_btn_prevent ml-0 mr-1" style="margin-top: 5px;"><i class="fi fi-ss-unlock"></i> CIERRE</button> *@
                        }
                    </div>
                    <div><input id="txtCodigoGestioncaja" type="text" value="@ViewBag.CodigoGestionCaja" hidden /></div>
                    <div><input id="txtIdCaja" type="text" value="@ViewBag.IdCaja" hidden /></div>
                </div>

            </div>
            <div class="col-sm-2">
                <div class="d-flex">
                    <div class="dropdown ml-auto" style="margin-top: 8px;">
                        <button class="btn btn-labeled btn-success dropdown-toggle" type="button" id="reporte-caja" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            <span class="btn-label">
                                <i class="fa-solid fa-file-excel"></i>
                            </span>
                            Reportes
                        </button>
                        <div class="dropdown-menu dropdown-menu-right" aria-labelledby="reporte-caja" style="border-color: teal;">
                            <a id="btnAbrirReporteConsolidadoVentas" class="dropdown-item" href="#">Consolidado de Ventas</a>
                            <a id="btnAbrirReporteConsolidadoRecaudacion" class="dropdown-item" href="#">Consolidado de Recaudación</a>
                            <a id="btnAbrirReporteResumenPorPartida" class="dropdown-item" href="#">Resumen por Partida</a>
                        </div>
                    </div>
                </div>
                @* <ol class="breadcrumb float-xs-right nav_breadcrumb_top_align">
                <li class="breadcrumb-item">
                    <a href="index1.html">
                        <i class="fa fa-home" data-pack="default" data-tags=""></i> Home
                    </a>
                </li>
                <li class="breadcrumb-item">
                    <a href="#">@ViewBag.Area</a>
                </li>
                <li class="breadcrumb-item active">Gestion de Caja</li>
            </ol> *@

            </div>
        </div>
    </div>
</header>

<div class="row m-0">
    <div class="col-sm-12">
        <ul class="nav nav-tabs" id="tabGestionCaja" role="tablist">
            <li class="nav-item" role="presentation">
                <a href="#" class="nav-link nav-link-custom active" id="TabBusqueda" data-toggle="tab" data-target="#TabPanelBusqueda" role="tab" aria-controls="TabPanelBusqueda" aria-selected="true">Busqueda</a>
            </li>
            @if (ViewBag.EstadoCaja == "A" && ViewBag.CodigoGestionCaja != "")
            {
                <li class="nav-item m-0" role="presentation">
                    <a href="#" class="nav-link nav-link-custom" id="TabEmisionComprobante" data-toggle="tab" data-target="#TabPanelEmisionComprobante" role="tab" aria-controls="TabPanelEmisionComprobante" aria-selected="false">Emisión Comprobante</a>
                </li>
                <li class="nav-item m-0" role="presentation">
                    <a href="#" class="nav-link nav-link-custom" id="TabCanjeNotaCreditoDebito" data-toggle="tab" data-target="#TabPanelCanjeNotaCreditoDebito" role="tab" aria-controls="TabPanelCanjeNotaCreditoDebito" aria-selected="false">Canje Nota Crédito/Débito</a>
                </li>
                <li class="nav-item m-0 d-none" role="presentation">
                    <a href="#" class="nav-link nav-link-custom" id="TabPlanCredito" data-toggle="tab" data-target="#TabPanelPlanCredito" role="tab" aria-controls="TabPanelPlanCredito" aria-selected="false">Plan de Crédito</a>
                </li>
            }            
        </ul>
        <div class="tab-content border pt-1 pl-1 pr-1" id="myTabContentGestionCaja">
            <!--=============================================Panel Busqueda==================================================================-->
            <div class="tab-pane fade active in pb-1 h-100" id="TabPanelBusqueda" role="tabpanel" aria-labelledby="TabBusqueda">
                <div class="row template_auto-1fr-auto">
                    <div class="col-lg-12 mb-1">
                        <div class="card bg-blue">
                            <div class="card-block">
                                <div class="row">
                                    @*<div class="col-md-2">
                                        <div class="form-group m-0">
                                            <label for="cboFiltroTipoDocumento" class="form-control-label">Tipo Comprobante</label>
                                            <select class="chzn-select w-100" id="cboFiltroTipoDocumento" data-placeholder="Seleccione una opción">
                                                @foreach (var item in @ViewBag.TiposDocumentos.Tables[0].Rows)
                                                {
                                                    <option value="@item["id"]"> @item["descripcion"]  </option>
                                                }
                                            </select>
                                        </div>
                                    </div>*@
                                    <div class="col-xl-3 col-lg-5 col-md-4">
                                        <div class="row">
                                            <div class="col-xl-5 col-lg-5 col-md-6"@* style="max-width: 100px;"*@>
                                                <div class="form-group m-0">
                                                    <label for="txtFiltroNroSerie" class="form-control-label">Serie</label>
                                                    <input type="text" autocomplete="off" class="form-control form-control-sm search solo-numero" id="txtFiltroNroSerie">
                                                </div>
                                            </div>
                                            <div class="col-xl-7 col-lg-7 col-md-6" @* style="max-width: 150px;"*@>
                                                <div class="form-group m-0">
                                                    <label for="txtFiltroNroDocumento" class="form-control-label">N° Documento</label>
                                                    <input type="text" autocomplete="off" class="form-control form-control-sm search solo-numero" id="txtFiltroNroDocumento">
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-xl-3">
                                        <div class="row">
                                            <div class="col-xl-6"@* style="max-width: 150px;"*@>
                                                <div class="form-group m-0">
                                                    <label for="txtFiltroNroHistoria" class="form-control-label">Historia</label>
                                                    <input type="text" autocomplete="off" class="form-control form-control-sm search solo-numero" id="txtFiltroNroHistoria">
                                                </div>
                                            </div>
                                            <div class="col-xl-6"@* style="max-width: 150px;"*@>
                                                <div class="form-group m-0">
                                                    <label for="txtFiltroNroCuenta" class="form-control-label">Cuenta</label>
                                                    <input type="text" autocomplete="off" class="form-control form-control-sm search solo-numero" id="txtFiltroNroCuenta">
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-xl-6">
                                        <div class="row">
                                            <div class="col-xl-4">
                                                <div class="form-group m-0">
                                                    <label for="cboFiltroCaja" class="form-control-label">Caja</label>
                                                    <select class="chzn-select-deselect search w-100" id="cboFiltroCaja" data-placeholder="Seleccione una opción">
                                                        <option value=""></option>
                                                        @foreach (var item in @ViewBag.ListaCajas.Tables[0].Rows)
                                                        {
                                                            <option value="@item["idCaja"]"> @item["descripcion"]  </option>
                                                        }
                                                    </select>
                                                </div>
                                            </div>

                                            <div class="col-xl-4">
                                                <div class="form-group m-0">
                                                    <label for="cboFiltroTurno" class="form-control-label">Turno</label>
                                                    <select class="chzn-select-deselect search w-100" id="cboFiltroTurno" data-placeholder="Seleccione una opción">
                                                        <option value=""></option>
                                                        @foreach (var item in @ViewBag.ListaTurnos.Tables[0].Rows)
                                                        {
                                                            <option value="@item["idTurno"]"> @item["descripcion"]  </option>
                                                        }
                                                    </select>
                                                </div>
                                            </div>

                                            <div class="col-xl-4">
                                                <div class="form-group m-0">
                                                    <label for="cboFiltroCajero" class="form-control-label">Cajero</label>
                                                    <select class="chzn-select-deselect search w-100" id="cboFiltroCajero" data-placeholder="Seleccione una opción">
                                                        <option value=""></option>
                                                        @foreach (var item in @ViewBag.ListaCajeros.Tables[0].Rows)
                                                        {
                                                            <option value="@item["idEmpleado"]"> @item["dCajero"]  </option>
                                                        }
                                                    </select>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-xl-3">
                                        <div class="form-group m-0">
                                            <label for="txtFiltroRazonSocial" class="form-control-label">Razón Social</label>
                                            <input type="text" autocomplete="off" class="form-control form-control-sm search" id="txtFiltroRazonSocial">
                                        </div>
                                    </div>

                                    <div class="col-xl-2" style="max-width: 200px;">
                                        <div class="form-group m-0">
                                            <label for="txtFechaInicioBuscar" class="form-control-label">Fecha Inicio</label>
                                            <div class="input-group input-group-sm">
                                                <input type="text" autocomplete="off" class="form-control form_val_popup_dp3 search" placeholder="dd/mm/yyyy" data-date-format="dd/mm/yyyy" id="txtFiltroFechaInicio">
                                                <span class="input-group-addon">
                                                    <i class="fa fa-calendar "></i>
                                                </span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-xl-2" style="max-width: 200px;">
                                        <div class="form-group m-0">
                                            <label for="txtFechaFinBuscar" class="form-control-label">Fecha Fin</label>
                                            <div class="input-group input-group-sm">
                                                <input type="text" autocomplete="off" class="form-control form_val_popup_dp3 search" placeholder="dd/mm/yyyy" data-date-format="dd/mm/yyyy" id="txtFiltroFechaFin">
                                                <span class="input-group-addon">
                                                    <i class="fa fa-calendar "></i>
                                                </span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-2">
                                        <div class="d-flex align-items-end" style="height: 55px;">
                                            <button class="btn btn-sm btn-primary layout_btn_prevent mr-1" id="btnFiltroBuscar" style="padding-left: 2rem !important; padding-right: 2rem !important;">Buscar</button>
                                            <button class="btn btn-sm btn-secondary layout_btn_prevent" id="btnFiltroLimpiar" style="padding-left: 2rem !important; padding-right: 2rem !important;">Limpiar</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                                    
                    <div class="col-lg-12 template_auto-1fr">
                        <div>
                            <ul class="nav nav-tabs border" id="ComprobantesNotas-TabList" role="tablist">
