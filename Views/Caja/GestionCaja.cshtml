                                                    <th>Historia</th>
                                                    <th>Razón Social</th>
                                                    <th>Total</th>
                                                    <th>Cajero</th>
                                                    <th>Estado</th>
                                                    <th>Migración</th>
                                                    <th>Imprimir</th>
                                                </tr>
                                            </thead>
                                            <tbody></tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>

                            <div class="tab-pane fade" id="notasCredito-tab" role="tabpanel" aria-labelledby="notas-tab-link">
