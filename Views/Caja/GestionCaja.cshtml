                                    <a class="nav-link active" id="comprobantes-tab-link" data-toggle="tab" href="#comprobantes-tab" role="tab" aria-controls="comprobantes" aria-selected="true" aria-expanded="true">Boletas y Facturas</a>
                                </li>
                                <li class="nav-item m-0">
                                    <a class="nav-link" id="notas-tab-link" data-toggle="tab" href="#notasCredito-tab" role="tab" aria-controls="notas" aria-selected="false" aria-expanded="false">Notas Crédito</a>
                                </li>
                                <li class="nav-item m-0">
                                    <a class="nav-link" id="notas-tab-link" data-toggle="tab" href="#notasDebito-tab" role="tab" aria-controls="notas" aria-selected="false" aria-expanded="false">Notas Débito</a>
                                </li>
                            </ul>
                        </div>
                        

                        <div class="tab-content" id="Comprobantes-TabContent" style="padding-top: 5px;">
