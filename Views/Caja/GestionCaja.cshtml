                                <div class="row">
                                    <div class="col-xl-6">
                                        @if (ViewBag.Eliminar && ViewBag.EstadoCaja == "A" && ViewBag.CodigoGestionCaja != "")
                                        {
                                            <button class="btn btn-danger layout_btn_prevent text-sm-left" id="btnEliminarComprobante"><i class="fa fi fi-ss-delete-document" style="width: 20px;"></i> ANULAR COMPROBANTE</button>
                                        }
                                    </div>
                                    <div class="col-xl-6 text-sm-right">
                                        @if (ViewBag.PermisoHabilitarEnvioSunat > 0)
                                        {
                                            <button class="btn btn-teal layout_btn_prevent" id="btnHabilitarEnvioSunatComprobante"><i class="fa-solid fa-send mr-1"></i> MIGRAR</button>
                                        }
                                        @if (ViewBag.PermisoCorrecionComprobante > 0)
                                        {
                                            <button class="btn btn-brown layout_btn_prevent" id="btnCorregirComprobante"><i class="fa-solid fa-screwdriver-wrench mr-1"></i> CORREGIR</button>
                                        }
                                    </div>
                                </div>
                                <div class="row">                                    
                                    <div class="col-xl-12 h-100" >
                                        <table id="tblComprobantes" width="100%" height="100%" class="table table-xs table-bordered table-content-sm" style="cursor: default;">
                                            <thead style="color: white;background: #434343;">
                                                <tr>
                                                    <th>Caja</th>
