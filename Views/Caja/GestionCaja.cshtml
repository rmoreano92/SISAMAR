                                        {
                                            <button class="btn btn-danger layout_btn_prevent text-sm-left" id="btnEliminarDevolucionNotaCredito"><i class="fa fi fi-ss-delete-document" style="width: 20px;"></i> REVERTIR DEVOLUCIÓN</button>
                                        }
                                    </div>
                                    <div class="col-xl-6 text-sm-right">
                                        @if (ViewBag.PermisoHabilitarEnvioSunat > 0)
                                        {
                                            <button class="btn btn-teal layout_btn_prevent" id="btnHabilitarEnvioSunatNotaCredito"><i class="fa-solid fa-send mr-1"></i> MIGRAR</button>
                                        }
