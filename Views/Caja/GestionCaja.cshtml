                                        </table>
                                    </div>
                                </div>                                
                            </div>

                            <div class="tab-pane fade" id="notasDebito-tab" role="tabpanel" aria-labelledby="notas-tab-link">
                                <div class="row">
                                    <div class="col-xl-6">
                                        @if (ViewBag.Eliminar && ViewBag.EstadoCaja == "A" && ViewBag.CodigoGestionCaja != "")
                                        {
                                            <button class="btn btn-danger layout_btn_prevent text-sm-left" id="btnEliminaCanjeNotaDebito"><i class="fa fi fi-ss-delete-document" style="width: 20px;"></i> REVERTIR CANJE</button>
                                        }
                                    </div>
                                    <div class="col-xl-6 text-sm-right">
                                        @if (ViewBag.PermisoHabilitarEnvioSunat > 0)
                                        {
                                            <button class="btn btn-teal layout_btn_prevent" id="btnHabilitarEnvioSunatNotaDebito"><i class="fa-solid fa-send mr-1"></i> MIGRAR</button>
                                        }
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-xl-12">
                                        <table id="tblNotasDebito" width="100%" class="table table-xs table-bordered table-content-sm" style="cursor: default;">
                                            <thead style="color: white;background: #434343;">
