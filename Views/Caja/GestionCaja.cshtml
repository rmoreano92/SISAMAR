                                                    <th>Migración</th>
                                                    <th>Imprimir</th>
                                                </tr>
                                            </thead>
                                            <tbody></tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>

                        </div>

                    </div>
                
                    <div class="col-xl-12">
                        <table class="table table-sm m-0">
                            <thead>
                                <tr>
                                    <td width="120">Resumen Caja</td>
                                    <th>Boletas</th>
                                    <th>Facturas</th>
                                    <th>Anuladas</th>
                                    <th>Notas Crédito</th>
                                    <th>Notas Débito</th>
                                    <th>Recaudado</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <th>Monto (S/.)</th>
                                    <td id="dMontoBoletas" class="text-info"></td>
                                    <td id="dMontoFacturas" class="text-teal"></td>
                                    <td id="dMontoAnulados" class="text-danger"></td>
                                    <td id="dMontoNotasCredito" class="text-warning"></td>
                                    <td id="dMontoNotasDebito" class="text-deep-purple"></td>
                                    <td id="dMontoRecaudado" class="text-muted"></td>
                                </tr>
                                <tr>
                                    <th>Cantidad</th>
                                    <td id="dCantidadBoletas" class="text-info"></td>
                                    <td id="dCantidadFacturas" class="text-teal"></td>
