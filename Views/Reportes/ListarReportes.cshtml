@section Css
    {
    <!-- plugin css -->
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/chosen/css/chosen.css" />
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/bootstrap-datetimepicker/css/bootstrap-datetimepicker.min.css" />
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/radio_css/css/radiobox.min.css" />
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/css/pages/radio_checkbox.css" />
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/jquery-validation-engine/css/validationEngine.jquery.css" />
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/bootstrapvalidator/css/bootstrapValidator.min.css" />
    <!--Page level styles-->
}
@using CapaEntidades
<header class="head">
    <div class="main-bar row">
        <div class="col-lg-6 col-md-4 col-sm-4">
            <h5 class="nav_top_align">
                <i class="fa fa-th"></i>Lista de Reportes de - @ViewBag.Modulo
            </h5>
        </div>
        <div class="col-lg-6 col-md-8 col-sm-8">
            <ol class="breadcrumb float-xs-right nav_breadcrumb_top_align">
                <li class="breadcrumb-item">
                    <a href="index1.html">
                        <i class="fa fa-home" data-pack="default" data-tags=""></i> Home
                    </a>
                </li>
                <li class="breadcrumb-item">
                    <a href="#">@ViewBag.Area</a>
                </li>
                <li class="breadcrumb-item active">Lista de Reportes de - @ViewBag.Modulo</li>
            </ol>
        </div>
    </div>
</header>
<div class="outer">
    <div class="inner bg-light lter bg-container">
        <div class="row">
            <div class="col-xs-12 data_tables">
                <div class="card">
                    <div class="card-header bg-white">
                        <i class="fa fa-table"></i> Lista de Reportes de - @ViewBag.Modulo
                    </div>
                    <input hidden="hidden" id="hdnIdListBar" name="idListBar" type="text" class="form-control" value="@ViewBag.idListBar">
                    <input hidden="hidden" id="hdnIdTipoServicio" name="idTipoServicio" type="text" class="form-control" value="@ViewBag.idTipoServicio">
                    <div class="card-block p-t-10">
                        <table id="lstReportes" class="table table-bordered" data-source="/Reportes/ListaReportes?area=Reportes">
                            <thead style="color: white;background: #3e6184;">
                                <tr>

                                    <th data-columna="Reporte" valign="middle" align="center">Nombre</th>
                                    <th data-columna="idReporte" valign="middle" align="center">id</th>
                                    <th data-columna="id_MenuReporte" valign="middle" align="center">idMenu</th>
                                    <th data-columna="Modulo" valign="middle" align="center">Modulo</th>
                                    <th data-columna="Accion" valign="middle" align="center">Acción</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>

                <div class="card mt-2">
                    <div class="card-header bg-white">
                        <i class="fa fa-pencil-square-o"></i> Reportes - UNIDAD DE SEGUROS
                    </div>

                    <div class="card-block">

                        <div class="row mt-2">
                            <div class="col-lg-12">
                                <ul class="list-group">
                                    <li class="list-group-item">Tablero Unidad de Seguros <button class="btn btn-info btn-sm float-lg-right" data-toggle="modal" data-target="#modalReporteTableroUnidadSeguros"><i class="fa-solid fa-eye"></i></button></li>
                                </ul>
                            </div>

                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>




@* =======================================================MODAL REPORTE TABLERO UNIDAD SEGUROS=========================================================================================== *@
<div class="modal fade display_none in" id="modalReporteTableroUnidadSeguros" tabindex="-1" role="dialog" aria-hidden="false" data-backdrop="static">

    <div class="modal-dialog modal-sm">

        <div class="modal-content" id="Reporte">
            <div class="modal-header modal-header bg-success">
                <h5 class="modal-title text-white" id="tituloRpt">Reporte Tablero Unidad Seguros</h5>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="card">
                            <div class="card-block">

                                <div class="row">
                                    <div class="col-md-12">
                                        <div class="form-group FechaIniRpt">
                                            <label for="txtFechaInicioTableroUnidadSeguro" class=" form-control-label">Fecha</label>
                                            <div class="input-group">
                                                <input type="text" class="form-control form_val_popup_dp3" placeholder="dd/mm/yyyy" data-date-format="dd/mm/yyyy" id="txtFechaInicioTableroUnidadSeguro" autocomplete="off">
                                                <span class="input-group-addon">
                                                    <i class="fa fa-calendar "></i>
                                                </span>
                                            </div>
                                        </div>                                        
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button id="btnGenerarReporteTableroUnidadSeguro" type="button" class="btn btn-success" onclick="ListarReportes.GenerarReporteTableroUnidadSeguro();">Generar Reporte</button>
                    <button type="button" class="btn btn-secondary" onclick="ListarReportes.CerrarModalReporteTableroUnidadSeguro();">Cancelar</button>
                </div>
            </div>
        </div>
    </div>
</div>
@* ============================================================================================================================================================= *@


<!-- /.outer -->
<!-- Modal -->
<!--- responsive model -->
<div class="modal fade in display_none" id="modalReporte" tabindex="-1" role="dialog" aria-hidden="false" style="overflow-y: scroll;">

    <div class="modal-dialog">

        <div class="modal-content" id="Reporte">
      

        </div>
    </div>
</div>
<!-- END modal-->



<div class="modal fade" id="modalReporteTamizajeOftalmologico" tabindex="-1" role="dialog" aria-labelledby="modalReporteTamizajeOftalmologicoLabel" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-sm" role="document">
        <div class="modal-content">
            <div class="modal-header modal-header" style="background: #1D6F42;">
                <h5 class="modal-title text-white" id="myModalLabel">Reporte Tamizaje Oftalmologico</h5>
            </div>
            <div class="modal-body">
                <div class="card mb-1">
                    <div class="card-block">
                        <div class="row">
                            <div class="col-xl-12">
                                <div class="form-group form-group-sm m-0">
                                    <label for="txtRptFechaInicioTamizajeOftalmologico" class="d-block text-truncate">Fecha Inicio</label>
                                    <div class="input-group input-group-sm">
                                        <input id="txtRptFechaInicioTamizajeOftalmologico" type="text" class="form-control form_val_popup_dp3 txtFechaRpt" placeholder="dd/mm/yyyy" data-date-format="dd/mm/yyyy" autocomplete="off">
                                        <span class="input-group-addon">
                                            <i class="fa fa-calendar"></i>
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <div class="col-xl-12">
                                <div class="form-group form-group-sm m-0">
                                    <label for="txtRptFechaFinTamizajeOftalmologico" class="d-block text-truncate">Fecha Fin</label>
                                    <div class="input-group input-group-sm">
                                        <input id="txtRptFechaFinTamizajeOftalmologico" type="text" class="form-control form_val_popup_dp3 txtFechaRpt" placeholder="dd/mm/yyyy" data-date-format="dd/mm/yyyy" autocomplete="off">
                                        <span class="input-group-addon">
                                            <i class="fa fa-calendar"></i>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                               
                <div class="check__toggle d-none">
                    <label class="toggle">
                        <input class="toggle__input" type="checkbox" id="chkRptEnExcelTamizajeOftalmologico" checked>
                        <span class="toggle__label mr-2">
                            <span class="toggle__text d-block text-truncate">En EXCEL</span>
                        </span>
                    </label>
                </div>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn text-white" style="background: #1D6F42;" id="btnGenerarReporteTamizajeOftalmologico">Generar Reporte <i class="fa-solid fa-file-excel ml-1"></i></button>
                <button type="button" class="btn btn-secondary" id="btnCerrarReporteTamizajeOftalmologico">Cerrar</button>
            </div>
        </div>
    </div>
</div>




@section Scripts
    {
    <script type="text/javascript" src="~/AdmiRE/vendors/chosen/js/chosen.jquery.js"></script>
    <script type="text/javascript" src="~/AdmiRE/vendors/raphael/js/raphael-min.js"></script>
    <script type="text/javascript" src="~/AdmiRE/vendors/justgage/js/justgage.js"></script>
    <script type="text/javascript" src="~/AdmiRE/vendors/d3/js/d3.min.js"></script>
    <script type="text/javascript" src="~/AdmiRE/vendors/c3/js/c3.min.js"></script>
    <script type="text/javascript" src="~/AdmiRE/vendors/bootstrap-datetimepicker/js/bootstrap-datetimepicker.min.js"></script>
    <script type="text/javascript" src="~/AdmiRE/vendors/bootstrapvalidator/js/bootstrapValidator.min.js"></script>
    <script src="~/AdmiRE/js/date.format.js"></script>
    <script type="text/javascript" src=@Href("~/js/Reportes/ListarReportes.js")></script>
    <script type="text/javascript" src="~/AdmiRE/vendors/sortable/js/Sortable.min.js"></script>
    <script type="text/javascript" src="~/AdmiRE/vendors/slimscroll/js/jquery.slimscroll.min.js"></script>
    <script type="text/javascript" src="~/AdmiRE/vendors/masked/masked.js"></script>
    <script type="text/javascript" src="~/AdmiRE/js/moment-with-locales.js"></script>

}


