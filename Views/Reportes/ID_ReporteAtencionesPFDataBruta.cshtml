<link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/chosen/css/chosen.css"/>
<link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/bootstrap-datetimepicker/css/bootstrap-datetimepicker.min.css"/>
<link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/radio_css/css/radiobox.min.css"/>
<link type="text/css" rel="stylesheet" href="~/AdmiRE/css/pages/radio_checkbox.css"/>
<link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/jquery-validation-engine/css/validationEngine.jquery.css"/>
<link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/bootstrapvalidator/css/bootstrapValidator.min.css"/>

<div class="modal-header modal-header bg-success">
    <h5 class="modal-title text-white" id="titulo">Reporte de Atenciones PP.FF. (Data Bruta)<label id="txtDatos" class="form-control-label"></label></h5>
</div>
<div class="modal-body">
    <div class="row">
        <div class="col-lg-12">
            <div class="card  m-t-5">
                @*<div class="card-header bg-white">Datos del Parto</div>*@
                <div class="card-block m-t-5">
                    <div class="row">
                        <div class="form-group ">
                            <div class="col-md-3 text-lg-right">
                                <label for="name4" class=" form-control-label">Tipo Servicio :</label>
                            </div>
                            <div class="col-md-9">
                                <div class="input-group">
                                    <select id="cboTipoServicio" class="chzn-select">
                                        <option value="-1">----------SELECCIONE----------</option>
                                        <option value="1">Consulta Externa</option>
                                        <option value="2">Emergencia</option>
                                        <option value="3">Hospitalización</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">

                        <div class="form-group ">
                            <div class="col-md-3 text-lg-right">
                                <label for="name4" class=" form-control-label">Servicio :</label>
                            </div>
                            <div class="col-md-9">
                                <div class="input-group">
                                    <select id="cboServicio" class="chzn-select"></select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="form-group ">
                            <div class="col-md-3 text-lg-right">
                                <label for="name4" class=" form-control-label">Fecha Inicio:</label>
                            </div>
                            <div class="col-md-9">
                                <div class="input-group">
                                    <input type="text" class="form-control form_val_popup_dp3" placeholder="dd/mm/yyyy" data-date-format="dd/mm/yyyy" id="txtFechaInicio" autocomplete="off">
                                    <span class="input-group-addon">
                                        <i class="fa fa-calendar "></i>
                                    </span>
                                </div>


                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="form-group ">
                            <div class="col-md-3 text-lg-right">
                                <label for="name4" class=" form-control-label">Fecha Fin:</label>
                            </div>
                            <div class="col-md-9">
                                <div class="input-group">
                                    <input type="text" class="form-control form_val_popup_dp3" placeholder="dd/mm/yyyy" data-date-format="dd/mm/yyyy" id="txtFechaFin" autocomplete="off">
                                    <span class="input-group-addon">
                                        <i class="fa fa-calendar "></i>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal-footer">
        <button id="btnGuardar" type="button" class="btn btn-success" onclick="ID_ReporteAtencionesPFDataBruta.GenerarReporte();">Generar Reporte</button>
        <button type="button" class="btn btn-secondary" onclick="ID_ReporteAtencionesPFDataBruta.CerrarModal();">Cancelar</button>
    </div>


</div>
<script src="~/js/Reportes/ID_ReporteAtencionesPFDataBruta.js"></script>