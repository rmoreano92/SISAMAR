@using Microsoft.Extensions.Configuration;
@{
    var version = new ConfigurationBuilder().AddJsonFile("appsettings.json").Build().GetValue<string>("Version");
    // var usaLabs = new ConfigurationBuilder().AddJsonFile("appsettings.json").Build().GetValue<string>("Configuraciones:UsaLabs");
}


@section Css
{
    <!-- plugin css -->
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/chosen/css/chosen.css" />
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/bootstrap-datetimepicker/css/bootstrap-datetimepicker.min.css" />
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/radio_css/css/radiobox.min.css" />
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/css/pages/radio_checkbox.css" />
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/jquery-tagsinput/css/jquery.tagsinput.css" />
    <link type="text/css" rel="stylesheet" href="~/css/ReporteRecienNacidoSIS.css" />
}
<header class="head">
    <div class="main-bar row">
        <div class="col-lg-6 col-md-4 col-sm-4">
            <h4 class="nav_top_align">
                <i class="fa fa-bed-pulse"></i>
                @*@ViewBag.Area*@
                Reporte de Atenciones sin Alta
            </h4>
        </div>
        <div class="col-lg-6 col-md-8 col-sm-8">
            <ol class="breadcrumb float-xs-right nav_breadcrumb_top_align">
                <li class="breadcrumb-item">
                    <a href="index1.html">
                        <i class="fa fa-home" data-pack="default" data-tags=""></i> Home
                    </a>
                </li>
                <li class="breadcrumb-item">
                    <a href="#">@ViewBag.Area</a>
                </li>
                <li class="breadcrumb-item active">Reporte Recien Nacidos</li>
            </ol>
        </div>
    </div>
</header>

<input type="text" id="hdNroEvaluacion" hidden />
<input type="text" id="hdIdTipoServicio" hidden />
<input type="hidden" value="@ViewBag.idMedico" id="idMedicotxt" />
<input type="hidden" value="@ViewBag.idUsuario" id="idUsuariotxt" />

<div class="outer">
    <div class="inner bg-light lter bg-container">
        <div class="row">
            <div class="card-block p-t-5">

                <ul class="nav nav-tabs" id="myTab" role="tablist">
                    <li class="nav-item" role="presentation">
                        <a href="#" class="nav-link nav-link-custom active" id="TabBusqueda" data-toggle="tab" data-target="#TabPanelBusqueda" role="tab" aria-controls="TabPanelBusqueda" aria-selected="true">Reporte</a>
                    </li>
                    <li class="nav-item m-0" role="presentation">
                        <a href="#" class="nav-link nav-link-custom" id="TabRegistro" data-toggle="tab" data-target="#TabPanelRegistro" role="tab" aria-controls="TabPanelRegistro" aria-selected="false" style="display:none;">Nota de ingreso</a>
                    </li>
                </ul>

                <div class="card">
                    <div class="card-block">
                        <div id="clothing-nav-content" class="tab-content pt-1">

                            <div role="tabpanel" class="tab-pane fade in active" id="TabPanelBusqueda" aria-labelledby="TabBusqueda-tab">

                                <div class="row">

                                    <div class="col-lg-12 mb-1">
                                        <div class="card" style="background-color: #ffe1ee;">
                                            @* <div class="card-header bg-white">DATOS DE LA ATENCIÓN</div> *@
                                            <div class="card-block p-t-5 custom-form">

                                                <div class="row">
                                                    <div class="col-lg-8">
                                                        <div class="row">
                                                            <div class="col-lg-6">
                                                                <label for="cboTipoConsulta" class="form-label">Tipo consulta</label>
                                                                <div class="input-group input-group-sm">
                                                                    <select class="chzn-select bloquear" id="cboTipoConsulta">
                                                                        <option value="1">Atenciones sin alta administrativa</option>
                                                                        <option value="2">Atenciones sin alta médica</option>
                                                                    </select>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>

                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-lg-12 mt-1">
                                        <button class="btn btn-success" id="btnDescargarReporteAtencionesSinAlta"><i class="fa-solid fa-file-excel"></i> Descargar</button>
                                        <table id="tblReporteAtencionesSinAlta" width="100%" class="table table-sm table-content-md table-bordered">
                                            <thead style="color: white;background: #434343">

                                                <tr>
                                                    <th style="width:9%">Tipo Servicio</th>
                                                    <th style="width:5%">N° Cuenta</th>
                                                    <th style="width:5%">N° Historia</th>
                                                    <th style="width:5%">N° Documento.</th>
                                                    <th style="width:20%">Paciente</th>
                                                    <th style="width:10%">Serv. Ingreso</th>
                                                    <th style="width:10%">Serv. Egreso</th>
                                                    <th style="width:10%">F. Ingreso</th>
                                                    <th style="width:10%">F. Egreso</th>

                                                    <th style="width:10%">F. Egreso Adm.</th>
                                                    <th style="width:8%">Estado Atencion</th>
                                                    <th style="width:8%">Estado Cuenta</th>
                                                </tr>
                                            </thead>
                                            <tbody></tbody>
                                        </table>
                                    </div>
                                </div>

                            </div>

                            <div role="tabpanel" class="tab-pane fade" id="TabPanelRegistro" aria-labelledby="TabPanelRegistro-tab">
                                <div id="modulo"></div>
                            </div>



                            <input type="hidden" value="@ViewBag.idEmpleado" id="idEmpleadotxt" /> @*JDELGADO001*@
                        </div>
                    </div>
                </div>

            </div>



            @section Scripts
            {
                <script type="text/javascript" src="~/AdmiRE/vendors/chosen/js/chosen.jquery.js"></script>
                <script type="text/javascript" src="~/AdmiRE/vendors/raphael/js/raphael-min.js"></script>
                <script type="text/javascript" src="~/AdmiRE/vendors/justgage/js/justgage.js"></script>
                <script type="text/javascript" src="~/AdmiRE/vendors/d3/js/d3.min.js"></script>
                <script type="text/javascript" src="~/AdmiRE/vendors/c3/js/c3.min.js"></script>
                <script type="text/javascript" src="~/AdmiRE/vendors/jquery-tagsinput/js/jquery.tagsinput.js"></script>
                <script type="text/javascript" src="~/AdmiRE/vendors/bootstrap-datetimepicker/js/bootstrap-datetimepicker.min.js"></script>
                <script type="text/javascript" src="~/AdmiRE/vendors/masked/masked.js"></script>
                <script src="https://momentjs.com/downloads/moment-with-locales.js"></script>


                <script src="~/AdmiRE/js/date.format.js"></script>


                <script type="text/javascript" src=@Href("~/js/Reportes/ReporteAtencionesSinAlta.js?v=" + version)></script>

            }

            <style>
                body {
                    padding-right: 0px !important;
                }

                nav.navbar {
                    background-color: #CC1414;
                }

                #clothing-nav-content2 .form-group {
                    margin-bottom: 0 !important;
                }

                #tblAtencion tr.over td {
                    background: #D6E8F8;
                    font-weight: bold;
                }

                .chosen-container {
                    width: 100% !important;
                }

                .modal-lg {
                    max-width: 1100px !important;
                }

                /*==============REFCON===============*/
                .chosen-disabled {
                    opacity: 1 !important;
                }

                    .chosen-disabled .chosen-single {
                        background: #eceeef !important;
                        border-color: rgba(0, 0, 0, 0.15) !important;
                    }

                .custom-control-indicator {
                    border: 1px solid darkgrey;
                }

                .text-right {
                    text-align: right !important;
                }

                .bg-light {
                    background-color: #f8f9fa !important;
                    color: #434343 !important;
                }

                .border-x-0 {
                    border-right: 0 !important;
                    border-left: 0 !important;
                }

                .btn-sm {
                    padding: 0.4rem 0.5rem !important;
                }

                legend {
                    width: auto !important;
                    padding: 0 5px !important;
                    font-size: 1.2rem !important;
                    margin-left: 5px !important;
                }

                fieldset {
                    border: 1px solid #ccc !important;
                    margin: 0px 10px !important;
                }

                .nav-link:hover {
                    border-color: whitesmoke !important;
                    background-color: whitesmoke !important;
                }

                .btn-outline-secondary {
                    color: #999 !important;
                    border-color: #999 !important;
                }

                    .btn-outline-secondary:hover {
                        color: #fff !important;
                        border-color: #ccc !important;
                    }

                #clothing-nav-content2 .form-group {
                    margin-bottom: 0 !important;
                }

                #tblAtencion tr.over td {
                    background: #D6E8F8;
                    font-weight: bold;
                }

                /*  .chosen-container chosen-container-single {
                                                                                                                                    width: 100% !important;
                                                                                                                                }*/


                .chosen-container {
                    width: 100% !important;
                }

                .modal-lg {
                    max-width: 1100px !important;
                }

                .titleAntecedentes {
                    color: #5353f9;
                    font-size: 15px;
                    font-weight: bold;
                }

            </style>
        </div>
    </div>
</div>

<div class="modal fade" id="modalReporteUCI" tabindex="-1" role="dialog" aria-labelledby="modalReporteUCILabel">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">Saldos por Almacén Por Fecha</h4>
            </div>
            <div class="modal-body">
                <div class="card-block">

                    <div class="row mt-2">
                        <div class="col-lg-12">
                            <div class="row">

                                <div class="col-md-6">
                                    <label for="txtFechaInicioReporte">Fecha Inicio</label>
                                    <div class="input-group form-group input-group-sm">
                                        <input type="text" class="form-control form_val_popup_dp3 search" placeholder="dd/mm/yyyy" data-date-format="dd/mm/yyyy" id="txtFechaInicioReporte" autocomplete="off">
                                        <span class="input-group-addon">
                                            <i class="fa fa-calendar"></i>
                                        </span>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <label for="txtFechaFinReporte">Fecha Fin</label>
                                    <div class="input-group form-group input-group-sm">
                                        <input type="text" class="form-control form_val_popup_dp3 search" placeholder="dd/mm/yyyy" data-date-format="dd/mm/yyyy" id="txtFechaFinReporte" autocomplete="off">
                                        <span class="input-group-addon">
                                            <i class="fa fa-calendar"></i>
                                        </span>
                                    </div>
                                </div>

                                @* <div class="col-md-2 d-flex align-items-end mb-1" style="height: 50px;">
                                <div>
                                <button type="button" class="btn btn-sm btn-default" style="padding-left: 1rem !important; padding-right: 1rem !important;">limpiar</button>
                                </div>
                                </div> *@
                                @*<div class="col-lg-12 mt-2">
                                <button class="btn btn-success btn-sm float-lg-right" id="btnGenerarSaldosPorAlmacen">Generar Reporte <i class="fa-solid fa-file-excel ml-1"></i></button>
                                </div>*@
                            </div>

                        </div>
                    </div>

                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-success" id="btnDescargarReporteUCI">Generar Reporte <i class="fa-solid fa-file-excel ml-1"></i></button>
            </div>
        </div>
    </div>
</div>



