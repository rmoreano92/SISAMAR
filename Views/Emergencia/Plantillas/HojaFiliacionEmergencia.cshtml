
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Hoja de Evaluación</title>
    @*<link type="text/css" rel="stylesheet" href="~/BootstrapV5.1.3/bootstrap.min.css" integrity="sha384-1BmE4kWBq78iYhFldvKuhfTAU6auU8tT94WrHftjDbrCEXSU1oBoqyl2QvZ6jIW3" crossorigin="anonymous" />*@
    <link type="text/css" rel="stylesheet" href="~/BootstrapV5.1.3/bootstrap.min.css" />
    <link href="~/BootstrapV5.1.3/font.roboto.css" rel="stylesheet">
    <style>
        body {
            font-size: 10px;
            color: black !important;
            font-family: 'Roboto', sans-serif;
            letter-spacing: 0.4px;
        }

        td, th {
            padding: 1.5px !important;
        }

        .font-sm {
            font-size: 8px;
        }

        .font-md {
            font-size: 11px;
        }

        .font-lg {
            font-size: 12px;
        }

        .table {
            border-color: #607d8b !important;
        }
    </style>
</head>


<body style="background: white;  width: 793px; height: 900px; position: relative;  /*border: 1px solid red;*/">

    <div class="row mt-4" style="width: 95%; margin-left: 15px">
        <div class="col-12 position-relative">

            <div class="row text-center mx-auto" style="width: 95%;">
                <div class="col-12"><span class="fw-bold" style="font-size: 12px;">@ViewBag.NombreInstitucion</span></div>
                <div class="col-12"><span style="font-size: 10px;">@ViewBag.DireccionInstitucion</span></div>
                <div class="col-12"><span style="font-size: 10px;">Telefono: @ViewBag.TelefonoInstitucion</span></div>
            </div>

            <div class="position-absolute text-center" style="width: 100px; right: 0px; top: 0px;">
                <div class="fw-bold w-100" style="font-size: 12px;">@ViewBag.FechaImpresion</div>
            </div>

            <div class="position-absolute" style="width: 90px; left:0px; top: 0px;">
                <img src="@ViewBag.Logo" width="100%" />
            </div>

            <br>
            <br>

            <div class="row text-center mx-auto" style="width: 100%;">
                <div class="col-12 my-2"><span class="fw-bold font-md" style="font-size: 20px;">HISTORIA CLÍNICA DE EMERGENCIA</span></div>
            </div>

            <table style="width: 750px; font-size: 16px;">
                <tr>
                    <th width="180px">Nro Historia</th>
                    <td width="180px">@ViewBag.NroHistoria - @ViewBag.TiposNumeracionHistoria</td>
                    <th width="160px">Nro Cuenta</th>
                    <td width="230px" class="text-truncate d-block">@ViewBag.NroCuenta @ViewBag.FuenteFinanciamiento</td>
                </tr>
            </table>

            <table style="width: 750px; font-size: 16px;">
                <tr>
                    <th width="180px">Apellidos Y Nombres</th>
                    <td width="570px" class="fw-bold">@ViewBag.PacienteNombres</td>
                </tr>
            </table>

            <table style="width: 750px; font-size: 16px;">
                <tr>
                    <th width="180px">Fecha Ingreso</th>
                    <td width="180px">@ViewBag.FechaCita</td>
                    <th width="160px">Edad (@ViewBag.TipoEdad)</th>
                    <td width="230px" class="text-truncate d-block">@ViewBag.Edad</td>
                </tr>
            </table>

            <table style="width: 750px; font-size: 16px;">
                <tr>
                    <th width="180px">Hora Ingreso</th>
                    <td width="180px">@ViewBag.HoraCita</td>
                    <th width="160px">Fecha Nacimiento</th>
                    <td width="230px" class="text-truncate d-block">@ViewBag.FechaNacimiento</td>
                </tr>
            </table>

            <table style="width: 750px; font-size: 16px;">
                <tr>
                    <th width="180px">Consultorio médico</th>
                    <td width="180px">@ViewBag.ServicioCita</td>
                    <th width="160px">Sexo</th>
                    <td width="230px" class="text-truncate d-block">@ViewBag.Sexo</td>
                </tr>
            </table>

            <table style="width: 750px; font-size: 16px;">
                <tr>
                    <th width="180px">Médico</th>
                    <td width="570px">@ViewBag.Medico</td>
                </tr>
            </table>

            <table style="width: 750px; font-size: 16px;">
                <tr>
                    <th width="180px">Teléfono</th>
                    <td width="180px">@ViewBag.Telefono</td>
                    <th width="160px">N° Documento</th>
                    <td width="230px" class="text-truncate d-block">@ViewBag.NroDocumento</td>
                </tr>
            </table>

            <table style="width: 750px; font-size: 16px;">
                <tr>
                    <th width="180px">Dirección</th>
                    <td width="570px">@ViewBag.DireccionDomicilio</td>
                </tr>
            </table>

            <table style="width: 750px; font-size: 16px;">
                <tr>
                    <th width="180px">Departamento</th>
                    <td width="180px">@ViewBag.NombreDepartamentoDomicilio</td>
                    <th width="160px">Provincia</th>
                    <td width="230px" class="text-truncate d-block">@ViewBag.NombreProvinciaDomicilio</td>
                </tr>
            </table>

            <table style="width: 750px; font-size: 16px;">
                <tr>
                    <th width="180px">Distrito</th>
                    <td width="180px" class="text-truncate d-block">@ViewBag.NombreDistritoDomicilio</td>
                    <th width="160px">Centro Poblado</th>
                    <td width="230px" class="text-truncate d-block">@ViewBag.NombreCentroPobladoDomicilio</td>
                </tr>
            </table>

            <table style="width: 750px; font-size: 16px;">
                <tr>
                    <th width="180px">Acompañante</th>
                    <td width="180px">@ViewBag.NombreAcompaniante</td>
                    <th width="160px" class="text-truncate d-block">Teléfono Acompañante</th>
                    <td width="230px" class="text-truncate d-block">@ViewBag.TelefonoAcompaniante</td>
                </tr>
            </table>

            <table style="width: 750px; font-size: 16px; margin-top: 20px;">
                <tr>
                    <th width="750px">FUNCIONES VITALES:</th>
                </tr>
            </table>

            <table style="width: 750px; font-size: 13px; border: 1px solid black; margin-top: 10px;">
                <tr>
                    <th width="150px" style="border: 1px solid black;">PRESION ARTERIAL</th>
                    <th width="150px" style="border: 1px solid black;">FREC. RESPIRATORIA</th>
                    <th width="150px" style="border: 1px solid black;">PULSO</th>
                    <th width="150px" style="border: 1px solid black;">TEMPERATURA</th>
                    <th width="150px" style="border: 1px solid black;">FREC.CARDIACA</th>
                </tr>
                <tr style="height: 25px;">
                    <td width="150px" style="border: 1px solid black;"></td>
                    <td width="150px" style="border: 1px solid black;"></td>
                    <td width="150px" style="border: 1px solid black;"></td>
                    <td width="150px" style="border: 1px solid black;"></td>
                    <td width="150px" style="border: 1px solid black;"></td>
                </tr>
            </table>

            <table style="width: 750px; font-size: 16px; margin-top: 15px;">
                <tr>
                    <th width="230px" class="text-truncate d-block">FUNCIONES BIOLOGICAS:</th>
                    <th width="520px" style="border-bottom: 1px solid black;"></th>
                </tr>
                <tr style="border-bottom: 1px solid black; height: 15px;">
                    <th width="750px" colspan="2"></th>
                </tr>
                <tr style="border-bottom: 1px solid black; height: 15px;">
                    <th width="750px" colspan="2"></th>
                </tr>
            </table>

            <table style="width: 750px; font-size: 16px; margin-top: 15px;">
                <tr>
                    <th width="200px" class="text-truncate d-block">EXPLORACION FISICA:</th>
                    <th width="550px" style="border-bottom: 1px solid black;"></th>
                </tr>
                <tr style="border-bottom: 1px solid black; height: 15px;">
                    <th width="750px" colspan="2"></th>
                </tr>
                <tr style="border-bottom: 1px solid black; height: 15px;">
                    <th width="750px" colspan="2"></th>
                </tr>
            </table>

            <table style="width: 750px; font-size: 16px; margin-top: 15px;">
                <tr>
                    <th width="200px" class="text-truncate d-block">SINTOMAS Y SIGNOS:</th>
                    <th width="550px" style="border-bottom: 1px solid black;"></th>
                </tr>
                <tr style="border-bottom: 1px solid black; height: 15px;">
                    <th width="750px" colspan="2"></th>
                </tr>
                <tr style="border-bottom: 1px solid black; height: 15px;">
                    <th width="750px" colspan="2"></th>
                </tr>
            </table>

            <table style="width: 750px; font-size: 16px; margin-top: 15px;">
                <tr>
                    <th width="750px">DIAGNOSTICOS:</th>
                </tr>
            </table>

            <table style="width: 750px; font-size: 13px; border: 1px solid black; margin-top: 10px;">
                <tr>
                    <th width="600px" style="border: 1px solid black; text-align: center;">Descripción</th>
                    <th width="25px" style="border: 1px solid black; text-align: center;">P</th>
                    <th width="25px" style="border: 1px solid black; text-align: center;">D</th>
                    <th width="25px" style="border: 1px solid black; text-align: center;">R</th>
                    <th width="75px" style="border: 1px solid black; text-align: center;">Código</th>
                </tr>

                @{
                    int index = 1;
                }
               
                <tr style="height: 20px;">
                    <td width="600px" style="border: 1px solid black; font-weight: bolder;">Causa externa</td>
                    <td width="25px" style="border: 1px solid black;"></td>
                    <td width="25px" style="border: 1px solid black;"></td>
                    <td width="25px" style="border: 1px solid black;"></td>
                    <td width="75px" style="border: 1px solid black;"></td>
                </tr>

                @foreach (System.Data.DataRow row in ViewBag.Diagnosticos.Rows)
                {
                    <tr style="height: 20px;">
                        <td width="600px" style="border: 1px solid black; font-weight: bolder;">DX @index @row["descripcion"]</td>
                        <td width="25px" style="border: 1px solid black;">@(row["codigoCIE10"].ToString() == "P" ? "X" : "")</td>
                        <td width="25px" style="border: 1px solid black;">@(row["codigoCIE10"].ToString() == "D" ? "X" : "")</td>
                        <td width="25px" style="border: 1px solid black;">@(row["codigoCIE10"].ToString() == "R" ? "X" : "")</td>
                        <td width="75px" style="border: 1px solid black;">@row["codigoCIE10"]</td>
                    </tr>

                    <br />
                    index++;
                }
                
               
            </table>

            <table style="width: 750px; font-size: 16px; margin-top: 20px;">
                <tr>
                    <th width="150px" class="text-truncate d-block">TRATAMIENTO:</th>
                    <th width="600px" style="border-bottom: 1px solid black;"></th>
                </tr>
                <tr style="border-bottom: 1px solid black; height: 15px;">
                    <th width="750px" colspan="2"></th>
                </tr>
                <tr style="border-bottom: 1px solid black; height: 15px;">
                    <th width="750px" colspan="2"></th>
                </tr>
                <tr style="border-bottom: 1px solid black; height: 15px;">
                    <th width="750px" colspan="2"></th>
                </tr>
                <tr style="border-bottom: 1px solid black; height: 15px;">
                    <th width="750px" colspan="2"></th>
                </tr>
                <tr style="border-bottom: 1px solid black; height: 15px;">
                    <th width="750px" colspan="2"></th>
                </tr>
                <tr style="border-bottom: 1px solid black; height: 15px;">
                    <th width="750px" colspan="2"></th>
                </tr>
                <tr style="border-bottom: 1px solid black; height: 15px;">
                    <th width="750px" colspan="2"></th>
                </tr>
            </table>



        </div>

    </div>

    <div class="row mt-4" style="page-break-before: always; position:relative;">
        <div class="col-12 position-relative">

            <div class="row text-center mx-auto" style="width: 95%;">
                <div class="col-12"><span class="fw-bold" style="font-size: 12px;">@ViewBag.NombreInstitucion</span></div>
                <div class="col-12"><span style="font-size: 10px;">@ViewBag.DireccionInstitucion</span></div>
                <div class="col-12"><span style="font-size: 10px;">Telefono: @ViewBag.TelefonoInstitucion</span></div>
            </div>

            <div class="position-absolute text-center" style="width: 100px; right: 0px; top: 0px;">
                <div class="fw-bold w-100" style="font-size: 12px;">@ViewBag.FechaImpresion</div>
            </div>

            <div class="position-absolute" style="width: 90px; left:0px; top: 0px;">
                <img src="@ViewBag.Logo" width="100%" />
            </div>

            <br>
            <br>


            <table style="width: 750px; font-size: 16px; margin-top: 15px;">
                <tr>
                    <th width="220px" class="text-truncate d-block">EXAMENES AUXILIARES:</th>
                    <th width="530px" style="border-bottom: 1px solid black;"></th>
                </tr>
                <tr style="border-bottom: 1px solid black; height: 15px;">
                    <th width="750px" colspan="2"></th>
                </tr>
                <tr style="border-bottom: 1px solid black; height: 15px;">
                    <th width="750px" colspan="2"></th>
                </tr>
                <tr style="border-bottom: 1px solid black; height: 15px;">
                    <th width="750px" colspan="2"></th>
                </tr>
                <tr style="border-bottom: 1px solid black; height: 15px;">
                    <th width="750px" colspan="2"></th>
                </tr>
            </table>


            <table style="width: 750px; font-size: 16px; margin-top: 20px;">
                <tr>
                    <th width="110px" class="text-truncate d-block">EVOLUCION:</th>
                    <th width="640px" style="border-bottom: 1px solid black;"></th>
                </tr>
                <tr style="border-bottom: 1px solid black; height: 15px;">
                    <th width="750px" colspan="2"></th>
                </tr>
                <tr style="border-bottom: 1px solid black; height: 15px;">
                    <th width="750px" colspan="2"></th>
                </tr>
                <tr style="border-bottom: 1px solid black; height: 15px;">
                    <th width="750px" colspan="2"></th>
                </tr>
                <tr style="border-bottom: 1px solid black; height: 15px;">
                    <th width="750px" colspan="2"></th>
                </tr>
                <tr style="border-bottom: 1px solid black; height: 15px;">
                    <th width="750px" colspan="2"></th>
                </tr>
                <tr style="border-bottom: 1px solid black; height: 15px;">
                    <th width="750px" colspan="2"></th>
                </tr>
                <tr style="border-bottom: 1px solid black; height: 15px;">
                    <th width="750px" colspan="2"></th>
                </tr>
                <tr style="border-bottom: 1px solid black; height: 15px;">
                    <th width="750px" colspan="2"></th>
                </tr>
                <tr style="border-bottom: 1px solid black; height: 15px;">
                    <th width="750px" colspan="2"></th>
                </tr>
            </table>

            <br />


            <table style="width: 750px; font-size: 13px; border: 1px solid black; margin-top: 10px;">
                <tr>
                    <th width="450px" style="border: 1px solid black;">INTERCONSULTAS SOLICITADAS /REALIZADAS</th>
                    <th width="150px" style="border: 1px solid black;">FECHA</th>
                    <th width="150px" style="border: 1px solid black;">HORA</th>
                </tr>
                <tr style="height: 25px;">
                    <td width="450px" style="border: 1px solid black;"></td>
                    <td width="150px" style="border: 1px solid black;"></td>
                    <td width="150px" style="border: 1px solid black;"></td>
                </tr>
            </table>

            <br />

            <table style="width: 750px; font-size: 16px; margin-top: 20px;">
                <tr>
                    <th width="750px">PROCEDIMIENTOS MÉDICOS-QUIRURGICOS QUE SE REALIZARON:</th>
                </tr>
            </table>

            <table style="width: 750px; font-size: 13px; border: 1px solid black; margin-top: 10px;">
                <tr>
                    <th width="650px" style="border: 1px solid black; text-align: center;">Descripción</th>
                    <th width="100px" style="border: 1px solid black; text-align: center;">Código</th>
                </tr>
                <tr style="height: 25px;">
                    <td width="650px" style="border: 1px solid black; font-weight: bold;">P1</td>
                    <td width="100px" style="border: 1px solid black;"></td>
                </tr>
                <tr style="height: 25px;">
                    <td width="650px" style="border: 1px solid black; font-weight: bold;">P2</td>
                    <td width="100px" style="border: 1px solid black;"></td>
                </tr>
                <tr style="height: 25px;">
                    <td width="650px" style="border: 1px solid black; font-weight: bold;">P3</td>
                    <td width="100px" style="border: 1px solid black;"></td>
                </tr>
                <tr style="height: 25px;">
                    <td width="650px" style="border: 1px solid black; font-weight: bold;">P4</td>
                    <td width="100px" style="border: 1px solid black;"></td>
                </tr>
            </table>


            <br />
            <br />
            <br />

            <table style="width: 750px; font-size: 16px;">
                <tr>
                    <th width="180px">FECHA DE ALTA:</th>
                    <td width="180px"></td>
                    <th width="160px">HORA::</th>
                    <td width="230px" class="text-truncate d-block"></td>
                </tr>
            </table>

            <br />

            <table style="width: 750px; font-size: 16px;">
                <tr>
                    <th width="750px">CONDICION DE EGRESADO:</th>
                </tr>
            </table>

            <table style="width: 750px; font-size: 16px;">
                <tr>
                    <th width="200px">( ) A su casa</th>
                    <th width="200px">( ) Citado</th>
                    <th width="200px">Fecha:</th>
                    <th width="150px" class="text-truncate d-block">Hora:</th>
                </tr>
                <tr>
                    <th width="200px">( ) Observación</th>
                    <th width="200px">N° cama</th>
                    <th width="200px">Fecha:</th>
                    <th width="150px" class="text-truncate d-block">Hora:</th>
                </tr>
                <tr>
                    <th width="200px">( ) Hospitalización</th>
                    <th width="200px">N° cama</th>
                    <th width="200px">Fecha:</th>
                    <th width="150px" class="text-truncate d-block">Hora:</th>
                </tr>
                <tr>
                    <th width="200px">( ) Sala de Operaciones</th>
                    <th width="200px"></th>
                    <th width="200px">Fecha:</th>
                    <th width="150px" class="text-truncate d-block">Hora:</th>
                </tr>
                <tr>
                    <th width="200px">( ) Fallecido</th>
                    <th width="200px"></th>
                    <th width="200px">Antes 24 h</th>
                    <th width="150px" class="text-truncate d-block">Después 24 h</th>
                </tr>
                <tr>
                    <th width="200px">( ) Transferencia</th>
                    <th width="200px"></th>
                    <th width="200px"></th>
                    <th width="150px" class="text-truncate d-block">( ) Contrareferencia</th>
                </tr>
                <tr>
                    <th width="200px">( ) Fuga</th>
                    <th width="200px"></th>
                    <th width="200px"></th>
                    <th width="150px" class="text-truncate d-block"></th>
                </tr>
                <tr>
                    <th width="200px">( ) Retiro Voluntario</th>
                    <th width="200px"></th>
                    <th width="200px"></th>
                    <th width="150px" class="text-truncate d-block">( ) Llego Cadaver</th>
                </tr>
            </table>

            <br />
            <br />
            <br />
            <br />
            <br />


            <table style="width: 750px; font-size: 16px;">
                <tr>
                    <th width="550px" style="border-top: 1px solid black; text-align: center;">Firma y Sello del Médico Responsable Atencion/Emergencia</th>
                    <th width="200px"></th>
                </tr>
            </table>


        </div>

    </div>
    <script src="~/BootstrapV5.1.3/bootstrap.bundle.min.js"></script>

</body>



</html>