@{
    Layout = null;
    // Espera en ViewBag: PacienteNombre, GradoParentesco, NroCIP, Garante, Dependencia, FechaIngreso, DiagnosticoAlta, Observaciones, FechaSalida, HoraSalida, Usuario, FechaImpresion, CodigoQR (byte[])
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Papeleta de Egreso</title>
    <style>
        body { font-family: Arial, sans-serif; font-size: 11px; color: #000; }
        .container { width: 700px; margin: 0 auto; padding: 10px; }
        .header { text-align: center; margin-bottom: 8px; }
        .title { font-weight:700; font-size: 16px; letter-spacing: 1px; }
        .row { display:flex; margin-bottom:6px; }
        .label { width: 140px; font-weight:600; }
        .value { flex:1; border-bottom:1px dotted #000; padding-left:6px; }
        .textarea { min-height: 60px; border: 1px dotted #000; padding:6px; }
        .sign { margin-top: 30px; display:flex; justify-content:space-between; }
        .sign .box { width: 200px; text-align:center; border-top:1px solid #000; padding-top:6px; }
         .logo {
            display: flex;
            align-items: center;
            gap: 12px;
        }
         .inst {
            font-size: 12px;
            line-height: 1;
            font-weight: 700;
            text-transform: uppercase;
        }
        .logo img {
            max-height: 64px
        .qr { position: absolute; right: 20px; top: 20px; width:70px; }
    </style>
</head>
<body>
    
    <div class="container">
          <div class="logo">
                <img src="@ViewBag.Logo" style="width:50px;" />
                <div class="inst">
                    DIRECCIÓN DE SALUD Y CENTRO MÉDICO NAVAL<br />
                    "CIRUJANO MAYOR SANTIAGO TAVARÁ"
                </div>
        </div>
        @if (ViewBag.CodigoQR != null) {
            <img class="qr" src="@String.Format("data:image/png;base64,{0}", Convert.ToBase64String((byte[])ViewBag.CodigoQR))" />
        }
        <div class="header">
            <div class="title">PAPELETA DE EGRESO</div>
        </div>

        <div class="row">
            <div class="label">Paciente:</div>
            <div class="value">@ViewBag.PacienteNombre</div>
        </div>

        <div class="row">
            <div class="label">Grado / Parentesco:</div>
            <div class="value">@ViewBag.GradoParentesco</div>
        </div>

        <div class="row">
            <div class="label">N° de CIP:</div>
            <div class="value">@ViewBag.NroCIP</div>
        </div>

        <div class="row">
            <div class="label">Garante:</div>
            <div class="value">@ViewBag.Garante</div>
        </div>

        <div class="row">
            <div class="label">Dependencia:</div>
            <div class="value">@ViewBag.Dependencia</div>
        </div>

        <div class="row">
            <div class="label">Fecha de ingreso:</div>
            <div class="value">@ViewBag.FechaIngreso</div>
        </div>

        <div class="row">
            <div class="label">Diagnóstico de alta:</div>
            <div class="value">@ViewBag.DiagnosticoAlta</div>
        </div>

        <div class="row">
            <div class="label">SALIO:</div>
            <div class="value">@ViewBag.EstadoSalida</div>
        </div>

        <div class="row">
            <div class="label">Observaciones:</div>
            <div class="value textarea">@ViewBag.Observaciones</div>
        </div>

        <div class="row">
            <div class="label">Fecha de salida:</div>
            <div class="value">@ViewBag.FechaSalida @ViewBag.HoraSalida</div>
        </div>
        </br>
        </br>
        </br>
        </br>
        </br>
        <div class="sign">
            <div class="box">Jefe del Departamento Clínico</div>
              <div>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                  &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                  &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                  &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</div>
            <div class="box">El Médico de Servicio</div>
        </div>

       @*  <div style="margin-top:12px; font-size:10px; color:#555;">
            Impreso por: @ViewBag.Usuario - Fecha impresión: @ViewBag.FechaImpresion
        </div> *@
    </div>
</body>
</html>