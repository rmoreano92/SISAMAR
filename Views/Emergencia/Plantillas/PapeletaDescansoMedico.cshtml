@{
    Layout = null;
    var grado = (ViewBag.Grado as string) ?? "";
    var paciente = (ViewBag.Paciente as string) ?? "";
    var cip = (ViewBag.Cip as string) ?? "";
    var dependencia = (ViewBag.Dependencia as string) ?? "";
    var totalHoras = (ViewBag.TotalHorasDescanso as string) ?? "";
    var fechaInicio = (ViewBag.FechaInicioDescanso as string) ?? "";
    var fechaFin = (ViewBag.FechaFinDescanso as string) ?? "";
    var fechaTexto = (ViewBag.FechaTexto as string) ?? "";
    var logoUrl = (ViewBag.LogoUrl as string) ?? Url.Content("@ViewBag.Logo");
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Papeleta de Descanso Médico</title>
    <style>
        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            color: #222;
            background: #fff;
            margin: 0;
            padding: 0;
        }
        .page {
            width: 750px;
            margin: 26px auto;
            padding: 36px 48px 32px 48px;
            background: #fff;
            border-radius: 10px;
            box-shadow: 0 2px 16px #0001;
            box-sizing: border-box;
        }
        .header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 2px solid #0a3a5a;
            padding-bottom: 10px;
            margin-bottom: 18px;
        }
        .logo {
            display: flex;
            align-items: center;
            gap: 14px;
        }
        .logo img {
            max-height: 60px;
        }
        .inst {
            font-size: 13px;
            font-weight: 700;
            color: #0a3a5a;
            text-transform: uppercase;
            line-height: 1.1;
        }
        .ss-note {
            font-size: 11px;
            color: #888;
            text-align: right;
        }
        .title {
            text-align: center;
            font-size: 22px;
            font-weight: 800;
            letter-spacing: 1px;
            margin: 24px 0 28px 0;
            color: #0a3a5a;
            text-transform: uppercase;
        }
        .info-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 18px;
        }
        .info-table td {
            padding: 7px 6px 7px 0;
            font-size: 15px;
            vertical-align: top;
        }
        .info-table .label {
            font-weight: 600;
            color: #0a3a5a;
            width: 180px;
            text-align: right;
            padding-right: 12px;
        }
        .info-table .value {
            border-bottom: 1.5px dotted #0a3a5a;
            min-width: 180px;
            padding-left: 6px;
            color: #222;
        }
        .descanso-row {
            margin: 18px 0 10px 0;
            font-size: 16px;
            text-align: center;
        }
        .descanso-row strong {
            color: #0a3a5a;
        }
        .fecha-block {
            text-align: right;
            margin: 32px 0 0 0;
            font-size: 15px;
        }
        .fecha-line {
            display: inline-block;
            border-bottom: 1.5px dotted #0a3a5a;
            min-width: 180px;
            padding: 2px 8px;
            font-size: 15px;
        }
        .firma {
            margin-top: 60px;
            text-align: center;
        }
        .firma .firma-line {
            display: inline-block;
            border-bottom: 2px solid #0a3a5a;
            min-width: 260px;
            padding: 8px 10px;
            margin-bottom: 8px;
        }
        .firma .text {
            margin-top: 4px;
            font-size: 15px;
            font-weight: 700;
            color: #0a3a5a;
        }
        .pie {
            margin-top: 60px;
            font-size: 13px;
            color: #555;
            display: flex;
            justify-content: space-between;
        }
        @media print {
            body { background: #fff; }
            .page { box-shadow: none; border-radius: 0; margin: 0; width: auto; }
        }
    </style>
</head>
<body>
    <div class="page">
        <div class="header">
            <div class="logo">
                <img src="@ViewBag.Logo" />
                <div class="inst">
                    DIRECCIÓN DE SALUD Y CENTRO MÉDICO NAVAL<br />
                    "CIRUJANO MAYOR SANTIAGO TAVARÁ"
                </div>
            </div>
            <div class="ss-note">SS – 135 (MOD. NOV. 2003)</div>
        </div>

        <div class="title">PAPELETA DE DESCANSO MÉDICO</div>

        <table class="info-table">
            <tr>
                <td class="label">Grado:</td>
                <td class="value">@grado</td>
                <td class="label">Paciente:</td>
                <td class="value">@paciente</td>
            </tr>
            <tr>
                <td class="label">CIP:</td>
                <td class="value">@cip</td>
                <td class="label">Dependencia:</td>
                <td class="value">@dependencia</td>
            </tr>
        </table>

        <div class="descanso-row">
            <span>Se otorga <strong>@totalHoras</strong> horas de <strong>descanso médico</strong></span>
        </div>

        <table class="info-table">
            <tr>
                <td class="label">Inicio:</td>
                <td class="value">@fechaInicio</td>
                <td class="label">Fin:</td>
                <td class="value">@fechaFin</td>
            </tr>
        </table>

        <div class="fecha-block">
            Fecha de emisión: <span class="fecha-line">@fechaTexto</span>
        </div>

        <div class="firma">
            <div class="firma-line"></div>
            <div class="text">El Médico Tratante</div>
            <div style="font-weight:600;">Sello y Firma</div>
        </div>

        <div class="pie">
            <div>Original: Paciente</div>
            <div>Copia: Archivo</div>
        </div>
    </div>
</body>
</html>