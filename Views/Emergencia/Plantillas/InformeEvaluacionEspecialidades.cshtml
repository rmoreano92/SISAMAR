                                                        <th class="border-0 p-0 align-middle" style="width: 70px;"><div class="border border-gray mx-1 px-1">NORMAL</div></th>
                                                    }
                                                    else
                                                    {
                                                        <th class="border-0 p-0 align-middle" style="width: 70px;"><div class="border border-gray mx-1 px-1 bg-yellow">ANORMAL</div></th>
                                                    }
                                                    <td class="border-0 pt-1 pb-1" style="width: 90px;">Extremidades</td>
                                                    <td class="border-0 pt-1 pb-1"><div class="border-bottom border-secondary">@ViewBag.DExtremidades</div></td>
                                                </tr>
                                                <tr>
                                                    @*<th class="border-0 p-0 align-middle @ViewBag.Piel" style="width: 25px;"><div class="item-box m-auto item-Si"></div></th>
                                                    <td class="border-0 p-0 align-middle @ViewBag.Piel" style="width: 25px;"><div class="item-box m-auto item-No"></div></td>*@
                                                    @if (ViewBag.Piel == "Si")
                                                    {
                                                        <th class="border-0 p-0 align-middle" style="width: 70px;"><div class="border border-gray mx-1 px-1">NORMAL</div></th>
                                                    }
                                                    else
                                                    {
                                                        <th class="border-0 p-0 align-middle" style="width: 70px;"><div class="border border-gray mx-1 px-1 bg-yellow">ANORMAL</div></th>
                                                    }
                                                    <td class="border-0 pt-1 pb-1" style="width: 90px;">Piel</td>
                                                    <td class="border-0 pt-1 pb-1"><div class="border-bottom border-secondary">@ViewBag.DPiel</div></td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>

                        </div>

                        @if (ViewBag.ObservacionTriaje != "" && ViewBag.ObservacionTriaje != null)
                        {
                            <div class="mt-1">
                                <form>
                                    <fieldset class="border border-secondary px-2">
                                        <legend class="float-none w-auto font-weight-bold m-0" style="font-size: 8.5px;">OBSERVACIONES</legend>
                                        <div class="white-space" style="min-height: 20px;">@ViewBag.ObservacionTriaje</div>
                                    </fieldset>
                                </form>
                            </div>
                        }

                    </div>

                </div>
            </div>
        </div>
                
    </div>

    @*-------------SIGUIENTE HOJA: PRIMERA EVALAUCIUON----------------*@
    <div class="w-100 pb-5" style="page-break-before: always; position:relative;">
        <div id="cajaTitulo">
            <p style="" class="fw-bold m-0">EVALUACIÓN Y SEGUIMIENTO EN EMERGENCIA N° @ViewBag.NroEvaluacion</p>
            @* <small class="fw-bold" style="color: lightgray">FN-000</small> *@
        </div>

        @if (ViewBag.CodigoQR != null)
        {
            <img class="qr-code" src="@String.Format("data:image/png;base64,{0}", Convert.ToBase64String(ViewBag.CodigoQR))" />
        }

        <div class="position-absolute text-right" style="right:75px; top:25px; font-size: 7px;">
            <span>@ViewBag.FechaImpresion</span><br />
            <span>@ViewBag.Usuario</span>
        </div>

        <div class="d-flex mb-1" style="font-size: 10px !important;">
            <table class="table table-bordered border-secondary m-0 me-2" style="width: 190px;">
                <tbody>
                    <tr>
                        <th class="border-secondary text-center fw-bold p-0" style="width:110px;">FECHA ATENCIÓN</th>
                        <td class="border-secondary text-center p-0">@ViewBag.FechaEvaluacion</td>
                    </tr>
                </tbody>
            </table>

            <table class="table table-bordered border-secondary m-0" style="width: 190px;">
                <tbody>
                    <tr>
                        <th class="border-secondary text-center fw-bold p-0" style="width:110px;">HORA ATENCIÓN</th>
                        <td class="border-secondary text-center p-0">@ViewBag.HoraEvaluacion</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="card mb-2 border-secondary">
            <div class="card-header border-secondary">
                EVALUACIÓN
            </div>
            <div class="card-block">
                <div class="white-space" style="min-height:70px;">@ViewBag.Evaluacion</div>
                @*<textarea id="evaluacion" class="w-100" style="height:100px;">@ViewBag.Evaluacion</textarea>*@
            </div>
        </div>

        <div class="card mb-2 border-secondary">
            <div class="card-header border-secondary">
                DIAGNÓSTICO
            </div>
            <div class="card-block">
                <div style="min-height: 70px;">
                    @{
                        int index = 1;
                    }
                    @foreach (System.Data.DataRow row in ViewBag.DxEvaluacion.Rows)
                    {
                        <span style="font-weight: bold;">DX @index</span>
                        <span>@row["codigoCIE10"] - @row["descripcion"] <b>(@row["tipoDiagnostico"])</b></span>
                        <br />
                        index++;
                    }
                </div>
            </div>
        </div>

        <div class="d-flex mb-2 ">
            <div class="w-50 border border-secondary">
                <div class="card  border-0">
                    <div class="card-header border-secondary">
                        TRATAMIENTO
                    </div>
                    <div class="card-block  border-0">
                        <div class="white-space  border-0" style="min-height:70px;">@ViewBag.ImpresionDiagnostica</div>
                        @*<textarea id="planTratamiento" class="w-100" style="height:100px;">@ViewBag.ImpresionDiagnostica</textarea>*@
                    </div>
                </div>
            </div>
            <div class="w-50 border border-secondary">
                <div class="card  border-0">
                    <div class="card-header border-secondary">
                        PLAN DE TRABAJO
                    </div>
                    <div class="card-block  border-0">
                        <div class="white-space border-0" style="min-height:70px;">@ViewBag.PlanTrabajo</div>
                        @*<textarea id="planTrabajo" class="w-100" style="height:100px;">@ViewBag.PlanTrabajo</textarea>*@
                    </div>
                </div>
            </div>
        </div>

        <div class=" ms-auto mt-4 pt-5 mb-2" style="width: 250px;">
            <div class="border-top border-secondary text-center p-1">
                SELLO Y FIRMA DEL RESPONSABLE<br />
                <b>@ViewBag.Medico</b>
            </div>
        </div>

        @*<table class="table table-bordered border-secondary m-0">
        <tbody>
        <tr>
        <th class="border-secondary table-active text-center p-0" style="background-color: #ebe9e9;">APELLIDOS Y NOMBRES</th>
