@* <div class="modal fade" id="modalReprogramacionMedica" style="background-color: rgba(0, 0, 0, 0.46);" data-backdrop="static"> *@
<div class="modal fade" id="modalReportesEstadistica" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="false" data-backdrop="static" data-keyboard="false">

    <div class="modal-dialog modal-lg">

        <div class="modal-content">
            <div class="modal-header bg-brown"><h5 class="text-white m-0">Reportes Estadística</h5></div>
            <div class="modal-body">

                <div class="row">
                    <div class="col-lg-4">
                        <label class="radioButtonStyleLabel">
                                <input type="radio" name="rdbTipoReporteEstadistica" class="radioButtonStyleInput" id="rdbTipoReporteMinsaEmer" value="1">
                                <span class="radioButtonStyleSpan w-100">Minsa Emergencia</span>
                        </label>
                    </div>

                    <div class="col-lg-4">
                        <label class="radioButtonStyleLabel">
                            <input type="radio" name="rdbTipoReporteEstadistica" class="radioButtonStyleInput" id="rdbTipoReportePPREmer" value="5">
                            <span class="radioButtonStyleSpan w-100">PPR Emergencia</span>
                        </label>
                    </div>

                    <div class="col-lg-4">
                        <label class="radioButtonStyleLabel">
                            <input type="radio" name="rdbTipoReporteEstadistica" class="radioButtonStyleInput" id="rdbTipoReporteGeneralEmer" value="8">
                            <span class="radioButtonStyleSpan w-100">General Emergencia</span>
                        </label>
                    </div>
                </div>

                <div class="row">
                    <div class="col-lg-4">
                        <label class="radioButtonStyleLabel">
                            <input type="radio" name="rdbTipoReporteEstadistica" class="radioButtonStyleInput" id="rdbTipoReporteMinsaCE" value="2">
                            <span class="radioButtonStyleSpan w-100">Minsa Consulta Externa</span>
                        </label>
                    </div>
                    <div class="col-lg-4">
                        <label class="radioButtonStyleLabel">
                            <input type="radio" name="rdbTipoReporteEstadistica" class="radioButtonStyleInput" id="rdbTipoReportePPRCE" value="6">
                            <span class="radioButtonStyleSpan w-100">PPR Consulta Externa</span>
                        </label>
                    </div>

                    <div class="col-lg-4">
                        <label class="radioButtonStyleLabel">
                            <input type="radio" name="rdbTipoReporteEstadistica" class="radioButtonStyleInput" id="rdbTipoReporteGeneralCE" value="9">
                            <span class="radioButtonStyleSpan w-100">General Consulta Externa</span>
                        </label>
                    </div>
                </div>

                <div class="row">
                    <div class="col-lg-4">
                        <label class="radioButtonStyleLabel">
                            <input type="radio" name="rdbTipoReporteEstadistica" class="radioButtonStyleInput" id="rdbTipoReporteMinsaApoyoDx" value="3">
                            <span class="radioButtonStyleSpan w-100">Apoyo al Diagnóstico</span>
                        </label>
                    </div>

                    <div class="col-lg-4">
                        <label class="radioButtonStyleLabel">
                            <input type="radio" name="rdbTipoReporteEstadistica" class="radioButtonStyleInput" id="rdbTipoReporteProdMed" value="7">
                            <span class="radioButtonStyleSpan w-100">Producción de Médicos</span>                                
                        </label>
                        <select class="chzn-select w-100" id="cboMedicoReporteEstadistica" data-placeholder="Seleccione una opción"></select>
                    </div>

                    <div class="col-lg-4">
                        <label class="radioButtonStyleLabel">
                            <input type="radio" name="rdbTipoReporteEstadistica" class="radioButtonStyleInput" id="rdbTipoReporteMinsaEgresosHosp" value="4">
                            <span class="radioButtonStyleSpan w-100">Egresos Hospitalarios</span>
                        </label>
                    </div>
                </div>

                <div class="row mt-1">
                    <div class="col-lg-4">
                        <label class="radioButtonStyleLabel">
                            <input type="radio" name="rdbTipoReporteEstadistica" class="radioButtonStyleInput" id="rdbTipoReporteEdisip" value="10">
                            <span class="radioButtonStyleSpan w-100">Reporte EDISIP</span>
                        </label>
                    </div>

                    <div class="col-lg-4">
                        <label class="radioButtonStyleLabel">
                            <input type="radio" name="rdbTipoReporteEstadistica" class="radioButtonStyleInput" id="rdbTipoReporteProcedimientos" value="11">
                            <span class="radioButtonStyleSpan w-100">Reporte de Procedimientos</span>
                        </label>
                    </div>

                    @* <div class="col-lg-4">
                    </div> *@
                </div>

                

                <div class="row">
                    <div class="col-xl-2">
                        <div class="form-group m-0">
                            <label for="txtFechaInicioRepEst">Fecha Inicio</label>
                            <div class="input-group input-group-sm">
                                <input type="text" autocomplete="off" class="form-control form_val_popup_dp3" placeholder="dd/mm/yyyy" data-date-format="dd/mm/yyyy" id="txtFechaInicioRepEst">
                                <span class="input-group-addon">
                                    <i class="fa fa-calendar "></i>
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-2">
                        <div class="form-group m-0">
                            <label for="txtFechaFinRepEst">Fecha Fin</label>
                            <div class="input-group input-group-sm">
                                <input type="text" autocomplete="off" class="form-control  form_val_popup_dp3" placeholder="dd/mm/yyyy" data-date-format="dd/mm/yyyy" id="txtFechaFinRepEst">
                                <span class="input-group-addon">
                                    <i class="fa fa-calendar "></i>
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-3">
                        <button class="btn btn-brown mt-2" id="btnGenerarReporteEstadistica">GENERAR REPORTE</button>
                    </div>
                </div>

            </div>
            <div class="modal-footer">
                <button id="btnCerrarHerrReportesEstadistica" class="btn btn-secondary">Cerrar</button>
            </div>
        </div>
    </div>
</div>