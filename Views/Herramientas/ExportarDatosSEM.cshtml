@* <div class="modal fade" id="modalReprogramacionMedica" style="background-color: rgba(0, 0, 0, 0.46);" data-backdrop="static"> *@
<div class="modal fade" id="modalReporteSEM" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="false" data-backdrop="static" data-keyboard="false">

    <div class="modal-dialog modal-sm">

        <div class="modal-content">
            <div class="modal-header bg-brown"><h5 class="text-white m-0">Reportes Estadística</h5></div>
            <div class="modal-body">

                <div class="row mb-1 d-none">
                    <div class="col-xl-12">
                        <label class="radioButtonStyleLabel">
                            <input type="radio" name="rdbTipoReporteExportaSEM" class="radioButtonStyleInput" id="rdbTipoReporteExportaSEMEmer" value="1">
                            <span class="radioButtonStyleSpan w-100">Emergencia</span>
                        </label>
                        <label class="radioButtonStyleLabel">
                            <input type="radio" name="rdbTipoReporteExportaSEM" class="radioButtonStyleInput" id="rdbTipoReporteExportaSEMHosp" value="2">
                            <span class="radioButtonStyleSpan w-100">Hospitalización</span>
                        </label>
                    </div>                    
                </div>

                <div class="row mb-1">
                    <div class="col-xl-12">
                        <label class="radioButtonStyleLabel">
                            <input type="radio" name="rdbTipoPacienteExportaSEM" class="radioButtonStyleInput" id="rdbTipoPacienteExportaSEMEmer" value="1">
                            <span class="radioButtonStyleSpan w-100">Adultas</span>
                        </label>
                        <label class="radioButtonStyleLabel">
                            <input type="radio" name="rdbTipoPacienteExportaSEM" class="radioButtonStyleInput" id="rdbTipoPacienteExportaSEMHosp" value="2">
                            <span class="radioButtonStyleSpan w-100">Neonatos</span>
                        </label>
                    </div>                    
                </div>

                <div class="row">
                    <div class="col-xl-6">
                        <div class="form-group m-0">
                            <label for="txtFechaInicioExpSEM">Fecha Inicio</label>
                            <div class="input-group input-group-sm">
                                <input type="text" autocomplete="off" class="form-control form_val_popup_dp3" placeholder="dd/mm/yyyy" data-date-format="dd/mm/yyyy" id="txtFechaInicioExpSEM">
                                <span class="input-group-addon">
                                    <i class="fa fa-calendar "></i>
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-6">
                        <div class="form-group m-0">
                            <label for="txtFechaFinExpSEM">Fecha Fin</label>
                            <div class="input-group input-group-sm">
                                <input type="text" autocomplete="off" class="form-control  form_val_popup_dp3" placeholder="dd/mm/yyyy" data-date-format="dd/mm/yyyy" id="txtFechaFinExpSEM">
                                <span class="input-group-addon">
                                    <i class="fa fa-calendar "></i>
                                </span>
                            </div>
                        </div>
                    </div>
                   @*  <div class="col-xl-3">
                        
                    </div> *@
                </div>

            </div>
            <div class="modal-footer">
                <button id="btnGenerarReporteSEM" class="btn btn-brown">GENERAR REPORTE</button>
                <button id="btnCerrarHerrReporteSEM" class="btn btn-secondary">Cerrar</button>
            </div>
        </div>
    </div>
</div>