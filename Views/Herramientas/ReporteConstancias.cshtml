@* <div class="modal fade" id="modalReprogramacionMedica" style="background-color: rgba(0, 0, 0, 0.46);" data-backdrop="static"> *@
<div class="modal fade" id="modalReporteConstancias" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel"
    aria-hidden="false" data-backdrop="static" data-keyboard="false">

    <div class="modal-dialog modal-sm">

        <div class="modal-content">
            <div class="modal-header bg-brown">
                <h5 class="text-white m-0">Reporte Constancias</h5>
            </div>
            <div class="modal-body">
               <div class="row">
                    <div class="col-xl-12">
                        <div class="form-group m-0">
                            <label for="txtFechaInicioConstancias">Fecha Inicio</label>
                            <div class="input-group input-group-sm">
                                <input type="text" autocomplete="off" class="form-control form_val_popup_dp3"
                                    placeholder="dd/mm/yyyy" data-date-format="dd/mm/yyyy" id="txtFechaInicioConstancias">
                                <span class="input-group-addon">
                                    <i class="fa fa-calendar "></i>
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-12">
                        <div class="form-group m-0">
                            <label for="txtFechaFinConstancias">Fecha Fin</label>
                            <div class="input-group input-group-sm">
                                <input type="text" autocomplete="off" class="form-control  form_val_popup_dp3"
                                    placeholder="dd/mm/yyyy" data-date-format="dd/mm/yyyy" id="txtFechaFinConstancias">
                                <span class="input-group-addon">
                                    <i class="fa fa-calendar "></i>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-xl-3">
                        <button class="btn btn-brown mt-2" id="btnGenerarReporteConstancias">GENERAR REPORTE</button>
                    </div>
                </div>

            </div>
            <div class="modal-footer">
                <button id="btnCerrarHerrReporteConstancias" class="btn btn-secondary">Cerrar</button>
            </div>
        </div>
    </div>
</div>