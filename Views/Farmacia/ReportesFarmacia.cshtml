@section Css
{
    <!-- plugin css -->
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/chosen/css/chosen.css" />
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/bootstrap-datetimepicker/css/bootstrap-datetimepicker.min.css" />
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/radio_css/css/radiobox.min.css" />
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/css/pages/radio_checkbox.css" />
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/jquery-tagsinput/css/jquery.tagsinput.css" />
}


<header class="head">
    <div class="main-bar row">
        <div class="col-lg-6 col-md-4 col-sm-4">
            <h4 class="nav_top_align">
                <i class="fa fa-th"></i>
                @ViewBag.Area
            </h4>
        </div>
        <div class="col-lg-6 col-md-8 col-sm-8">
            <ol class="breadcrumb float-xs-right nav_breadcrumb_top_align">
                <li class="breadcrumb-item">
                    <a href="index1.html">
                        <i class="fa fa-home" data-pack="default" data-tags=""></i> Home
                    </a>
                </li>
                <li class="breadcrumb-item">
                    <a href="#">@ViewBag.Area</a>
                </li>
                <li class="breadcrumb-item active">Reportes</li>
            </ol>
        </div>
    </div>
</header>

<div class="outer">
    <div class="inner bg-light lter bg-container">
        <div class="row">
            <div class="col-xs-12 data_tables">
                <div class="card">
                    <div class="card-header bg-white">
                        <i class="fa fa-pencil-square-o"></i> Reportes - Farmacia
                    </div>

                    <div class="card-block">

                        <div class="row mt-2">
                            <div class="col-lg-12">
                                <ul class="list-group">
                                    <li class="list-group-item">Saldos por Almacén <button class="btn btn-info btn-sm float-lg-right" data-toggle="modal" data-target="#modalSaldosPorAlmacen"><i class="fa-solid fa-eye"></i></button></li>
                                    <li class="list-group-item">Saldos por Almacén (Por Fecha) <button class="btn btn-info btn-sm float-lg-right" data-toggle="modal" data-target="#modalSaldosPorAlmacenPorFecha"><i class="fa-solid fa-eye"></i></button></li>
                                    <li class="list-group-item">Reporte ICI - MGP/Ventas <button class="btn btn-info btn-sm float-lg-right" data-toggle="modal" data-target="#modalReporteICI_MGP"><i class="fa-solid fa-eye"></i></button></li>

                                    <li class="list-group-item">Formato ICI <button class="btn btn-info btn-sm float-lg-right" data-toggle="modal" data-target="#modalICI"><i class="fa-solid fa-eye"></i></button></li>
                                    <li class="list-group-item">Formato IDI <button class="btn btn-info btn-sm float-lg-right" data-toggle="modal" data-target="#modalIDI"><i class="fa-solid fa-eye"></i></button></li>
                                    <li class="list-group-item">Reporte de Consumo en el Servicio <button class="btn btn-info btn-sm float-lg-right" data-toggle="modal" data-target="#modalActividadesConsumoServicio"><i class="fa-solid fa-eye"></i></button></li>


                                    <li class="list-group-item">Consumo en el Servicio (Farmacia)<button class="btn btn-info btn-sm float-lg-right" data-toggle="modal" data-target="#modalActividadesConsumoServicioFarmacia"><i class="fa-solid fa-eye"></i></button></li>
                                    <li class="list-group-item">Recetas por servicio <button class="btn btn-info btn-sm float-lg-right" data-toggle="modal" data-target="#modalRecetasPorServicio"><i class="fa-solid fa-eye"></i></button></li>
                                    <li class="list-group-item">Registro de Ventas <button class="btn btn-info btn-sm float-lg-right" data-toggle="modal" data-target="#modalRegistroVentas"><i class="fa-solid fa-eye"></i></button></li>



                                    <li class="list-group-item">Productos en Desabastecimiento <button class="btn btn-info btn-sm float-lg-right" data-toggle="modal" data-target="#modalProductosEnDesabastecimiento"><i class="fa-solid fa-eye"></i></button></li>
                                    <li class="list-group-item">Productos en Sobrestock <button class="btn btn-info btn-sm float-lg-right" data-toggle="modal" data-target="#modalProductosEnSobrestock"><i class="fa-solid fa-eye"></i></button></li>
                                    <li class="list-group-item">Reporte Recetas Médicas <button class="btn btn-info btn-sm float-lg-right" data-toggle="modal" data-target="#modalMovimientoRecetas"><i class="fa-solid fa-eye"></i></button></li>
                                    <li class="list-group-item">Reporte Medicamentos por Vencer <button class="btn btn-info btn-sm float-lg-right" data-toggle="modal" data-target="#modalMedicamentosPorVencer"><i class="fa-solid fa-eye"></i></button></li>
                                    <li class="list-group-item">Reporte Fajos <button class="btn btn-info btn-sm float-lg-right" data-toggle="modal" data-target="#modalReporteFajos"><i class="fa-solid fa-eye"></i></button></li>

                                    <li class="list-group-item">Reporte Total Ventas<button class="btn btn-info btn-sm float-lg-right" data-toggle="modal" data-target="#modalReporteTotalVentas"><i class="fa-solid fa-eye"></i></button></li>

                                    <li class="list-group-item">Reporte Psicotrópicos<button class="btn btn-info btn-sm float-lg-right" data-toggle="modal" data-target="#modalReportePsicotropicos"><i class="fa-solid fa-eye"></i></button></li>

                                    <li class="list-group-item">Reporte Antimicrobianos<button class="btn btn-info btn-sm float-lg-right" data-toggle="modal" data-target="#modalReporteAntimicrobianos"><i class="fa-solid fa-eye"></i></button></li>
                                    <li class="list-group-item">Movimiento de Documentos de Entrada y Salida<button class="btn btn-info btn-sm float-lg-right" data-toggle="modal" data-target="#modalReporteMovimientoEntradaSalida"><i class="fa-solid fa-eye"></i></button></li>
                                    <li class="list-group-item">Productos por Vencer<button class="btn btn-info btn-sm float-lg-right" data-toggle="modal" data-target="#modalProductosPorVencer"><i class="fa-solid fa-eye"></i></button></li>
                                    <li class="list-group-item">Recetas por Servicio<button class="btn btn-info btn-sm float-lg-right" data-toggle="modal" data-target="#modalReporteAntimicrobianos"><i class="fa-solid fa-eye"></i></button></li>
                                    <li class="list-group-item">Recetas registradas por Usuario del Sistema<button class="btn btn-info btn-sm float-lg-right" data-toggle="modal" data-target="#modalReporteAntimicrobianos"><i class="fa-solid fa-eye"></i></button></li>
                                </ul>
                            </div>

                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="modalSaldosPorAlmacen" tabindex="-1" role="dialog" aria-labelledby="modalSaldosPorAlmacenLabel">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">Saldos por Almacén</h4>
            </div>
            <div class="modal-body">
                <partial name="~/Views/Shared/Components/VistasParciales/Farmacia/SaldosPorAlmacen.cshtml" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-success" id="btnGenerarSaldosPorAlmacen">Generar Reporte <i class="fa-solid fa-file-excel ml-1"></i></button>
            </div>
        </div>
    </div>
</div>



