<div class="modal fade" id="modalActividadesConsumoServicio" tabindex="-1" role="dialog" aria-labelledby="modalActividadesConsumoServicioLabel">
    <div class="modal-dialog modal-sm" role="document">
        <div class="modal-content">
            <div class="modal-header modal-header" style="background: #1D6F42;">
                <h5 class="modal-title text-white" id="myModalLabel">Consumo en el Servicio</h5>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-12">
                        <div class="form-group form-group-sm">
                            <label for="cboUsuarioConsumoServicio">Usuario</label>
                            <select id="cboUsuarioConsumoServicio" class="chzn-select"></select>
                        </div>
                        <div class="form-group form-group-sm">
                            <label for="txtFechaInicioConsumoServicio">Fecha Inicio</label>
                            <div class="input-group input-group-sm">
                                <input type="text" autocomplete="off" class="form-control form_val_popup_dp3" placeholder="dd/mm/yyyy" data-date-format="dd/mm/yyyy" id="txtFechaInicioConsumoServicio">
                                <span class="input-group-addon">
                                    <i class="fa fa-calendar"></i>
                                </span>
                            </div>
                        </div>
                        <div class="form-group form-group-sm">
                            <label for="txtFechaFinConsumoServicio">Fecha Fin</label>
                            <div class="input-group input-group-sm">
                                <input type="text" autocomplete="off" class="form-control form_val_popup_dp3" placeholder="dd/mm/yyyy" data-date-format="dd/mm/yyyy" id="txtFechaFinConsumoServicio">
                                <span class="input-group-addon">
                                    <i class="fa fa-calendar"></i>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal" id="btnCerrarConsumoServicioFarmacia">Cerrar</button>
                <button type="button" class="btn text-white" style="background: #1D6F42;" id="btnConsumoServicioFarmacia">Generar Reporte <i class="fa-solid fa-file-excel ml-1"></i></button>
            </div>
        </div>
    </div>
</div>

