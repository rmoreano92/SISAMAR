@using Microsoft.Extensions.Configuration;
@{
    var version = new ConfigurationBuilder().AddJsonFile("appsettings.json").Build().GetValue<string>("Version");
    // var usaLabs = new ConfigurationBuilder().AddJsonFile("appsettings.json").Build().GetValue<string>("Configuraciones:UsaLabs");
}

<div>
    <div>
        <div>
            @section Css
            {
                <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/chosen/css/chosen.css" />
                <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/bootstrap-datetimepicker/css/bootstrap-datetimepicker.min.css" />
                <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/radio_css/css/radiobox.min.css" />
                <link type="text/css" rel="stylesheet" href="~/AdmiRE/css/pages/radio_checkbox.css" />
                <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/jquery-tagsinput/css/jquery.tagsinput.css" />
            }

            <header class="head">
                <div class="main-bar row">
                    <div class="col-lg-6 col-md-4 col-sm-4">
                        <h4 class="nav_top_align">
                            <i class="fa fi fi-ss-binoculars"></i>
                            Farmaco Vigilancia
                        </h4>
                    </div>
                    <div class="col-lg-6 col-md-8 col-sm-8">
                        <ol class="breadcrumb float-xs-right nav_breadcrumb_top_align">
                            <li class="breadcrumb-item">
                                <a href="index1.html">
                                    <i class="fa fa-home" data-pack="default" data-tags=""></i> Home
                                </a>
                            </li>
                            <li class="breadcrumb-item">
                                <a href="#">@ViewBag.Area</a>
                            </li>
                            <li class="breadcrumb-item active">@ViewBag.Modulo</li>
                        </ol>
                    </div>
                </div>
            </header>


            <div class="row m-0">
                <div class="col-sm-12">
                    <ul class="nav nav-tabs" id="myTab" role="tablist">
                        <li class="nav-item" role="presentation">
                            <a href="#PanelBusqueda-tab" class="nav-link nav-link-custom active" id="TabBusqueda" data-toggle="tab" data-target="#TabPanelBusqueda" role="tab" aria-controls="TabPanelBusqueda" aria-selected="true">Busqueda</a>
                        </li>
                        <li class="nav-item m-0" role="presentation">
                            <a href="#PanelRegistro-tab" class="nav-link nav-link-custom" id="TabRegistro" data-toggle="tab" data-target="#TabPanelRegistro" role="tab" aria-controls="TabPanelRegistro" aria-selected="false" style="display:none;">Registro Notificaciones</a>
                        </li>
                    </ul>

                    <div class="tab-content border pt-1 pl-1 pr-1" id="myTabContent">
                        <!--=============================================Panel Busqueda==================================================================-->
                        <div class="tab-pane fade active in" id="TabPanelBusqueda" role="tabpanel" aria-labelledby="TabBusqueda">
                            <div class="row">
                                <div class="col-lg-12">
                                    <div class="card">
                                        <div class="card-block">
                                            <div class="row">
                                                <div class="col-lg-8">
                                                    <div class="row">                                                        
                                                        <div class="col-lg-2">
                                                            <div class="form-group m-0">
                                                                <label for="txtNroCuenta" class="form-control-label">N° Cuenta</label>
                                                                <div class="input-group">
                                                                    <input id="txtNroCuenta" autocomplete="off" placeholder="" class=" solo-numero form-control form-control-sm searchFarmacoVigilancia">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-lg-2">
                                                            <div class="form-group m-0">
                                                                <label for="txtNroDni" class="form-control-label">N° Dni</label>
                                                                <div class="input-group">
                                                                    <input id="txtNroDni" autocomplete="off" placeholder="" class=" solo-numero form-control form-control-sm searchFarmacoVigilancia">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-lg-2">
                                                            <div class="form-group m-0">
                                                                <label for="txtNroHistoria" class="form-control-label">N° Historia</label>
                                                                <div class="input-group">
                                                                    <input id="txtNroHistoria" autocomplete="off" placeholder="" class=" solo-numero form-control form-control-sm searchFarmacoVigilancia">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-lg-3">
                                                            <div class="form-group m-0">
                                                                <label for="txtApPaterno" class="form-control-label">Ap. Paterno</label>
                                                                <div class="input-group">
                                                                    <input id="txtApPaterno" autocomplete="off" placeholder="" class=" form-control form-control-sm searchFarmacoVigilancia">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-lg-3">
                                                            <div class="form-group m-0">
                                                                <label for="txtApMaterno" class="form-control-label">Ap. Materno</label>
                                                                <div class="input-group">
                                                                    <input id="txtApMaterno" autocomplete="off" placeholder="" class=" form-control form-control-sm searchFarmacoVigilancia">
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-lg-2">
                                                    <div class="d-flex align-items-end" style="height: 55px;">
                                                        <button class="btn btn-sm btn-primary layout_btn_prevent mr-1" id="btnBuscarFarmacoVigilancia" style="padding-left: 2rem !important; padding-right: 2rem !important;">Buscar</button>
                                                        <button class="btn btn-sm btn-secondary layout_btn_prevent" id="btnLimpiarFarmacoVigilancia" style="padding-left: 2rem !important; padding-right: 2rem !important;">Limpiar</button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-12 pt-2 pb-0">
                                    @{
                                        if (@ViewBag.Agregar)
                                        {
                                            <button class="btn btn-success layout_btn_prevent" id="btnAgregar">Agregar</button>
                                        }
                                        if (@ViewBag.Modificar)
                                        {
                                            <button class="btn btn-info layout_btn_prevent" id="btnModificar">Modificar</button>
                                        }
                                        if (@ViewBag.Consultar)
                                        {
                                            <button class="btn btn-warning layout_btn_prevent" id="btnConsultar">Consultar</button>
                                        }
                                        if (@ViewBag.Eliminar)
                                        {
                                            <button class="btn btn-danger layout_btn_prevent" id="btnEliminar">Eliminar</button>
                                        }                                        
                                    }
                                </div>

                                <div class="col-md-12">
                                    <table id="tblFarmacoVigilancia" width="100%" class="table table-sm table-bordered table-content-md">
                                        <thead style="color: white; background-color: #434343;">
                                            <tr>
                                                <th>N° Cuenta</th>
                                                <th>Historia</th>
                                                <th>Paciente</th>
                                                <th>Fec. Ing.</th>
                                                <th>Servicio Ingreso</th>                                                
                                                <th>Plan</th>
                                                <th>Servicio Actual</th>
                                                <th>Estado</th>
                                                @* <th>Notificaciones</th> *@
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>

                            </div>
                        </div>
                        <!--=============================================Panel Registro==================================================================-->
                        <div class="tab-pane fade" id="TabPanelRegistro" role="tabpanel" aria-labelledby="TabRegistro">                            
                            <partial name="~/Views/Shared/Components/VistasParciales/Farmacia/FarmacoVigilancia/RegistroFarmacoVigilancia.cshtml" />
                        </div>
                    </div>

                </div>
            </div>

            

        </div>
    </div>
</div>



@*============================= BUSQUEDA DE CUENTAS =======================================*@
<partial name="~/Views/Shared/Components/VistasParciales/Comun/BusquedaCuentasPacientes.cshtml" />

