{
    <script type="text/javascript" src="~/AdmiRE/vendors/chosen/js/chosen.jquery.js"></script>
    <script type="text/javascript" src="~/AdmiRE/vendors/raphael/js/raphael-min.js"></script>
    <script type="text/javascript" src="~/AdmiRE/vendors/justgage/js/justgage.js"></script>
    <script type="text/javascript" src="~/AdmiRE/vendors/d3/js/d3.min.js"></script>
    <script type="text/javascript" src="~/AdmiRE/vendors/c3/js/c3.min.js"></script>
    <script type="text/javascript" src="~/AdmiRE/vendors/jquery-tagsinput/js/jquery.tagsinput.js"></script>
    <script type="text/javascript" src="~/AdmiRE/vendors/bootstrap-datetimepicker/js/bootstrap-datetimepicker.min.js"></script>
    <script type="text/javascript" src="~/AdmiRE/vendors/masked/masked.js"></script>

    <script type="text/javascript" src=@Href("~/js/Farmacia/FarmacoVigilancia.js?v=" + version)></script>
    @* <script type="text/javascript" src=@Href("~/js/VistasParciales/Recetas/OrdenesV3.js?v=" + version)></script> *@
    <script type="text/javascript" src=@Href("~/js/Comun/Utilitarios.js?v=" + version)></script>
    <script type="text/javascript" src=@Href("~/js/VistasParciales/Recetas/VisorRecetas.js?v=" + version)></script>
    <script type="text/javascript" src=@Href("~/js/VistasParciales/Comun/BusquedaCuentasPacientes.js?v=" + version)></script>
    <script type="text/javascript" src=@Href("~/js/Comun/PermisosGenerales.js?v=" + version)></script>
    <script type="text/javascript" src=@Href("~/js/Comun/Variables.js?v=" + version)></script>

    <script src="~/AdmiRE/js/date.format.js"></script>
       
}

<style>
    .form-group {
        margin-bottom: 0.25rem;
    }

    #clothing-nav-content2 .form-group {
        margin-bottom: 0 !important;
    }

    #tblAtencion tr.over td {
        background: #D6E8F8;
        font-weight: bold;
    }
        
    .chosen-container {
        width: 100% !important;
    }

    .modal-lg {
        max-width: 1100px !important;
    }

    /*=======KHOYOSI============*/
    .chosen-disabled {
        opacity: 1 !important;
    }

        .chosen-disabled .chosen-single {
            background: #eceeef !important;
            border-color: rgba(0, 0, 0, 0.15) !important;
        }


    legend {
        width: auto !important;
        padding: 0 5px !important;
        font-size: 1.2rem !important;
        margin-left: 5px !important;
    }

    fieldset {
        border: 1px solid #ccc !important;
        margin: 0px 10px !important;
    }
</style>