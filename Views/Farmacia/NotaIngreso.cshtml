<div data-backdrop="static" data-keyboard="false" class="modal fade" id="modalReporteNotaIngreso" role="dialog" aria-hidden="false" style="background-color: #00000075;">
    <div class="modal-dialog" style="box-shadow: 0 20px 13px 0 rgb(0, 0, 0);">
        <div class="modal-content">
            <div class="modal-header bg-primary">
                <h4 class="modal-title text-white">Reporte Tamizaje</h4>
            </div>
            <div class="modal-body">

                <div class="row mb-1">

                    <div class="col-lg-4" ">
                        <div class="form-group m-0">
                            <label for="txtFechaInicio" class="form-control-label">Fecha Inicio</label>
                            <div class="input-group input-group-sm m-0">
                                <input type="text" autocomplete="off" class="form-control form_val_popup_dp3" placeholder="dd/mm/yyyy" data-date-format="dd/mm/yyyy" id="txtFechaInicio">
                                <span class="input-group-addon">
                                    <i class="fa fa-calendar "></i>
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <div class="form-group m-0">
                            <label for="txtFechaFin" class="form-control-label">Fecha Fin</label>
                            <div class="input-group input-group-sm m-0">
                                <input type="text" autocomplete="off" class="form-control form_val_popup_dp3" placeholder="dd/mm/yyyy" data-date-format="dd/mm/yyyy" id="txtFechaFin">
                                <span class="input-group-addon">
                                    <i class="fa fa-calendar "></i>
                                </span>
                            </div>
                        </div>
                    </div>


                    <div class="col-lg-2 d-flex align-items-end" style="height: 55px;">
                        <div>
                            <button class="btn btn-success btn-sm layout_btn_prevent" style="padding-left: 2rem !important; padding-right: 2rem !important;" id="btnGenerarRptTamizaje"><i class="fas fa-file-excel mr-1"></i> Descargar</button>
                        </div>
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button" data-dismiss="modal" class="btn btn-secondary">Close</button>
                </div>
            </div>
        </div>
    </div>
</div>

@*=========================================================================CONSUMO FARMACIA==============================================================================================*@
<div data-backdrop="static" data-keyboard="false" class="modal fade" id="modalConsumoFarmacia" role="dialog" aria-labelledby="modalLabelsuccess">
    <div class="modal-dialog modal-xxl" role="document">
        <div class="modal-content">

            <div class="modal-header bg-indigo">
                <span class="text-white" style="font-size: 1.28rem;font-weight: 500;letter-spacing: 0.5px;">Consumo Farmacia</span>
            </div>

            <div class="modal-body">
                <div class="row mb-1">
                    <div class="col-md-12">
                        <div class="card bg-blue">
                            @* <div class="card-header bg-white">Datos de Cabecera</div> *@
                            <div class="card-block">
                                <div class="row">
                                    <div class="col-md-12">
                                        <div class="row">
                                            <div class="col-lg-3">
                                                <div class="row">
                                                    <div class="col-lg-6">
                                                        <div class="form-group mb-0">
                                                            <label for="txtNroCuentaPacienteCF" class="form-control-label">Nro. Cuenta</label>
                                                            <input id="txtNroCuentaPacienteCF" autocomplete="off" placeholder="" class="solo-numero form-control form-control-sm" autocomplete="off" disabled readonly>
                                                        </div>
                                                    </div>
                                                    <div class="col-lg-6">
                                                        <div class="form-group mb-0">
                                                            <label for="txtNroHistoriaPacienteCF" class="form-control-label">Nro. Historia</label>
                                                            <input id="txtNroHistoriaPacienteCF" autocomplete="off" placeholder="" class="solo-numero form-control form-control-sm" autocomplete="off" disabled readonly>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-9">
                                                <div class="row">
                                                    <div class="col-lg-5">
                                                        <div class="form-group mb-0">
                                                            <label for="txtNombrePacienteCF">Paciente</label>
                                                            <input type="text" class="form-control form-control-sm" id="txtNombrePacienteCF" autocomplete="off" disabled readonly>
                                                        </div>
                                                    </div>
                                                    <div class="col-lg-7">
                                                        <div class="form-group mb-0">
                                                            <label for="txtServicioPacienteCF">Plan/Servicio</label>
                                                            <input type="text" class="form-control form-control-sm" id="txtServicioPacienteCF" autocomplete="off" disabled readonly>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                      
                                    </div>
                                                                        
                                </div>

                            </div>
                        </div>
                    </div>
                </div>

                <div class="row mb-2">
                    <div class="col-md-12">
                        <h5 class="text-sm-center mb-0 font-weight-bold" style="color: #791336;">Consumos de la cuenta</h5>
                        <table id="tblDetalleConsumoFarmacia" width="100%" class="table table-sm table-bordered table-striped table-content-sm">
                            <thead style="color: white; background: #791336;">
                                <tr>
                                    <th>Nro. Documento</th>
                                    <th>Fecha Documento</th>
                                    <th>Código</th>
                                    <th>Nombre Producto</th>
                                    <th>Cantidad</th>
                                    <th>Almacén</th>
                                    <th>Nro. Movim.</th>
                                    <th>Nro. Orden</th>
                                    <th>Fuente Finan.</th>
                                    <th>Acción</th>
                                </tr>
                            </thead>
                            <tbody style="cursor: pointer;"></tbody>
                        </table>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12">
                        <h5 class="text-sm-center mb-0 font-weight-bold" style="color: #20295e;">Productos a devolver</h5>
                        <table id="tblDetalleDevolucion" width="100%" class="table table-sm table-bordered table-striped table-content-sm">
                            <thead style="color: white; background: #20295e;">
                                <tr>
                                    <th>Nro. Documento</th>
                                    <th>Código</th>
                                    <th>Nombre Producto</th>                                    
                                    <th>Lote</th>
                                    <th>F. Vencimiento</th>
                                    <th>Cantidad</th>
                                    <th>Registro Sanitario</th>
                                    <th>Acción</th>
                                </tr>
                            </thead>
                            <tbody style="cursor: pointer;"></tbody>
                        </table>
                    </div>
                </div>

            </div>

            <div class="modal-footer mt-2">
                <button id="btnGuardarDevolucion" type="button" class="btn btn-indigo btn-lg mb-1 pl-3 pr-3" style="max-width: 140px;">Guardar</button>
                <button id="btnCancelarDevolucion" type="button" class="btn btn-secondary btn-lg mb-1 ml-2 pl-3 pr-3" style="max-width: 140px;">Cancelar</button>
            </div>

        </div>
    </div>

</div>



<div data-backdrop="static" style="overflow-y: scroll;" data-keyboard="false" class="modal fade" id="modalInforme" role="dialog" aria-labelledby="modalLabelsuccess">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary">
