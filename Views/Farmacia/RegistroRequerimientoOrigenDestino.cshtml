@using Microsoft.Extensions.Configuration;
@{
    var version = new ConfigurationBuilder().AddJsonFile("appsettings.json").Build().GetValue<string>("Version");
}

@section Css
{
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/chosen/css/chosen.css" />
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/bootstrap-datetimepicker/css/bootstrap-datetimepicker.min.css" />
}

<header class="head">
    <div class="main-bar row">
        <div class="col-lg-6 col-md-4 col-sm-4">
            <h4 class="nav_top_align"><i class="fa fa-exchange"></i> Registro de Requerimiento Origen - Destino</h4>
        </div>
    </div>
</header>

<div class="row m-0" id="appRequerimientoOD">
    <div class="col-md-12">
        <ul class="nav nav-tabs" id="myTab" role="tablist">
            <li class="nav-item" role="presentation">
                <a href="#" class="nav-link nav-link-custom active" id="TabBusqueda" data-toggle="tab" data-target="#TabPanelBusqueda" role="tab">Busqueda</a>
            </li>
            <li class="nav-item m-0" role="presentation">
                <a href="#" class="nav-link nav-link-custom" id="TabRegistro" data-toggle="tab" data-target="#TabPanelRegistro" role="tab" style="display:none;">Registro Requerimiento</a>
            </li>
        </ul>

        <div class="tab-content border pt-2 pl-2 pr-2 pb-2">
            <div class="tab-pane fade active in" id="TabPanelBusqueda" role="tabpanel">
                <div class="card mb-2"><div class="card-block"><div class="row align-items-end">
                    <div class="col-md-2"><label>Fecha inicio</label><input id="txtFechaInicioFiltro" class="form-control form-control-sm search" placeholder="dd/mm/yyyy" /></div>
                    <div class="col-md-2"><label>Fecha fin</label><input id="txtFechaFinFiltro" class="form-control form-control-sm search" placeholder="dd/mm/yyyy" /></div>
                    <div class="col-md-2"><label>Estado</label><select id="cboEstadoFiltro" class="form-control form-control-sm search"><option value="">Todos</option><option>PENDIENTE</option><option>APROBADO</option><option>RECHAZADO</option><option>DESESTIMADO</option></select></div>
                    <div class="col-md-3"><label>Origen</label><select id="cboOrigenFiltro" class="form-control form-control-sm search"></select></div>
                    <div class="col-md-3"><label>Destino</label><select id="cboDestinoFiltro" class="form-control form-control-sm search"></select></div>
                </div><div class="row mt-2"><div class="col-md-12">
                    <button id="btnBuscarRequerimientos" class="btn btn-primary btn-sm mr-1">Buscar</button>
                    <button id="btnLimpiarBusqueda" class="btn btn-secondary btn-sm">Limpiar</button>
                </div></div></div></div>

                <div class="mb-2">
                    <button class="btn btn-success btn-sm layout_btn_prevent" id="btnAgregarRequerimiento">Agregar</button>
                    <button class="btn btn-info btn-sm layout_btn_prevent" id="btnVerDetalleRequerimiento">Ver detalle</button>
                    <button class="btn btn-primary btn-sm layout_btn_prevent" id="btnAprobarRequerimiento">Aprobar</button>
                    <button class="btn btn-danger btn-sm layout_btn_prevent" id="btnRechazarRequerimiento">Rechazar</button>
                    <button class="btn btn-warning btn-sm layout_btn_prevent" id="btnDesestimarRequerimiento">Desestimar</button>
                </div>

                <table id="tblRequerimientosEnviados" class="table table-sm table-bordered w-100">
                    <thead style="color:white;background:#434343;"><tr><th>N°</th><th>Fecha</th><th>Origen</th><th>Destino</th><th>Estado</th><th>Acciones</th></tr></thead>
                    <tbody></tbody>
                </table>
            </div>

            <div class="tab-pane fade" id="TabPanelRegistro" role="tabpanel">
                <div class="card mb-2"><div class="card-block">
                    <div class="row">
                        <div class="col-md-3"><label>Tipo de compartimiento / origen</label><select id="cboTipoCompartimiento" class="form-control form-control-sm"></select></div>
                        <div class="col-md-3"><label>Origen</label><select id="cboOrigen" class="form-control form-control-sm"></select></div>
                        <div class="col-md-2"><label>Fecha de registro</label><input id="txtFechaRegistro" class="form-control form-control-sm" readonly /></div>
                        <div class="col-md-2"><label>Estado del requerimiento</label><input id="txtEstadoReq" class="form-control form-control-sm" readonly value="BORRADOR" /></div>
                        <div class="col-md-2"><label>Documento referencia</label><input id="txtDocumentoReferencia" class="form-control form-control-sm" maxlength="50" /></div>
                        <div class="col-md-8 mt-1"><label>Observaciones</label><input id="txtObservaciones" class="form-control form-control-sm" maxlength="250" /></div>
                        <div class="col-md-4 mt-1"><label>Destino</label><select id="cboDestino" class="form-control form-control-sm"></select></div>
                    </div>
                </div></div>

                <div class="card mb-2"><div class="card-block">
                    <div class="row align-items-end">
                        <div class="col-md-2"><label>Fecha inicio</label><input id="txtFechaInicioConsumo" class="form-control form-control-sm" placeholder="dd/mm/yyyy" /></div>
                        <div class="col-md-2"><label>Fecha fin</label><input id="txtFechaFinConsumo" class="form-control form-control-sm" placeholder="dd/mm/yyyy" /></div>
                        <div class="col-md-3"><button id="btnCalcularConsumo" class="btn btn-info btn-sm"><i class="fa fa-calculator"></i> Calcular consumo</button></div>
                    </div>
                </div></div>

                <div class="mb-2">
                    <button id="btnAgregarProducto" class="btn btn-primary btn-sm"><i class="fa fa-plus"></i> Agregar producto</button>
                </div>

                <table id="tblDetalleRequerimiento" class="table table-sm table-bordered w-100">
                    <thead style="color:white;background:#434343;">
                        <tr><th>Código</th><th>Producto</th><th>Unidad</th><th>Saldo Actual</th><th>Consumo</th><th>Cantidad a Solicitar</th><th>Acción</th></tr>
                    </thead>
                    <tbody></tbody>
                </table>

                <div class="mt-2">
                    <button id="btnEnviarRequerimiento" class="btn btn-success btn-sm">Enviar requerimiento</button>
                    <button id="btnGuardarRequerimiento" class="btn btn-info btn-sm">Guardar</button>
                    <button id="btnCancelarRequerimiento" class="btn btn-secondary btn-sm">Cancelar</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script type="text/javascript" src="~/AdmiRE/vendors/bootstrap-datetimepicker/js/bootstrap-datetimepicker.min.js"></script>
    <script type="text/javascript" src="~/AdmiRE/vendors/moment/js/moment.min.js"></script>
    <script type="text/javascript" src="~/js/Farmacia/RegistroRequerimientoOrigenDestino.js?v=@version"></script>
}
