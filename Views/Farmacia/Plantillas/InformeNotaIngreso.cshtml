@*<body style="background: white; width:793px; height:1145px; position:relative; /*border: 1px solid red;*/" class="pt-2 m-0">*@
<body style="background: transparent; width:698px; height:1015px; position:relative;">

    

    <img class="position-absolute" src="@ViewBag.ServerFiles/resources/images/Logo.png" style="height: 50px; top:-20px;" />

    <div class="text-center mb-3">
        <p class="fw-bold m-0" style="font-size: 12px;">@ViewBag.nombre</p>
        <p class="fw-bold" style="font-size: 8px; margin-bottom: 5px;">@ViewBag.direccion</p>
        <p class="fw-bold m-0" style="font-size: 8px;">TELEFONO: @ViewBag.telefono</p>
    </div>

    <div class="position-absolute text-right" style="right:80px; top:10px; font-size: 7px;">
        <span>@ViewBag.FechaImpresion</span><br />
        <span>@ViewBag.Usuario</span>
    </div>

    <div class="text-center mb-3">
        <p class="fw-bold m-0" style="font-size: 15px;">@ViewBag.Tipo </p>
    </div>

    <div id="cajaTitulo">
        <p style="font-size: 20px;" class="fw-bold m-0">@ViewBag.TipoDocumento - @ViewBag.DocumentoNumero</p>
        <small></small>
        @* <small class="fw-bold" style="color:lightgray">FN-000</small> *@
    </div>

    <div class="mb-2">
        <table>
            <tbody>

                <tr>
                    <th align="left" width="140" style="text-align: left;">Alm. Destino:</th>
                    <td width="300">@ViewBag.AlmacenDestino</td>
                    <th align="left" width="140" style="text-align: left;">N° Movimiento:</th>
                    <td width="300">@ViewBag.NroCuenta @ViewBag.MovNumero</td>
                </tr>

                <tr>
                    <th align="left" width="140" style="text-align: left;">Alm. Origen:</th>
                    <td width="300">@ViewBag.AlmacenOrigen</td>
                    <th align="left" width="140" style="text-align: left;">Fecha Movimiento:</th>
                    <td width="300">@ViewBag.NroCuenta @ViewBag.FechaMovimiento</td>
                </tr>

            </tbody>
        </table>
    </div>

    <div class="mb-2">
        <table class="table table-bordered border-secondary m-0 me-1">
            <tbody>

                <tr>
                    <th align="left" width="100" style="text-align: left;" class="border-secondary">Observaciones:</th>
                    <td width="500">@ViewBag.Observaciones</td>
                </tr>

            </tbody>
        </table>
    </div>


    @*  @foreach (System.Data.DataRow row in ViewBag.RecetasDespachadas.Rows)
    {
    <span>
    <b>&gt;&gt;Producto: </b>@row["Producto"] - <b>Dosis: </b>@row["Dosis"] - <b>ViaAdministracion: </b>@row["ViaAdministracion"] - <b>Frecuencia: </b>@row["Frecuencia"], &nbsp;&nbsp;&nbsp;
    </span>
    } *@

    <table class="table table-bordered border-secondary m-0 me-1">
        <thead>
            <tr>
                <th class="border-secondary text-center">CODIGO</th>
                <th class="border-secondary text-center" style="width:350px;">PRODUCTO</th>
                @*
                <th class="border-secondary text-center">UM</th>
                <th class="border-secondary text-center">Tipo Salida</th>
                *@
                <th class="border-secondary text-center">PETITORIO</th>
                <th class="border-secondary text-center">MARCA</th>
                <th class="border-secondary text-center">F.F.</th>
                <th class="border-secondary text-center">CANT.</th>
                <th class="border-secondary text-center">PRECIO UNIT.</th>
                <th class="border-secondary text-center">IMPORTE</th>
                <th class="border-secondary text-center">FECHA VENC.</th>
                <th class="border-secondary text-center">LOTE</th>
                <th class="border-secondary text-center">OBSERVACIÓN</th>
            </tr>
        </thead>
        <tbody>
            @foreach (System.Data.DataRow row in ViewBag.detalleRegistro.Rows)
            {
            <tr>
                    <td class="text-center">@row["Codigo"]</td>
                    <td>@row["Producto"]</td>
                    @*
                    <td>@row["UM"]</td>
                    <td>@row["tipo"]</td>    
                    *@
                    <td class="text-center">@(Convert.ToBoolean(row["Petitorio"]) ? "SI" : "NO")</td>
                    <td>@row["Fabricante"]</td>    
                    <td>@row["FormaFarmaceutica"]</td>    
                    <td class="text-center">@row["Cantidad"]</td>
                    <td class="text-right">@row["Precio"]</td>
