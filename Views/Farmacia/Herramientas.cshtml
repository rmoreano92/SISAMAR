@using CapaEntidades
<header class="head">
    <div class="main-bar row">
        <div class="col-lg-6 col-md-4 col-sm-4">
            <h4 class="nav_top_align">
                <i class="fa fa-wrench mr-1"></i>
                Herramientas - Farmacia @*- @ViewBag.Area*@
            </h4>
        </div>
        <div class="col-lg-6 col-md-8 col-sm-8">
            <ol class="breadcrumb float-xs-right nav_breadcrumb_top_align">
                <li class="breadcrumb-item">
                    <a href="index1.html">
                        <i class="fa fa-home" data-pack="default" data-tags=""></i> Home
                    </a>
                </li>
                <li class="breadcrumb-item">
                    <a href="#">@ViewBag.Area</a>
                </li>
                <li class="breadcrumb-item active">Herramientas</li>
            </ol>
        </div>
    </div>
</header>



<div class="outer">
    <div class="inner bg-light lter bg-container">
        <div class="row m-0">
            <div class="col-sm-12">
                <input hidden="hidden" id="hdIdProducto" type="text" class="form-control">
                <ul class="nav nav-tabs" id="myTab" role="tablist">
                    <li class="nav-item" role="presentation">
                        <a href="#" class="nav-link nav-link-custom active" id="TabFecVenc" data-toggle="tab" data-target="#TabPanel1" role="tab" aria-controls="TabPanel1" aria-selected="true">Actualizar Fecha Vencimiento </a>
                    </li>
                </ul>
                <div class="tab-content border pt-1 pl-1 pr-1" id="myTabContent">
                    <!--=============================================Panel Actualizar fecha vencimiento==================================================================-->
                    <div class="tab-pane fade active in" id="TabPanel1" role="tabpanel" aria-labelledby="TabFecVenc">
                        <div class="row">
                            <div class="col-lg-12">
                                <div class="card">
                                    <div class="card-block pb-0">
                                        <div class="row">
                                            <div class="col-md-2">
                                                <div class="form-group">
                                                    <label for="cboAlmacen">Almacen/Farmacia</label>
                                                    <select class="chzn-select w-100" id="cboAlmacen" data-placeholder="Seleccione una opción"></select>
                                                </div>
                                            </div>

                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label for="txtCodigo">Producto</label>
                                                    <div class="input-group input-group-sm d-flex">
                                                        <input type="text" class="form-control buscaProducto" id="txtCodigo" style="max-width: 120px">
                                                        <button class="btn btn-sm btn-primary" type="button" id="btnBuscarProducto" style="border-radius: 0;">
                                                            <i class="fa-solid fa-magnifying-glass mr-1 ml-1"></i>
                                                        </button>
                                                        <input type="text" class="form-control" id="txtDescripcion" disabled>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="col-md-2">
                                                <div class="form-group">
                                                    <label for="cboTipoSalida">Tipo Salida</label>
                                                    <select class="chzn-select w-100" id="cboTipoSalida"></select>
                                                </div>
                                            </div>

                                            <div class="col-md-2 d-flex align-items-end" style="height: 55px;">
                                                <div>
                                                    <button type="button" class="btn btn-sm btn-primary" style="padding-left: 2rem !important; padding-right: 2rem !important;" onclick="Kardex.ListarKardex();" id="btnListarKardex">Buscar</button>&nbsp;&nbsp;
                                                    <button type="button" class="btn btn-sm btn-default" style="padding-left: 2rem !important; padding-right: 2rem !important;" onclick="Kardex.LimpiarFiltroBusqueda();">limpiar</button>
                                                </div>
                                            </div>
                                        </div>
                                        
                                    </div>
                                </div>
                            </div>
                            
                            
                            <div class="col-md-12 mt-2">
                                <div class="card bg-green" style="border-color: #9ec9ec;">
                                    <div class="card-header bg-white">
                                        <div class="d-flex">
                                            <div>Resultado de Lotes</div>                                            
                                        </div>
                                    </div>
                                    <div class="card-block pt-1">
                                        <div class="row">
                                            <div class="col-md-12">
                                                <h5 id="KardexDescripcion1" class="d-flex"></h5>
                                                <h5 id="KardexDescripcion2" class="d-flex mb-1 m-t-5"></h5>
                                            </div>

                                            <div class="col-lg-12">
                                                <table id="tblSaldoLotes" width="100%" class="table table-sm table-bordered">
                                                    <thead style="color: white; background: #434343;">
                                                        <tr>
                                                            <th valign="middle" width: "25%">Almacen/Farmacia</th>
                                                            <th valign="middle" width: "20%">Lote</th>
                                                            <th valign="middle" width: "15%">Tipo Salida</th>
                                                            <th valign="middle" width: "20%">Fecha Vencimiento</th>
                                                            <th valign="middle" width: "10%">Cantidad</th>
                                                            <th valign="middle" width: "10%">Precio</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody style="cursor: pointer;"></tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>


<div class="modal fade display_none in" id="modalActualizarLote" tabindex="-1" role="dialog" aria-hidden="false" data-backdrop="static" style="background-color: rgba(0,0,0,0.4);">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header modal-header bg-info">
                <h5 class="modal-title text-white">Actualizar Fecha Vencimiento</h5>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-lg-12">
                        <div style="text-align: center;">
                            <i class="fa-solid fa-calendar-day fa-3x text-secondary"></i>
                            <p class="mt-1" id="DescModalActualizarLote"></p>
                        </div>
                        <div class="form-group">
                            <label style="font-weight: bold;">Nuevo Lote</label>
                            <input class="form-control" type="text" id="NuevoLote" required />
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button id="btnActualizarLote" type="button" class="btn btn-info" onclick="">Guardar</button>
                    <button type="button" class="btn btn-secondary" onclick="Kardex.CerrarModalActualizarFechaVencimiento();">Cancelar</button>
                </div>
            </div>
        </div>
    </div>
</div>


<div class="modal fade display_none in" id="modalActualizarFechaVencimiento" tabindex="-1" role="dialog" aria-hidden="false" data-backdrop="static" style="background-color: rgba(0,0,0,0.4);">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header modal-header bg-info">
                <h5 class="modal-title text-white">Actualizar Fecha Vencimiento</h5>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-lg-12">
                        <div style="text-align: center;">
                            <i class="fa-solid fa-calendar-day fa-3x text-secondary"></i>
                            <p class="mt-1" id="DescModalActualizarFechaVenc"></p>
                        </div>
                        <div class="form-group">
                            <label style="font-weight: bold;">Nueva fecha</label>
                            <input class="form-control" type="date" id="NuevaFechaVencimiento" required />
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button id="btnActualizarFechaVencimiento" type="button" class="btn btn-info" onclick="">Guardar</button>
                    <button type="button" class="btn btn-secondary" onclick="Kardex.CerrarModalActualizarFechaVencimiento();">Cancelar</button>
                </div>
            </div>
        </div>
    </div>
</div>



