@using Microsoft.Extensions.Configuration;
@{
    var version = new ConfigurationBuilder().AddJsonFile("appsettings.json").Build().GetValue<string>("Version");
    // var usaLabs = new ConfigurationBuilder().AddJsonFile("appsettings.json").Build().GetValue<string>("Configuraciones:UsaLabs");
}

@section Css
{
    <!-- plugin css -->
    @* <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/chosen/css/chosen.css" />
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/bootstrap-datetimepicker/css/bootstrap-datetimepicker.min.css" />
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/radio_css/css/radiobox.min.css" />
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/css/pages/radio_checkbox.css" />
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/jquery-tagsinput/css/jquery.tagsinput.css" /> *@

    <!-- plugin css -->
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/chosen/css/chosen.css" />
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/bootstrap-datetimepicker/css/bootstrap-datetimepicker.min.css" />
    @* <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/fullcalendar/3.10.0/fullcalendar.min.css"> *@
    <link type="text/css" rel="stylesheet" href="~/css/context-menu.css" />
}

<header class="head">
    <div class="main-bar row">
        <div class="col-lg-6 col-md-4 col-sm-4">
            <h4 class="nav_top_align">
                <i class="fa fa-clipboard-list-check"></i>
                @ViewBag.Modulo
            </h4>
        </div>
        <div class="col-lg-6 col-md-8 col-sm-8">
            <ol class="breadcrumb float-xs-right nav_breadcrumb_top_align">
                <li class="breadcrumb-item">
                    <a href="index1.html">
                        <i class="fa fa-home" data-pack="default" data-tags=""></i> Home
                    </a>
                </li>
                <li class="breadcrumb-item">
                    <a href="#">@ViewBag.Area</a>
                </li>
                <li class="breadcrumb-item active">@ViewBag.Modulo</li>
            </ol>
        </div>
    </div>
</header>

<div class="outer">
    <div class="inner bg-light lter bg-container">
        <div class="row">
            <div class="col-md-12">
                <ul class="nav nav-tabs" id="myTab" role="tablist">
                    <li class="nav-item" role="presentation">
                        <a href="#" class="nav-link nav-link-custom active" id="TabBusqueda" data-toggle="tab" data-target="#TabPanelBusqueda" role="tab" aria-controls="TabPanelBusqueda" aria-selected="true">Busqueda</a>
                    </li>
                    <li class="nav-item m-0" role="presentation">
                        <a href="#" class="nav-link nav-link-custom" id="TabRegistro" data-toggle="tab" data-target="#TabPanelRegistro" role="tab" aria-controls="TabPanelRegistro" aria-selected="false" style="display:none;">Registro Resultados</a>
                    </li>
                </ul>
                <div class="tab-content border pt-1 pl-1 pr-1" id="myTabContent">
                    <!--=============================================Panel Busqueda==================================================================-->
                    <div class="tab-pane fade active in" id="TabPanelBusqueda" role="tabpanel" aria-labelledby="TabBusqueda">
                        <div class="row">
                            <div class="col-xl-12 mb-2">
                                <div class="card">
                                    <div class="card-block pb-1">
                                        <div class="row">
                                            <div class="col-xl-4">
                                                <div class="row">
                                                    <div class="col-xl-4">
                                                        <div class="form-group m-0">
                                                            <label for="txtNroEvaluacionBusq" class="d-block text-truncate">N° Evaluación</label>
                                                            <input id="txtNroEvaluacionBusq" autocomplete="off" placeholder="" class=" solo-numero form-control form-control-sm search">
                                                        </div>
                                                    </div>
                                                    <div class="col-xl-4">
                                                        <div class="form-group m-0">
                                                            <label for="txtNroCuentaBusq" class="d-block text-truncate">N° Cuenta</label>
                                                            <input id="txtNroCuentaBusq" autocomplete="off" placeholder="" class=" solo-numero form-control form-control-sm search">
                                                        </div>
                                                    </div>
                                                    <div class="col-xl-4">
                                                        <div class="form-group m-0">
                                                            <label for="txtNroHistoriaBusq" class="d-block text-truncate">N° Historia</label>
                                                            <input id="txtNroHistoriaBusq" autocomplete="off" placeholder="" class=" solo-numero form-control form-control-sm search">
                                                        </div>
                                                    </div>
                                                                                                      
                                                </div>                                                
                                            </div>
                                            <div class="col-xl-4">
                                                <div class="row">
                                                    <div class="col-xl-4">
                                                        <div class="form-group m-0">
                                                            <label for="txtNroDocumentoBusq" class="d-block text-truncate">N° Documento</label>
                                                            <input id="txtNroDocumentoBusq" autocomplete="off" placeholder="" class=" solo-numero form-control form-control-sm search">
                                                        </div>
                                                    </div>
                                                    <div class="col-xl-4">
                                                        <div class="form-group m-0">
                                                            <label for="txtApPaternoBusq" class="d-block text-truncate">Ap. Paterno</label>
                                                            <input id="txtApPaternoBusq" autocomplete="off" placeholder="" class=" form-control form-control-sm search">
                                                        </div>
                                                    </div>
                                                    <div class="col-xl-4">
                                                        <div class="form-group m-0">
                                                            <label for="txtApMaternoBusq" class="d-block text-truncate">Ap. Materno</label>
                                                            <input id="txtApMaternoBusq" autocomplete="off" placeholder="" class=" form-control form-control-sm search">
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-xl-4">
                                                <div class="row">
                                                    <div class="col-xl-4">
                                                        <div class="form-group m-0">
                                                            <label for="txtFechaBusq" class="d-block text-truncate">Fecha</label>
                                                            <div class="input-group form-group input-group-sm m-0">
                                                                <input type="text" class="form-control form_val_popup_dp3 maskFecha search" placeholder="dd/mm/yyyy" data-date-format="dd/mm/yyyy" id="txtFechaBusq" autocomplete="off">
                                                                <span class="input-group-addon">
                                                                    <i class="fa fa-calendar"></i>
                                                                </span>
                                                            </div>
                                                        </div>                                                        
                                                    </div>
                                                    <div class="col-xl-8 d-flex align-items-end" style="height: 55px;">
                                                        <button class="btn btn-sm btn-primary layout_btn_prevent mr-2" style="padding-left: 2rem !important; padding-right: 2rem !important;" id="btnBuscar">Buscar</button>
                                                        <button class="btn btn-sm btn-secondary layout_btn_prevent" style="padding-left: 2rem !important; padding-right: 2rem !important;" id="btnLimpiar">Limpiar</button>
                                                    </div>
                                                </div>
                                            </div>
                                            
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-12">
                                @{
                                    if (@ViewBag.Agregar)
                                    {
                                        <button class="btn btn-success layout_btn_prevent" id="btnAgregar">Agregar</button>
                                    }
                                    if (@ViewBag.Modificar)
                                    {
                                        <button class="btn btn-info layout_btn_prevent" id="btnModificar">Modificar</button>
                                    }
                                    if (@ViewBag.Eliminar)
                                    {
                                        <button class="btn btn-danger layout_btn_prevent" id="btnEliminar">Eliminar</button>
                                    }
                                    if (@ViewBag.Consultar)
                                    {
                                        <button class="btn btn-warning layout_btn_prevent" id="btnConsultar">Consultar</button>
                                    }
                                }

                                <table id="tblEvaluacionRiesgoSocial" class="table table-sm table-content-sm table-bordered table-striped w-100" style="cursor: default;">
                                    <thead style="color: white; background: #434343;">
                                        <tr>
                                            <th>N° Evaluación</th>
                                            <th>N° Cuenta</th>
                                            <th>N° Historia</th>
                                            <th>Paciente</th>
                                            <th>Fec. Evaluación</th>
                                            <th>Fec. Ingreso</th>                                            
                                            <th>Serv. Actual</th>
                                            <th>Plan</th>
                                            <th>Informe</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                            <div class="col-xl-12 d-flex align-items-end justify-content-end" style="height: 50px;">
                                <div>
                                    <button class="btn btn-info layout_btn_prevent m-1" id="btnFirmaLote"><i class="fa-light fa-signature mr-1"></i>Firmar Lote</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!--=============================================Panel Busqueda==================================================================-->
                    <div class="tab-pane fade" id="TabPanelRegistro" role="tabpanel" aria-labelledby="TabRegistro">
                        <partial name="~/Views/Shared/Components/VistasParciales/Facturacion/RegistroEvaluacionRiesgoSocial.cshtml" />
                    </div>
                </div>

            </div>

        </div>
    </div>
</div>

