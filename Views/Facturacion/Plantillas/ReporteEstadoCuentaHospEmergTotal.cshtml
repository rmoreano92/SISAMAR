<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8" />
    <title>Registro de Ventas</title>
    <style>
        body {
            font-size: 11px;
            color: black !important;
            letter-spacing: 1.5px;
            font-family: helvetica;
        }

        td,
        th {
            font-size: 11px !important;
        }


        /*=====================MI CSS=======================*/

        .text-center {
            text-align: center;
        }

        .text-left {
            text-align: left;
        }

        .text-right {
            text-align: right;
        }

        .table {
            caption-side: bottom;
            border-collapse: collapse;
        }



        .table-bordered td,
        .table-bordered th {
            border: solid 1px #000;
        }
    </style>
</head>


<body style="background: white; width: 700px; height: 900px; /*position: relative; border: 1px solid red;*/" class="">

    @{
        // Variables para subtotales
        decimal subTotal = 0;
        decimal TotalGeneral = 0;
    }

    <table class="table table-bordered border-secondary w-100  mt-2" style="width: 600px !important;">
        <tbody>

            @{
                int index = 1;
                bool mostrarPuntoCarga = true;

                var tablaServicios = ViewBag.RegistroRptPtoCargaConsolidado.Rows;
                string puntoCargaActual = tablaServicios[0]["DesPuntoCarga"].ToString();
                string puntoCargaAnterior = "";

                index = 1;
                mostrarPuntoCarga = true;

            }


            <tr style="">
                <td class="border-secondary align-top" style="width: 120px;">PuntoCarga</td>
                <td class="border-secondary text-center" style="width: 50px;">Código</td>
                <td class="border-secondary align-top" style="width: 210px;">Descripción</td>
                <td class="border-secondary text-center" style="width: 10px;">Cant</td>
                <td class="border-secondary text-center" style="max-width: 20px;">Precio</td>
                <td class="border-secondary text-center" style="width: 20px;">Total</td>
                <td class="border-secondary text-center" style="width: 20px;">Tot.PCarga</td>
            </tr>

            @foreach (System.Data.DataRow row in tablaServicios)
            {
                puntoCargaAnterior = row["DesPuntoCarga"].ToString();

                // Si cambia el punto de carga (y no es la primera fila), mostramos el subtotal acumulado
                if (puntoCargaAnterior != puntoCargaActual && index > 1)
                {
                    <tr style="">
                        <td colspan="6" class="text-end" style="font-size: 12px; text-align: right; border: none;"></td>
                        <td class="text-center" style="font-size: 12px; border: none;">@subTotal.ToString("N2")</td>
                    </tr>

                    // Reiniciar acumuladores
                    subTotal = 0;

                    puntoCargaActual = puntoCargaAnterior;
                    mostrarPuntoCarga = true;
                }
                else
                {
                    mostrarPuntoCarga = false;
                }

                // Acumuladores
                subTotal += Convert.ToDecimal(row["Total"]);
                TotalGeneral += Convert.ToDecimal(row["Total"]);



                <tr>
                    <td class="border-secondary align-top" style="font-size: 12px; border: none;">@(mostrarPuntoCarga ||
                                            index == 1 ? row["DesPuntoCarga"].ToString() : "")</td>
                    <td class="border-secondary text-center" style="font-size: 12px;">@row["Codigo"]</td>
                    <td class="border-secondary align-top" style="font-size: 12px;">@row["Nombre"]</td>
                    <td class="border-secondary text-center" style="font-size: 12px;">@row["Cantidad"]</td>
                    <td class="border-secondary text-center" style="font-size: 12px;">@string.Format("{0:N2}",
                                            row["PrecioUnitario"])</td>
                <td class="border-secondary text-center" style="font-size: 12px;">
                    @string.Format("{0:N2}", row["Total"])</td>
                <td class="border-secondary text-center" style="font-size: 12px; border: none;"></td>
            </tr>

                        index++;
            }

            <tr style="">
                <td colspan="6" class="text-end" style="font-size: 12px; text-align: right; border: none;"></td>
                <td class="text-center" style="font-size: 12px; border: none;">@subTotal.ToString("N2")</td>
            </tr>

            <tr style=" height: 20px;">
                <td colspan="7" class="text-end" style="font-size: 12px;"></td>
            </tr>

            @{
                TotalGeneral = Math.Round(Convert.ToDecimal(TotalGeneral), 0);
            }

            <tr style="">
                <td colspan="6" class="text-end" style="font-size: 12px; text-align: right; border: none;">Total:</td>
                <td class="text-center" style="font-size: 12px; border: none;">@TotalGeneral.ToString("N2")</td>
            </tr>

        </tbody>
    </table>

</body>



</html>