<body style="background: transparent; width:698px; height:1015px; position:relative; padding-bottom:200px;" class="">

    <img src="@(ViewBag.IpArchivos)/resources/images/Logo.png"
        style="width: 90px; position:absolute; top:-5px; left: 0px;" />

    @if (ViewBag.CodigoQR != null)
    {
        <img class="qr-code" src="@String.Format("data:image/png;base64,{0}", Convert.ToBase64String(ViewBag.CodigoQR))" />
    }

    <div class="text-center">
        <p class="fw-bold m-0 mb-2" style="font-size: 13px;">@ViewBag.NombreInstitucion</p>
        <p class="fw-bold m-0" style="font-size: 14px; padding-bottom: 6px;">EVALUACIÓN DE RIESGO SOCIAL</p>
        <p class="m-0" style="font-size: 12px;">Servicio de Trabajo Social</p>
        @*<p class="m-0 mb-1" style="font-size: 11px;">@ViewBag.DireccionInstitucion</p>
        <p class="m-0" style="font-size: 11px;">TELEFONO: @ViewBag.TelefonoInstitucion</p> *@
    </div>

    <div class="position-absolute text-end" style="right:75px; top:40px; font-size: 9px;">
        <div><b>Fecha de Creación:</b></div>
        <span style="margin: 0;">@ViewBag.FechaImpresion @ViewBag.HoraImpresion</span>
    </div>

    <table class="mt-3" style="width: 100%; padding-top: 10px;">
        <tr>
            <th style="border: solid #a9a9a9 1px; width:100px; text-align: left;"><b>PACIENTE</b></th>
            <td style="border: solid #a9a9a9 1px; width:300px;" colspan="3">@ViewBag.Evaluacion["Paciente"]</td>
            <th style="border: solid #a9a9a9 1px; width:100px; text-align: left;"><b>Nº DOCUMENTO</b></th>
            <td style="border: solid #a9a9a9 1px; width:100px;">@ViewBag.Evaluacion["NroDocumento"]</td>
            <th style="border: solid #a9a9a9 1px; width:100px; text-align: left;"><b>Nº HISTORIA</b></th>
            <td style="border: solid #a9a9a9 1px; width:100px;">@ViewBag.Evaluacion["NroHistoriaClinica"]</td>
        </tr>

        <tr>
            <th style="border: solid #a9a9a9 1px; width:100px; text-align: left;"><b>Nº CUENTA</b></th>
            <td style="border: solid #a9a9a9 1px; width:100px;">@ViewBag.Evaluacion["IdcuentaAtencion"]</td>
