    <table class="" style="width: 100%;">
        
    </table>


    <table class="" style="width: 100%;">           
       
    </table>

    <table class="" style="width: 100%;">           
        
    </table> *@

    <div class="row mb-3">
        @foreach (string rowCategoria in ViewBag.Categorias)
        {
            <div class="col-6 mt-2">

                <table class="table-striped" style="width: 100%">
                    <thead style="border: solid #a9a9a9 1px">
                        <tr>
                            <th style="background-color:#c6d7ff;" colspan="2"><b>@rowCategoria</b></th>
                        </tr>
                        @* <tr>
                            <th style="width: 200px;text-align:left;"><b>SubCategoria</b></th>
                            <th style="width: 220px;text-align:left;">Valor</th>
                        </tr> *@
                    </thead>

                    <tbody style="border: solid #a9a9a9 1px">
                        @foreach (System.Data.DataRow rowDetalle in ViewBag.EvaluacionDetalle.Rows)
                        {
                            if (rowDetalle["Categoria"].ToString() == rowCategoria)
                            {
                                <tr style="border-bottom: 1px solid green;">
                                    <th class="text-left">@rowDetalle["SubCategoria"]</th>
                                    <td class="pre">@rowDetalle["SubCategoriaDetalle"]</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>

            </div>
        }
    </div>

    <div class="row mb-2">
        <div class="col-12 mb-1">
            <div class="card h-100">
                <div class="card-header font-weight-bold">
                    EVALUACIÓN DE RIESGO SOCIAL
                </div>
                <div class="card-block p-1">
                    <div class="white-space">@ViewBag.Evaluacion["NivelRiesgo"]</div>
                </div>
            </div>
        </div>
        <div class="col-12 mb-1">
            <div class="card">
                <div class="card-header font-weight-bold">
                    DIAGNÓSTICO SOCIAL
                </div>
                <div class="card-block p-1">

                    @{
                        int indexDx = 1;
                    }
                    @foreach (System.Data.DataRow row in ViewBag.DxEvaluacion.Rows)
                    {
                        <span><b>DX @indexDx</b> -> @row["diagnostico"]</span>
                    
                        <br>
                        indexDx++;
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12 mb-1">
            <div class="card h-100">
                <div class="card-header font-weight-bold">
