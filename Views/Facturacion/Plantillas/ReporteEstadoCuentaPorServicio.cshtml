                </tr>
                <tr style="font-weight: bold;">
                    <td class="text-end" style="font-size: 8px;"></td>
                    <td class="text-end" style="font-size: 8px;">SIS CUBRE (-PAGOS A CUENTA)</td>
                    <td class="text-end" style="font-size: 8px;">@totalSisGeneral.ToString("N2")</td>
                    <td class="text-end" style="font-size: 8px;"></td>
                </tr>
                <tr style="font-weight: bold;">
                    <td class="text-end" style="font-size: 8px;"></td>
                    <td class="text-end" style="font-size: 8px;">SOAT CUBRE (-PAGOS A CUENTA)</td>
                    <td class="text-end" style="font-size: 8px;">@totalSoatGeneral.ToString("N2")</td>
                    <td class="text-end" style="font-size: 8px;"></td>
                </tr>
                <tr style="font-weight: bold;">
                    <td class="text-end" style="font-size: 8px;"></td>
                    <td class="text-end" style="font-size: 8px;">CONVENIOS CUBRE (-PAGOS A CUENTA)</td>
                    <td class="text-end" style="font-size: 8px;">@totalConvenioGeneral.ToString("N2")</td>
                    <td class="text-end" style="font-size: 8px;"></td>
                </tr>
                <tr style="font-weight: bold;">
                    <td class="text-end" style="font-size: 8px;"></td>
                    <td class="text-end" style="font-size: 8px; border: solid 1px blue;">TOTAL DEUDA</td>
                    <td class="text-end" style="font-size: 8px; border: solid 1px blue;">@debeGeneral.ToString("N2")</td>
