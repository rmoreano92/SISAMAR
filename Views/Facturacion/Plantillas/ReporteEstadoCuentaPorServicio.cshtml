    @{
        var idFuenteFinanciamiento = @ViewBag.RegistroRptCabecera["idFuenteFinanciamiento"];


        saldoGeneral = saldoGeneral - pagosCuenta;

    }

    <div style="width: 50%; display: inline-block;">

        <table class="w-100 mt-3" style="margin-top: 50px !important;">
