                    <td class="text-end" style="font-size: 8px;" width="10%">@subTotalGeneral.ToString("N2")</td>
                    <td class="text-end" style="font-size: 8px;" width="30%"></td>
                </tr>
                <tr style="font-weight: bold;">
                    <td class="text-end" style="font-size: 8px;"></td>
                    <td class="text-end" style="font-size: 8px;">EXONERADO</td>
                    <td class="text-end" style="font-size: 8px;">@importeExoneraGeneral.ToString("N2")</td>
