    @{
        // Variables para subtotales
        decimal subTotalGeneral = 0;
        decimal importeExoneraGeneral = 0;
        decimal totalSisGeneral = 0;
        decimal totalSoatGeneral = 0;
        decimal totalConvenioGeneral = 0;
        decimal debeGeneral = 0;
        decimal pagoGeneral = 0;
        decimal saldoGeneral = 0;

        decimal farmaciaGeneral = 0;
        decimal servicioGeneral = 0;
        decimal pagosCuenta = 0;
    }

    <table class="table table-bordered border-secondary w-100  mt-2">
        <tbody>
            <tr>
                @* <th class="border-secondary table-active text-left" style="font-size: 8px;">#</th> *@
                <th class="border-secondary table-active text-center" width="10%" style="font-size: 8px;">Punto de Carga</th>
                <th class="border-secondary table-active text-center" width="30%" style="font-size: 8px;">Descripcion</th>
                <th class="border-secondary table-active text-center" width="5%" style="font-size: 8px;">UM</th>
                <th class="border-secondary table-active text-center" width="2%" style="font-size: 8px;">Cantidad</th>
                <th class="border-secondary table-active text-center" width="2%" style="font-size: 8px;">Prec.Unit</th>
                <th class="border-secondary table-active text-center" width="2%" style="font-size: 8px;">SubTotal</th>
                <th class="border-secondary table-active text-center" width="2%" style="font-size: 8px;">Exonerado</th>
                <th class="border-secondary table-active text-center" width="2%" style="font-size: 8px;">SIS Cubre</th>
                <th class="border-secondary table-active text-center" width="2%" style="font-size: 8px;">SOAT Cubre</th>
                <th class="border-secondary table-active text-center" width="2%" style="font-size: 8px;">CONVENIO Cubre</th>
                <th class="border-secondary table-active text-center" width="2%" style="font-size: 8px;">Debe</th>
                <th class="border-secondary table-active text-center" width="2%" style="font-size: 8px;">Pago</th>
                <th class="border-secondary table-active text-center" width="2%" style="font-size: 8px;">Saldo</th>
                <th class="border-secondary table-active text-center" width="5%" style="font-size: 8px;">Nro Orden</th>
                <th class="border-secondary table-active text-center" width="10%" style="font-size: 8px;">F. Despacho</th>
                <th class="border-secondary table-active text-center" width="10%" style="font-size: 8px;">Servicio</th>
                <th class="border-secondary table-active text-center" width="10%" style="font-size: 8px;">USUARIO EXONERO</th>
            </tr>
            @{
                int index = 1;
                bool mostrarPuntoCarga = true;

                // Variables para subtotales
                decimal subTotal = 0;
                decimal importeExonera = 0;
                decimal totalSis = 0;
                decimal totalSoat = 0;
                decimal totalConvenio = 0;
                decimal debe = 0;
                decimal pago = 0;
                decimal saldo = 0;
            }


            @{

                var tablaServicios = ViewBag.RegistroRptPorServicio.Rows;
                string puntoCargaActual = tablaServicios[0]["ServicioPuntoCarga"].ToString();
                string puntoCargaAnterior = "";

                index = 1;
                mostrarPuntoCarga = true;

                // Variables para subtotales
                subTotal = 0;
                importeExonera = 0;
                totalSis = 0;
                totalSoat = 0;
                totalConvenio = 0;
                debe = 0;
                pago = 0;
                saldo = 0;
            }

            @foreach (System.Data.DataRow row in tablaServicios)
            {
                puntoCargaAnterior = row["ServicioPuntoCarga"].ToString();

                // Si cambia el punto de carga (y no es la primera fila), mostramos el subtotal acumulado
                if (puntoCargaAnterior != puntoCargaActual && index > 1)
                {
                    <tr style="font-weight: bold; border: none;">
                        <td colspan="5" class="text-end" style="font-size: 8px;  border: none;"></td>
                        <td class="text-center" style="font-size: 8px; border: none;">@subTotal.ToString("N2")</td>
                        <td class="text-center" style="font-size: 8px; border: none;">@importeExonera.ToString("N2")</td>
                        <td class="text-center" style="font-size: 8px; border: none;">@totalSis.ToString("N2")</td>
                        <td class="text-center" style="font-size: 8px; border: none;">@totalSoat.ToString("N2")</td>
                        <td class="text-center" style="font-size: 8px; border: none;">@totalConvenio.ToString("N2")</td>
                        <td class="text-center" style="font-size: 8px; border: none;">@debe.ToString("N2")</td>
                        <td class="text-center" style="font-size: 8px; border: none;">@pago.ToString("N2")</td>
                        <td class="text-center" style="font-size: 8px; border: none;">@saldo.ToString("N2")</td>
                        <td colspan="4" style=" border: none;"></td>
                    </tr>

                    // Reiniciar acumuladores
                    subTotal = 0;
                    importeExonera = 0;
                    totalSis = 0;
                    totalSoat = 0;
                    totalConvenio = 0;
                    debe = 0;
                    pago = 0;
                    saldo = 0;

                    puntoCargaActual = puntoCargaAnterior;
                    mostrarPuntoCarga = true;
                }
                else
                {
                    mostrarPuntoCarga = false;
                }

                // Acumuladores
                subTotal += Convert.ToDecimal(row["SubTotal"]);
                importeExonera += Convert.ToDecimal(row["ImporteExonera"]);
                totalSis += Convert.ToDecimal(row["TotalFinanciadoSis"]);
                totalSoat += Convert.ToDecimal(row["TotalFinanciadoSoat"]);
                totalConvenio += Convert.ToDecimal(row["TotalConvenio"]);
                debe += Convert.ToDecimal(row["Debe"]);
                pago += Convert.ToDecimal(row["Pago"]);
                saldo += Convert.ToDecimal(row["Saldo"]);



                importeExoneraGeneral += Convert.ToDecimal(row["ImporteExonera"]);
                totalSisGeneral += Convert.ToDecimal(row["TotalFinanciadoSis"]);
                totalSoatGeneral += Convert.ToDecimal(row["TotalFinanciadoSoat"]);
                totalConvenioGeneral += Convert.ToDecimal(row["TotalConvenio"]);
                debeGeneral += Convert.ToDecimal(row["Debe"]);
                pagoGeneral += Convert.ToDecimal(row["Pago"]);
                saldoGeneral += Convert.ToDecimal(row["Saldo"]);

                if (row["Codigo"].ToString() != "F00001")
                {
                    subTotalGeneral += Convert.ToDecimal(row["SubTotal"]);
                    servicioGeneral += Convert.ToDecimal(row["Saldo"]);
                }
                else
                {
                    pagosCuenta = Convert.ToDecimal(row["SubTotal"]);
                }


                <tr>
                    <td class="border-secondary align-top" style="font-size: 8px; border: none;">@(mostrarPuntoCarga || index == 1 ? row["ServicioPuntoCarga"].ToString() : "")</td>
                    <td class="border-secondary align-top" style="font-size: 8px;">@row["Producto"]</td>
                    <td class="border-secondary align-top" style="font-size: 8px;">@row["UM"]</td>
                    <td class="border-secondary align-top text-center" style="font-size: 8px;">@row["Cantidad"]</td>
                    <td class="border-secondary align-top text-center" style="font-size: 8px;">@row["PrecioUnitario"]</td>
                    <td class="border-secondary align-top text-center" style="font-size: 8px;">@row["SubTotal"]</td>
                    <td class="border-secondary align-top text-center" style="font-size: 8px;">@row["ImporteExonera"]</td>
                    <td class="border-secondary align-top text-center" style="font-size: 8px;">@row["TotalFinanciadoSis"]</td>
                    <td class="border-secondary align-top text-center" style="font-size: 8px;">@row["TotalFinanciadoSoat"]</td>
                    <td class="border-secondary align-top text-center" style="font-size: 8px;">@row["TotalConvenio"]</td>
                    <td class="border-secondary align-top text-center" style="font-size: 8px;">@row["Debe"]</td>
                    <td class="border-secondary align-top text-center" style="font-size: 8px;">@row["Pago"]</td>
                    <td class="border-secondary align-top text-center" style="font-size: 8px;">@row["Saldo"]</td>
                    <td class="border-secondary align-top text-center" style="font-size: 8px;">@row["DocumentoNumero"]</td>
                    <td class="border-secondary align-top text-center" style="font-size: 8px;">@row["FechaCreacion"]</td>
                    <td class="border-secondary align-top text-center" style="font-size: 8px;">@row["ServicioEstancia"]</td>
                    <td class="border-secondary align-top text-center" style="font-size: 8px;">@row["UsuarioExonera"]</td>
                </tr>

                index++;
            }

            <tr style="font-weight: bold;">
                <td colspan="5" class="text-end" style="font-size: 8px; border: none;"></td>
                <td class="text-center" style="font-size: 8px; border: none;">@subTotal.ToString("N2")</td>
                <td class="text-center" style="font-size: 8px; border: none;">@importeExonera.ToString("N2")</td>
                <td class="text-center" style="font-size: 8px; border: none;">@totalSis.ToString("N2")</td>
                <td class="text-center" style="font-size: 8px; border: none;">@totalSoat.ToString("N2")</td>
                <td class="text-center" style="font-size: 8px; border: none;">@totalConvenio.ToString("N2")</td>
                <td class="text-center" style="font-size: 8px; border: none;">@debe.ToString("N2")</td>
                <td class="text-center" style="font-size: 8px; border: none;">@pago.ToString("N2")</td>
                <td class="text-center" style="font-size: 8px; border: none;">@saldo.ToString("N2")</td>
                <td colspan="4" style=" border: none;"></td>
            </tr>

            <tr style="font-weight: bold; border: none;">
                <td colspan="17" class="text-end" style="font-size: 8px; height: 15px;"></td>
            </tr>

            <tr style="font-weight: bold;">
                <td class="text-end" style="font-size: 8px;">Total:</td>
                <td colspan="4" class="text-end" style="font-size: 8px;"></td>
                <td class="text-center" style="font-size: 8px;">@subTotalGeneral.ToString("N2")</td>
                <td class="text-center" style="font-size: 8px;">@importeExoneraGeneral.ToString("N2")</td>
                <td class="text-center" style="font-size: 8px;">@totalSisGeneral.ToString("N2")</td>
                <td class="text-center" style="font-size: 8px;">@totalSoatGeneral.ToString("N2")</td>
                <td class="text-center" style="font-size: 8px;">@totalConvenioGeneral.ToString("N2")</td>
                <td class="text-center" style="font-size: 8px;">@debeGeneral.ToString("N2")</td>
                <td class="text-center" style="font-size: 8px;">@pagoGeneral.ToString("N2")</td>
                <td class="text-center" style="font-size: 8px;">@saldoGeneral.ToString("N2")</td>
                <td colspan="4"></td>
            </tr>

            <tr style="font-weight: bold;">
                <td class="text-end" style="font-size: 8px;">Total:</td>
                <td colspan="4" class="text-end" style="font-size: 8px;"></td>
                <td class="text-center" style="font-size: 8px;">@subTotalGeneral.ToString("N2")</td>
                <td class="text-center" style="font-size: 8px;">@importeExoneraGeneral.ToString("N2")</td>
                <td class="text-center" style="font-size: 8px;">@totalSisGeneral.ToString("N2")</td>
                <td class="text-center" style="font-size: 8px;">@totalSoatGeneral.ToString("N2")</td>
                <td class="text-center" style="font-size: 8px;">@totalConvenioGeneral.ToString("N2")</td>
                <td class="text-center" style="font-size: 8px;">@debeGeneral.ToString("N2")</td>
                <td class="text-center" style="font-size: 8px;">@pagoGeneral.ToString("N2")</td>
                <td class="text-center" style="font-size: 8px;">@saldoGeneral.ToString("N2")</td>
                <td colspan="4"></td>
            </tr>


        </tbody>
    </table>




