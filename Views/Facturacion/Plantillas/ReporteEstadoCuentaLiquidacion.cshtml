    @{
        // Variables para subtotales
        decimal subTotalGeneral = 0;
        decimal importeExoneraGeneral = 0;
        decimal totalSisGeneral = 0;
        decimal totalSoatGeneral = 0;
        decimal totalConvenioGeneral = 0;
        decimal debeGeneral = 0;
        decimal pagoGeneral = 0;
        decimal saldoGeneral = 0;

        decimal farmaciaGeneral = 0;
        decimal servicioGeneral = 0;
        decimal pagosCuenta = 0;
    }

    <table class="table table-bordered border-secondary w-100  mt-2">
        <tbody>
            <tr>
                @* <th class="border-secondary table-active text-left" style="font-size: 8px;">#</th> *@
                <th class="border-secondary table-active text-center" width="10%" style="font-size: 8px;">PTO. CARGA</th>
                <th class="border-secondary table-active text-center" width="30%" style="font-size: 8px;">DESCRIPCION</th>
                <th class="border-secondary table-active text-center" width="2%" style="font-size: 8px;">CANTIDAD</th>
                <th class="border-secondary table-active text-center" width="2%" style="font-size: 8px;">TARIFA</th>
                <th class="border-secondary table-active text-center" width="2%" style="font-size: 8px;">IMP. EXONERADO</th>
                <th class="border-secondary table-active text-center" width="2%" style="font-size: 8px;">TOTAL</th>
                <th class="border-secondary table-active text-center" width="2%" style="font-size: 8px;">N° ORDEN</th>
            </tr>
            @{
                int index = 1;
                bool mostrarPuntoCarga = true;

                // Variables para subtotales
                decimal subTotal = 0;
                decimal importeExonera = 0;
                decimal totalSis = 0;
                decimal totalSoat = 0;
                decimal totalConvenio = 0;
                decimal debe = 0;
                decimal pago = 0;
                decimal saldo = 0;
            }
            @foreach (System.Data.DataRow row in ViewBag.RegistroRptFarmacia.Rows)
            {
                <tr>
                    <td class="border-secondary align-top" style="font-size: 8px; border: none;">@(mostrarPuntoCarga || index == 1 ? row["DesPuntoCarga"].ToString() : "")</td>
                    <td class="border-secondary align-top" style="font-size: 8px;">@row["Producto"]</td>
                    <td class="border-secondary align-top text-center" style="font-size: 8px;">@(totalSoat > 0 ? row["Cantidad"] : 0)</td>
                    <td class="border-secondary align-top text-center" style="font-size: 8px;">@(totalSoat > 0 ? row["PrecioUnitario"] : 0)</td>
                    <td class="border-secondary align-top text-center" style="font-size: 8px;">@row["ImporteExonera"]</td>
                    <td class="border-secondary align-top text-center" style="font-size: 8px;"></td>
                    <td class="border-secondary align-top text-center" style="font-size: 8px;">@row["IdOrden"]</td>
                </tr>

                subTotal += Convert.ToDecimal(row["SubTotal"]);
                importeExonera += Convert.ToDecimal(row["ImporteExonera"]);
                totalSis += Convert.ToDecimal(row["TotalFinanciadoSis"]);
                totalSoat += Convert.ToDecimal(row["TotalFinanciadoSoat"]);
                totalConvenio += Convert.ToDecimal(row["TotalConvenio"]);
                debe += Convert.ToDecimal(row["Debe"]);
                pago += Convert.ToDecimal(row["Pago"]);
                saldo += Convert.ToDecimal(row["Saldo"]);

                subTotalGeneral += Convert.ToDecimal(row["SubTotal"]);
                importeExoneraGeneral += Convert.ToDecimal(row["ImporteExonera"]);
                totalSisGeneral += Convert.ToDecimal(row["TotalFinanciadoSis"]);
                totalSoatGeneral += Convert.ToDecimal(row["TotalFinanciadoSoat"]);
                totalConvenioGeneral += Convert.ToDecimal(row["TotalConvenio"]);
                debeGeneral += Convert.ToDecimal(row["Debe"]);
                pagoGeneral += Convert.ToDecimal(row["Pago"]);
                saldoGeneral += Convert.ToDecimal(row["Saldo"]);
                farmaciaGeneral += Convert.ToDecimal(row["Saldo"]);

                index++;
            }

            <tr style="font-weight: bold;">
                <td colspan="5" class="text-end" style="font-size: 8px; border: none;"></td>
                <td class="text-center" style="font-size: 8px; border: none;">@importeExonera.ToString("N2")</td>
                @* <td class="text-center" style="font-size: 8px;">@importeExonera.ToString("N2")</td>
                <td class="text-center" style="font-size: 8px;">@totalSis.ToString("N2")</td>
                <td class="text-center" style="font-size: 8px;">@totalSoat.ToString("N2")</td>
                <td class="text-center" style="font-size: 8px;">@totalConvenio.ToString("N2")</td>
                <td class="text-center" style="font-size: 8px;">@debe.ToString("N2")</td>
                <td class="text-center" style="font-size: 8px;">@pago.ToString("N2")</td>
                <td class="text-center" style="font-size: 8px;">@saldo.ToString("N2")</td>*@
                <td style="border: none;"></td> 
            </tr>

            @* <tr><td colspan="17" style="height: 5px; border-color: #5495ff; border-width: medium;"></td></tr> *@

            @{

                var tablaServicios = ViewBag.RegistroRptServicios.Rows;
                string puntoCargaActual = tablaServicios[0]["DesPuntoCarga"].ToString();
                string puntoCargaAnterior = "";

                index = 1;
                mostrarPuntoCarga = true;

                // Variables para subtotales
                subTotal = 0;
                importeExonera = 0;
                totalSis = 0;
                totalSoat = 0;
                totalConvenio = 0;
                debe = 0;
                pago = 0;
                saldo = 0;
            }

            @foreach (System.Data.DataRow row in tablaServicios)
            {
                puntoCargaAnterior = row["DesPuntoCarga"].ToString();

                // Si cambia el punto de carga (y no es la primera fila), mostramos el subtotal acumulado
                if (puntoCargaAnterior != puntoCargaActual && index > 1)
                {
                    <tr style="font-weight: bold;">
                        <td colspan="5" class="text-end" style="font-size: 8px; border: none;"></td>
                        <td class="text-center" style="font-size: 8px; border: none;">@importeExonera.ToString("N2")</td>
                        @* <td class="text-center" style="font-size: 8px;">@importeExonera.ToString("N2")</td>
                <td class="text-center" style="font-size: 8px;">@totalSis.ToString("N2")</td>
                <td class="text-center" style="font-size: 8px;">@totalSoat.ToString("N2")</td>
                <td class="text-center" style="font-size: 8px;">@totalConvenio.ToString("N2")</td>
                <td class="text-center" style="font-size: 8px;">@debe.ToString("N2")</td>
                <td class="text-center" style="font-size: 8px;">@pago.ToString("N2")</td>
                <td class="text-center" style="font-size: 8px;">@saldo.ToString("N2")</td>*@
                        <td style="border: none;"></td>
                    </tr>

                    // Reiniciar acumuladores
                    subTotal = 0;
                    importeExonera = 0;
                    totalSis = 0;
                    totalSoat = 0;
                    totalConvenio = 0;
                    debe = 0;
                    pago = 0;
                    saldo = 0;

                    puntoCargaActual = puntoCargaAnterior;
                    mostrarPuntoCarga = true;
                }
                else
                {
                    mostrarPuntoCarga = false;
                }

                // Acumuladores
                subTotal += Convert.ToDecimal(row["SubTotal"]);
                importeExonera += Convert.ToDecimal(row["ImporteExonera"]);
                totalSis += Convert.ToDecimal(row["TotalFinanciadoSis"]);
                totalSoat += Convert.ToDecimal(row["TotalFinanciadoSoat"]);
                totalConvenio += Convert.ToDecimal(row["TotalConvenio"]);
                debe += Convert.ToDecimal(row["Debe"]);
                pago += Convert.ToDecimal(row["Pago"]);
                saldo += Convert.ToDecimal(row["Saldo"]);



                importeExoneraGeneral += Convert.ToDecimal(row["ImporteExonera"]);
                totalSisGeneral += Convert.ToDecimal(row["TotalFinanciadoSis"]);
                totalSoatGeneral += Convert.ToDecimal(row["TotalFinanciadoSoat"]);
                totalConvenioGeneral += Convert.ToDecimal(row["TotalConvenio"]);
                debeGeneral += Convert.ToDecimal(row["Debe"]);
                pagoGeneral += Convert.ToDecimal(row["Pago"]);
                saldoGeneral += Convert.ToDecimal(row["Saldo"]);

                if (row["Codigo"].ToString() != "F00001")
                {
                    subTotalGeneral += Convert.ToDecimal(row["SubTotal"]);
                    servicioGeneral += Convert.ToDecimal(row["Saldo"]);
                }
                else
                {
                    pagosCuenta = Convert.ToDecimal(row["SubTotal"]);
                }


                <tr>
                    <td class="border-secondary align-top" style="font-size: 8px; border: none;">@(mostrarPuntoCarga || index == 1 ? row["DesPuntoCarga"].ToString() : "")</td>
                    <td class="border-secondary align-top" style="font-size: 8px;">@row["Producto"]</td>
                    <td class="border-secondary align-top text-center" style="font-size: 8px;">@(totalSoat > 0 ? row["Cantidad"] : 0)</td>
                    <td class="border-secondary align-top text-center" style="font-size: 8px;">@(totalSoat > 0 ? row["PrecioUnitario"] : 0)</td>
                    <td class="border-secondary align-top text-center" style="font-size: 8px;">@row["ImporteExonera"]</td>
                    <td class="border-secondary align-top text-center" style="font-size: 8px;"></td>
                    <td class="border-secondary align-top text-center" style="font-size: 8px;">@row["IdOrden"]</td>
                </tr>

                index++;
            }

            <tr style="font-weight: bold;">
                <td colspan="5" class="text-end" style="font-size: 8px; border: none;"></td>
                <td class="text-center" style="font-size: 8px; border: none;">@importeExonera.ToString("N2")</td>
                @* <td class="text-center" style="font-size: 8px;">@importeExonera.ToString("N2")</td>
                <td class="text-center" style="font-size: 8px;">@totalSis.ToString("N2")</td>
                <td class="text-center" style="font-size: 8px;">@totalSoat.ToString("N2")</td>
                <td class="text-center" style="font-size: 8px;">@totalConvenio.ToString("N2")</td>
                <td class="text-center" style="font-size: 8px;">@debe.ToString("N2")</td>
                <td class="text-center" style="font-size: 8px;">@pago.ToString("N2")</td>
                <td class="text-center" style="font-size: 8px;">@saldo.ToString("N2")</td>*@
                <td style="border: none;"></td>
            </tr>

            <tr style="font-weight: bold;">
                <td colspan="17" class="text-end" style="font-size: 8px; height: 15px; border: none;"></td>
            </tr>
            <tr style="font-weight: bold;">
                <td>Total:</td>
                <td colspan="4" class="text-end" style="font-size: 8px;"></td>
                <td class="text-center" style="font-size: 8px;">@importeExoneraGeneral.ToString("N2")</td>
                @* <td class="text-center" style="font-size: 8px;">@importeExonera.ToString("N2")</td>
                <td class="text-center" style="font-size: 8px;">@totalSis.ToString("N2")</td>
                <td class="text-center" style="font-size: 8px;">@totalSoat.ToString("N2")</td>
                <td class="text-center" style="font-size: 8px;">@totalConvenio.ToString("N2")</td>
                <td class="text-center" style="font-size: 8px;">@debe.ToString("N2")</td>
                <td class="text-center" style="font-size: 8px;">@pago.ToString("N2")</td>
                <td class="text-center" style="font-size: 8px;">@saldo.ToString("N2")</td>*@
                <td style=""></td>
            </tr>



        </tbody>
    </table>


</body>



