<body style="background: white; width: 780px; height: 800px;" class="">

    @* <img src="~/images/Logo.png" style="width: 80px; position:absolute; top: 0px;" />
    <table class="table" style="width: 200px; position:absolute; right: 0; top: 0px; border: none;">
        <tbody>
            <tr style="">
                <td class="border-secondary text-right">Usuario: @ViewBag.Usuario</td>
            </tr>
            <tr style="">
                <td class="border-secondary text-right">F. Impresión: @ViewBag.FechaImpresion</td>
            </tr>
        </tbody>
    </table>

    <div class="row text-center mx-auto mb-3" style="width: 100%;">
        <div class="col-12"><span class="fw-bold" style="font-size: 11px;">@ViewBag.NombreInstitucion</span></div>
        <div class="col-12"><span style="font-size: 9px;">@ViewBag.DireccionInstitucion</span></div>
        <div class="col-12"><span style="font-size: 9px;">Telefono: @ViewBag.TelefonoInstitucion</span></div>
    </div>



    <div class="d-flex mb-1">
        <table class="table me-2" style="width: 750px;">
            <tbody>
                <tr>
                    <th class="border-secondary text-left fw-bold" style="width:100px;">CONSUMOS CONSOLIDADOS de la Cuenta Nª: @ViewBag.RegistroRptCabecera["IdCuentaAtencion"]</th>
                </tr>
                <tr>
                    <th class="border-secondary text-left fw-bold" style="width:100px;">Estado de Cuenta al @ViewBag.FechaImpresion.ToString().Substring(0, 10)</th>
                </tr>
                <tr>
                    <th class="border-secondary text-left fw-bold" style="width:100px;">Paciente @ViewBag.RegistroRptCabecera["NroHistoriaClinica"] - @ViewBag.RegistroRptCabecera["Paciente"]</th>
                </tr>
                <tr>
                    <th class="border-secondary text-left fw-bold" style="width:100px;">Cuenta: (@ViewBag.RegistroRptCabecera["estadoCta"]) IAFA: @ViewBag.RegistroRptCabecera["dFuenteFinanciamiento"] (PP: @ViewBag.RegistroRptCabecera["dTipoFinanciamiento"])</th>
                </tr>
                <tr>
                    <th class="border-secondary text-left fw-bold" style="width:100px;">Serv.Egreso: @ViewBag.RegistroRptCabecera["ServEgreso"]</th>
                </tr>
            </tbody>
        </table>

    </div> *@



    @{
        // Variables para subtotales
        decimal subTotal = 0;
        decimal TotalGeneral = 0;
    }

    <table class="table table-bordered border-secondary w-100  mt-2">
        <tbody>

            @{
                int index = 1;
                bool mostrarPuntoCarga = true;

                var tablaServicios = ViewBag.RegistroRptPtoCargaConsolidado.Rows;
                string puntoCargaActual = tablaServicios[0]["DesPuntoCarga"].ToString();
                string puntoCargaAnterior = "";

                index = 1;
                mostrarPuntoCarga = true;

            }


            <tr style="font-weight: bold;">
                <td class="border-secondary align-top" style="font-size: 8px;">Punto Carga</td>
                <td class="border-secondary align-top" style="font-size: 8px;">Codigo</td>
                <td class="border-secondary align-top" style="font-size: 8px;">Producto</td>
                <td class="border-secondary align-top" style="font-size: 8px;">Cantidad</td>
                <td class="border-secondary align-top" style="font-size: 8px;">Precio</td>
                <td class="border-secondary align-top" style="font-size: 8px; text-align: left;">Total</td>
            </tr>

            @foreach (System.Data.DataRow row in tablaServicios)
            {
                puntoCargaAnterior = row["DesPuntoCarga"].ToString();

                // Si cambia el punto de carga (y no es la primera fila), mostramos el subtotal acumulado
                if (puntoCargaAnterior != puntoCargaActual && index > 1)
                {
                    <tr style="font-weight: bold;">
                        <td colspan="5" class="text-end" style="font-size: 8px; text-align: right;  border: none;">Total:</td>
                        <td class="text-center" style="font-size: 8px; text-align: left;  border: none;">@subTotal.ToString("N2")</td>
                    </tr>

                    // Reiniciar acumuladores
                    subTotal = 0;

                    puntoCargaActual = puntoCargaAnterior;
                    mostrarPuntoCarga = true;
                }
                else
                {
                    mostrarPuntoCarga = false;
                }

                // Acumuladores
                subTotal += Convert.ToDecimal(row["Total"]);
                TotalGeneral += Convert.ToDecimal(row["Total"]);



                <tr>
                    <td class="border-secondary align-top" style="font-size: 8px; border: none;">@(mostrarPuntoCarga || index == 1 ? row["DesPuntoCarga"].ToString() : "")</td>
                    <td class="border-secondary align-top" style="font-size: 8px;">@row["Codigo"]</td>
                    <td class="border-secondary align-top" style="font-size: 8px;">@row["Nombre"]</td>
                    <td class="border-secondary align-top" style="font-size: 8px;">@row["Cantidad"]</td>
                    <td class="border-secondary align-top" style="font-size: 8px;">@row["PrecioUnitario"]</td>
                    <td class="border-secondary align-top" style="font-size: 8px; text-align: left;">@row["Total"]</td>
                </tr>

                index++;
            }

            <tr style="font-weight: bold;">
                <td colspan="5" class="text-end" style="font-size: 8px; text-align: right; border: none;">Total:</td>
                <td class="text-center" style="font-size: 8px; text-align: left; border: none;">@subTotal.ToString("N2")</td>
            </tr>

            <tr style="font-weight: bold; height: 20px;">
                <td colspan="6" class="text-end" style="font-size: 8px;  border: none;"></td>
            </tr>

            <tr style="font-weight: bold;">
                <td colspan="5" class="text-end" style="font-size: 8px; text-align: right;">Total:</td>
                <td class="text-center" style="font-size: 8px; text-align: left;">@TotalGeneral.ToString("N2")</td>
            </tr>

        </tbody>
    </table>

</body>



