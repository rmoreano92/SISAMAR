    @{
        // Variables para subtotales
        decimal subTotalGeneral = 0;
        decimal importeExoneraGeneral = 0;
        decimal totalSisGeneral = 0;
        decimal totalSoatGeneral = 0;
        decimal totalConvenioGeneral = 0;
        decimal debeGeneral = 0;
        decimal pagoGeneral = 0;
        decimal saldoGeneral = 0;

        decimal farmaciaGeneral = 0;
        decimal servicioGeneral = 0;
        decimal pagosCuenta = 0;
    }

    <table class="table table-bordered border-secondary w-100  mt-2">
        <tbody>
            <tr>
                <th class="border-secondary table-active text-center" width="70%" style="font-size: 8px;">DESCRIPCION</th>
                <th class="border-secondary table-active text-center" width="5%" style="font-size: 8px;">Particular</th>
                <th class="border-secondary table-active text-center" width="5%" style="font-size: 8px;">Exonerado</th>
                <th class="border-secondary table-active text-center" width="5%" style="font-size: 8px;">SIS Cubre</th>
                <th class="border-secondary table-active text-center" width="5%" style="font-size: 8px;">SOAT Cubre</th>
                <th class="border-secondary table-active text-center" width="5%" style="font-size: 8px;">CONVENIO Cubre</th>
                <th class="border-secondary table-active text-center" width="5%" style="font-size: 8px;">DEUDA</th>
            </tr>
            @{
                int index = 1;
                bool mostrarPuntoCarga = true;

                // Variables para subtotales
                decimal subTotal = 0;
                decimal importeExonera = 0;
                decimal totalSis = 0;
                decimal totalSoat = 0;
                decimal totalConvenio = 0;
                decimal debe = 0;
                decimal pago = 0;
                decimal saldo = 0;
            }
            @foreach (System.Data.DataRow row in ViewBag.RegistroRptFarmacia.Rows)
            {

                subTotal += Convert.ToDecimal(row["SubTotal"]);
                importeExonera += Convert.ToDecimal(row["ImporteExonera"]);
                totalSis += Convert.ToDecimal(row["TotalFinanciadoSis"]);
                totalSoat += Convert.ToDecimal(row["TotalFinanciadoSoat"]);
                totalConvenio += Convert.ToDecimal(row["TotalConvenio"]);
                debe += Convert.ToDecimal(row["Debe"]);
                pago += Convert.ToDecimal(row["Pago"]);
                saldo += Convert.ToDecimal(row["Saldo"]);

                subTotalGeneral += Convert.ToDecimal(row["SubTotal"]);
                importeExoneraGeneral += Convert.ToDecimal(row["ImporteExonera"]);
                totalSisGeneral += Convert.ToDecimal(row["TotalFinanciadoSis"]);
                totalSoatGeneral += Convert.ToDecimal(row["TotalFinanciadoSoat"]);
                totalConvenioGeneral += Convert.ToDecimal(row["TotalConvenio"]);
                debeGeneral += Convert.ToDecimal(row["Debe"]);
                pagoGeneral += Convert.ToDecimal(row["Pago"]);
                saldoGeneral += Convert.ToDecimal(row["Saldo"]);
                farmaciaGeneral += Convert.ToDecimal(row["Saldo"]);

                index++;
            }

            <tr>
                <td class="border-secondary align-top" style="font-size: 8px;">Farmacia</td>
                <td class="border-secondary align-top text-center" style="font-size: 8px;">@subTotal.ToString("N2")</td>
                <td class="border-secondary align-top text-center" style="font-size: 8px;">@importeExonera.ToString("N2")</td>
                <td class="border-secondary align-top text-center" style="font-size: 8px;">@totalSis.ToString("N2")</td>
                <td class="border-secondary align-top text-center" style="font-size: 8px;">@totalSoat.ToString("N2")</td>
                <td class="border-secondary align-top text-center" style="font-size: 8px;">@totalConvenio.ToString("N2")</td>
                <td class="border-secondary align-top text-center" style="font-size: 8px;">@debe.ToString("N2")</td>
            </tr>

            @* <tr><td colspan="17" style="height: 5px; border-color: #5495ff; border-width: medium;"></td></tr> *@

            @{

                var tablaServicios = ViewBag.RegistroRptServicios.Rows;
                string puntoCargaActual = tablaServicios[0]["DesPuntoCarga"].ToString();
                string puntoCargaAnterior = "";

                index = 1;
                mostrarPuntoCarga = true;

                // Variables para subtotales
                subTotal = 0;
                importeExonera = 0;
                totalSis = 0;
                totalSoat = 0;
                totalConvenio = 0;
                debe = 0;
                pago = 0;
                saldo = 0;
            }

            @foreach (System.Data.DataRow row in tablaServicios)
            {
                puntoCargaAnterior = row["DesPuntoCarga"].ToString();

                // Si cambia el punto de carga (y no es la primera fila), mostramos el subtotal acumulado
                if (puntoCargaAnterior != puntoCargaActual && index > 1)
                {

                    <tr>
                        <td class="border-secondary align-top" style="font-size: 8px;">@puntoCargaActual</td>
                        <td class="border-secondary align-top text-center" style="font-size: 8px;">@subTotal.ToString("N2")</td>
                        <td class="border-secondary align-top text-center" style="font-size: 8px;">@importeExonera.ToString("N2")</td>
                        <td class="border-secondary align-top text-center" style="font-size: 8px;">@totalSis.ToString("N2")</td>
                        <td class="border-secondary align-top text-center" style="font-size: 8px;">@totalSoat.ToString("N2")</td>
                        <td class="border-secondary align-top text-center" style="font-size: 8px;">@totalConvenio.ToString("N2")</td>
                        <td class="border-secondary align-top text-center" style="font-size: 8px;">@debe.ToString("N2")</td>
                    </tr>

                    // Reiniciar acumuladores
                    subTotal = 0;
                    importeExonera = 0;
                    totalSis = 0;
                    totalSoat = 0;
                    totalConvenio = 0;
                    debe = 0;
                    pago = 0;
                    saldo = 0;

                    puntoCargaActual = puntoCargaAnterior;
                    mostrarPuntoCarga = true;
                }
                else
                {
                    mostrarPuntoCarga = false;
                }

                // Acumuladores
                subTotal += Convert.ToDecimal(row["SubTotal"]);
                importeExonera += Convert.ToDecimal(row["ImporteExonera"]);
                totalSis += Convert.ToDecimal(row["TotalFinanciadoSis"]);
                totalSoat += Convert.ToDecimal(row["TotalFinanciadoSoat"]);
                totalConvenio += Convert.ToDecimal(row["TotalConvenio"]);
                debe += Convert.ToDecimal(row["Debe"]);
                pago += Convert.ToDecimal(row["Pago"]);
                saldo += Convert.ToDecimal(row["Saldo"]);



                importeExoneraGeneral += Convert.ToDecimal(row["ImporteExonera"]);
                totalSisGeneral += Convert.ToDecimal(row["TotalFinanciadoSis"]);
                totalSoatGeneral += Convert.ToDecimal(row["TotalFinanciadoSoat"]);
                totalConvenioGeneral += Convert.ToDecimal(row["TotalConvenio"]);
                debeGeneral += Convert.ToDecimal(row["Debe"]);
                pagoGeneral += Convert.ToDecimal(row["Pago"]);
                saldoGeneral += Convert.ToDecimal(row["Saldo"]);

                if (row["Codigo"].ToString() != "F00001")
                {
                    subTotalGeneral += Convert.ToDecimal(row["SubTotal"]);
                    servicioGeneral += Convert.ToDecimal(row["Saldo"]);
                }
                else
                {
                    pagosCuenta = Convert.ToDecimal(row["SubTotal"]);
                }


                index++;
            }
            @{
                decimal montoLiquidacion = subTotalGeneral - pagoGeneral;
            }

            <tr>
                <td class="border-secondary align-top" style="font-size: 8px;">@puntoCargaActual</td>
                <td class="border-secondary align-top text-center" style="font-size: 8px;">@subTotal.ToString("N2")</td>
                <td class="border-secondary align-top text-center" style="font-size: 8px;">@importeExonera.ToString("N2")</td>
                <td class="border-secondary align-top text-center" style="font-size: 8px;">@totalSis.ToString("N2")</td>
                <td class="border-secondary align-top text-center" style="font-size: 8px;">@totalSoat.ToString("N2")</td>
                <td class="border-secondary align-top text-center" style="font-size: 8px;">@totalConvenio.ToString("N2")</td>
                <td class="border-secondary align-top text-center" style="font-size: 8px;">@debe.ToString("N2")</td>
            </tr>

            <tr>
                <td class="border-secondary align-top" colspan="5" style="font-size: 8px; height: 15px;"></td>
            </tr>



            <tr>
                <td class="border-secondary align-top" style="font-size: 8px;">Total</td>
                <td class="border-secondary align-top text-center" style="font-size: 8px;">@subTotalGeneral.ToString("N2")</td>
                <td class="border-secondary align-top text-center" style="font-size: 8px;">@importeExoneraGeneral.ToString("N2")</td>
                <td class="border-secondary align-top text-center" style="font-size: 8px;">@totalSisGeneral.ToString("N2")</td>
                <td class="border-secondary align-top text-center" style="font-size: 8px;">@totalSoatGeneral.ToString("N2")</td>
                <td class="border-secondary align-top text-center" style="font-size: 8px;">@totalConvenioGeneral.ToString("N2")</td>
                <td class="border-secondary align-top text-center" style="font-size: 8px;">@debeGeneral.ToString("N2")</td>
            </tr>

        </tbody>
    </table>


    <div style="width: 50%;">

        <table class="w-100 mt-3" style="margin-top: 50px !important;">
            <tbody>

                <tr style="font-weight: bold;">
                    <td class="text-start" style="font-size: 8px;" width="25%">TOTAL PAGO A CUENTA:</td>
                    <td class="text-start" style="font-size: 8px;" width="10%">@pagoGeneral.ToString("N2")</td>
                    <td class="text-start" style="font-size: 8px;" width="30%"></td>
                </tr>
                <tr style="font-weight: bold;">
                    <td class="text-start" style="font-size: 8px;">TOTAL PACIENTE:</td>
                    <td class="text-start" style="font-size: 8px;">@debeGeneral.ToString("N2")</td>
                    <td class="text-start" style="font-size: 8px;"></td>
                </tr>
                <tr style="font-weight: bold;">
                    <td class="text-start" style="font-size: 8px;">PAGADO:</td>
                    <td class="text-start" style="font-size: 8px;">@pagoGeneral.ToString("N2")</td>
                    <td class="text-start" style="font-size: 8px;"></td>
                </tr>
                <tr style="font-weight: bold;">
                    <td class="text-start" style="font-size: 8px;">POR PAGAR PACIENTE:</td>
                    <td class="text-start" style="font-size: 8px;">@saldoGeneral.ToString("N2")</td>
                    <td class="text-start" style="font-size: 8px;"></td>
                </tr>
                
            </tbody>
        </table>
    </div>
    
