<div class="modal fade" id="modalIntervencionEnfermeria" role="dialog" aria-hidden="false" style="background-color: #00000075; z-index: 9999" data-keyboard="false" data-backdrop="static">
    <div class="modal-dialog modal-lg" style="box-shadow: 0 20px 13px 0 rgb(0, 0, 0);">
        <div class="modal-content">
            <div class="modal-header bg-success">
                <h4 class="modal-title text-white" id="titulo">intervenciones de Enfermeria</h4>
            </div>
            <div class="modal-body p-t-5">
                <div class="card-block p-t-5">
                    <div class="row">
                        <div class="col-xl-2">
                            <label for="txtCodigoCptIntervencion" class="form-control-label">Codigo</label>
                            <div class="input-group input-group-sm">
                                <input type="text" autocomplete="off" class="form-control" id="txtCodigoCptIntervencion" disabled>
                            </div>
                        </div>

                        <div class="col-xl-10">
                            <label for="txtDescripcionIntervencion" class="form-control-label">Decripcion</label>
                            <div class="input-group input-group-sm">
                                <input type="text" autocomplete="off" class="form-control" id="txtDescripcionIntervencion" disabled>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-xl-8">
                            <label for="cboIntervencionesEnfermeria" class="form-control-label">Servicio</label>
                            <div class="input-group">
                                <select class="chzn-select" data-placeholder="Seleccionar una opcion" id="cboIntervencionesEnfermeria"></select>
                            </div>
                        </div>
                        <div class="col-xl-4" style="height: 50px;">
                            <div>
                                <button class="btn btn-primary btn-sm layout_btn_prevent mt-2" style="padding-left: 2rem !important; padding-right: 2rem !important;" id="btnAgregarIntervencion">Agregar</button>
                                <button class="btn btn-danger btn-sm layout_btn_prevent mt-2" style="padding-left: 2rem !important; padding-right: 2rem !important;" id="btnEliminarIntervencion">Eliminar</button>
                            </div>
                        </div>
                    </div>

                    <table id="tblIntervencionesEnfemeria" width="100%" class="table table-sm table-content-sm table-striped table-bordered w-100 mt-1">
                        <thead style="color: white;background: #434343;">
                            <tr>
                                <th style="width:20%">id</th>
                                <th style="width:80%">Descripcion</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>

            </div>
            <div class="modal-footer">
                @* <button id="btnGuardarIntervenciones" type="button" class="btn btn-default">Guardar</button> *@
                <button id="btnCerrarModalIntervencion" type="button" class="btn btn-default">Cancelar</button>
            </div>

        </div>
    </div>
</div>

