<div class="modal fade" id="modalEvaluarPlan" role="dialog" aria-hidden="false">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-success">
                <h4 class="modal-title text-white" id="titulo">Plan de Desarrollo Psicomotor</h4>
            </div>
            <div class="modal-body p-t-5" style="background-color: #dedede">
                <div class="row mb-1">
                    <div class="col-md-12">
                        <div class="card m-t-5" style="background: #c9ecfa;">
                            <div class="card-header bg-white text-info" id="hsessionEvaluarPlan">Session</div>
                            <div class="card-block pt-1">

                                <div class="row">
                                    <div class="col-md-2">
                                        <label for="txtFechaProgramada" disabled class="form-control-label">Fecha Programada</label>
                                    </div>
                                    <div class="col-md-2">
                                        <div class="form-group">
                                            <div class="input-group">
                                                <input id="txtFechaProgramadaEvaluarPlan" placeholder="dd/mm/yyyy" data-date-format="dd/mm/yyyy" disabled autocomplete="off" placeholder="" class=" form-control">
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-2">
                                        <label for="txtFechaEjecucion" disabled class="form-control-label">Fecha Ejecución</label>
                                    </div>
                                    <div class="col-md-2">
                                        <div class="form-group">
                                            <div class="input-group">
                                                <input id="txtFechaEjecucionEvaluarPlan" placeholder="dd/mm/yyyy" data-date-format="dd/mm/yyyy" autocomplete="off" placeholder="" class=" form-control">
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-2">
                                        <label for="txtEvaluacion" disabled class="form-control-label">Evaluación</label>
                                    </div>
                                    <div class="col-md-2">
                                        <div class="form-group">
                                            <div class="input-group">
                                                <input id="txtEvaluacionEvaluarPlan" style="color: #2221fd;" disabled autocomplete="off" placeholder="" class=" form-control">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12">
                        <div class="card m-t-5">
                            <div class="card-header bg-white text-info" id="">Items a Evaluar</div>
                            <div class="card-block pt-1">

                                <div class="row">
                                    <div class="col-md-12">
                                        <table id="tblItemsEvaluarPlan" class="table table-sm table-bordered" style=" width:100%">
                                            <thead style="color: white;background: #3e6184;">
                                                <tr>
                                                    <th style="display: none;width: 0%" align="center">idItem</th>
                                                    <th style="width: 80%" align="center">Descripcion</th>
                                                    <th style="width: 10%" align="center">SI</th>
                                                    <th style="width: 10%" align="center">NO</th>
                                                </tr>
                                            </thead>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
            <div class="modal-footer" style="background-color: #dedede">
                <button type="button" class="btn btn-info" id="btnGurdarEvaluarPlan">Guardar</button>
                <button type="button" class="btn btn-default" id="btnCerrarEvaluarPlan">Cancelar</button>
            </div>

        </div>
    </div>
</div>

