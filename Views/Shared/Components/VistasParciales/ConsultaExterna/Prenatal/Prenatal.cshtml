    <div role="tabpanel" class="tab-pane fade" id="ordenes" aria-labelledby="ordenes-tab">
        <div class="row">
            <div class="col-md-12">
                <partial name="~/Views/Shared/Components/VistasParciales/Ordenes.cshtml" />
            </div>
        </div>
        <div class="row campo">
            <div class="col-md-12">
                <div class="card m-t-20">
                    <div class="card-header bg-white">Destino Atención</div>
                    <div class="card-block bg-green">

                        <div class="row">
                            <div class="col-lg-6">
                                <div class="row" style="display:none">
                                    <div class="col-lg-12">
                                        <label style="text-align: left" class="custom-control custom-checkbox">
                                            <input id="chkValida" type="checkbox" class="custom-control-input">
                                            <span class="custom-control-indicator"></span>
                                            <span class="custom-control-description">Alta definitva</span>
                                        </label>
                                    </div>

                                </div>
                                <div class="row">
                                    <div class="col-lg-8">
                                        <div class="form-group">
                                            <label for="cboDestino" class="form-control-label">Destino</label>
                                            <div class="input-group">
                                                <select class="chzn-select" id="cboDestino"></select>
                                            </div>
                                        </div>
                                    </div>

                                    @{
                                        if (@ViewBag.PermisoRefCon == "1")
                                        {
                                            <div class="col-lg-4 d-flex align-items-end" style="height: 57px;">
                                                <div>
                                                    <button id="btnRefCon" class="btn btn-outline-info" onclick="ModificarRefCon();"><i class="fa-solid fa-file-plus mr-1"></i>Referencia</button>
                                                </div>
                                            </div>
                                        }
                                    }

                                </div>

                            </div>
                            <div class="col-lg-6">

                                <div class="row" style="display:none">
                                </div>
                                <div class="row">
                                    <div class="col-lg-6">
                                        <div class="form-group">
                                            <label for="cboDestino" class="form-control-label">Próxima Consulta</label>
                                            <div class="input-group input-group-sm">
                                                <input type="text" autocomplete="off" class="form-control form_val_popup_dp3" placeholder="dd/mm/yyyy" data-date-format="dd/mm/yyyy" id="txtProximaConsulta" disabled="disabled">
                                                <span class="input-group-addon">
                                                    <i class="fa fa-calendar "></i>
                                                </span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-lg-6">
                                        <div class="form-group">
                                            <label for="cboTipoConsulta" class="form-control-label">Tipo de proxima consulta</label>
                                            <div class="input-group">
                                                <select class="chzn-select" id="cboTipoConsulta"></select>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>

                        <form>
                            <fieldset class="m-0 mb-2 pb-1" style="border-color: #d5d5d5;">
                                <legend style="font-weight: 700;color: #6688e9;">Episodio Clínico</legend>
                                <div class="row m-0">
                                    <div class="col-lg-6">

                                        <div class="form-group">
                                            <label for="cboEpisodio" class="form-control-label">Episodio hístorico</label>
                                            <select class="chzn-select" id="cboEpisodio"></select>
                                        </div>

                                    </div>
                                    <div class="col-lg-3">
                                        <br>
                                        <div class="form-group">

                                            <div class="check__toggle mt-04">
                                                <label class="toggle">
                                                    <input class="toggle__input campo" type="checkbox" id="chkNuevo">
                                                    <span class="toggle__label mr-2">
                                                        <span class="toggle__text">Nuevo Espisodio</span>
                                                    </span>
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-3">
                                        <br>
                                        <div class="form-group">

                                            <div class="check__toggle mt-04">
                                                <label class="toggle">
                                                    <input class="toggle__input campo" type="checkbox" id="chkCierre">
                                                    <span class="toggle__label mr-2">
                                                        <span class="toggle__text">Cierre Espisodio</span>
                                                    </span>
                                                </label>
                                            </div>

                                        </div>

                                    </div>
                                </div>
                            </fieldset>
                        </form>

                        <div class="row">
                            <div class="col-md-4">
                                <div style="max-width:250px;" class="m-auto" ">
                                    <div class="msc-hotline mb-1">
                                        <div class="msc-hotline-icon bg-danger">
                                            <i class="fa-solid fa-head-side-medical"></i>
                                        </div>
                                        <div class="msc-hotline-content">
                                            <div class="msc-hotline-title">
                                                <span id="lblEstadoAtencion" class="text-danger"></span>
                                            </div>
                                            <div class="msc-hotline-text">Estado Atención</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div style="max-width:250px;" class="m-auto" ">
                                    <div class="msc-hotline mb-1">
                                        <div class="msc-hotline-icon">
                                            <i class="fa-solid fa-hospital-user"></i>
                                        </div>
                                        <div class="msc-hotline-content">
                                            <div class="msc-hotline-title">
                                                <span id="lblDesEstablecimiento"></span>
                                            </div>
                                            <div class="msc-hotline-text">En el Establecimiento</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div style="max-width:250px;" class="m-auto">
                                    <div class="msc-hotline mb-1">
                                        <div class="msc-hotline-icon">
                                            <i class="fa-solid fa-id-card-clip"></i>
                                        </div>
                                        <div class="msc-hotline-content">
                                            <div class="msc-hotline-title">
                                                <span id="lblDesServicio"></span>
                                            </div>
                                            <div class="msc-hotline-text">En el Servicio</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row mt-1">
                            <div class="col-lg-2">
                                <label for="txtOtrasObservacionesGe" class="form-control-label"><strong>Otras Observaciones: </strong></label>
                            </div>
                            <div class="col-lg-10">
                                <textarea style="background:antiquewhite" class="form-control" id="txtOtrasObservacionesGe" rows="1"></textarea>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<input hidden="hidden" id="idCabecera" name="idCabecera" type="text" class="form-control">
<input hidden="hidden" id="idControl" name="idControl" type="text" class="form-control">
<input hidden="hidden" id="EstadoCabecera" name="EstadoCabecera" type="text" class="form-control">
<input hidden="hidden" id="inicioCliclo" name="inicioCliclo" type="text" class="form-control">

<div data-backdrop="static" style="overflow-y: scroll;" data-keyboard="false" class="modal fade" id="modalLstControl" role="dialog" aria-labelledby="modalLabelsuccess">
    <div class="modal-dialog" role="document">
        <div class="modal-content" style="border: 5px solid rgb(168 189 154);">
            <div class="modal-header bg-success">
                <h4 class="modal-title text-white" id="modalLabelsuccess">Lista de Controles</h4>
            </div>
            <div class="modal-body">
                <table id="tblListaControl" class="table table-sm table-bordered">
                    <thead style="color: white; background: #971742; ">
                        <tr>
                            <th width="20%">Control</th>
                            <th width="20%">Fecha</th>
                            <th width="20%">Consultorio</th>
                            <th width="20%">Medico</th>
                            <th width="20%">Cuenta</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
            <div class="modal-footer">
                <button id="btnCerrarListaControl" target="_blank" class="btn  btn-secondary "> Cerrar</button>
            </div>
        </div>
    </div>
</div>

<div data-backdrop="static" style="overflow-y: scroll;" data-keyboard="false" class="modal fade" id="modalCierreCiclo" role="dialog" aria-labelledby="modalLabelsuccess">
    <div class="modal-dialog" role="document">
        <div class="modal-content" style="border: 5px solid rgb(168 189 154);">
            <div class="modal-header bg-success">
                <h4 class="modal-title text-white" id="modalLabelsuccess">Cerrar ciclo de embarazo</h4>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-lg-6">
                        <label for="txtFechaFinCiclo" class="form-control-label">Fecha fin ciclo</label>
                        <div class="input-group input-group-sm">
                            <input type="text" autocomplete="off" class="form-control form_val_popup_dp3" placeholder="dd/mm/yyyy" data-date-format="dd/mm/yyyy" id="txtFechaFinCiclo">
                            <span class="input-group-addon">
                                <i class="fa fa-calendar "></i>
                            </span>
                        </div>
                    </div>
                </div>
                <div class="row mt-2">
                    <div class="col-lg-12">
                        <div class="form-group">
                            <label for="txtMotivoCierreCiclo" class="form-control-label font-weight-bold text-info">Motivo Cierre</label>
                            <textarea class="form-control" id="txtMotivoCierreCiclo" rows="2"></textarea>
                        </div>
                    </div>
                </div>

            </div>
            <div class="modal-footer">
                <button id="btnAceptarCierreCiclo" target="_blank" class="btn btn-success "> Aceptar</button>
                <button id="btnCerrarModalCierreCiclo" target="_blank" class="btn btn-secondary "> Cerrar</button>
            </div>
        </div>
    </div>

</div>

