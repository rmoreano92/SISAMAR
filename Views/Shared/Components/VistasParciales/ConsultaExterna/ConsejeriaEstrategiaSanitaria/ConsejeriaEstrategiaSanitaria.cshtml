<input id="TipoModulo" type="text" value="@ViewBag.TipoModulo" disabled hidden />


<div class="row">
    

    <div class="col-md-12">
        <div class="row">
            <div class="col-lg-3">
                <div class="form-group campo">
                    <label for="cboClasisifcacion" class="form-control-label">Tipo de Paciente</label>
                    <div class="input-group">
                        <select class="chzn-select" data-placeholder="Seleccione una opción" id="cboClasisifcacion"></select>
                    </div>
                </div>
            </div>
            <div class="col-lg-3">
                <div class="form-group">
                    <label for="cboDestino" class="form-control-label">Controles MGP</label>
                    <div class="input-group">
                        <input id="txtControles" autocomplete="off" placeholder="" class=" solo-numero form-control form-control-sm">
                    </div>
                </div>
            </div>
            <div class="col-lg-3">
                <div class="form-group">
                    <label for="txtEdadGestacional" class="form-control-label">Edad Gestacional</label>
                    <div class="input-group">
                        <input id="txtEdadGestacional" autocomplete="off" placeholder="" class=" solo-numero form-control form-control-sm">
                    </div>
                </div>
            </div>
            <div class="col-lg-3">
                <div class="form-group">
                    <label for="txtGestas" class="form-control-label">Nro. Gestas</label>
                    <div class="input-group">
                        <input id="txtGestas" autocomplete="off" placeholder="" class=" solo-numero form-control form-control-sm">
                    </div>
                </div>
            </div>
        </div>
    </div>


    <div class="col-md-12">
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <b><label for="txtAtencedentes" class="form-control-label text-info titulo ">Motivo de consejeria</label></b>
                    <div class="input-group">
                        <textarea class="form-control" id="txtMotivoConsejeria" rows="3"></textarea>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-group">
                    <b><label for="txtAtencedentes" class="form-control-label text-info titulo ">Identificacion de necesidades</label></b>
                    <div class="input-group">
                        <textarea class="form-control" id="txtIdentificacionNecesidades" rows="3"></textarea>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-group">
                    <b><label for="txtAtencedentes" class="form-control-label text-info titulo ">Deteccion de signos de alarma</label></b>
                    <div class="input-group">
                        <textarea class="form-control" id="txtDeteccionSignosAlarma" rows="3"></textarea>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-group">
                    <b><label for="txtAtencedentes" class="form-control-label text-info titulo ">Recomendaciones y sugerencias</label></b>
                    <div class="input-group">
                        <textarea class="form-control" id="txtRecomendacionesSugerencias" rows="3"></textarea>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<style>
    #cboTipoConsejeria_chosen {
        max-width: 350px;
    }
</style>


