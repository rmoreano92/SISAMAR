<div class="row">
    <div class="col-xl-4 mb-1">
        <div class="card bg-orange">
            <div class="card-block p-1">
                <div class="form-group m-0">
                    <div class="row">
                        <div class="col-xl-6" style="max-width: 200px;">
                            <label for="" class="d-block text-truncate font-weight-bold">Gestante preparada al parto</label>
                        </div>
                        <div class="col-xl-3 px-0 pr-1" style="max-width: 110px;">
                            <label class="radioButtonStyleLabel m-0">
