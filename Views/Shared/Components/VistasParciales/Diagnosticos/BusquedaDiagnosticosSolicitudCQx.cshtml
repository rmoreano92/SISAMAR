<div class="modal fade" id="modalBusquedaDiagnosticosSolicitudCQx" role="dialog" aria-hidden="false" style="background-color: #00000075; z-index: 9999" data-keyboard="false" data-backdrop="static">

    <div class="modal-dialog modal-lg" style="box-shadow: 0 20px 13px 0 rgb(0, 0, 0);">

        <div class="modal-content">
            <div class="modal-header bg-success">
                <h4 class="modal-title text-white" id="titulo">Busqueda de Diagnósticos</h4>
            </div>
            <div class="modal-body p-t-5">
                <div class="card-block p-t-5">
                    <div class="row">
                        <div class="col-md-2">
                            <div class="form-group m-0">
                                <label class="font-weight-bold">Código</label>
                                <input id="txtCodigoDiagSolicitudCQxFiltro" autocomplete="off" type="text" class="form-control" maxlength="7">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group m-0">
                                <label class="font-weight-bold">Descripción</label>
                                <input id="txtDescripcionDiagSolicitudCQxFiltro" autocomplete="off" type="text" class="form-control">
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div style="margin-top: 30px;">
                                <button type="button" class="btn btn-primary mr-1" onclick="Ordenes.BuscarDiagnosticoBusqueda();">Buscar</button>
                                <button type="button" class="btn btn-default" onclick="Ordenes.LimpiarFiltros();">limpiar</button>
                            </div>
                        </div>
                    </div>


                    <table id="lstDiagnosticosSolicitudCQxBusqueda" class="table table-bordered" @*data-source="/PlanificacionFamiliar/ObtenerDiagnostico?area=Comun"*@>
                        <thead style="color: white;background: #3e6184;">
                            <tr>
                                <th data-columna="Iddiagnostico" valign="middle" align="center">Iddiagnostico</th>
                                <th data-columna="codigoCIEsinPto" valign="middle" align="center">codigoCIEsinPto</th>
                                <th data-columna="Codigo" valign="middle" align="center" style="width: 10%">Código</th>
                                <th data-columna="Descripcion" valign="middle" align="center">Descripcion</th>
                                <th data-columna="EsActivo" valign="middle" align="center">EsActivo</th>
                                <th data-columna="FechaInicioVigencia" valign="middle" align="center">FechaInicioVigencia</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" onclick="Ordenes.CerrarModalBusqueda();">Cancelar</button>
            </div>

        </div>
    </div>
</div>