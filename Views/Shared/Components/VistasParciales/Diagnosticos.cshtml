<div class="modal fade" id="modalBusquedaDiagnostico" role="dialog" aria-hidden="false" style="background-color: #00000075;">

    <div class="modal-dialog modal-lg" style="box-shadow: 0 20px 13px 0 rgb(0, 0, 0);">

        <div class="modal-content">
            <div class="modal-header bg-success">
                <h4 class="modal-title text-white" id="titulo">Busqueda de Diagnósticos</h4>
            </div>
            <div class="modal-body p-t-5">
                <div class="card-block p-t-5">
                    @*<h5 class="m-t-10">Búsqueda</h5>*@
                    <div class="row">
                        <div class="col-md-2">
                            <div class="form-group">
                                <label class="font-weight-bold">Código</label>
                                <input id="txtCodigoDiagFiltro" autocomplete="off" type="text" class="form-control" maxlength="7">
                            </div>
                            @*<h4 style=" color: black !important;">Código :</h4>
                            <p>
                                <input id="txtCodigoDiagFiltro" autocomplete="off" type="text" class="form-control" maxlength="7">
                            </p>*@
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="font-weight-bold">Descripción</label>
                                <input id="txtDescripcionDiagFiltro" autocomplete="off" type="text" class="form-control">
                            </div>
                            @*<h4 style=" color: black !important;">Descripción :</h4>
                            <p>
                                <input id="txtDescripcionDiagFiltro" autocomplete="off" type="text" class="form-control">
                            </p>*@
                        </div>
                        <div class="col-md-4">
                            <div style="margin-top: 30px;">
                                <button type="button" class="btn btn-primary mr-1" onclick="Diagnosticos.BuscarDiagnosticoBusqueda();">Buscar</button>
                                <button type="button" class="btn btn-default" onclick="Diagnosticos.LimpiarFiltros();">limpiar</button>
                            </div>
                            @*<h4>&nbsp;</h4>
                            <button type="button" class="btn btn-primary mt-2 mr-1" onclick="Diagnosticos.BuscarDiagnosticoBusqueda();">Buscar</button>&nbsp;&nbsp;
                            <button type="button" class="btn btn-default mt-2" onclick="Diagnosticos.LimpiarFiltros();">limpiar</button>&nbsp;&nbsp;*@
                        </div>
                    </div>


                    <table id="lstDiagnosticosBusqueda" class="table table-bordered" data-source="/PlanificacionFamiliar/ObtenerDiagnostico?area=Comun">
                        <thead style="color: white;background: #3e6184;">
                            <tr>
                                <th data-columna="Iddiagnostico" valign="middle" align="center">Iddiagnostico</th>
                                <th data-columna="codigoCIEsinPto" valign="middle" align="center">codigoCIEsinPto</th>
                                <th data-columna="Codigo" valign="middle" align="center" style="width: 10%">Código</th>
                                <th data-columna="Descripcion" valign="middle" align="center">Descripcion</th>
                                <th data-columna="EsActivo" valign="middle" align="center">EsActivo</th>
                                <th data-columna="FechaInicioVigencia" valign="middle" align="center">FechaInicioVigencia</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" onclick="Diagnosticos.CerrarModalBusqueda();">Cancelar</button>
            </div>

        </div>
    </div>
</div>