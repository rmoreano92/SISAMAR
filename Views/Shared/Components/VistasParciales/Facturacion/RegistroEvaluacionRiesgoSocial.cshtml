@*=========================================================MODAL EVALUACIONES RIESGO SOCIAL==================================================================*@
<div data-backdrop="static" data-keyboard="false" class="modal fade" id="modalEvaluacionesRiesgoSocial" role="dialog" aria-hidden="false" style="background-color: #00000075;">
    <div class="modal-dialog modal-xl" style="box-shadow: 0 20px 13px 0 rgb(0, 0, 0);">
        <div class="modal-content">
            <div class="modal-header bg-deep-pink">
                <h4 class="modal-title text-white">Evaluaciones de Riesgo Social del Paciente</h4>
            </div>
            <div class="modal-body">
                <div class="row">                    
                    <div class="col-md-12 mb-1">                        
                        <table class="table table-sm able-content-sm table-bordered table-striped" id="tblEvaluacionesRSPaciente" width="100%" style="cursor: pointer;">
                            <thead style="color: white; background: #434343;">
                                <tr>
                                    <th>Nº Evaluación</th>
                                    <th>Evaluador</th>
                                    <th>F. Evaluación</th>
                                    <th>Puntaje</th>
                                    <th>Resultado</th>
                                    <th>Nº Cuenta</th>  
                                    <th>Informe</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>

