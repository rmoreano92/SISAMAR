                                            <input type="text" autocomplete="off" class="form-control text-info font-weight-bold reading" disabled id="txtNroPlanRs" @* style="max-width: 70px;" *@>
                                            <span class="input-group-addon">-</span>
                                            <input type="text" autocomplete="off" class="form-control text-info font-weight-bold reading" disabled id="txtNombrePlanRs">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xl-5">
                    <div class="card mb-1 bg-light">
                        @* <div class="card-header">Receta/Orden</div> *@
                        <div class="card-block p-0">

                            @foreach (DataRow cat in ViewBag.CategoriaRs.Rows)
                            {
                                <ul class="nav nav-tabs flex-column tabListEvaluacion" role="tablist">
                                    <li class="nav-item m-0 w-100">
                                        <h6 class="nav-link text-white m-0" data-toggle="collapse" href="@("#sbRs" + cat["idRsCategoria"])">
                                            <i style="width: 20px; text-align:center;" class="fa fa-circle-check"></i>
                                            <span class="">@cat["descripcion"]</span>
                                            <i class="fa-solid fa-caret-down" style="float: right;"></i>
                                        </h6>
                                        <div id="@("sbRs" + cat["idRsCategoria"])" class="collapse submenu">
                                            @foreach (DataRow subcat in ViewBag.SubCategoriaRs.Rows)
                                            {
                                                @if (cat["idRsCategoria"].ToString() == subcat["idRsCategoria"].ToString())
                                                {
                                                    <a class="nav-link d-block text-truncate pl-2" href="@("#panelRs" + subcat["idRsCategoriaSub"])" data-toggle="tab" role="tab" id="@("#navRs" + subcat["idRsCategoriaSub"] + "-tab")" aria-controls="hats">@subcat["descripcion"]</a>
                                                }
                                            }
                                        </div>
                                        <div class="dropdown-divider"></div>
                                    </li>
                                </ul>
                            }

                        </div>
                    </div>
                </div>

                <div class="col-xl-7">

                    <div id="clothing-nav-content" class="tab-content fade in">

                        @foreach (DataRow subcat in ViewBag.SubCategoriaRs.Rows)
                        {
                            <div role="tabpanel" class="tab-pane fade" id="@("panelRs" + subcat["idRsCategoriaSub"])" aria-labelledby="@("navRs" + subcat["idRsCategoriaSub"] + "-tab")">
                                <div class="card mb-1">
                                    <div class="card-header">@subcat["descripcion"]</div>
                                    <div class="card-block p-1">
                                        <ul class="list-group border">
                                            @foreach (DataRow det in ViewBag.CategoriaDetalleRs.Rows)
                                            {
                                                @if (subcat["idRsCategoriaSub"].ToString() == det["idRsCategoriaSub"].ToString())
                                                {
                                                    <li class="list-group-item d-flex justify-content-between align-items-center border">
                                                        <label class="radioButtonStyleLabel m-0 w-100">
                                                            @if(subcat["idRsCategoriaSub"].ToString() == "811" || subcat["idRsCategoriaSub"].ToString() == "812") {
                                                                <input type="checkbox" name="@("rdbRs" + det["idRsCategoriaSub"])" class="radioButtonStyleInput rdbPuntajeEvaluacion" id="@("rdbRs" + det["idRsCategoriaSub"] + "_" + det["numeroOrden"])" value="@det["puntaje"]" data-orden="@det["numeroOrden"]" data-subcategoria="@det["idRsCategoriaSub"]">

                                                            } else {
                                                                <input type="radio" name="@("rdbRs" + det["idRsCategoriaSub"])" class="radioButtonStyleInput rdbPuntajeEvaluacion" id="@("rdbRs" + det["idRsCategoriaSub"] + "_" + det["numeroOrden"])" value="@det["puntaje"]" data-orden="@det["numeroOrden"]" data-subcategoria="@det["idRsCategoriaSub"]">

                                                            }
                                                            
                                                            <span class="radioButtonStyleSpan w-100">@det["descripcion"]</span>
                                                        </label>
                                                        <span class="chip primary">@det["puntaje"]</span>
                                                    </li>
                                                }
                                            }

                                        </ul>
                                    </div>
                                </div>
                            </div>
                        }

                    </div>
                </div>
            </div>
        </div>
    </div>


    <div class="row p-1 border" style="background: #ededed;">
        <div class="col-lg-8">
            <button id="btnImprimeSeguimiento" target="_blank" class="btn btn-lg  btn-light-blue  float-lg-left mr-1 mb-1"><i class="fa fa-wheelchair-move mr-1"></i>Seguimiento</button>
