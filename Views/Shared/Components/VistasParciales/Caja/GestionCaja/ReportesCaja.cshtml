                        <div class="form-group form-group-sm m-0">
                            <label for="cboRptCajaResumenPorPartida">Caja</label>
                            <select id="cboRptCajaResumenPorPartida" class="chzn-select" data-placeholder="Seleccione una opción">
                                <option value=""></option>
                                @foreach (var item in @ViewBag.ListaCajas.Tables[0].Rows)
                                {
                                    <option value="@item["idCaja"]"> @item["descripcion"]  </option>
                                }
                            </select>
                        </div>

                        <div class="form-group form-group-sm m-0">
                            <label for="cboRptCajeroResumenPorPartida">Cajero</label>
