                                }
                            </select>
                        </div>

                        <div class="check__toggle" style="margin-top: 10px;">
                            <label class="toggle">
                                <input class="toggle__input" type="checkbox" id="chkRptSoloPartidaMayorCeroResumenPorPartida">
                                <span class="toggle__label mr-2">
                                    <span class="toggle__text d-block text-truncate">Solo partidas totalizadas mayor a 0 (cero)</span>
                                </span>
                            </label>
                        </div>

                        <div class="check__toggle" style="margin-top: 10px;">
                            <label class="toggle">
                                <input class="toggle__input" type="checkbox" id="chkRptIncluyeNotasCreditoResumenPorPartida">
