                    </div>
                    <div class="col-xl-4">
                        <div class="form-group m-0">
                            <label for="txtRazonSocialNotaCreditoDebito" class="form-label d-block text-truncate">Razón Social ó Apellidos y Nombres</label>
                            <input id="txtRazonSocialNotaCreditoDebito" autocomplete="off" placeholder="" class="form-control form-control-sm reading" disabled>
                        </div>
                    </div>
                    <div class="col-xl-4">
                        <div class="form-group m-0">
                            <label for="txtDireccionNotaCreditoDebito" class="form-label d-block text-truncate">Dirección</label>
                            <input id="txtDireccionNotaCreditoDebito" autocomplete="off" placeholder="" class="form-control form-control-sm reading" disabled>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-xl-3">
                        <div class="form-group m-0">
                            <label for="txtMotivoNotaCreditoDebito" class="form-label d-block text-truncate">Motivo</label>
                            <input id="txtMotivoNotaCreditoDebito" autocomplete="off" placeholder="" class="form-control form-control-sm reading" disabled>
                        </div>
                    </div>
                    <div class="col-xl-4">
                        <div class="form-group m-0">
                            <label for="txtResponableAprobacionNotaCreditoDebito" class="form-label d-block text-truncate">Responable de la Aprobación</label>
                            <input id="txtResponableAprobacionNotaCreditoDebito" autocomplete="off" placeholder="" class="form-control form-control-sm reading" disabled>
                        </div>
                    </div>                    
                </div>
                <div class="row">
                    <div class="col-xl-12">
                        <div class="form-group m-0">
                            <label for="txtConceptoNotaCreditoDebito" class="form-label d-block text-truncate">Concepto</label>
                            <textarea id="txtConceptoNotaCreditoDebito" style="overflow:scroll;" class="form-control reading" rows="4" disabled></textarea>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-xl-10"></div>
                    <div class="col-xl-2">
                        <div class="form-group m-0">
                            <label for="txtImporteNotaCreditoDebito" class="form-label d-block text-truncate font-weight-bold">IMPORTE</label>
                            <div class="input-group">
                                <input id="txtImporteNotaCreditoDebito" type="text" autocomplete="off" class="form-control reading" disabled>
                                <span class="input-group-addon">S/.</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-footer">
                <button type="button" class="btn btn-lg btn-primary" id="btnGuardarCanjeNotaCreditoDebito" style="min-width: 150px;" disabled>DEVOLUCIÓN</button>                
            </div>
        </div>
    </div>
