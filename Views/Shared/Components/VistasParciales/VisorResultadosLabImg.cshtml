<div data-backdrop="static" style="background-color: #00000075;overflow-y: scroll;" data-keyboard="false" class="modal fade" id="modalResultadosLabImg" role="dialog" aria-labelledby="modalLabelsuccess">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header bg-dark-purple">
                <h5 class="modal-title text-white" id="modalLabelsuccess">Resultados</h5>
            </div>
            <div class="modal-body">

                <div class="row">
                    <div class="col-md-12">
                        <h4 id="lblNombreExamen" style="color: #3c3c3c !important;"></h4>
                    </div>
                    <div class="col-md-12">
                        <div class="card">
                            <div class="card-block p-0">
                                <div class="row">

                                    <div class="col-md-12">
                                        <table id="tblResultadosExamenes" class="table table-sm table-bordered">
                                            <thead style="color: white;background: #3e6184;">
                                                <tr>
                                                    <th align="center" @*style="width: 150px;"*@>Grupo/Item</th>
                                                    <th align="center" @*style="width: 100px;"*@>Valor</th>
                                                    <th align="center" @*style="width: 100px;"*@>Valor Referencial</th>
                                                </tr>
                                            </thead>
                                            <tbody id="tbodyResultados"></tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <br>
                <div class="row">
                    <div class="col-md-12">
                        <label class="form-control-label font-weight-bold">OBSERVACIONES/CONCLUSIONES</label>
                        <textarea style="overflow:scroll;" disabled class="form-control" id="txtObserOrdRes" rows="7"></textarea>
                    </div>
                </div>


            </div>
            <div class="modal-footer">
                <button id="btnCerrarResultadoLabImg" target="_blank" class="btn  btn-secondary "> Cerrar</button>
            </div>
        </div>
    </div>

</div>