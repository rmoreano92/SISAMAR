@using System.Data
<div class="modal fade" id="modalRegistroMovimientoHistoria" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary">
                <h5 class="modal-title text-white" id="exampleModalLabel">Registro Movimiento Historia Clínica</h5>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-12 mb-1">
                        <div class="card bg-teal">
                            <div class="card-block">
                                <div class="row">
                                    <div class="col-xl-6">
                                        <div class="row">
                                            <div class="col-xl-6">
                                                <div class="form-group m-0">
                                                    <label for="txtNroHistoriaPaciente" class="form-label d-block text-truncate font-weight-bold">N° Historia</label>
                                                    <div class="input-group input-group-sm">
                                                        <input type="text" class="form-control solo-numero writing reading searchHistoria" id="txtNroHistoriaPaciente" autocomplete="off">
                                                        <span class="input-group-btn">
                                                            <button class="btn btn-info" type="button" id="btnBuscarDatosPacienteNroHistoria"><i class="fa fa-search"></i></button>
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="col-xl-6">
                                                <div class="form-group m-0">
                                                    <label for="txtNroDocumentoPaciente" class="form-label d-block text-truncate font-weight-bold">N° Documento</label>
                                                    <div class="input-group input-group-sm">
                                                        <input type="text" class="form-control solo-numero writing reading searchDocumento" id="txtNroDocumentoPaciente" autocomplete="off">
                                                        <span class="input-group-btn">
                                                            <button class="btn btn-info" type="button" id="btnBuscarDatosPacienteNroDocumento"><i class="fa fa-search"></i></button>
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-xl-6">
                                        <div class="form-group m-0">
                                            <label for="txtNombrePaciente" class="form-label d-block text-truncate font-weight-bold">Paciente</label>
                                            <input id="txtNombrePaciente" autocomplete="off" placeholder="" class="form-control form-control-sm writing reading" disabled>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-xl-12 mb-1">
                        <div class="card bg-blue">
                            <div class="card-block">
                                <div class="row">
                                    <div class="col-xl-4">
                                        <div class="form-group m-0">
                                            <label for="cboMotivoMovHc">Motivo</label>
                                            <select id="cboMotivoMovHc" class="chzn-select-deselect writing" data-placeholder="Seleccione una opción">
                                                <option value=""></option>
                                                @foreach (DataRow motivo in ViewBag.Motivos.Rows)
                                                {
                                                    <option value="@motivo["IdMotivo"]">@motivo["Descripcion"]</option>
                                                }
                                            </select>
                                        </div>
                                    </div>      
                                    <div class="col-xl-4" id="frmServicioOrigen">
                                        <div class="form-group m-0">
                                            <label for="cboServicioOrigenMovHc">Servicio Origen</label>
                                            <select id="cboServicioOrigenMovHc" class="chzn-select-deselect reading" disabled data-placeholder="Seleccione una opción">
                                                <option value=""></option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-xl-4" id="frmServicioDestino">
                                        <div class="form-group m-0">
                                            <label for="cboServicioDestinoMovHc">Servicio Destino</label>
                                            <select id="cboServicioDestinoMovHc" class="chzn-select-deselect writing" data-placeholder="Seleccione una opción">
                                                <option value=""></option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-xl-4">
                                        <div class="form-group m-0">
                                            <label for="cboResponsableSalidaMovHc">Responsable Salida</label>
                                            <select id="cboResponsableSalidaMovHc" class="chzn-select-deselect writing" data-placeholder="Seleccione una opción">
                                                <option value=""></option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-xl-4">
                                        <div class="form-group m-0">
                                            <label for="cboResponsableTransporteMovHc">Resposanble Transporte</label>
                                            <select id="cboResponsableTransporteMovHc" class="chzn-select-deselect writing" disabled data-placeholder="Seleccione una opción">
                                                <option value=""></option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-xl-4">
                                        <div class="form-group m-0">
                                            <label for="cboResponsableRecepcionMovHc">Responsable Recepción</label>
                                            <select id="cboResponsableRecepcionMovHc" class="chzn-select-deselect writing" data-placeholder="Seleccione una opción">
                                                <option value=""></option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">                                    
                                    <div class="col-xl-3">
                                        <div class="form-group m-0">
                                            <label for="txtFechaMovHc">Fecha</label>
                                            <div class="input-group input-group-sm">
                                                <input id="txtFechaMovHc" type="text" autocomplete="off" class="form-control form_val_popup_dp3 maskFecha reading" placeholder="dd/mm/yyyy" data-date-format="dd/mm/yyyy" disabled>
                                                <span class="input-group-addon">
                                                    <i class="fa fa-calendar "></i>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xl-2">
                                        <div class="form-group m-0">
                                            <label for="txtHoraMovHc" class="form-control-label">Hora</label>
                                            <div class="input-group input-group-sm">
                                                <input id="txtHoraMovHc" type="text" autocomplete="off" class="form-control form_val_popup_dp3 maskHora reading" disabled>
                                                <span class="input-group-addon">
                                                    <i class="fa fa-timer"></i>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xl-7">
                                        <div class="form-group m-0">
                                            <label for="txtObservacionMovHc" class="form-control-label">Observación</label>
                                            <input id="txtObservacionMovHc" autocomplete="off" placeholder="" class="form-control form-control-sm writing">
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>

                    </div>
                </div>
                                
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-lg btn-primary" id="btnGuardarRegistroMovimientoHistoria">GUARDAR</button>
                <button type="button" class="btn btn-lg btn-secondary" id="btnCancelarRegistroMovimientoHistoria">CERRAR</button>
            </div>
        </div>
    </div>
</div>


