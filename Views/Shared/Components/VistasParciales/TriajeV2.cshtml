                </div>
            </div>
            <div class="col-lg-12">
                <div class="form-group m-0">
                    <div class="input-group">
                        <input type="text" autocomplete="off" class="form-control form-control-sm solo-numero" id="txtDatosCuenta" disabled>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

