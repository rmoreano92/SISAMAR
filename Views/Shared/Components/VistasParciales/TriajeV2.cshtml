<div class="row">
    <div class="card shadow-sm mb-3">
        <div class="card-body">
            
            <div class="row align-items-end">

                <!-- Número Cuenta -->
                <div class="col-lg-2 col-md-4 mb-2">
                    <label for="txtCuentaTriaje" class="form-control-label">
                        N° Cuenta
                    </label>
                    <input type="text"
                           id="txtCuentaTriaje"
                           name="txtCuentaTriaje"
                           autocomplete="off"
                           class="form-control form-control-sm solo-numero"
                           placeholder="Documento">
                </div>
				<!-- Número Documento -->
                <div class="col-lg-2 col-md-4 mb-2">
                    <label for="txtNumeroDocumento" class="form-control-label">
                        N° Documento
                    </label>
                    <input type="text"
                           id="txtNumeroDocumento"
                           name="NumeroDocumento"
                           autocomplete="off"
                           class="form-control form-control-sm solo-numero"
                           placeholder="Documento">
                </div>

                <!-- Apellido Paterno -->
                <div class="col-lg-2 col-md-4 mb-2">
                    <label for="txtApellidoPaterno" class="form-control-label">
                        Apellido Paterno
                    </label>
                    <input type="text"
                           id="txtApellidoPaterno"
                           name="ApellidoPaterno"
                           autocomplete="off"
                           class="form-control form-control-sm"
                           placeholder="Apellido Paterno">
                </div>

                <!-- Apellido Materno -->
                <div class="col-lg-2 col-md-4 mb-2">
                    <label for="txtApellidoMaterno" class="form-control-label">
                        Apellido Materno
                    </label>
                    <input type="text"
                           id="txtApellidoMaterno"
                           name="ApellidoMaterno"
                           autocomplete="off"
                           class="form-control form-control-sm"
                           placeholder="Apellido Materno">
                </div>

                <!-- Nombres -->
                <div class="col-lg-3 col-md-6 mb-2">
                    <label for="txtNombres" class="form-control-label">
                        Nombres
                    </label>
                    <input type="text"
                           id="txtNombres"
                           name="Nombres"
                           autocomplete="off"
                           class="form-control form-control-sm"
                           placeholder="Nombres">
                </div>

                <!-- Botón Buscar -->
                <div class="col-lg-1 col-md-2 mb-2">
                    <button type="button"
                            id="btnBuscarDatosPaciente"
                            class="btn btn-info btn-sm w-100">
                        Buscar
                    </button>
                </div>

            </div>

        </div>
    </div>
</div>
<div class="row">
    <div class="col-lg-12">
