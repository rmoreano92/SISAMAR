<div class="card bg-blue">
    @*<div class="card-header bg-white">Resultados</div>*@
    <div class="card-block custom-form pt-1">
        <div class="row">            
            <div class="col-md-12">

                <ul class="nav nav-tabs" id="Eva-tab" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link active" id="lab-res-tab-link" data-toggle="tab" href="#laboratorio-res-tab" role="tab" aria-controls="home" aria-selected="true" aria-expanded="true">Laboratorio</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" id="img-res-tab-link" data-toggle="tab" href="#imagenologia-res-tab" role="tab" aria-controls="home" aria-selected="false" aria-expanded="false">Imagenología</a>
                    </li>                   
                </ul>

                <div class="tab-content pt-1" id="EvaTabContent">
                    <div class="tab-pane fade show active in" id="laboratorio-res-tab" role="tabpanel" aria-labelledby="lab-res-tab-link" aria-expanded="true">
                        
                        <div class="row">
                            <div class="col-md-12">
                                <button class="btn btn-warning btn-sm layout_btn_prevent" id="btnConsultarResultadoLab" style="width:100px;"><i class="fa fa-eye" style="width: 20px; text-align:center;"></i> Consultar</button>
                            </div>
                            <div class="col-md-12">
                                <table id="tblLaboratorioMovimientos" class="table table-bordered table-sm table-content-sm">
                                    <thead style="color: white;background: #3e6184;">
                                        <tr>
                                            <th width="8%">Movimiento</th>
                                            <th width="12%">Punto Carga</th>
                                            <th width="27%">Exámen</th>
                                            <th width="25%">Médico Ordena</th>
                                            <th width="12%">Fecha Resultado</th>
                                            <th width="8%">Res. Ind.</th>
                                            <th width="8%">Res. Grup.</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>
                        
                    </div>

                    <div class="tab-pane fade" id="imagenologia-res-tab" role="tabpanel" aria-labelledby="img-res-tab-link" aria-expanded="true">

                        <div class="row">
                            <div class="col-md-12">
                                <button class="btn btn-warning btn-sm layout_btn_prevent" id="btnConsultarResultadoImg" style="width:100px;"><i class="fa fa-eye" style="width: 20px; text-align:center;"></i> Consultar</button>
                            </div>
                            <div class="col-md-12">
                                <table id="tblImagenesMovimientos" class="table table-bordered table-sm table-content-sm">
                                    <thead style="color: white;background: #3e6184;">
                                        <tr>
                                            <th width="8%">Movimiento</th>
                                            <th width="15%">Punto Carga</th>
                                            @*<th width="10%">Código</th>*@
                                            <th width="32%">Exámen</th>
                                            <th width="25%">Médico Ordena</th>
                                            @*<th width="10%">Fecha</th>*@
                                            <th width="12%">Fecha Resultado</th>
                                            @*<th width="5%">Con Res.</th>*@
                                            <th width="8%">Resultado</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>

                       
                    </div>

                </div>
                                
            </div>
        </div>
    </div>

</div>



