@using System.Data
@using CapaDatos
@{
    DalUtilitario dalUtili = new DalUtilitario();
    DataSet lsTiposServiciosMGP = await dalUtili.ListarServiciosMGP();
    DataSet lsTiposGravedad = await dalUtili.ListarTiposGravedadAtencion();
    DataSet lsOrigenAtencionEmer = await dalUtili.ListarOrigenAtencionEmergencia();
}

<div class="row">
    <div class="col-md-12">
        <div class="card  m-t-5 bg-blue" style="padding-bottom: 0px;">
            <div class="card-header bg-white">Datos del Paciente</div>
            <div class="card-block m-t-5 custom-form" style="padding-bottom: 0px;">

                <div class="row  pb-1">
                    <div class="col-md-2">
                        <div class="form-group">
                            <label for="txtNroCuenta">N° Cuenta</label>
                            <input type="text" class="form-control form-control-sm" id="txtNroCuenta" placeholder="" autocomplete="off" disabled>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label for="txtHistoria">Historia</label>
                            <input type="text" class="form-control form-control-sm" id="txtHistoria" placeholder="" autocomplete="off" disabled>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label for="txtPacienteNombre">Nombres</label>
                            <input type="text" class="form-control form-control-sm" id="txtPacienteNombre" placeholder="" autocomplete="off" disabled>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label for="txtNroDocumento">N° Documento</label>
                            <div class="d-flex">
                                <input type="text" class="form-control form-control-sm m-r-5" id="txtTipoDocumentoEmer" placeholder="" autocomplete="off" disabled>
                                <input type="text" class="form-control form-control-sm m-l-5" id="txtNroDocumentoEmer" placeholder="" autocomplete="off" disabled>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label for="">Edad (A|M|D)</label>
                            <div class="d-flex">
                                <input type="text" class="form-control form-control-sm" id="txtEdadAnio" placeholder="" autocomplete="off" disabled>
                                <span style="margin: 0 2px;font-weight: bold;">|</span>
                                <input type="text" class="form-control form-control-sm" id="txtEdadMes" placeholder="" autocomplete="off" disabled>
                                <span style="margin: 0 2px;font-weight: bold;">|</span>
                                <input type="text" class="form-control form-control-sm" id="txtEdadDia" placeholder="" autocomplete="off" disabled>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group campo">
                            <label for="cboTipoPaciente">Tipo Paciente</label>
                            <select id="cboTipoPaciente" class="chzn-select">
                                <option value=""></option>
                                @foreach (DataRow gravedad in lsTiposServiciosMGP.Tables[0].Rows)
                                {
                                    @if (Int32.Parse(gravedad["idServicio"].ToString()) != 3)
                                    {
                                        <option value="@gravedad["idServicio"]">@gravedad["descripcion"]</option>
                                    }                                    
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label for="cboOrigenPaciente">Origen</label>
                            <select id="cboOrigenPaciente" class="chzn-select" disabled>
                                <option value=""></option>
                                @foreach (DataRow origen in lsOrigenAtencionEmer.Tables[0].Rows)
                                {
                                    <option value="@origen["idOrigenAtencion"]">@origen["descripcionLarga"]</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group campo">
                            <label for="cboPrioridad">Prioridad</label>
                            <select id="cboPrioridad" class="chzn-select">
                                <option value=""></option>
                                @foreach (DataRow gravedad in lsTiposGravedad.Tables[0].Rows)
                                {
                                    <option value="@gravedad["idTipoGravedad"]">@gravedad["descripcion"]</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-md-1" style="display:none;">@*RMOREANO 11042026 SOLICITO ROLY OCULTAR *@ 
                        <div class="form-group campo">
                            @* <label for="txtGlasgow">Glasgow</label> *@
                            <input type="text" class="form-control form-control-sm" id="txtGlasgow" placeholder="" autocomplete="off">
                        </div>
                    </div>

                    <div class="col-md-1">
                        <div class="form-group custom-controls-stacked campo">
                            <label>Riesgo Caida</label>
                            <div class="switch-field">
                                <input type="radio" id="rdbRiesgoCaidaSi" name="rdbRiesgoCaida" value="1">
                                <label for="rdbRiesgoCaidaSi" class="pl-1 pr-1">Si</label>
                                <input type="radio" id="rdbRiesgoCaidaNo" name="rdbRiesgoCaida" value="0">
                                <label for="rdbRiesgoCaidaNo" class="pl-1 pr-1">No</label>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-1" style="display: none;">
                        <div class="form-group">
                            <label for="txtNroAtencion">N° Atención</label>
                            <input type="text" class="form-control form-control-sm" id="txtNroAtencion" placeholder="" autocomplete="off" disabled>
                        </div>
                    </div>
                    @*<div class="col-md-1" style="display: none;">
                        <div class="form-group">
                            <label for="hdIdTipoFuenteFian">Fuente Financiamiento</label>
                            <input type="text" class="form-control form-control-sm" id="hdIdTipoFuenteFian" placeholder="" autocomplete="off" disabled>
                        </div>
                    </div>*@
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <partial name="~/Views/Shared/Components/VistasParciales/Triaje.cshtml" />
        @*@Html.Partial("~/Views/Shared/Components/VistasParciales/Triaje.cshtml")*@
    </div>
</div>

