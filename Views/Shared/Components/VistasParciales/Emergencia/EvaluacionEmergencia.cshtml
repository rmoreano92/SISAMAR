<script>
    $('.solo-numero').keyup(function () {
        this.value = (this.value + '').replace(/[^0-9]/g, '');
    });

    $('.solo-numero').keydown(function () {
        this.value = (this.value + '').replace(/[^0-9]/g, '');
    });

    $('.solo-decimal').on('input', function () {
        this.value = this.value.replace(/[^0-9,.]/g, '').replace(/,/g, '.');
    });
</script>



