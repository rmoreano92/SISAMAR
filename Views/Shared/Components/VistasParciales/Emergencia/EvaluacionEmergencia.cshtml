        </li>
        <li class="w-100 nav-item m-0">
            <a class="nav-link" href="#ordenes" role="tab" id="ordenes-tab" data-toggle="tab" aria-controls="hats">Órdenes Médicas</a>
        </li>
        <li class="w-100 nav-item m-0">
            <a class="nav-link" href="#otrosCpt" role="tab" id="otrosCpt-tab" data-toggle="tab" aria-controls="hats">Procedimientos (CPT)</a>
        </li>
                            *@
                        </ul>
                    </div>
                </div>
            </div>
        </div>


        <div class="row mt-1" id="PanelEvaluaciones">
            <div class="col-lg-12">
                <form>
                    <fieldset class="m-0 pr-1 pl-1 pb-1">
                        <legend class="mb-0">Evaluaciones del Paciente</legend>
                        <table id="tblEvaluacionesEmergencia" class="table table-sm table-bordered" style="width: 100%; cursor: pointer;">
                            <thead style="color: white;">
                                <tr style="background-color: #434343;">
                                    <th style="width:15% !important; text-align:center;">Eval.</th>
                                    <th style="width:85% !important;">Médico</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>

                        <div class="row mt-1" id="divFirma">
                            <div class="col-xs-12 text-xs-center">
                                <button type="button" style="width: 60px;" class="btn btn-sm btn-success" id="ImprimirEvalEmerCF"><i class="fa fa-print"></i></button>
                                <button type="button" style="width: 60px;" class="btn btn-sm btn-info" id="FirmarEvalEmer"><i class="fa fa-pencil"></i></button>
                                <button type="button" style="width: 60px;" class="btn btn-sm btn-warning" id="ImprimirEvalEmerSF"><i class="fa fa-eye"></i></button>
                            </div>
                        </div>
                    </fieldset>
                </form>
            </div>
        </div>

        <div class="row mt-2">
            <div class="col-lg-12">
                <button style="width:100%;letter-spacing: 1px;" class="btn btn-success font-weight-bold layout_btn_prevent" id="btnNuevoRegistro"><i style="width: 20px; text-align:center;" class="fa-solid fa-file-plus"></i> NUEVA EVALUACIÓN</button>
            </div>
        </div>
       
    </div>
