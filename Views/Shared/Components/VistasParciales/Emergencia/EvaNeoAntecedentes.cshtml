<div class="row">
    <div class="col-md-12 mt-1">
        <div class="form-group">
            <label for="txtAntecedentesGenerales">Atecedentes Generales</label>
            <textarea class="form-control" id="txtAntecedentesGenerales" rows="3"></textarea>
        </div>
    </div>

    <div class="col-md-12 mt-1">
        <ul class="nav nav-tabs" id="myTab" role="tablist">
            <li class="nav-item">
                <a class="nav-link active" id="atencion-tab-link" data-toggle="tab" href="#atencion-tab" role="tab" aria-controls="profile" aria-selected="false" aria-expanded="false">Antecedentes Perinatales</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" id="nacimiento-tab-link" data-toggle="tab" href="#nacimiento-tab" role="tab" aria-controls="home" aria-selected="true" aria-expanded="true">Nacimiento</a>
            </li>
        </ul>

        <div class="tab-content" id="myTabContent">
            <div class="tab-pane fade" id="nacimiento-tab" role="tabpanel" aria-labelledby="nacimiento-tab-link" aria-expanded="true">
                <div class="row">
                    <div class="col-lg-5 mb-1">
                        <div class="card  m-t-5 bg-yellow" style="padding-bottom: 0px;">
                            <div class="card-header bg-white">Nacimiento</div>
                            <div class="card-block m-t-5 custom-form" style="padding-bottom: 0px;">
                                <div class="row pb-1">
                                    <div class="col-md-12">
                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label for="txtFecNac">Fecha Nacimiento</label>
                                                    <input type="text" class="form-control form-control-sm" id="txtFecNac" placeholder="" autocomplete="off" disabled>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label for="txtHoraNac">Hora. Nacimiento</label>
                                                    <input type="text" class="form-control form-control-sm" id="txtHoraNac" placeholder="" autocomplete="off" disabled>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label for="cboSexo">Sexo</label>
                                                    <select id="cboSexo" class="chzn-select" disabled></select>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label for="txtNroHijo">Nro. de Hijo(a)</label>
                                                    <input type="text" class="form-control form-control-sm" id="txtNroHijo" autocomplete="off" disabled>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="form-group campo">
                                            <label for="txtEdadGestacional">Edad Gest. al Nacer (sem)</label>
                                            <input type="text" class="form-control form-control-sm solo-numero campo" id="txtEdadGestacional" maxlength="2" autocomplete="off">
                                        </div>




                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group campo">
                                            <label for="txtPesoRn">Peso al Nacer (gr)</label>
                                            <input type="text" class="form-control form-control-sm solo-decimal campo" id="txtPesoRn" maxlength="10" autocomplete="off">
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group campo">
                                            <label for="txtTallaRn">Talla al Nacer (cm)</label>
                                            <input type="text" class="form-control form-control-sm solo-decimal campo" id="txtTallaRn" maxlength="10" autocomplete="off">
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group campo">
                                            <label for="txtPerCefalico">Périmetro Cefálico</label>
                                            <input type="text" class="form-control form-control-sm solo-decimal campo" id="txtPerCefalico" maxlength="10" autocomplete="off">
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group campo">
                                            <label for="txtPerToracico">Périmetro Toráxico</label>
                                            <input type="text" class="form-control form-control-sm solo-decimal campo" id="txtPerToracico" maxlength="10" autocomplete="off">
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>


                    <div class="col-lg-7 mb-1 campo">
