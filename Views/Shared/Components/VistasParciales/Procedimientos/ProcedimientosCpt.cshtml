﻿<style>
     #tblCSAtencion th:nth-child(8),
     #tblCSAtencion td:nth-child(8) {
         display: none !important;
     }
</style>
<div class="card bg-pink">
    <div class="card-header bg-white">Procedimientos en el Servicio</div>
    <div class="card-block m-t-5 custom-form">
        <div class="row p-t-5">
            <div class="col-md-12">
                <table id="tblCSAtencion" class="table table-sm table-content-md table-bordered table-striped">
                    <thead style="color: white; background: #7a5151;">
                        <tr>
                            <th style="width: 10%">N°. Orden</th>
                            <th style="width: 10%">N°. Orden Pago</th>
                            <th style="width: 40%">Producto</th>
                            <th style="width: 10%">cantidad</th>
                            <th style="width: 10%">lab</th>
                            <th style="width: 10%">dx</th>
                            <th style="width: 10%">Ticket</th>
                            <th style="width: 10%">Informe</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
            <div class="OpcionesCPT col-md-12 m-t-5">
                <div class="d-flex align-items-end">
                    <button id="btnAgregarCSAtencion" title="Agregar CPT" data-toggle="tooltip" type="button"
                        class="btn btn-sm btn-success mr-1" style="width: 100px;">
                        <i class="fa fa-plus" style="width: 20px; text-align:center;"></i>
                        Agregar
                    </button>

                    <button id="btnEliminarCSAtencion" title="Eliminar CPT" data-toggle="tooltip" type="button"
                        class="btn btn-sm btn-danger mr-1" style="width: 100px;">
                        <i class="fa fa-trash" style="width: 20px; text-align:center;"></i>
                        Quitar
                    </button>

                    <button id="btnActualizaCSAtencion" title="Actualiza CPT" data-toggle="tooltip" type="button"
                        class="btn btn-sm btn-primary mr-1" style="width: 100px;">
                        <i class="fa fa-refresh" style="width: 20px; text-align:center;"></i>
                        Actualizar
                    </button>

                    <button id="btnAgregarIntervenciones" title="Agregar Actividades" data-toggle="tooltip"
                        type="button" class="btn btn-sm btn-success mr-1"
                        style="background-color: #27b6d5 !important; border-color: #27b6d5 !important;">
                        <i class="fa fa-plus" style="width: 20px; text-align:center;"></i>
                        Agregar Intervencion Enf.
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    (function () {
        function ocultarColumnaInformeTblCSAtencion() {
            const $tabla = $('#tblCSAtencion');
            if (!$tabla.length) return;

            $tabla.find('thead th:nth-child(8), tbody td:nth-child(8)').css('display', 'none');

            if ($.fn.dataTable && $.fn.dataTable.isDataTable($tabla)) {
                const dt = $tabla.DataTable();
                if (dt.column(7).visible()) {
                    dt.column(7).visible(false, false);
                    dt.columns.adjust().draw(false);
                }
            }
        }

        $(document).ready(ocultarColumnaInformeTblCSAtencion);
        $(document).on('init.dt draw.dt', '#tblCSAtencion', ocultarColumnaInformeTblCSAtencion);
    })();
</script>