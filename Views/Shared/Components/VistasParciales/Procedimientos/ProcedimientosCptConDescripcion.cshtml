<div class="card bg-pink">
    <div class="card-header bg-white">Procedimientos en el Servicio</div>
    <div class="card-block m-t-5 custom-form">
        <div class="row p-t-5">
            <div class="col-md-12">
                <table id="tblCSAtencion" class="table table-sm table-bordered">
                    <thead style="color: white; background: #7a5151;">
                        <tr>
                            <th style="width: 10%">N°. Orden</th>
                            <th style="width: 30%">Producto</th>
                            <th style="width: 10%">cantidad</th>
                            <th style="width: 10%">Fecha</th>
                            <th style="width: 50%">Descripción</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
            <div class="OpcionesCPT col-md-12 m-t-5">
                <div class="d-flex align-items-end">
                    <button id="btnAgregarCSAtencion" title="Agregar CPT" data-toggle="tooltip" type="button" class="btn btn-sm btn-success mr-1" style="width: 100px;">
                        <i class="fa fa-plus" style="width: 20px; text-align:center;"></i>
                        Agregar
                    </button>
                    <button id="btnEliminarCSAtencion" title="Eliminar CPT" data-toggle="tooltip" type="button" class="btn btn-sm btn-danger mr-1" style="width: 100px;">
                        <i class="fa fa-trash" style="width: 20px; text-align:center;"></i>
                        Quitar
                    </button>
                    <button id="btnActualizaCSAtencion" title="Actualiza CPT" data-toggle="tooltip" type="button" class="btn btn-sm btn-primary" style="width: 100px;">
                        <i class="fa fa-refresh" style="width: 20px; text-align:center;"></i>
                        Actualizar
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
