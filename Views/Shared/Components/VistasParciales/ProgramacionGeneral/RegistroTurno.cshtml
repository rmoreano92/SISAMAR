<div class="modal fade" id="modalRegistroTurno" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog modal-sm" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary">
                <h5 class="modal-title text-white" id="exampleModalLabel">Registro Turnos</h5>
            </div>
            <div class="modal-body">

                <div class="row">
                    <div class="col-lg-12 mb-1">
                        <div class="card bg-yellow">
                            @* <div class="card-header bg-white">Turno</div> *@
                            <div class="card-block">
                                <div class="row">
                                    <div class="col-lg-6">
                                        <div class="form-group m-0">
                                            <label for="txtCodigo" class="form-control-label">Código</label>
                                            <input id="txtCodigo" autocomplete="off" placeholder="" class="form-control form-control-sm campo">
                                        </div>
                                    </div>
                                    <div class="col-lg-12">
                                        <div class="form-group m-0">
                                            <label for="txtDescripcion" class="form-control-label">Descripción</label>
                                            <input id="txtDescripcion" autocomplete="off" placeholder="" class="form-control form-control-sm campo">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-12">
                        <div class="card bg-yellow">
                            <div class="card-header bg-white">Valores por defecto</div>
                            <div class="card-block">
                                <div class="row">
                                    <div class="col-lg-6">
                                        <div class="form-group m-0">
                                            <label for="txtHoraInico" class="form-control-label">Hora Inicio</label>
                                            <input id="txtHoraInico" autocomplete="off" placeholder="" class="form-control form-control-sm maskHora campo">
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div class="form-group m-0">
                                            <label for="txtHoraFin" class="form-control-label">Hora Fin</label>
                                            <input id="txtHoraFin" autocomplete="off" placeholder="" class="form-control form-control-sm maskHora campo">
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="form-group m-0">
                                    <label for="cboTipoServicio">Tipo Servicio</label>
                                    <select class="chzn-select campo" id="cboTipoServicio" data-placeholder="Seleccione una opción"></select>
                                </div>

                                <div class="form-group m-0">
                                    <label for="cboTipoTurno">Turno Refer.</label>
                                    <select class="chzn-select campo" id="cboTipoTurno" data-placeholder="Seleccione una opción"></select>
                                </div>
                                
                            </div>
                        </div>
                    </div>

                    
                </div>

            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-lg btn-secondary mr-1" id="btnCerrarTurno" style="width: 120px;">CERRAR</button>
                <button type="button" class="btn btn-lg btn-primary" id="btnGuardarTurno" style="width: 120px;">GUARDAR</button>
            </div>
        </div>
    </div>
</div>



<style>
    .chosen-container {
        width: 100% !important;
    }
</style>
