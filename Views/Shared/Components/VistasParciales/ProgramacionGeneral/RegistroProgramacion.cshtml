<div class="modal fade" id="modalRegistroProgramacion" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog modal-sm" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary">
                <h4 class="modal-title text-white" id="exampleModalLabel">Registro Programación</h4>
            </div>
            <div class="modal-body">

                <div class="row">
                    <div class="col-lg-12">
                        <div class="card bg-yellow">
                            @* <div class="card-header bg-white">Turno</div> *@
                            <div class="card-block">
                                <div class="row">
                                    <div class="col-lg-12">
                                        <div class="form-group m-0">
                                            <label for="cboTipoServicioProgramacion">Tipo Servicio</label>
                                            <select class="chzn-select-deselect campo campoEdicion" id="cboTipoServicioProgramacion" data-placeholder="Seleccione una opción"><option value=""></option></select>
                                        </div>
                                    </div>
                                    <div class="col-lg-12">
                                        <div class="form-group m-0">
                                            <label for="cboMedicoProgramacion">Medico</label>
                                            <input type="text" autocomplete="off" class="form-control form-control-sm campo" id="txtIdMedicoProgramacion"  disabled hidden>
                                            <input type="text" autocomplete="off" class="form-control form-control-sm campo" id="txtMedicoProgramacion" disabled>
                                            @* <select class="chzn-select-deselect campo" id="cboMedicoProgramacion" data-placeholder="Seleccione una opción" disabled></select> *@
                                        </div>
                                    </div>
                                    <div class="col-lg-12">
                                        <div class="form-group m-0">
                                            <label for="cboEspecialidadProgramacion">Especialidad</label>
                                            <select class="chzn-select-deselect campo campoEdicion" id="cboEspecialidadProgramacion" data-placeholder="Seleccione una opción"><option value=""></option></select>
                                        </div>
                                    </div>
                                    <div class="col-lg-12">
                                        <div class="form-group m-0">
                                            <label for="cboConsultorioProgramacion">Consultorio</label>
                                            <select class="chzn-select-deselect campo campoEdicion" id="cboConsultorioProgramacion" data-placeholder="Seleccione una opción"><option value=""></option></select>
                                        </div>
                                    </div>
                                    <div class="col-lg-12">
                                        <div class="form-group m-0">
                                            <label for="txtFechaProgramacion">Fecha</label>
                                            <div class="row">
                                                <div class="col-xs-6" style="padding-right: 5px;">
                                                    <div class="input-group input-group-sm">
                                                        <input type="text" autocomplete="off" class="form-control  form_val_popup_dp3 campo" placeholder="dd/mm/yyyy" data-date-format="dd/mm/yyyy" id="txtFechaInicioProgramacion" disabled>
                                                        <span class="input-group-addon">
                                                            <i class="fa fa-calendar "></i>
                                                        </span>
                                                    </div>
                                                </div>
                                                <div class="col-xs-6" style="padding-left: 5px;" id="divFechaFinProgramacion">
                                                    <div class="input-group input-group-sm">
                                                        <input type="text" autocomplete="off" class="form-control  form_val_popup_dp3 campo" placeholder="dd/mm/yyyy" data-date-format="dd/mm/yyyy" id="txtFechaFinProgramacion" disabled>
                                                        <span class="input-group-addon">
                                                            <i class="fa fa-calendar "></i>
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>                                            
                                        </div>
                                    </div>
                                    <div class="col-lg-12">
                                        <div class="form-group m-0">
                                            <label for="cboTipoProgramacion">Tipo Programación</label>
                                            <select class="chzn-select-deselect campo campoEdicion" id="cboTipoProgramacion" data-placeholder="Seleccione una opción"><option value=""></option></select>
                                        </div>
                                    </div>

                                    <div class="col-lg-12">
                                        <div class="form-group m-0">
                                            <label for="cboTurnoProgramacion">Turno</label>
                                            <select class="chzn-select-deselect campo campoEdicion" id="cboTurnoProgramacion" data-placeholder="Seleccione una opción"><option value=""></option></select>
                                        </div>
                                    </div>

                                    <div class="col-lg-12">
                                        <div class="row">
                                            <div class="col-xs-6">
                                                <div class="form-group m-0">
                                                    <label for="txtHoraInicoProgramacion" class="form-control-label">Hora Inicio</label>
                                                    <div class="input-group input-group-sm">
                                                        <input type="text" autocomplete="off" class="form-control  form_val_popup_dp3 maskHora campo campoEdicion" id="txtHoraInicoProgramacion">
                                                        <span class="input-group-addon">
                                                            <i class="fa fa-timer"></i>
                                                        </span>
                                                    </div>                                                   
                                                </div>
                                            </div>
                                            <div class="col-xs-6">
                                                <div class="form-group m-0">
                                                    <label for="txtHoraFinProgramacion" class="form-control-label">Hora Final</label>
                                                    <div class="input-group input-group-sm">
                                                        <input type="text" autocomplete="off" class="form-control  form_val_popup_dp3 maskHora campo campoEdicion" id="txtHoraFinProgramacion">
                                                        <span class="input-group-addon">
                                                            <i class="fa fa-timer"></i>
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-lg-12">
                                        <div class="form-group m-0">
                                            <label for="txtDescripcionProgramacion">Descripción</label>
                                            <textarea class="form-control campo campoEdicion" id="txtDescripcion" rows="2"></textarea>
                                        </div>
                                    </div>

                                    <div class="col-lg-12 d-none">
                                        <div class="form-group m-0">
                                            <label for="txtColorProgramacion" class="form-control-label">Color</label>
                                            <input type="color" id="txtColorProgramacion" autocomplete="off" placeholder="" class="form-control form-control-sm maskHora campo">
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>

                    
                </div>

            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-lg btn-secondary mr-1" id="btnCerrarProgramacion" style="width: 120px;">CERRAR</button>
                <button type="button" class="btn btn-lg btn-primary" id="btnGuardarProgramacion" style="width: 120px;">GUARDAR</button>
            </div>
        </div>
    </div>
</div>
