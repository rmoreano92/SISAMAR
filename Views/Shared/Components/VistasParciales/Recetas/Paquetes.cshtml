                                    <select class="chzn-select" id="cboPaquetes"></select>
                                </div>
                            </div>
                            @* <div class="col-md-3">
                                <label id="lblPaq" style="color:red" class="form-control-label"><b>Seleccione Paquete</b></label>
                            </div>
                            <div class="col-md-6 float-lg-left">
                                <select class="chzn-select" id="cboPaquetes"></select>
                            </div> *@

