@using Microsoft.Extensions.Configuration;
@{
    var AppVistaOrdenesMedica = new ConfigurationBuilder().AddJsonFile("appsettings.json").Build().GetValue<string>("Configuraciones:TipoVistaOrdenesMedica");
    string VistaOrdenesMedica = AppVistaOrdenesMedica.ToString();
}

<div data-backdrop="static" style="overflow-y: scroll; background-color: #0606067a;" data-keyboard="false" class="modal fade" id="modalRecetaImprime" role="dialog" aria-labelledby="modalLabelsuccess">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header bg-cyan">
                <h4 class="modal-title text-white" id="modalLabelsuccess">Visor Recetas y Ordenes</h4>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-4 col-lg-3 col-xl-3">
                        <div class="card" style="background-color: aliceblue;">
                            <div class="card-header">
                                Recetas/Orden
                            </div>
                            <div class="card-block p-0">

                                <ul id="ListNavTiposOrdenes" class="nav nav-tabs jerarquia2A" role="tablist">
                                    <li class="nav-item w-100 m-0">
                                        <a class="nav-link btnReceta" href="#" role="tab" data-name="REC-F" id="farmaciaRece" data-toggle="tab" aria-controls="hats" aria-expanded="true"><i class="fa-solid fa-pills mr-1"></i>Farmacia</a>
                                    </li>
                                    <li class="nav-item w-100 m-0">
                                        <a class="nav-link btnReceta" href="#" role="tab" data-name="REC-F" id="farmaciaAntimicRece" data-toggle="tab" aria-controls="hats" aria-expanded="true"><i class="fa fi fi-ss-prescription-bottle-pill mr-1"></i>Farmacia Antimic.</a>
                                    </li>
                                    <li class="nav-item w-100 m-0">
                                        <a class="nav-link btnReceta" href="#" role="tab" data-name="REC-F" id="farmaciaIntSanitRece" data-toggle="tab" aria-controls="hats" aria-expanded="true"><i class="fi fi-ss-medicine mr-1"></i>Farmacia Int. Sanit.</a>
                                    </li>
                                    <li class="nav-item w-100 m-0">
                                        <a class="nav-link btnReceta" href="#" role="tab" data-name="REC-PC" id="patoClinicaRece" data-toggle="tab" aria-controls="hats" aria-expanded="false"><i class="fa-solid fa-microscope mr-1"></i>Pat. Clinica</a>
                                    </li>
                                    <li class="nav-item w-100 m-0">
                                        <a class="nav-link btnReceta" href="#" role="tab" data-name="REC-AP" id="anatoPatoRece" data-toggle="tab" aria-controls="hats"><i class="fa-solid fa-vial mr-1"></i>Anat. Patologica</a>
                                    </li>
                                    <li class="nav-item w-100 m-0">
