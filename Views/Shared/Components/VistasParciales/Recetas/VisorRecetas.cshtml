                                    </li>
                                    @if (VistaOrdenesMedica == "1")
                                    {
                                        <li class="nav-item w-100 m-0">
                                            <a class="nav-link btnReceta" href="#" role="tab" data-name="REC-EO" id="ecoObstRece" data-toggle="tab" aria-controls="hats"><i class="fa-solid fa-person-pregnant mr-1"></i>Eco. Obstétrica</a>
                                        </li>
                                    }
                                    @if (VistaOrdenesMedica == "2")
                                    {
                                        <li class="nav-item w-100 m-0">
                                            <a class="nav-link btnReceta" href="#" role="tab" data-name="REC-EO" id="ecoObstRece" data-toggle="tab" aria-controls="hats"><i class="fa-solid fa-person-pregnant mr-1"></i>Eco. Medicina Fetal</a>
                                        </li>
                                        <li class="nav-item w-100 m-0">
                                            <a class="nav-link btnReceta" href="#" role="tab" data-name="REC-EOP" id="ecoObstProcRece" data-toggle="tab" aria-controls="hats"><i class="fa-solid fa-person-pregnant mr-1"></i>Proc. Medicina Fetal</a>
                                        </li>
                                    }
                                    <li class="nav-item w-100 m-0">
                                        <a class="nav-link btnReceta" href="#" role="tab" data-name="REC-EG" id="ecoGeneRece" data-toggle="tab" aria-controls="hats"><i class="fa-solid fa-person-dots-from-line mr-1"></i>Eco. General</a>
                                    </li>
                                    <li class="nav-item w-100 m-0">
                                        <a class="nav-link btnReceta" href="#" role="tab" data-name="REC-RX" id="rayosRece" data-toggle="tab" aria-controls="hats"><i class="fa-solid fa-x-ray mr-1"></i>Rayos X</a>
                                    </li>
                                    <li class="nav-item w-100 m-0">
