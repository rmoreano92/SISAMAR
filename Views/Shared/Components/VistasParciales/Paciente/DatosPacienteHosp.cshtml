<div class="card m-t-5" style="background-color: #eceeef;">
    <div class="card-header bg-white">Ingreso a UCIM</div>
    
    <div class="card-block m-t-5">

        <div class="row">
            <div class="col-lg-2">
                <label for="txtFechaIngresoMGP" class="form-control-label">Fecha de Ingreso al MGP</label>
                <div class="input-group input-group-sm">
                    <input type="text" autocomplete="off" class="form-control campoRegistro form_val_popup_dp3 bloquear" placeholder="dd/mm/yyyy" data-date-format="dd/mm/yyyy" id="txtFechaIngresoMGP">
                    <span class="input-group-addon">
                        <i class="fa fa-calendar "></i>
                    </span>
                </div>
            </div>

            <div class="col-lg-2">
                <label for="txtHoraIngresoMGP" class="font-weight-bold text-info">Hora</label>
                <div class="form-group m-0">
                    <div class="d-flex">
                        <div style="max-width:80px;">
                            <input type="text" name="txtHoraAtencionUCI" id="txtHoraIngresoMGP" onblur="valida_hora(value)" class="form-control campoRegistro form-control-sm" placeholder="" autocomplete="off">
                        </div>
                        <div class="ml-1 mr-1">
                            <label class="m-0 text-info">24 Horas</label>
                        </div>
                    </div>
                </div>
            </div>

            @*<div class="col-lg-2">
            <label for="cboProcedenciaUCI">Procedencia</label>
            <div class="input-group">
            <select class="chzn-select campoRegistroSelect" id="cboProcedenciaUCI">
            <option value="0">--Seleccionar--</option>
            <option value="1">Referida</option>
            <option value="2">Institucional</option>
            </select>
            </div>
            </div>*@
            <div class="col-lg-4" id="contProcedenciaHospital">
                <label for="" class="form-label" id="lblEstabRefCon">Hospital de Referencia</label>
                <div class="input-group input-group-sm">
                    <input type="text" class="form-control campoRegistro" id="txtIdReferenciaCita" style="width: 70px;" disabled="">

                    <input type="text" class="form-control campoRegistro" id="txtDescripcionReferenciaCita" disabled="" style="width: 320px;">
                    <span class="input-group-btn">
                        <button class="btn btn-info bloquear" type="button" id="btnOpenModalEstablecimientoReferenciaCita">Buscar</button>
                    </span>
                    <span class="input-group-btn">
                        <button class="btn btn-secondary bloquear" type="button" id="btnLimpiarReferencia">Limpiar</button>
                    </span>
                </div>
            </div>

            <div class="col-lg-3" id="contProcedenciaServicio">
                <label for="cboProcedenciaServicio">Servicio de Procedencia</label>
                <div class="input-group">
                    <select class="chzn-select campoRegistroSelect" id="cboProcedenciaServicio" data-placeholder="Seleccionar una opcion"></select>
                </div>
            </div>

        </div>

        <div class="row">
            <div class="col-lg-2">
                <label for="txtFechaIngresoUCIM" class="form-control-label">Fecha de Ingreso a UCIM</label>
                <div class="input-group input-group-sm">
                    <input type="text" autocomplete="off" class="form-control campoRegistro form_val_popup_dp3 bloquear" placeholder="dd/mm/yyyy" data-date-format="dd/mm/yyyy" id="txtFechaIngresoUCIM">
                    <span class="input-group-addon">
                        <i class="fa fa-calendar "></i>
                    </span>
                </div>
            </div>

            <div class="col-lg-2">
                <label for="txtHoraAtencionUCI" class="font-weight-bold text-info">Hora</label>
                <div class="form-group m-0">
                    <div class="d-flex">
                        <div style="max-width:80px;">
                            <input type="text" name="txtHoraAtencionUCI" id="txtHoraAtencionUCI" onblur="valida_hora(value)" class="form-control campoRegistro form-control-sm" placeholder="" autocomplete="off">
                        </div>
                        <div class="ml-1 mr-1">
                            <label class="m-0 text-info">24 Horas</label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-2">
                <label for="cboTipoIngresoUCIM">Tipo de ingreso a UCIM</label>
                <div class="input-group">
                    <select class="chzn-select campoRegistroSelect" id="cboTipoIngresoUCIM" data-placeholder="Seleccionar una opcion">
                        <option value="1">Nuevo</option>
                        <option value="2">Reingreso +48 h</option>
                        <option value="3">Reingreso -48 h</option>
                    </select>
                </div>
            </div>

            <div class="col-lg-2">
                <label for="cboCamaHospitalizacion" class="form-control-label">UCIM - Cama</label>
                <div class="input-group mb-1">
                    <select class="chzn-select campoRegistroSelect" id="cboCamaHospitalizacion" data-placeholder="Seleccionar una opcion"></select>
                </div>
            </div>
        </div>
    </div>
</div>
