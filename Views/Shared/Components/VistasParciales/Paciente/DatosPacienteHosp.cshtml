<div class="card m-t-5 bg-blue">
    <div class="card-header bg-white">Datos generales</div>
    <div class="card-block m-t-5">

        <div class="row">
            <div class="col-lg-2">
                <label for="txtNroCuenta">N° Cuenta</label>
                <div class="form-group m-0">
                    <input type="text" class="form-control campoRegistro form-control-sm" id="txtNroCuenta" placeholder="" autocomplete="off" disabled="">
                </div>
            </div>

            <div class="col-lg-2">
                <label for="txtNroHistoria">N° Historia</label>
                <div class="form-group m-0">
                    <input type="text" class="form-control campoRegistro form-control-sm" id="txtNroHistoria" placeholder="" autocomplete="off" disabled="">
                </div>
            </div>

            <div class="col-lg-3">
                <label for="txtApellidosNombrePaciente">Nombres</label>
                <div class="form-group m-0">
                    <input type="text" class="form-control campoRegistro form-control-sm" id="txtApellidosNombrePaciente" placeholder="" autocomplete="off" disabled="">
                </div>
            </div>

            <div class="col-lg-2">
                <label for="cboEstadoCivil">Estado Civil</label>
                <div class="input-group">
                    <select class="chzn-select campoRegistroSelect" id="cboEstadoCivil" data-placeholder="Seleccionar una opcion" disabled></select>
                </div>
            </div>

            <div class="col-lg-2">
                <label for="txtFechaNacimiento" class="form-control-label">Fecha de Nacimiento</label>
                <div class="input-group input-group-sm">
                    <input type="text" autocomplete="off" class="form-control campoRegistro form_val_popup_dp3 bloquear" placeholder="dd/mm/yyyy" data-date-format="dd/mm/yyyy" id="txtFechaNacimiento" disabled>
                    <span class="input-group-addon">
                        <i class="fa fa-calendar "></i>
                    </span>
                </div>
            </div>

            <div class="col-lg-1">
                <label for="txtEdad">Edad</label>
                <div class="form-group m-0">
                    <input type="text" class="form-control campoRegistro form-control-sm" id="txtEdad" placeholder="" autocomplete="off" disabled="">
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-2">
                <label for="cboNacionalidad">Nacionalidad</label>
                <div class="input-group">
                    <select class="chzn-select campoRegistroSelect" id="cboNacionalidad" data-placeholder="Seleccionar una opcion" disabled></select>
                </div>
            </div>



            <div class="col-lg-3">
                <label for="cboGradoInstruccion">Instruccion</label>
                <div class="input-group">
                    <select class="chzn-select campoRegistroSelect" id="cboGradoInstruccion" data-placeholder="Seleccionar una opcion" disabled></select>
                </div>
            </div>

            <div class="col-lg-2">
                <label for="txtTelefono">Telefono</label>
                <div class="form-group m-0">
                    <input type="text" class="form-control campoRegistro form-control-sm" id="txtTelefono" placeholder="" autocomplete="off" disabled="">
                </div>
            </div>
        </div>
    </div>
</div>

