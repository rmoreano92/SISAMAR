<div class="card  m-t-5 bg-blue">
    <div class="card-header bg-white">Datos del Paciente</div>
    <div class="card-block m-t-5">
        <div class="row">
            <div class="col-md-8">
                <div class="row">
                    <div class="col-md-2">
                        <div class="form-group m-0">
                            <label for="txtDatoCuenta">N° Cuenta</label>
                            <input type="text" class="form-control form-control-sm" id="txtDatoCuenta" placeholder="" autocomplete="off" disabled="">
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group m-0">
                            <label for="txtDatoPaciente">Nombres</label>
                            <input type="text" class="form-control form-control-sm" id="txtDatoPaciente" placeholder="" autocomplete="off" disabled="">
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group m-0">
                            <label for="txtDatoHistoria">N° Historia</label>
                            <input type="text" class="form-control form-control-sm" id="txtDatoHistoria" placeholder="" autocomplete="off" disabled="">
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group m-0">
                            <label for="txtDatoEdad">Edad</label>
                            <input type="text" class="form-control form-control-sm" id="txtDatoEdad" placeholder="" autocomplete="off" disabled="">
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="d-flex">
                    <div class="mr-1" style="max-width: 170px;">
                        <div class="form-group m-0">
                            <label for="txtHoraCia" class="font-weight-bold text-info">Hora de Cita</label>
                            <input type="text" class="form-control form-control-sm" id="txtHoraCia" placeholder="" autocomplete="off" style="max-width:80px;" disabled="">
                        </div>
                    </div>
                    <div class="ml-1" style="max-width: 170px;">
                        <div class="form-group m-0 campo">
                            <label for="HoraInicioAtencion" class="font-weight-bold text-info">Hora de Inicio de Atención</label>
                            <div class="d-flex">
                                <div style="max-width:80px;">
                                    <input type="text" name="HoraInicioAtencion" id="HoraInicioAtencion" onblur="valida_hora(value)" class="form-control form-control-sm" placeholder="" autocomplete="off">
                                </div>
                                <div class="ml-1 mr-1">
                                    <label class="m-0 text-info">24 Horas</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>