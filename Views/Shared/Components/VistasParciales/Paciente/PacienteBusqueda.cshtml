<div data-backdrop="static" style="overflow-y: scroll; background-color: rgba(0, 0, 0, 0.46);" data-keyboard="false" class="modal fade" id="modalPacienteBusqueda" role="dialog" aria-labelledby="modalLabelsuccess">
    <div class="modal-dialog modal-xxl" role="document">
        <div class="modal-content">

            <div class="modal-header bg-primary">
                <h4 class="modal-title text-white" id="titulo">Pacientes</h4>
            </div>

            <div class="modal-body">
                <div class="card-block">
                    <div class="row">                        
                        <div class="col-md-12">
                            <div class="card">
                                <div class="card-block">
                                    <div class="row">
                                        <div class="col-lg-2">
                                            <div class="form-group m-0">
                                                <label for="txtNroDniBusq" class="form-control-label">N° Dni</label>
                                                <div class="input-group input-group-sm">
                                                    <input id="txtNroDniBusq" autocomplete="off" placeholder="" class=" solo-numero form-control search2">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-2">
                                            <div class="form-group m-0">
                                                <label for="txtNroHistoriaBusq" class="form-control-label">N° Historia</label>
                                                <div class="input-group input-group-sm">
                                                    <input id="txtNroHistoriaBusq" autocomplete="off" placeholder="" class=" solo-numero form-control search2">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-2">
                                            <div class="form-group m-0">
                                                <label for="txtApPaternoBusq" class="form-control-label">Apellido Paterno</label>
                                                <div class="input-group input-group-sm">
                                                    <input id="txtApPaternoBusq" autocomplete="off" placeholder="" class=" form-control search2">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-2">
                                            <div class="form-group m-0">
                                                <label for="txtApMaternoBusq" class="form-control-label">Apellido Materno</label>
                                                <div class="input-group input-group-sm">
                                                    <input id="txtApMaternoBusq" autocomplete="off" placeholder="" class=" form-control search2">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-2">
                                            <div class="d-flex align-items-end" style="height: 55px;">
                                                <button class="btn btn-primary btn-sm layout_btn_prevent mr-1" id="btnBuscarPacientes" style="padding-left: 2rem !important; padding-right: 2rem !important;">Buscar</button>
                                                <button class="btn btn-default btn-sm layout_btn_prevent" id="btnLimpiarPacientes" style="padding-left: 2rem !important; padding-right: 2rem !important;">Limpiar</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-12">
                            <table id="tblPacientes" class="table table-sm table-bordered w-100">
                                <thead style="color: white; background: #434343;">
                                    <tr>
                                        <th width="5%">Nro Historia</th>
                                        <th width="10%">Apellido Paterno</th>
                                        <th width="10%">Apellido Materno</th>
                                        <th width="10%">1er Nombre</th>
                                        <th width="10%">2do Nombre</th>

                                        <th width="5%">Fecha de Nac.</th>
                                        @*<th>Ult. Tipo de Serv.</th>
                                        <th>Ult. Serv. Ing.</th>
                                        <th>Ult. Fecha. Ing.</th>
                                        <th>Ult. Fecha. Egr.</th>*@
                                    </tr>
                                </thead>
                                <tbody style="cursor: pointer;"></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button id="btnAceptarPaciente" type="button" class="btn btn-primary px-2 mr-2" >Aceptar</button>
                <button id="btnCancelarPaciente" type="button" class="btn btn-secondary px-2">Cancelar</button>
            </div>

        </div>
    </div>

</div>







