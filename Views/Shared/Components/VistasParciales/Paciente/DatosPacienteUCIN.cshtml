<div class="row">
    <div class="col-xl-8 mb-1">
        <div class="card bg-blue pb-1">
            <div class="card-header bg-white">Datos del Paciente</div>
            <div class="card-block pb-0">

                <div class="row">
                    <div class="col-xl-2">
                        <div class="form-group mb-0">
                            <label for="txtNroCuenta" class="d-block text-truncate">N° Cuenta</label>
                            <input type="text" class="form-control form-control-sm" id="txtNroCuenta" placeholder="" autocomplete="off" disabled="">
                        </div>
                    </div>
                    <div class="col-xl-2">
                        <div class="form-group mb-0">
                            <label for="txtHistoria" class="d-block text-truncate">Historia</label>
                            <input type="text" class="form-control form-control-sm" id="txtHistoria" placeholder="" autocomplete="off" disabled="">
                        </div>
                    </div>
                    <div class="col-xl-4">
                        <div class="form-group mb-0">
                            <label for="txtPacienteNombre" class="d-block text-truncate">Nombres</label>
                            <input type="text" class="form-control form-control-sm" id="txtPacienteNombre" placeholder="" autocomplete="off" disabled="">
                        </div>
                    </div>
                    <div class="col-xl-4">
                        <div class="form-group mb-0">
                            <label for="txtNroDocumento" class="d-block text-truncate">N° Documento</label>
                            <div class="d-flex">
                                <input type="text" class="form-control form-control-sm m-r-5" id="txtTipoDocumento" placeholder="" autocomplete="off" disabled="">
                                <input type="text" class="form-control form-control-sm m-l-5" id="txtNroDocumento" placeholder="" autocomplete="off" disabled="">
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-xl-2">
                        <div class="form-group mb-0">
                            <label for="txtFechaNacimiento" class="d-block text-truncate">Fecha Nac.</label>
                            <div class="input-group input-group-sm">
                                <input type="text" autocomplete="off" class="form-control form_val_popup_dp3 maskFecha" placeholder="dd/mm/yyyy" data-date-format="dd/mm/yyyy" id="txtFechaNacimiento" disabled="" readonly="">
                                <span class="input-group-addon " for="txtFechaNacimiento" id="txtFechaNacimientoIcon">
                                    <i class="fa fa-calendar "></i>
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-2">
                        <div class="form-group mb-0">
                            <label for="txtHoraNacimiento" class="d-block text-truncate">Hora Nac.</label>
                            <input type="text" autocomplete="off" class="form-control form-control-sm maskHora" name="txtHoraNacimiento" id="txtHoraNacimiento" disabled="" readonly="">
                        </div>
                    </div>
                    <div class="col-xl-3">
                        <div class="form-group mb-0">
                            <label for="" class="d-block text-truncate">Edad (A|M|D)</label>
                            <div class="input-group input-group-sm">
                                <input type="text" class="form-control form-control-sm" id="txtEdadAnio" placeholder="" autocomplete="off" disabled="">
                                <span class="input-group-addon">|</span>
                                <input type="text" class="form-control form-control-sm" id="txtEdadMes" placeholder="" autocomplete="off" disabled="">
                                <span class="input-group-addon">|</span>
                                <input type="text" class="form-control form-control-sm" id="txtEdadDia" placeholder="" autocomplete="off" disabled="">
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-3">
                        <div class="form-group mb-0">
                            <label for="txtSexo" class="d-block text-truncate">Sexo</label>
                            <input type="text" class="form-control form-control-sm" id="txtSexo" placeholder="" autocomplete="off" disabled="">
                        </div>
                    </div>
                    <div class="col-xl-2">
                        <div class="form-group mb-0">
                            <label for="txtNroCama" class="d-block text-truncate">Nro Cama</label>
                            <input type="text" class="form-control form-control-sm" id="txtNroCama" placeholder="" autocomplete="off" disabled="">
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-xl-7">
                        <div class="row">
                            <div class="col-xl-6">
                                <div class="form-group mb-0">
                                    <label for="txtServicioNacimiento" class="d-block text-truncate">Servicio Nacimiento</label>
                                    <input type="text" class="form-control form-control-sm" id="txtServicioNacimiento" placeholder="" autocomplete="off" disabled="">
                                </div>
                            </div>
                            <div class="col-xl-6">
                                <div class="form-group mb-0">
                                    <label for="txtServicioActual" class="d-block text-truncate">Servicio Actual</label>
                                    <input type="text" class="form-control form-control-sm" id="txtServicioActual" placeholder="" autocomplete="off" disabled="">
                                </div>
                            </div>
                        </div>
                    </div>                  
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-4 mb-1">
        <div class="card bg-orange pb-1">
            <div class="card-header bg-white">Datos de la Madre</div>
            <div class="card-block pb-0">
                <div class="row">
                    <div class="col-xl-3">
                        <div class="form-group mb-0">
                            <label for="txtNroHistoriaMadre" class="d-block text-truncate">Historia Clinica</label>
                            <input type="text" class="form-control form-control-sm" id="txtNroHistoriaMadre" disabled="" autocomplete="off">
                        </div>
                    </div>
                    <div class="col-xl-9">
                        <div class="form-group mb-0">
                            <label for="txtNombreMadre" class="d-block text-truncate">Datos Personales</label>
                            <input type="text" class="form-control form-control-sm" id="txtNombreMadre" disabled="" autocomplete="off">
                        </div>
                    </div>

                </div>

                <div class="row">
                    <div class="col-xl-6">
                        <div class="form-group mb-0">
                            <label for="txtTipoDocMadre" class="d-block text-truncate">Tipo Documento</label>
                            <input type="text" class="form-control form-control-sm" id="txtTipoDocMadre" disabled="" autocomplete="off">
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mb-0">
                            <label for="txtNroDocMadre" class="d-block text-truncate">Nro Documento</label>
                            <input type="text" class="form-control form-control-sm" id="txtNroDocMadre" disabled="" autocomplete="off">
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-xl-6">
                        <div class="form-group mb-0">
                            <label for="txtEdadMadre" class="d-block text-truncate">Edad (años)</label>
                            <input type="text" class="form-control form-control-sm" id="txtEdadMadre" disabled="" autocomplete="off">
                        </div>
                    </div>

                    <div class="col-xl-6">
                        <div class="form-group mb-0">
                            <label for="txtEstadoCivilMadre" class="d-block text-truncate">Estado Civil</label>
                            <input type="text" class="form-control form-control-sm" id="txtEstadoCivilMadre" disabled="" autocomplete="off">
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <div class="col-xl-12 mb-1 d-none">
        <div class="card" style="background-color: #eceeef;">
            <div class="card-header bg-white">Ingreso a UCIN</div>

            <div class="card-block">

                <div class="row">
                    <div class="col-xl-3">
                        <div class="row">
                            <div class="col-xl-7">
                                <div class="form-group m-0">
                                    <label for="txtFechaIngresoMGP" class="d-block text-truncate">Fecha de Ingreso al MGP</label>
                                    <div class="input-group input-group-sm">
                                        <input type="text" autocomplete="off" class="form-control form_val_popup_dp3 maskFecha" placeholder="dd/mm/yyyy" data-date-format="dd/mm/yyyy" id="txtFechaIngresoMGP">
                                        <span class="input-group-addon">
                                            <i class="fa fa-calendar "></i>
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-xl-5">
                                <div class="form-group m-0">
                                    <label for="txtHoraIngresoMGP" class="font-weight-bold text-info d-block text-truncate">Hora</label>
                                    <div class="input-group input-group-sm">
                                        <input type="text" class="form-control form-control-sm maskHora" name="txtHoraIngresoMGP" id="txtHoraIngresoMGP" autocomplete="off">
                                        <span class="input-group-addon text-info">24 Horas</span>
                                    </div>
                                    @* <div class="d-flex">
                                            <div style="max-width:80px;">
                                                <input type="text" name="txtHoraAtencionUCI" id="txtHoraIngresoMGP" onblur="valida_hora(value)" class="form-control campoRegistro form-control-sm" placeholder="" autocomplete="off">
                                            </div>
                                            <div class="ml-1 mr-1">
                                                <label class="m-0 text-info">24 Horas</label>
                                            </div>
                                        </div> *@
                                </div>
                            </div>
                        </div>
                    </div>


                    

                    

