@*=========================================================MODAL BUSQUEDA CUENTAS PACIENTES==================================================================*@
<div data-backdrop="static" data-keyboard="false" class="modal fade" id="modalBusquedaCuentasAtenciones" role="dialog" aria-hidden="false" style="background-color: #00000075;">
    <div class="modal-dialog modal-xxl" style="box-shadow: 0 20px 13px 0 rgb(0, 0, 0);">
        <div class="modal-content">
            <div class="modal-header bg-indigo">
                <h4 class="modal-title text-white">Busqueda de Pacientes</h4>
            </div>
            <div class="modal-body">

                <div class="row">
                    <div class="col-lg-12 mb-1">
                        @* <div class="row">
                        <div class="col-lg-12">
                        <b>Busqueda</b>
                        </div>
                        </div> *@
                        <div class="card bg-blue">
                            <div class="card-block">
                                <div class="row">

                                    <div class="col-lg-2" style="max-width: 180px;">
                                        <div class="form-group m-0">
                                            <label for="txtBusquedaCAPacienteDNI" class="form-control-label">DNI</label>
                                            <div class="input-group input-group-sm">
                                                <input type="text" class="form-control bloquear-campos searchCAPaciente" id="txtBusquedaCAPacienteDNI" autocomplete="off">
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-lg-2" style="max-width: 180px;">
                                        <div class="form-group m-0">
                                            <label for="txtBusquedaCAPacienteNroHistoria" class="form-control-label">N° Historia</label>
                                            <div class="input-group input-group-sm">
                                                <input type="text" class="form-control bloquear-campos searchCAPaciente" id="txtBusquedaCAPacienteNroHistoria" autocomplete="off">
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-lg-2" style="max-width: 180px;">
                                        <div class="form-group m-0">
                                            <label for="txtBusquedaCAPacienteApPaterno" class="form-control-label">Apellido Paterno</label>
                                            <div class="input-group input-group-sm">
                                                <input type="text" class="form-control bloquear-campos searchCAPaciente" id="txtBusquedaCAPacienteApPaterno" autocomplete="off">
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-lg-2" style="max-width: 180px;">
                                        <div class="form-group m-0">
                                            <label for="txtBusquedaCAPacienteApMaterno" class="form-control-label">Apellido Materno</label>
                                            <div class="input-group input-group-sm">
                                                <input type="text" class="form-control bloquear-campos searchCAPaciente" id="txtBusquedaCAPacienteApMaterno" autocomplete="off">
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-lg-2" style="max-width: 180px;">
                                        <div class="form-group m-0">
                                            <label for="txtBusquedaCAPacientePrimerNombre" class="form-control-label">Nombres</label>
                                            <div class="input-group input-group-sm">
                                                <input type="text" class="form-control bloquear-campos searchCAPaciente" id="txtBusquedaCAPacientePrimerNombre" autocomplete="off">
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-lg-2 d-flex align-items-end" style="height: 55px;">
                                        <div>
                                            <button class="btn btn-primary btn-sm layout_btn_prevent" style="padding-left: 2rem !important; padding-right: 2rem !important;" id="btnBuscarCAPacientes">Buscar</button>
                                            <button class="btn btn-secondary btn-sm layout_btn_prevent" style="padding-left: 2rem !important; padding-right: 2rem !important;" id="btnLimpiarBusquedaCAPaciente">Limpiar</button>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="col-md-12 mb-1">
                        @* <h5 class="text-sm-center mb-0 font-weight-bold" style="color: #20295e;">Productos a devolver</h5> *@
                        <table class="table table-sm table-bordered" id="tblBusquedaCAPacientes" width="100%" style="font-size: 12px;">
                            <thead style="color: white; background: #434343;">
                                <tr>
                                    <th width="10%">Ap .Paterno</th>
                                    <th width="10%">Ap .Materno</th>
                                    <th width="10%">1er Nombre</th>
                                    <th width="10%">2do Nombre</th>
                                    <th width="10%">N° Historia</th>
                                    <th width="10%">Fecha Nac.</th>
                                    <th width="10%">Ult. Tipo Serv.</th>
                                    <th width="10%">Ult. Serv. Ing.</th>
                                    <th width="10%">Ult. F. Ing.</th>
                                    <th width="10%">Ult. F. Egr.</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>

                    <div class="col-md-12">
                        <h5 class="text-sm-center mb-0 font-weight-bold" style="color: #135d79;">Atenciones del Paciente</h5>
                        <table class="table table-sm table-bordered" id="tblCuentasAtencionesPacientes" width="100%" style="font-size: 12px;">
                            <thead style="color: white; background: #135d79;">
                                <tr>
                                    <th width="7%">Nª Cuenta</th>
                                    <th width="10%">Estado Cuenta</th>
                                    <th width="7%">Fec. Ingreso</th>
                                    <th width="7%">Fec. Egreso</th>
                                    <th width="7%">Hr. Egreso</th>
                                    <th width="13%">Servicio Ing.</th>
                                    <th width="10%">Tipo Servicio</th>
                                    <th width="7%">Edad</th>
                                    <th width="25%">Diagnóstico</th>
                                    <th width="7%">Veces Abierto</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-indigo" id="btnAceptarCAPaciente">Aceptar</button>
                    <button type="button" class="btn btn-secondary" id="btnCerrarModalBusquedaCAPaciente">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
</div>