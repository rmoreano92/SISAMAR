            <div class="modal-header bg-primary">
                <h4 class="modal-title text-white">Selecciona Paciente</h4>
            </div>
            <div class="modal-body">

                <div class="row">
                    <div class="col-md-12">
                        <table class="table table-sm table-bordered" id="tblPacientesBusqueda" width="100%" style="font-size: 12px;">
