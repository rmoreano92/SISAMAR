<div data-backdrop="static" style="background-color: rgba(0, 0, 0, 0.46); overflow-y: scroll; z-index: 1060;" data-keyboard="false" class="modal fade" id="modalServicios" role="dialog" aria-labelledby="modalLabelsuccess">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary">
                <h4 class="modal-title text-white" id="modalLabelsuccess">Búsqueda de servicios</h4>
            </div>
            <div class="modal-body">

                <div class="row mb-1">
                    <div class="col-md-2">
                        <div class="form-group m-0">
                            <label for="txtCodigoServicioBuscar" class="form-control-label">Código</label>
                            <input type="text" autocomplete="off" class="form-control form-control-sm search" id="txtCodigoServicioBuscar">
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group m-0">
                            <label for="txtNombreServicioBuscar" class="form-control-label">Nombre</label>
                            <input type="text" autocomplete="off" class="form-control form-control-sm search" id="txtNombreServicioBuscar">
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-group m-0">
                            <label for="cboTipoServicioBuscar" class="form-label">Tipo Servicio.</label>
                            <div class="input-group input-group-sm">
                                <select class="chzn-select" id="cboTipoServicioBuscar" disabled></select>
                            </div>
                        </div>
                    </div>

                </div>

                <div class="row mb-1">

                    <div class="col-md-2">
                        <div class="d-flex align-items-end" style="height: 55px;">
                            <button class="btn btn-sm btn-primary layout_btn_prevent mr-1" id="btnBuscarServicio" style="padding-left: 2rem !important; padding-right: 2rem !important;">Buscar</button>
                            <button class="btn btn-sm btn-secondary layout_btn_prevent" id="btnLimpiarFiltroServicio" style="padding-left: 2rem !important; padding-right: 2rem !important;">Limpiar</button>
                        </div>
                    </div>

                </div>

                <div class="row">
                    <div class="col-md-12">
                        <table id="tblServicios" width="100%" class="table table-sm table-bordered table-content-sm" style="cursor: default;">
                            <thead style="color: white;background: #434343;">
                                <tr>
                                    <th style="width:10%">Código</th>
                                    <th style="width:70%">Nombre</th>
                                    <th style="width:10%">Especialidad</th>
                                    <th style="width:10%">CodigoServicioHIS</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button id="btnSeleccionarServicio" target="_blank" class="btn btn-primary "> Aceptar</button>
                <button id="btnCerrarModalServicio" target="_blank" class="btn btn-secondary "> Cerrar</button>
            </div>
        </div>
    </div>
</div>