<div data-backdrop="static" style="background-color: rgba(0, 0, 0, 0.46); overflow-y: scroll; z-index: 1060;" data-keyboard="false" class="modal fade" id="modalMedicoTopico" role="dialog" aria-labelledby="modalLabelsuccess">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary">
                <h4 class="modal-title text-white" id="modalLabelsuccess">Búsqueda de médicos</h4>
            </div>
            <div class="modal-body">

                <div class="row mb-1">
                    <div class="col-md-3">
                        <div class="form-group m-0">
                            <label for="txtCodigoPlanillaMedicoTopicoBuscar" class="form-control-label">Cód. Planilla</label>
                            <input type="text" autocomplete="off" class="form-control form-control-sm search" id="txtCodigoPlanillaMedicoTopicoBuscar">
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-group m-0">
                            <label for="txtApellidoPaternoMedicoTopicoBuscar" class="form-control-label">Apellido Pat.</label>
                            <input type="text" autocomplete="off" class="form-control form-control-sm search" id="txtApellidoPaternoMedicoTopicoBuscar">
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-group m-0">
                            <label for="txtApellidoMaternoMedicoTopicoBuscar" class="form-control-label">Apellido Mat.</label>
                            <input type="text" autocomplete="off" class="form-control form-control-sm search" id="txtApellidoMaternoMedicoTopicoBuscar">
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-group m-0">
                            <label for="txtNombresMedicoTopicoBuscar" class="form-control-label">Nombres</label>
                            <input type="text" autocomplete="off" class="form-control form-control-sm search" id="txtNombresMedicoTopicoBuscar">
                        </div>
                    </div>

                    <div class="col-md-2">
                        <div class="d-flex align-items-end" style="height: 55px;">
                            <button class="btn btn-sm btn-primary layout_btn_prevent mr-1" id="btnBuscarMedicoTopico" style="padding-left: 2rem !important; padding-right: 2rem !important;">Buscar</button>
                            <button class="btn btn-sm btn-secondary layout_btn_prevent" id="btnLimpiarFiltroMedicoTopico" style="padding-left: 2rem !important; padding-right: 2rem !important;">Limpiar</button>
                        </div>
                    </div>

                </div>

                <div class="row">
                    <div class="col-md-12">
                        <table id="tblMedicoTopico" width="100%" class="table table-sm table-bordered table-content-sm" style="cursor: default;">
                            <thead style="color: white;background: #434343;">
                                <tr>
                                    @* <th style="width:10%">N° Admin</th> *@
                                    <th style="width:70%">Médico</th>
                                    <th style="width:10%">Especialidad</th>
                                    <th style="width:10%">Colegiatura</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button id="btnSeleccionarMedicoTopico" target="_blank" class="btn btn-primary "> Aceptar</button>
                <button id="btnCerrarModalMedicoTopico" target="_blank" class="btn btn-secondary "> Cerrar</button>
            </div>
        </div>
    </div>
</div>