                        </div>
                    </div>
                    <div class="col-xl-2">
                        <label for="" class="form-label">Nro. Doc.</label>
                        <div class="input-group input-group-sm">
                            <input type="text" class="form-control bloquear-campos" id="txtNroDocMadre" autocomplete="off">
                        </div>
                    </div>
                    <div class="col-xl-2">
                        <label for="" class="form-label">Apellido Paterno</label>
                        <div class="input-group input-group-sm">
                            <input type="text" class="form-control bloquear-campos" id="txtApellidoPaternoMadre" autocomplete="off">
                        </div>
                    </div>
                    <div class="col-xl-2">
                        <label for="" class="form-label">Apellido Materno</label>
                        <div class="input-group input-group-sm">
                            <input type="text" class="form-control bloquear-campos" id="txtApellidoMaternoMadre" autocomplete="off">
                        </div>
                    </div>
                    <div class="col-xl-2">
                        <label for="" class="form-label">Primer Nombre</label>
                        <div class="input-group input-group-sm">
                            <input type="text" class="form-control bloquear-campos" id="txtPrimerNombreMadre" autocomplete="off">
                        </div>
                    </div>
                    <div class="col-xl-2">
                        <label for="" class="form-label">Segundo Nombre</label>
                        <div class="input-group input-group-sm">
                            <input type="text" class="form-control bloquear-campos" id="txtSegundoNombreMadre" autocomplete="off">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4" style="display: none;">
        <div class="card  m-t-5 bg-blue pb-1" style="padding-bottom: 0px;">
            <div class="card-header bg-white">Datos del Sector y Sectorista</div>
            <div class="card-block m-t-5 custom-form" style="padding-bottom: 0px;">
                <div class="row">
                    <div class="col-lg-6">
                        <label for="" class="form-label">Sector</label>
                        <div class="input-group input-group-sm">
                            <input type="text" class="form-control bloquear-campos" id="txtSector" autocomplete="off">
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <label for="" class="form-label">Sectorista</label>
                        <div class="input-group input-group-sm">
                            <input type="text" class="form-control bloquear-campos" id="txtSectorista" autocomplete="off">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


