@*JDELGADO001.2 CREACION*@

<div class="card bg-yellow RegistroPacienteContenedor">
    <div class="card-header bg-white">Datos de la historia clinica</div>
    <div class="card-block p-t-5 custom-form">
        <div class="row">
            <div class="col-md-5">
                <div class="row">
                    <div class="col-md-6 col-lg-5">
                        <label for="txtUsuarioCrea" class="form-label">Usuario Crea</label>
                        <div class="input-group input-group-sm bloquear-campos">
                            <input type="text" class="form-control" id="txtUsuarioCrea" autocomplete="off" disabled>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-5">
                        <label for="txtUsuarioModifica" class="form-label">Usuario Modifica</label>
                        <div class="input-group input-group-sm bloquear-campos">
                            <input type="text" class="form-control" id="txtUsuarioModifica" autocomplete="off" disabled>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-5">
                <div class="row">
                    <div class="col-md-6 col-lg-5">
                        <label for="" class="form-label">Tipo Doc.</label>
                        <div class="input-group input-group-sm">
                            <select  data-placeholder="Seleccione una opción" class="chzn-select bloquear-campos" id="cboTipoDocPaciente" data-placeholder="Seleccione una opción"></select>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-5">
                        <label for="" class="form-label">Nro. Doc.</label>
                        <div class="input-group input-group-sm bloquear-campos">
                            <input type="text" class="form-control bloquear-campos" id="txtDniPaciente" autocomplete="off">
                            <div class="alert alert-danger" role="alert" id="errorDocumento" style="display: none"></div>
                        </div>
                    </div>                    
                </div>
            </div>
            <div class="col-lg-5">
                <div class="row">
                    <div class="col-md-6 col-lg-5">
                        <label for="" class="form-label">Tipo Nro. Historia</label>
                        <div class="input-group input-group-sm">
                            <select  data-placeholder="Seleccione una opción"  data-placeholder="Seleccione una opción" class="chzn-select" id="cboTipoHistoriaPaciente" disabled>
                                <option value="1">1 = Automatica</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-5">
                        <label for="" class="form-label">Nro. Historia.</label>
                        <div class="input-group input-group-sm">
                            <input type="text" class="form-control" id="txtNroHistoriaPaciente" disabled>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-2">
                <div class="row">
                    <div class="col-md-6 col-lg-12">
                        <label for="" class="form-label">Fecha Creacion</label>
                        <div class="input-group input-group-sm">
                            <input type="text" autocomplete="off" class="form-control form_val_popup_dp3" placeholder="dd/mm/yyyy" data-date-format="dd/mm/yyyy" id="txtFechaCreacionPaciente" disabled>
                            <span class="input-group-addon">
                                <i class="fa fa-calendar "></i>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        
    </div>
</div>

<div class="card mt-1 bg-green RegistroPacienteContenedor">
    <div class="card-header bg-white">Datos del paciente</div>
    <div class="card-block m-t-5 custom-form">
        <div class="row">
            <div class="col-xl-10">
                <div class="row">
                    <div class="col-md-6 col-xl-2">
                        <label for="" class="form-label">Apellido Paterno</label>
                        <div class="input-group input-group-sm">
                            <input type="text" class="form-control bloquear-campos" id="txtApellidoPaternoPaciente" autocomplete="off">
                        </div>
                    </div>
                    <div class="col-md-6 col-xl-2">
                        <label for="" class="form-label">Apellido Materno</label>
                        <div class="input-group input-group-sm">
                            <input type="text" class="form-control bloquear-campos" id="txtApellidoMaternoPaciente" autocomplete="off">
                        </div>
                    </div>
                    <div class="col-md-4 col-xl-2">
                        <label for="" class="form-label">Primer Nombre</label>
                        <div class="input-group input-group-sm">
                            <input type="text" class="form-control bloquear-campos" id="txtPrimerNombrePaciente" autocomplete="off">
                        </div>
                    </div>
                    <div class="col-md-4 col-xl-2">
                        <label for="" class="form-label">Segundo Nombre</label>
                        <div class="input-group input-group-sm">
                            <input type="text" class="form-control bloquear-campos" id="txtSegundoNombrePaciente" autocomplete="off">
                        </div>
                    </div>
                    <div class="col-md-4 col-xl-2">
                        <label for="" class="form-label">Tercer Nombre</label>
                        <div class="input-group input-group-sm">
                            <input type="text" class="form-control bloquear-campos" id="txtTercerNombrePaciente" autocomplete="off">
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-2">
                <div class="offset-sm-6 offset-xl-2 col-xl-10">
                    <label for="" class="form-label">Id Paciente</label>
                    <div class="input-group input-group-sm">
                        <input type="text" class="form-control" id="txtIdPaciente" disabled>
                    </div>
                </div>
            </div>            
        </div>

        <div class="row">
            <div class="col-xl-7">
                <div class="row">
                    <div class="col-md-3 col-xl-3">
                        <label for="txtFechaNacimientoPaciente" class="form-label">Fecha Nacimiento</label>
                        <div class="input-group input-group-sm">
                            <input type="text" autocomplete="off" class="form-control form_val_popup_dp3 bloquear-campos" placeholder="dd/mm/yyyy" data-date-format="dd/mm/yyyy" id="txtPacienteFechaNacimiento">
                            <span class="input-group-addon">
                                <i class="fa fa-calendar "></i>
                            </span>
                        </div>
                    </div>
                    <div class="col-md-2 col-xl-2">
                        <label for="" class="form-label">Hora: </label>
                        <div class="input-group input-group-sm">
                            <input type="text" class="form-control bloquear-campos" id="txtHoraNacimientoPaciente" placeholder="__:__" value="00:00">
                        </div>
                    </div>
                    <div class="col-md-2 col-xl-2">
                        <label for="" class="form-label">Edad</label>
                        <div class="input-group input-group-sm">
                            <input type="text" class="form-control bloquear-campos" id="txtEdadPaciente" style="background: #d8eaff;">
                        </div>
                    </div>
                    <div class="col-md-3 col-xl-2">
                        <label for="" class="form-label">Tipo Edad</label>
                        <div class="input-group input-group-sm">
                            <select  data-placeholder="Seleccione una opción"  data-placeholder="Seleccione una opción" class="chzn-select bloquear-campos" id="cboTipoEdadPaciente"></select>
                        </div>
                    </div>
                    <div class="col-md-2 col-xl-2">
                        <label for="" class="form-label">Es hijo N°</label>
                        <div class="input-group input-group-sm">
                            <input type="text" class="form-control bloquear-campos" id="txtEsNroHijoPaciente" autocomplete="off">
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-5">
                <div class="row">
                    <div class=" col-md-4 col-xl-3">
                        <label for="" class="form-label">Sexo</label>
                        <div class="input-group input-group-sm">
                            <select  data-placeholder="Seleccione una opción"  data-placeholder="Seleccione una opción" class="chzn-select bloquear-campos" id="cboSexoPaciente">
                                <option value="0">--Seleccionar--</option>
                                <option value="1">1 = Masculino</option>
                                <option value="2">2 = Femenino</option>
                            </select>
                        </div>
                    </div>
                    <div class=" col-md-4 col-xl-4">
                        <label for="" class="form-label">Estado Civil</label>
                        <div class="input-group input-group-sm">
                            <select  data-placeholder="Seleccione una opción"  data-placeholder="Seleccione una opción" class="chzn-select bloquear-campos" id="cboEstadoCivilPaciente"></select>
                        </div>
                    </div>
                    <div class=" col-md-4 col-xl-5">
                        <label for="" class="form-label">Etnia</label>
                        <div class="input-group input-group-sm">
                            <select  data-placeholder="Seleccione una opción"  data-placeholder="Seleccione una opción" class="chzn-select bloquear-campos" id="cboEtniaPaciente">
                                <option value="0">--Seleccionar--</option>
                            </select>
                        </div>
                    </div>                    
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-xl-12">
                <div class="row">
                    <div class="col-md-4 col-xl-2">
                        <label for="" class="form-label">Idioma Materno</label>
                        <div class="input-group input-group-sm bloquear-campos">
                            <select  data-placeholder="Seleccione una opción" class="chzn-select bloquear-campos" id="cboIdiomaMaternoPaciente">
                                <option value="0">--Seleccionar--</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-4 col-xl-3">
                        <label for="" class="form-label">Grado de Instruccion</label>
                        <div class="input-group input-group-sm">
                            <select  data-placeholder="Seleccione una opción" class="chzn-select bloquear-campos" id="cboGradoInstruccionPaciente"></select>
                        </div>
                    </div>
                    <div class="col-md-4 col-xl-2">
                        <label for="" class="form-label">Ocupacion</label>
                        <div class="input-group input-group-sm">
                            <select  data-placeholder="Seleccione una opción" class="chzn-select bloquear-campos" id="cboOcupacionPaciente"></select>
                        </div>
                    </div>
                    <div class="col-md-4 col-xl-3">
                        <label for="" class="form-label">Procedencia</label>
                        <div class="input-group input-group-sm">
                            <select  data-placeholder="Seleccione una opción" class="chzn-select bloquear-campos" id="cboProcedenciaPaciente"></select>
                        </div>
                    </div>
                    <div class="col-md-4 col-xl-2">
                        <label for="" class="form-label">Religion</label>
                        <div class="input-group input-group-sm">
                            <select  data-placeholder="Seleccione una opción" class="chzn-select bloquear-campos" id="cboReligionPaciente"></select>
                        </div>
                    </div>
                </div>
            </div>            
        </div>

        <div class="row">
            <div class="col-xl-6">
                <div class="row">
                    <div class="col-md-4 col-xl-3">
                        <label for="" class="form-label">Telefono</label>
                        <div class="input-group input-group-sm">
                            <input type="text" class="form-control bloquear-campos" id="txtTelefonoPaciente">
                        </div>
                    </div>
                    <div class="col-md-4 col-xl-4">
                        <label for="" class="form-label">Email</label>
                        <div class="input-group input-group-sm">
                            <input type="text" class="form-control bloquear-campos" id="txtEmailPaciente">
                        </div>
                    </div>
                    <div class="col-md-4 col-xl-5">
                        <label for="" class="form-label">Nombre Padre</label>
                        <div class="input-group input-group-sm">
                            <input type="text" class="form-control bloquear-campos" id="txtNombrePadrePaciente" autocomplete="off">
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-6">
                <label for="" class="form-label">Observaciones</label>
                <div class="input-group input-group-sm">
                    <textarea class="form-control text-info bloquear-campos" style="font-weight: bold;" id="txtObservacionPaciente" rows="2"></textarea>
                </div>
            </div>
        </div>        
    </div>

</div>


<div class="row">
    <div class="col-lg-12">
        <div class="card mt-1 bg-pink RegistroPacienteContenedor">
            <div class="card-header bg-white">Datos de la Madre o Tutor</div>
            <div class="card-block p-t-5 custom-form">
                <div class="row">
