<div class="card bg-blue mt-1">

    <div class="card-header bg-white">
        PATOLOGÍAS OBSTÉTRICAS-GINECOLÓGICAS
    </div>

    <div class="card-block">

        <div class="row mt-1">

            <div class="col-lg-12">
                <div class="row mt-1">

                    <div class="col-lg-7">
                        <div class="input-group">
                            <label for="cboAnteEnfHipertenEmbarazoGinecoObst" class="form-control-label">Antecedente enfermedad hipertensiva del embarazo</label>
                            <select class="chzn-select" id="cboAnteEnfHipertenEmbarazoGinecoObst">
                                <option value="0">-- Seleccionar --</option>
                                <option value="1">Preeclampsia</option>
                                <option value="2">Preeclampsia severa</option>
                                <option value="3">Preeclampsia severa Y sindrome hellp </option>
                                <option value="4">Preeclampsia y eclampsia</option>
                                <option value="5">Hipertensión crónica preexistente</option>
                                <option value="6">Hipertensión gestacional</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-12 mt-1">
                <div class="mb-1">
                    <span style="color: blue;"><b>OTRAS PATOLOGÍAS</b></span>
                </div>

                <div class="card bg-teal">
                    <div class="card-header bg-white">Otras patologías</div>
                    <div class="card-block custom-form pt-1">
                        <div class="row OpcionesDiagnosticos">
                            <div class="col-md-3" style="max-width: 200px;">
                                <div class="form-group">
                                    <div class="d-flex">
                                        <input id="txtCodigoOtrasPat" type="text" class="form-control form-control-sm m-auto" autocomplete="off">
                                        <input id="hdnIdOtrasPat" type="hidden" class="form-control">
                                        <button type="button" class="btn btn-sm btn-outline-primary layout_btn_prevent ml-1" onclick="RegistroEvaluacionesUCI.AbrirModalBusquedaOtrasPat();">
                                            <i class="fa-solid fa-magnifying-glass-plus"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-9">
                                <div class="form-group">
                                    <input id="txtDescripcionOtrasPat" type="text" class="form-control form-control-sm m-auto" readonly>
                                </div>
                            </div>

                            <div class="col-md-12">
                                <div class="row mb-1">
                                    @*<div class="col-lg-3" style="max-width: 300px;">
                                        <div class="fomr-group">
                                            <label class="font-weight-bold">Tipo de Diagnóstico</label>
                                            <select class="hide_search" id="cboTipoDiagnosticoOtrasPat" name="cboTipoDiagnosticoOtrasPat">
                                                <option value="-1">---Seleccione tipo diagnostico---</option>
                                                @foreach (var item in @ViewBag.TiposDiagnosticos)
                                                {
                                                    <option value="@item.IdSubclasificacionDx"> @item.Descripcion  </option>
                                                }
                                            </select>
                                        </div>

                                    </div>*@

                                    <div class="col-lg-4">
                                        <button id="btnAniadirOtrasPat" type="button" class="btn btn-sm btn-labeled btn-success mr-1 mt-2" style="width: 100px;" onclick="RegistroEvaluacionesUCI.AgregarDiagnostico();">
                                            <span class="btn-label">
                                                <i class="fa fa-plus" style="width: 20px; text-align:center;"></i>
                                            </span>
                                            Agregar
                                        </button>
                                        <button id="btnQuitarOtrasPat" type="button" class="btn btn-sm btn-labeled btn-danger mt-2" style="width: 100px;" onclick="RegistroEvaluacionesUCI.QuitarDiagnostico();">
                                            <span class="btn-label">
                                                <i class="fa fa-trash" style="width: 20px; text-align:center;"></i>
                                            </span>
                                            Quitar
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-12">
                                <table id="tblOtrasPatologias" class="table table-sm table-bordered" width="100%">
                                    <thead style="color: white;background: #51717a;">
                                        <tr>
                                            
                                            <th style="width: 0%;" data-columna="Iddiagnostico" valign="middle" align="center">Iddiagnostico</th>
                                            <th style="width: 0%;" data-columna="codigoCIEsinPto" valign="middle" align="center">codigoCIEsinPto</th>
                                            <th style="width: 10%;" data-columna="Codigo" valign="middle" align="center">Código</th>
                                            <th style="width: 80%;" data-columna="Descripcion" valign="middle" align="center">Descripcion</th>
                                            <th style="width: 0%;" data-columna="EsActivo" valign="middle" align="center">EsActivo</th>
                                            <th style="width: 0%;" data-columna="FechaInicioVigencia" valign="middle" align="center">FechaInicioVigencia</th>
                                            <th style="width: 0%;" data-columna="idTipoDiagnostico" valign="middle" align="center">idTipoDiagnostico</th>
                                            <th style="width: 10%;" data-columna="TipoDiagnostico" valign="middle" align="center">TipoDiagnostico</th>
                                            <th style="width: 10%;" data-columna="Intrahospitalario" valign="middle" align="center">IntraHospitalario</th>
                                            @*<th style="width: 10%;" data-columna="TipoDiagnostico" valign="middle" align="center">TipoDiagnostico</th>*@
                                            @*<th style="width: 10%;" data-columna="Intrahospitalario" valign="middle" align="center">IntraHospitalario</th>*@
                                            @*<th style="width: 10%;" data-columna="lab" valign="middle" align="center">Lab</th>*@
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
            
