    <div class="card mt-1" style="background-color: #f5f5f5;">
        <div class="card-block">
            <div class="row mt-1">
                <div class="col-lg-3">
                    <label for="txtDatoCalculadoSOFA" class="form-control-label">SOFA</label>

                    <div class="input-group input-group-sm mb-3">
                        <span class="input-group-addon" id="basic-addon1">Puntaje:</span>
                        <input type="text" class="form-control campoRegistro" placeholder="Sofa" aria-label="Username" aria-describedby="basic-addon1" id="txtDatoCalculadoSOFA">
                        <span class="input-group-addon" id="mortality">Mortalidad</span>
                        <span class="input-group-btn">
                            <button class="btn btn-primary bloquear" type="button" id="btnModalSOFA"><i class="fas fa-calculator"></i></button>
                        </span>
                    </div>

                </div>


            </div>
        </div>
    </div>

    <div class="card mt-1" style="background-color: #f5f5f5;">
        <div class="card-block">
            <div class="row mt-1">
                <div class="col-lg-12">
                    <label for="txtComentarioApreciacionEvaluacion" class="form-control-label">APRECIACION</label>
                    <div class="form-group">
                        <textarea class="form-control" id="txtComentarioApreciacionEvaluacion" rows="3"></textarea>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card mt-1" style="background-color: #f5f5f5;">
        <div class="card-block">
            <div class="row mt-1">
                <div class="col-lg-12">
                    <label for="txtPlanEvaluacion" class="form-control-label">PLAN</label>
                    <div class="form-group">
                        <textarea class="form-control" id="txtPlanEvaluacion" rows="3"></textarea>
                    </div>
                </div>

            </div>

            <div class="row">
                <div class="col-lg-6">
                    <div class="row">
                        <div class="col-lg-12">
                            <label for="cboExamenImagenologico">Examen imagenologico y pruebas especiales</label>
                            <select id="cboExamenImagenologico" data-placeholder="Reflejo" class="chosen-select" multiple style="width:350px;" tabindex="4">
                            </select>
                        </div>

                        <div class="col-lg-12">
                            <label for="txtExamenImagenologico" class="form-control-label">Descripcion Examen imagenologico</label>
                            <div class="form-group">
                                <textarea class="form-control" id="txtExamenImagenologico" rows="3"></textarea>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="row">
                        <div class="col-lg-12">
                            <label for="cboExamenLaboratorial">Examenes laboratoriales  </label>
                            <select id="cboExamenLaboratorial" data-placeholder="Reflejo" class="chosen-select" multiple style="width:350px;" tabindex="4">
                            </select>
                        </div>

                        <div class="col-lg-12">
                            <label for="txtExamenLaboratorial" class="form-control-label">Descripcion Examenes laboratoriales</label>
                            <div class="form-group">
                                <textarea class="form-control" id="txtExamenLaboratorial" rows="3"></textarea>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row mt-1">

                <hr />

                <div class="col-lg-2">
                    <label for="txtMotivoEvaluacionUCI" class="form-control-label">INFORME</label>
                    <div class="switch-field">
                        <input type="radio" id="rdbInformeSi" name="rdbInforme" class="bloquear-campos">
                        <label for="rdbInformeSi" class="pl-2 pr-2">Si</label>
                        <input type="radio" id="rdbInformeNo" name="rdbInforme" class="bloquear-campos">
                        <label for="rdbInformeNo" class="pl-2 pr-2 mr-auto">No</label>
                    </div>
                </div>

                <div class="col-lg-12" id="contMotivoInforme">
                    <label for="txtMotivoEvaluacionUCI" class="form-control-label">MOTIVO</label>
                    <div class="form-group">
                        <textarea class="form-control" id="txtMotivoEvaluacionUCI" rows="3"></textarea>
                    </div>
                </div>
            </div>

            <div class="row mt-1">
                <div class="col-lg-3">
                    <div class="row">
                        <div class="col-lg-4">
                            <label for="cboMedicoComentarioEvaluacion" class="form-control-label">Medico </label>
                        </div>
                        <div class="col-lg-8">
                            <div class="input-group mb-1">
                                <select class="chzn-select" data-placeholder="Seleccionar una opcion" id="cboMedicoComentarioEvaluacion"></select>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-3">
                    <div class="row">
                        <div class="col-lg-4">
                            <label for="cboDestinoComentarioEvaluacion" class="form-control-label">Destino</label>
                        </div>
                        <div class="col-lg-8">
                            <div class="input-group mb-1">
                                <select class="chzn-select" data-placeholder="Seleccionar una opcion" id="cboDestinoComentarioEvaluacion">
                                    <option value="0">Permanece</option>
                                    <option value="1">Alta de UCI</option>
                                    <option value="2">Fallecida</option>
                                    <option value="3">Transferencia a otro EESS</option>
                                    <option value="4">Pasa a UCIM1</option>
                                    <option value="5">Pasa a UCIM2</option>
                                    <option value="6">Sala de operaciones</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-3">
                    <div class="row">
                        <div class="col-lg-4">
                            <label for="txtFechaAltaPlanApreciacion" class="form-control-label">Fecha</label>
                        </div>
                        <div class="col-lg-8">
                            <div class="input-group input-group-sm">
                                <input type="text" autocomplete="off" class="form-control campoRegistro form_val_popup_dp3 bloquear" placeholder="dd/mm/yyyy" data-date-format="dd/mm/yyyy" id="txtFechaAltaPlanApreciacion">
                                <span class="input-group-addon">
                                    <i class="fa fa-calendar "></i>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

        </div>
