<div class="card bg-blue mt-1">
    <div class="card-block">

        <div class="row">
            <div class="col-lg-6 pt-2 pb-0">
                <button class="btn btn-success layout_btn_prevent" id="btnAgregarNotaAdicional">Agregar</button>
                <button class="btn btn-info layout_btn_prevent" id="btnModificarNotaAdicional">Modificar</button>
            </div>
        </div>

        <div class="row mt-1">
            <div class="col-lg-12">
                <div class="card m-t-5 bg-orange" style="padding-bottom: 0px;">
                    <div class="card-header bg-white">Nota adicional</div>

                    <div class="card-block m-t-5 custom-form" style="padding-bottom: 0px;">
                        <table id="tblComentarioApreciacion" width="100%" class="table table-sm table-bordered">
                            <thead style="color: white;background: #434343;">
                                <tr>
                                    <th style="width:10%">N°</th>
                                    <th style="width:20%">Fecha</th>
                                    <th style="width:30%">Medico</th>
                                    <th style="width:30%">Destino</th>
                                    <th style="width:10%">Informe</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-lg-12">
                <div class="card m-t-5 bg-orange" style="padding-bottom: 0px;">
                    <div class="card-header bg-white">Detalle</div>

                    <div class="card-block m-t-5 custom-form" style="padding-bottom: 0px;">
                        <div class="col-lg-6">
                            <label for="txtComentarioApreciacionDetalle" class="form-control-label">COMENTARIO/APRECIACION</label>
                            <div class="form-group">
                                <textarea class="form-control" id="txtComentarioApreciacionDetalle" rows="3" disabled></textarea>
                            </div>
                        </div>

                        <div class="col-lg-6">
                            <label for="txtPlanDetalle" class="form-control-label">PLAN</label>
                            <div class="form-group">
                                <textarea class="form-control" id="txtPlanDetalle" rows="3" disabled></textarea>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>



    </div>
</div>