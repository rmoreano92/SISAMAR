<div class="row">
    <div class="col-xl-4">
        <div class="card bg-blue">
            <div class="card-block p-1">
                <div class="form-group">
                    <label for="cboCondicionIngreso">Tipo de paciente </label>
                    <select class="chzn-select-deselect" data-placeholder="Seleccionar una opcion" id="cboCondicionIngreso">
                        <option value=""></option>
                        <option value="1">Recién nacido a termino</option>
                        <option value="2">Recién nacido prematuro</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="">Edad Gestacional Final</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-addon">Semanas</span>
                        <input type="text" class="form-control form-control-sm" id="txtEdadGestacionalSemanas" placeholder="" autocomplete="off">
                        <span class="input-group-addon">Días</span>
                        <input type="text" class="form-control form-control-sm" id="txtEdadGestacionalDias" placeholder="" autocomplete="off">
                    </div>
                </div>
            </div>
        </div>               
    </div>

    <div class="col-xl-8">
        <div class="card bg-orange">
            <div class="card-header bg-white">Signos y Síntomas</div>
            <div class="card-block">
                <div class="row m-t-5">
                    <div class="col-xl-4">
                        <div class="check__toggle mt-04">
                            <label class="toggle">
                                <input class="toggle__input campo" type="checkbox" id="chkDificultadRespiratoria">
                                <span class="toggle__label mr-2">
                                    <span class="toggle__text">Dificultad respiratoria</span>
                                </span>
                            </label>
                        </div>
                        <div class="check__toggle mt-04">
                            <label class="toggle">
                                <input class="toggle__input campo" type="checkbox" id="chkLetargia">
                                <span class="toggle__label mr-2">
                                    <span class="toggle__text">Letargia</span>
                                </span>
                            </label>
                        </div>
                        <div class="check__toggle mt-04">
                            <label class="toggle">
                                <input class="toggle__input campo" type="checkbox" id="chkFiebre">
                                <span class="toggle__label mr-2">
                                    <span class="toggle__text">Fiebre</span>
                                </span>
                            </label>
                        </div>
                        <div class="check__toggle mt-04">
                            <label class="toggle">
                                <input class="toggle__input campo" type="checkbox" id="chkBajoPeso">
                                <span class="toggle__label mr-2">
                                    <span class="toggle__text">Bajo peso</span>
                                </span>
                            </label>
                        </div>                        
                    </div>

                    <div class="col-xl-4">
                        <div class="check__toggle mt-04">
                            <label class="toggle">
                                <input class="toggle__input campo" type="checkbox" id="chkMalaAlimentacion">
                                <span class="toggle__label mr-2">
                                    <span class="toggle__text">Mala alimentación</span>
                                </span>
                            </label>
                        </div>
                        <div class="check__toggle mt-04">
                            <label class="toggle">
                                <input class="toggle__input campo" type="checkbox" id="chkVomitos">
                                <span class="toggle__label mr-2">
                                    <span class="toggle__text">Vómitos</span>
                                </span>
                            </label>
                        </div>
                        <div class="check__toggle mt-04">
                            <label class="toggle">
                                <input class="toggle__input campo" type="checkbox" id="chkDistensionAbdominal">
                                <span class="toggle__label mr-2">
                                    <span class="toggle__text">Distension Abdominal</span>
                                </span>
                            </label>
                        </div>
                        <div class="check__toggle mt-04">
                            <label class="toggle">
                                <input class="toggle__input campo" type="checkbox" id="chkPalidez">
                                <span class="toggle__label mr-2">
                                    <span class="toggle__text">Palidez</span>
                                </span>
                            </label>
                        </div>
                    </div>

                    <div class="col-xl-4">
                        <div class="check__toggle mt-04">
                            <label class="toggle">
                                <input class="toggle__input campo" type="checkbox" id="chkMalaFormacionCongenita">
                                <span class="toggle__label mr-2">
                                    <span class="toggle__text">Mala formación congenita</span>
                                </span>
                            </label>
                        </div>
                        <div class="check__toggle mt-04">
                            <label class="toggle">
                                <input class="toggle__input campo" type="checkbox" id="chkIrritacion">
                                <span class="toggle__label mr-2">
                                    <span class="toggle__text">Irritación</span>
                                </span>
                            </label>
                        </div>
                        <div class="check__toggle mt-04">
                            <label class="toggle">
                                <input class="toggle__input campo" type="checkbox" id="chkOtros">
                                <span class="toggle__label mr-2">
                                    <span class="toggle__text">Otros</span>
                                </span>
                                <input type="text" class="form-control form-control-sm" id="txtOtroSintomas" placeholder="" autocomplete="off">
                            </label>
                        </div>
                    </div>                    
                </div>
            </div>
        </div>
    </div>

        
</div>

<div class="row">
    <div class="col-xl-12 mb-1">
        <div class="form-group m-0">
            <label for="txtRelato" class="font-weight-bold">RELATO</label>
            <textarea class="form-control" id="txtRelato" rows="5"></textarea>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-xl-12">
        <div class="card bg-teal">
            <div class="card-header bg-white">Diagnósticos de Ingreso</div>
            <div class="card-block">
                <div class="row mb-1 mt-5">       
                    <div class="col-xl-6">
                        <div class="fomr-group m-0">
                            <label for="cboDiagnosticoIngreso">Diagnóstico</label>
                            <select class="chzn-select-deselect" id="cboDiagnosticoIngreso" data-placeholder="Seleccione una opción"></select>
                        </div>
                    </div>

                    <div class="col-xl-3">
                        <div class="fomr-group m-0">
                            <label for="cboTipoDiagnosticoIngreso">Tipo de Diagnóstico</label>
                            <select class="chzn-select-deselect" id="cboTipoDiagnosticoIngreso" data-placeholder="Seleccione una opción">
                                <option value=""></option>
                                <option value="101"> P = Presuntivo  </option>
                                <option value="102"> D = Definitivo  </option>
                                <option value="103"> R = Repetido  </option>
                            </select>
                        </div>
                    </div>

                    <div class="col-xl-3">
                        <br />
                        <button id="btnAñadirDiagnosticoIngreso" type="button" class="btn btn-sm btn-labeled btn-success mr-1" style="min-width: 100px;">
                            <span class="btn-label">
                                <i class="fa fa-plus text-sm-left" style="width: 20px;"></i>
                            </span>
                            Agregar
                        </button>
                        <button id="btnQuitarDiagnosticoIngreso" type="button" class="btn btn-sm btn-labeled btn-danger" style="min-width: 100px;">
                            <span class="btn-label">
                                <i class="fa fa-trash text-sm-left" style="width: 20px;"></i>
                            </span>
                            Quitar
                        </button>
                    </div>
                </div>

                <div class="row">
                    <div class="col-xl-12">
                        <table id="lstDiagnosticosIngresos" class="table table-sm table-bordered table-striped table-content-sm w-100">
                            <thead style="color: white;background: #51717a;">
                                <tr>                                    
                                    <th>Código</th>
                                    <th>Descripcion</th>                                    
                                    <th>TipoDiagnostico</th>
                                    <th>Lab</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>
    </div>


    
</div>