<div class="card bg-blue mb-1">
    <div class="card-block pb-0">
        <div class="row">
            <div class="col-xl-12">
                <div class="row">
                    <div class="col-xl-2">
                        <label for="cboIntervencionesTipoHemoderivado">Tipo hemoderivado</label>
                        <div class="form-group">
                            <select id="cboIntervencionesTipoHemoderivado" class="chzn-select" data-placeholder="Seleccionar una opcion">
                                <option value="0">No</option>
                                <option value="1">Paquete globular</option>
                                <option value="2">Plasma fresco congelado</option>
                                <option value="3">Plaquetas aféresis</option>
                                <option value="4">Plaquetas</option>
                                <option value="5">Crioprecipitados</option>
                                <option value="99">Otro</option>
                            </select>
                        </div>

                        <div class="input-group">
                            <input type="text" autocomplete="off" class="form-control form-control-sm " id="txtIntervencionesTipoHemoderivadoOtros" style="display: none;">
                        </div>
                    </div>

                    <div class="col-xl-2">
                        <label for="txtIntervencionesHemoderivadoNroUnidades">N° Uni.</label>
                        <div class="form-group">
                            <input type="text" class="form-control form-control-sm" id="txtIntervencionesHemoderivadoNroUnidades" autocomplete="off">
                        </div>
                    </div>


                    <div class="col-xl-4 mt-2">
                        <button id="btnAgregarHemoderivado" type="button" class="btn btn-sm btn-labeled btn-success mr-1" style="width: 100px;">
                            <span class="btn-label">
                                <i class="fa fa-plus" style="width: 20px; text-align:center;"></i>
                            </span>
                            Agregar
                        </button>
                        <button id="btnQuitarHemoderivado" type="button" class="btn btn-sm btn-labeled btn-danger" style="width: 100px;">
                            <span class="btn-label">
                                <i class="fa fa-trash" style="width: 20px; text-align:center;"></i>
                            </span>
                            Quitar
                        </button>
                    </div>
                </div>
            </div>

            <div class="col-xl-12 mt-1">
                <table id="tblIntervencionesHemoderivado" width="100%" class="table table-sm table-bordered">
                    <thead style="color: white;background: #434343;">
                        <tr>
                            <th style="width:0%">IdTipoHemoderivado</th>
                            <th style="width:70%">Tipo hemoderivado</th>
                            <th style="width:30%">N° Unidades</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>

            <div class="col-xl-12 mt-1">
                <div class="row">
                    <div class="offset-lg-8 col-xl-2">
                        <label for="txtTotalUnidadesHemoderivado">Total Unidades</label>
                    </div>

                    <div class="col-xl-2">
                        <div class="form-group">
                            <input type="text" class="form-control form-control-sm" id="txtTotalUnidadesHemoderivado" autocomplete="off" disabled>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

