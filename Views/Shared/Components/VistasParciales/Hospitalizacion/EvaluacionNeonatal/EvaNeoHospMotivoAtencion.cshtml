<div class="row mt-1">
    <div class="col-md-5">
        <div class="card m-t-5 bg-yellow" style="padding-bottom: 0px;">
            <div class="card-header bg-white">Enfermedad Actual</div>
            <div class="card-block m-t-5 custom-form" style="padding-bottom: 0px;">
                <div class="row pb-1">
                    <div class="col-md-12">
                        <div class="form-group">
                            <label for="txtTiempoEnfermedad">Tiempo Enfermedad</label>
                            <input type="text" class="form-control form-control-sm" id="txtTiempoEnfermedad" placeholder="" autocomplete="off">
                        </div>
                        <div class="form-group">
                            <label for="txtInicioEnfermedad">Inicio</label>
                            <input type="text" class="form-control form-control-sm" id="txtInicioEnfermedad" placeholder="" autocomplete="off">
                        </div>
                        <div class="form-group">
                            <label for="txtCursoEnfermedad">Curso</label>
                            <input type="text" class="form-control form-control-sm" id="txtCursoEnfermedad" placeholder="" autocomplete="off">
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
    <div class="col-md-7">
        <div class="card  m-t-5 bg-orange" style="padding-bottom: 0px;">
            <div class="card-header bg-white">Signos y Síntomas</div>
            <div class="card-block m-t-5 custom-form" style="padding-bottom: 0px;">
                <div class="row pb-1">
                    <div class="col-md-6">
                        <div class="check__toggle mt-04">
                            <label class="toggle">
                                <input class="toggle__input campo" type="checkbox" id="chkDificultadRespiratoria">
                                <span class="toggle__label mr-2">
                                    <span class="toggle__text">Dificultad Respiratoria</span>
                                </span>
                            </label>
                        </div>
                        <div class="check__toggle mt-04">
                            <label class="toggle">
                                <input class="toggle__input campo" type="checkbox" id="chkDiarrea">
                                <span class="toggle__label mr-2">
                                    <span class="toggle__text">Diarrea</span>
                                </span>
                            </label>
                        </div>
                        <div class="check__toggle mt-04">
                            <label class="toggle">
                                <input class="toggle__input campo" type="checkbox" id="chkDistensionAbdominal">
                                <span class="toggle__label mr-2">
                                    <span class="toggle__text">Distension Abdominal</span>
                                </span>
                            </label>
                        </div>
                        <div class="check__toggle mt-04">
                            <label class="toggle">
                                <input class="toggle__input campo" type="checkbox" id="chkCianosis">
                                <span class="toggle__label mr-2">
                                    <span class="toggle__text">Cianosis</span>
                                </span>
                            </label>
                        </div>
                        <div class="check__toggle mt-04">
                            <label class="toggle">
                                <input class="toggle__input campo" type="checkbox" id="chkMalOlorOmbligo">
                                <span class="toggle__label mr-2">
                                    <span class="toggle__text">Mal olor Ombligo</span>
                                </span>
                            </label>
                        </div>
                        <div class="check__toggle mt-04">
                            <label class="toggle">
                                <input class="toggle__input campo" type="checkbox" id="chkIctericia">
                                <span class="toggle__label mr-2">
                                    <span class="toggle__text">Ictericia</span>
                                </span>
                            </label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="check__toggle mt-04">
                            <label class="toggle">
                                <input class="toggle__input campo" type="checkbox" id="chkDolor">
                                <span class="toggle__label mr-2">
                                    <span class="toggle__text">Dolor</span>
                                </span>
                            </label>
                        </div>
                        <div class="check__toggle mt-04">
                            <label class="toggle">
                                <input class="toggle__input campo" type="checkbox" id="chkConvulsiones">
                                <span class="toggle__label mr-2">
                                    <span class="toggle__text">Convulsiones</span>
                                </span>
                            </label>
                        </div>
                        <div class="check__toggle mt-04">
                            <label class="toggle">
                                <input class="toggle__input campo" type="checkbox" id="chkFiebre">
                                <span class="toggle__label mr-2">
                                    <span class="toggle__text">Fiebre</span>
                                </span>
                            </label>
                        </div>
                        <div class="check__toggle mt-04">
                            <label class="toggle">
                                <input class="toggle__input campo" type="checkbox" id="chkVomitos">
                                <span class="toggle__label mr-2">
                                    <span class="toggle__text">Vómitos</span>
                                </span>
                            </label>
                        </div>
                        <div class="check__toggle mt-04">
                            <label class="toggle">
                                <input class="toggle__input campo" type="checkbox" id="chkHemorragia">
                                <span class="toggle__label mr-2">
                                    <span class="toggle__text">Hemorragia</span>
                                </span>
                            </label>
                        </div>
                        <div class="check__toggle mt-04">
                            <label class="toggle">
                                <input class="toggle__input campo" type="checkbox" id="chkOtros">
                                <span class="toggle__label mr-2">
                                    <span class="toggle__text">Otros</span>
                                </span>
                                <input type="text" class="form-control form-control-sm" id="txtOtroSintomas" placeholder="" autocomplete="off">
                            </label>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-12 mt-1">
        <div class="form-group">
            <label for="txtRelato">Anamnesis / Relato</label>
            <textarea class="form-control" id="txtRelato" rows="5"></textarea>
        </div>
    </div>
</div>
