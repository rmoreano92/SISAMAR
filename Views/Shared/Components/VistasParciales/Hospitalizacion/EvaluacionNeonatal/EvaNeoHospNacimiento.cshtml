<div class="row">
    <div class="col-md-8">
        <div class="card bg-yellow">
            <div class="card-header bg-white">Datos de Nacimiento del Neonato</div>
            <div class="card-block">
                <div class="row">
                    <div class="col-md-5">
                        <div class="row">
                            <div class="col-sm-7">
                                <div class="form-group mb-0">
                                    <label for="txtFechaNacimientoRn">Fecha Nacimiento</label>
                                    <div class="input-group input-group-sm">
                                        <input type="text" autocomplete="off" class="form-control form_val_popup_dp3" placeholder="dd/mm/yyyy" data-date-format="dd/mm/yyyy" id="txtFechaNacimientoRn">
                                        <span class="input-group-addon">
                                            <i class="fa fa-calendar "></i>
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-5">
                                <div class="form-group mb-0">
                                    <label for="txtHoraNacimientoRn">Hora Nac. </label>
                                    <input type="text" class="form-control form-control-sm" id="txtHoraNacimientoRn" placeholder="__:__" autocomplete="off">
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-7">
                                <div class="form-group mb-0">
                                    <label for="cboTipoSexoRn">Sexo</label>
                                    <select id="cboTipoSexoRn" class="chzn-select " data-placeholder="Seleccione una opción"></select>
                                </div>
                            </div>
                        </div>

                        <div class="casilla mt-1">
                            <h5>N° Gemelar</h5>
                            <div class="form-group mb-0">
                                <label for="cboTipoGestacionRn">Tipo de Gestación</label>
                                <select id="cboTipoGestacionRn" class="chzn-select " data-placeholder="Seleccione una opción"></select>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group mb-0">
                                        <label for="txtNroFetosRn">N° de Fetos</label>
                                        <input type="text" class="form-control form-control-sm solo-numero " id="txtNroFetosRn" autocomplete="off">
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group mb-0">
                                        <label for="cboNumeroGemelarRn">Gemelar</label>
                                        <select id="cboNumeroGemelarRn" class="chzn-select" data-placeholder="Seleccione una opción"></select>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="form-group mb-0" hidden>
                            <label for="cboRiesgoRn">Riesgo del RN</label>
                            <select id="cboRiesgoRn" class="chzn-select" data-placeholder="Seleccione una opción"></select>
                        </div>

                        <div class="row">
                            <div class="col-md-7">
                                <div class="form-group mb-0">
                                    <label for="cboCondicionRn">Condición</label>
                                    <select id="cboCondicionRn" class="chzn-select" data-placeholder="Seleccione una opción"></select>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="form-group mb-0">
                                    <label style="width: 100%;">Óbito</label>
                                    <div class="switch-field">
                                        <input type="radio" id="rdbObitoRnNo" name="rdbObitoRn" class="rdbObitoRn" />
                                        <input type="radio" id="rdbObitoRnSiMenor" name="rdbObitoRn" class="rdbObitoRn" />
                                        <label for="rdbObitoRnSiMenor" class="pl-1 pr-1">&#60 500 GR</label>
                                        <input type="radio" id="rdbObitoRnSiMayor" name="rdbObitoRn" class="rdbObitoRn" />
                                        <label for="rdbObitoRnSiMayor" class="pl-1 pr-1">&#62; 500 GR</label>
                                    </div>
                                </div>
                            </div>
                        </div>


                    </div>


                    <div class="col-md-3">
                        <div class="form-group mb-0">
                            <label for="txtPesoRn">Peso al Nacer (gr)</label>
                            <input type="text" class="form-control form-control-sm solo-numero" id="txtPesoRn" minlength="3" maxlength="4" autocomplete="off">
                        </div>

                        <div class="form-group mb-0">
                            <label for="txtTallaRn">Talla al Nacer (cm)</label>
                            <input type="text" class="form-control form-control-sm solo-decimal" id="txtTallaRn" autocomplete="off">
                        </div>

                        <div class="form-group mb-0">
                            <label for="txtPerCefalicoRn">Périmetro Cefálico</label>
                            <input type="text" class="form-control form-control-sm solo-decimal" id="txtPerCefalicoRn" autocomplete="off">
                        </div>

                        <div class="form-group mb-0">
                            <label for="txtPerToracicoRn">Périmetro Toráxico</label>
                            <input type="text" class="form-control form-control-sm solo-decimal" id="txtPerToracicoRn" autocomplete="off">
                        </div>

                        <div class="form-group mb-0">
                            <label for="txtEdadGestacionalRn">Edad Gest. al Nacer (sem)</label>
                            <input type="text" class="form-control form-control-sm solo-numero" id="txtEdadGestacionalRn" minlength="2" maxlength="2" autocomplete="off">
                        </div>

                        <div class="form-group mb-0">
                            <label for="cboTiempoClampajeRn">Tiempo Clampaje</label>
                            <select id="cboTiempoClampajeRn" class="chzn-select" data-placeholder="Seleccione una opción"></select>
                        </div>

                    </div>

                    <div class="col-md-4">
                        <div class="form-group mb-0">
                            <label style="width: 100%;">Clamp Tardío</label>
                            <div class="switch-field">
                                <input type="radio" id="rdbTardioRnSi" name="rdbTardioRn" class="rdbTardioRn" />
                                <label for="rdbTardioRnSi" class="pl-2  pr-2">Si</label>
                                <input type="radio" id="rdbTardioRnNO" name="rdbTardioRn" class="rdbTardioRn" />
                                <label for="rdbTardioRnNO" class="pl-2  pr-2">No</label>
                            </div>
                        </div>

                        <div class="form-group mb-0">
                            <label for="cboContactoPielRn">Contacto Piel a Piel</label>
                            <select id="cboContactoPielRn" class="chzn-select" data-placeholder="Seleccione una opción"></select>
                        </div>

                        <div class="form-group mb-0">
                            <label style="width: 100%;">Lact. 1era Hora</label>
                            <div class="switch-field">
                                <input type="radio" id="rdbLacthoraRnSi" name="rdbLacthoraRn" class="rdbLacthoraRn" />
                                <label for="rdbLacthoraRnSi" class="pl-2 pr-2">Si</label>
                                <input type="radio" id="rdbLacthoraRnNO" name="rdbLacthoraRn" class="rdbLacthoraRn" />
                                <label for="rdbLacthoraRnNO" class="pl-2 pr-2">No</label>
                            </div>
                        </div>

                        <div class="form-group mb-0">
                            <label for="cboServicioNacimientoRn">Servicio Nacimiento</label>
                            <select id="cboServicioNacimientoRn" class="chzn-select-deselect " data-placeholder="Seleccione una opción"></select>
                        </div>

                        <div class="form-group mb-0">
                            <label for="cboProcedenciaRn">Otra Procedencia</label>
                            <select id="cboProcedenciaRn" class="chzn-select" data-placeholder="Seleccione una opción"></select>
                        </div>

                        @* <div class="form-group mb-0">
                            <label for="txtTiempoHosp">Tiempo Hospitalización (días)</label>
                            <input type="text" class="form-control form-control-sm solo-numero" id="txtTiempoHosp" autocomplete="off" disabled>
                        </div> *@
                        
                    </div>

                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card bg-blue" style="padding-bottom: 0px;">
            <div class="card-header bg-white">Respiración y Llanto al Nacer</div>
            <div class="card-block">
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group mb-0">
                            <label style="width: 100%;">Inmediato</label>
                            <div class="switch-field">
                                <input type="radio" id="rdbInmediatoRnSi" name="rdbInmediatoRn" class="rdbInmediatoRn" />
                                <label for="rdbInmediatoRnSi" class="pl-2 pr-2">Si</label>
                                <input type="radio" id="rdbInmediatoRnNO" name="rdbInmediatoRn" class="rdbInmediatoRn" />
                                <label for="rdbInmediatoRnNO" class="pl-2 pr-2">No</label>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-12">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-0">
                                    <label style="width: 100%;">Reanimación</label>
                                    <div class="switch-field">
                                        <input type="radio" id="rdbReanimacionRnSi" name="rdbReanimacionRn" class="rdbReanimacionRn" />
                                        <label for="rdbReanimacionRnSi" class="pl-2 pr-2">Si</label>
                                        <input type="radio" id="rdbReanimacionRnNO" name="rdbReanimacionRn" class="rdbReanimacionRn" />
                                        <label for="rdbReanimacionRnNO" class="pl-2 pr-2">No</label>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-0">
                                    <label for="cboTipoReanimacionRn">Tipo Reanimación</label>
                                    <select id="cboTipoReanimacionRn" class="chzn-select field" data-placeholder="Seleccione una opción"></select>
                                </div>
                            </div>
                        </div>                       
                    </div>

                    <div class="col-md-6">
                        <div class="form-group mb-0">
                            <label for="txtMinutoRn">APGAR 1 min</label>
                            <input type="text" class="form-control form-control-sm solo-numero" id="txtMinutoRn" minlength="1" maxlength="2" autocomplete="off">
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group mb-0">
                            <label for="txt5MinutoRn">APGAR 5 min</label>
                            <input type="text" class="form-control form-control-sm solo-numero" id="txt5MinutoRn" minlength="1" maxlength="2" autocomplete="off">
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group mb-0">
                            <label for="txt10MinutoRn">APGAR 10 min</label>
                            <input type="text" class="form-control form-control-sm solo-numero" id="txt10MinutoRn" minlength="1" maxlength="2" autocomplete="off">
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group mb-0">
                            <label for="txt15MinutoRn">APGAR 15 min</label>
                            <input type="text" class="form-control form-control-sm solo-numero" id="txt15MinutoRn" minlength="1" maxlength="2" autocomplete="off">
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group mb-0">
                            <label for="txt20MinutoRn">APGAR 20 min</label>
                            <input type="text" class="form-control form-control-sm solo-numero" id="txt20MinutoRn" minlength="1" maxlength="2" autocomplete="off">
                        </div>
                    </div>

                    <div class="col-md-12">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-group mb-0">
                                    <label style="width: 100%;">Patología Neonatal</label>
                                    <div class="switch-field">
                                        <input type="radio" id="rdbPatNeoRnSi" name="rdbPatNeoRn" class="rdbPatNeoRn" />
                                        <label for="rdbPatNeoRnSi" class="pl-2 pr-2">Si</label>
                                        <input type="radio" id="rdbPatNeoRnNo" name="rdbPatNeoRn" class="rdbPatNeoRn" />
                                        <label for="rdbPatNeoRnNo" class="pl-2 pr-2">No</label>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="form-group mb-0">
                                    <label for="txtEspecificarRn">Especificar</label>
                                    <input type="text" class="form-control form-control-sm" id="txtEspecificarRn" autocomplete="off">
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-12">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-0">
                                    <label style="width: 100%;">Transporte</label>
                                    <div class="switch-field">
                                        <input type="radio" id="rdbTransporteSi" name="rdbTransporte" class="rdbTransporte field" />
                                        <label for="rdbTransporteSi" class="pl-2 pr-2">Si</label>
                                        <input type="radio" id="rdbTransporteNO" name="rdbTransporte" class="rdbTransporte field" />
                                        <label for="rdbTransporteNO" class="pl-2 pr-2">No</label>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group mb-0">
                                    <label for="cboTipoTransporteRn">Tipo Transporte</label>
                                    <select id="cboTipoTransporteRn" class="chzn-select field" data-placeholder="Seleccione una opción"></select>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

</div>