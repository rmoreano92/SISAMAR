<div class="row mb-1">
    <div class="col-md-7">
        <div class="card bg-blue pb-1">
            <div class="card-header bg-white">Datos del Paciente</div>
            <div class="card-block pb-0">

                <div class="row">
                    <div class="col-md-2">
                        <div class="form-group mb-0">
                            <label for="txtNroCuenta">N° Cuenta</label>
                            <input type="text" class="form-control form-control-sm" id="txtNroCuenta" placeholder="" autocomplete="off" disabled>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group mb-0">
                            <label for="txtHistoria">Historia</label>
                            <input type="text" class="form-control form-control-sm" id="txtHistoria" placeholder="" autocomplete="off" disabled>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group mb-0">
                            <label for="txtPacienteNombre">Nombres</label>
                            <input type="text" class="form-control form-control-sm" id="txtPacienteNombre" placeholder="" autocomplete="off" disabled>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group mb-0">
                            <label for="txtNroDocumento">N° Documento</label>
                            <div class="d-flex">
                                <input type="text" class="form-control form-control-sm m-r-5" id="txtTipoDocumento" placeholder="" autocomplete="off" disabled>
                                <input type="text" class="form-control form-control-sm m-l-5" id="txtNroDocumento" placeholder="" autocomplete="off" disabled>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-2">
                        <div class="form-group mb-0">
                            <label for="txtFechaNacimiento" class="form-control-label">Fecha Nac.</label>
                            <div class="input-group input-group-sm">
                                <input type="text" autocomplete="off" class="form-control form_val_popup_dp3" placeholder="dd/mm/yyyy" data-date-format="dd/mm/yyyy" id="txtFechaNacimiento" disabled readonly>
                                <span class="input-group-addon " for="txtFechaNacimiento" id="txtFechaNacimientoIcon">
                                    <i class="fa fa-calendar "></i>
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group mb-0">
                            <label for="txtHoraNacimiento" class="form-control-label">Hora Nac.</label>
                            <div class="input-group input-group-sm">
                                <input type="text" autocomplete="off" class="form-control" name="txtHoraNacimiento" id="txtHoraNacimiento" onblur="valida_hora(value)" disabled readonly>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group mb-0">
                            <label for="">Edad (A|M|D)</label>
                            <div class="d-flex">
                                <input type="text" class="form-control form-control-sm" id="txtEdadAnio" placeholder="" autocomplete="off" disabled>
                                <span style="margin: 0 2px;font-weight: bold;">|</span>
                                <input type="text" class="form-control form-control-sm" id="txtEdadMes" placeholder="" autocomplete="off" disabled>
                                <span style="margin: 0 2px;font-weight: bold;">|</span>
                                <input type="text" class="form-control form-control-sm" id="txtEdadDia" placeholder="" autocomplete="off" disabled>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group mb-0">
                            <label for="cboSexo">Sexo</label>
                            <select id="cboSexo" class="chzn-select" disabled></select>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group mb-0">
                            <label for="txtReingreso">Reingreso</label>
                            <input type="text" class="form-control form-control-sm" id="txtReingreso" placeholder="" autocomplete="off" disabled>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-xl-7">
                        <div class="row">
                            <div class="col-xl-6">
                                <div class="form-group mb-0">
                                    <label for="txtServicioNacimiento">Servicio Nacimiento</label>
                                    <input type="text" class="form-control form-control-sm" id="txtServicioNacimiento" placeholder="" autocomplete="off" disabled>
                                </div>
                            </div>
                            <div class="col-xl-6">
                                <div class="form-group mb-0">
                                    <label for="txtServicioActual">Servicio Actual</label>
                                    <input type="text" class="form-control form-control-sm" id="txtServicioActual" placeholder="" autocomplete="off" disabled>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-5">
                        <div class="row">
                            <div class="col-xl-8">
                                <div class="form-group">
                                    <label for="cboTipoPaciente">Tipo Paciente</label>
                                    <select id="cboTipoPaciente" class="chzn-select"></select>
                                </div>
                            </div>
                            <div class="col-xl-4">
                                <div class="form-group mb-0">
                                    <label for="txtNroCama">Nro Cama</label>
                                    <input type="text" class="form-control form-control-sm" id="txtNroCama" placeholder="" autocomplete="off" disabled>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    
                </div>


                    @* <div class="col-md-2">
                        <div class="form-group">
                            <label for="cboTipoPaciente">Tipo Paciente</label>
                            <select id="cboTipoPaciente" class="chzn-select" disabled></select>
                        </div>
                    </div> 
                    <div class="col-md-2">
                        <div class="form-group">
                            <label for="cboOrigenPaciente">Origen</label>
                            <select id="cboOrigenPaciente" class="chzn-select" disabled></select>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group campo">
                            <label for="cboPrioridad">Prioridad</label>
                            <select id="cboPrioridad" class="chzn-select"></select>
                        </div>
                    </div>
                    <div class="col-md-1">
                        <div class="form-group campo">
                            <label for="txtGlasgow">Glasgow</label>
                            <input type="text" class="form-control form-control-sm" id="txtGlasgow" placeholder="" autocomplete="off">
                        </div>
                    </div>

                    <div class="col-md-1" style="display: none;">
                        <div class="form-group">
                            <label for="txtNroAtencion">N° Atención</label>
                            <input type="text" class="form-control form-control-sm" id="txtNroAtencion" placeholder="" autocomplete="off" disabled>
                        </div>
                    </div>*@
                    @*<div class="col-md-1" style="display: none;">
                    <div class="form-group">
                    <label for="hdIdTipoFuenteFian">Fuente Financiamiento</label>
                    <input type="text" class="form-control form-control-sm" id="hdIdTipoFuenteFian" placeholder="" autocomplete="off" disabled>
                    </div>
                    </div>
                </div>*@
            </div>
        </div>
    </div>

    <div class="col-md-5">
        <div class="card bg-orange pb-1">
            <div class="card-header bg-white">Datos de la Madre</div>
            <div class="card-block pb-0">
                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group mb-0">
                            <label for="txtNroHistoriaMadre">Historia Clinica</label>
                            <input type="text" class="form-control form-control-sm" id="txtNroHistoriaMadre" disabled autocomplete="off">
                        </div>
                    </div>
                    <div class="col-md-9">
                        <div class="form-group mb-0">
                            <label for="txtNombreMadre">Datos Personales</label>
                            <input type="text" class="form-control form-control-sm" id="txtNombreMadre" disabled autocomplete="off">
                        </div>
                    </div>
                    
                    @* <div class="col-md-3">
                        <div class="form-group">
                            <label for="cboGradoInstruccionMadre">Grado de Instrucción</label>
                            <select id="cboGradoInstruccionMadre" class="chzn-select" disabled data-placeholder="Seleccione una opción"></select>
                        </div>
                    </div> *@
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group mb-0">
                            <label for="txtTipoDocMadre">Tipo Documento</label>
                            <input type="text" class="form-control form-control-sm" id="txtTipoDocMadre" disabled autocomplete="off">
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mb-0">
                            <label for="txtNroDocMadre">Nro Documento</label>
                            <input type="text" class="form-control form-control-sm" id="txtNroDocMadre" disabled autocomplete="off">
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group mb-0">
                            <label for="txtEdadMadre">Edad (años)</label>
                            <input type="text" class="form-control form-control-sm" id="txtEdadMadre" disabled autocomplete="off">
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group mb-0">
                            <label for="txtEstadoCivilMadre">Estado Civil</label>
                            <input type="text" class="form-control form-control-sm" id="txtEstadoCivilMadre" disabled autocomplete="off">
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

