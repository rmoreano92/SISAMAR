                                            </span>
                                            <span class="opcion-radio d-block">
                                                <input type="radio" id="AglutinacionOpt3" name="Aglutinacion" value="3">
                                                <label for="AglutinacionOpt3">Moderada</label>
                                            </span>
                                            <span class="opcion-radio d-block">
                                                <input type="radio" id="AglutinacionOpt4" name="Aglutinacion" value="4">
                                                <label for="AglutinacionOpt4">Abundante</label>
                                            </span>
                                            <span class="opcion-radio d-block">
                                                <input type="radio" id="AglutinacionOpt5" name="Aglutinacion" value="5">
                                                <label for="AglutinacionOpt5">Severa</label>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <h6 class="font-weight-bold">Agregación</h6>
                                    <div class="opciones-radio">
                                        <div class="form-group">
                                            <span class="opcion-radio d-block">
                                                <input type="radio" id="AgregacionOpt1" name="Agregacion" value="1">
                                                <label for="AgregacionOpt1">Ausente</label>
                                            </span>
                                            <span class="opcion-radio d-block">
                                                <input type="radio" id="AgregacionOpt2" name="Agregacion" value="2">
                                                <label for="AgregacionOpt2">Presente</label>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-7">
                        <div class="form-group">
                            <label for="txtObservacion">Observación</label>
                            <textarea class="form-control field" id="txtObservacion" rows="8"></textarea>
                        </div>
                    </div>

                </div>

            </div>
        </div>
    </div>

    <div class="col-md-12">
        <div class="form-group ml-auto" style="max-width:350px;">
            <label for="cboProfesionalBiologo">Profesional Biólogo</label>
            <select id="cboProfesionalBiologo" class="chzn-select field" data-placeholder="Seleccione una opción">               
                @foreach (DataRow row in ViewBag.Biologos.Rows)
