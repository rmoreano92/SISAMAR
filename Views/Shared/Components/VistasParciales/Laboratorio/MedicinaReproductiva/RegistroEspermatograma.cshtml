    <div class="col-md-4">
        <div class="card bg-yellow mb-2">
            <div class="card-header bg-white">Datos de Recolección de Muestra</div>
            <div class="card-block custom-form">
                <div class="row">
                    <div class="col-md-12">
                        <div class="row">
                            <div class="col-sm-6">
                                <div class="form-group">
                                    <label for="txtFechaExamen">Fecha de Examen</label>
                                    <div class="input-group input-group-sm">
                                        <input type="text" autocomplete="off" class="form-control form_val_popup_dp3 maskFecha field" placeholder="__/__/____" data-date-format="dd/mm/yyyy" id="txtFechaExamen">
                                        <span class="input-group-addon">
                                            <i class="fa fa-calendar "></i>
                                        </span>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label for="txtHoraRecoleccion">Hora Recolección</label>
                                    <input type="text" class="form-control form-control-sm maskHora field" id="txtHoraRecoleccion" placeholder="__:__" autocomplete="off">
                                </div>
                                <div class="form-group">
                                    <label for="txtHoraEvaluacion">Hora Evaluación</label>
                                    <input type="text" class="form-control form-control-sm maskHora field" id="txtHoraEvaluacion" placeholder="__:__" autocomplete="off">
                                </div>
                                <div class="form-group">
                                    <label for="cboMetodoObtencion">Método de Obtención</label>
                                    <select id="cboMetodoObtencion" class="chzn-select field" data-placeholder="Seleccione una opción">
                                        <option value="1">Masturbación</option>                                        
                                        <option value="2">Coito interrumpido</option>
                                        <option value="9">Otros</option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label for="txtMetodoObtencion">Otro Metodo</label>
                                    <input type="text" class="form-control form-control-sm field" id="txtMetodoObtencion" autocomplete="off">
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="form-group">
                                    <label for="txtAbstinenciaSexual">Abstinencia sexual</label>
                                    <div class="input-group input-group-sm">
                                        <input type="text" autocomplete="off" class="form-control field" id="txtAbstinenciaSexual" placeholder="" autocomplete="off">
                                        <span class="input-group-addon">días</span>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label for="txtDificultad">Dificultad</label>
                                    <input type="text" class="form-control form-control-sm field" id="txtDificultad" autocomplete="off">
                                </div>
                                <div class="form-group">
                                    <label for="cboLugarObtencion">Lugar de Obtención</label>
                                    <select id="cboLugarObtencion" class="chzn-select field" data-placeholder="Seleccione una opción">
                                        <option value="1">MGP</option>
                                        <option value="2">Casa</option>
                                        <option value="9">Otros</option>                                        
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label for="txtLugarObtencion">Otro Lugar</label>
                                    <input type="text" class="form-control form-control-sm field" id="txtLugarObtencion" autocomplete="off">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>


