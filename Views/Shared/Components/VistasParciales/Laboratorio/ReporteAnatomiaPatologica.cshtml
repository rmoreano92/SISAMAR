@using System.Data

<div class="modal fade" id="modalReporteAnatomiaPatologica" tabindex="-1" role="dialog" aria-labelledby="mmodalReporteConsolidadoVentasLabel" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header modal-header" style="background: #1D6F42;">
                <h5 class="modal-title text-white" id="myModalLabel">Reporte Anatomía Patalógica</h5>
            </div>
            <div class="modal-body">
                <div class="card">
                    <div class="card-block">
                        <div class="row">

                            <div class="col-md-6">
                                <div class="form-group form-group-sm m-0">
                                    <label for="txtFechaInicioReporteAnatomiaPatologica" class=" form-control-label">Fecha Inicio</label>
                                    <div class="input-group">
                                        <input type="text" class="form-control form_val_popup_dp3" placeholder="dd/mm/yyyy" data-date-format="dd/mm/yyyy" id="txtFechaInicioReporteAnatomiaPatologica" autocomplete="off">
                                        <span class="input-group-addon">
                                            <i class="fa fa-calendar "></i>
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group form-group-sm m-0">
                                    <label for="txtFechaFinReporteAnatomiaPatologica" class=" form-control-label">Fecha Fin</label>
                                    <div class="input-group">
                                        <input type="text" class="form-control form_val_popup_dp3" placeholder="dd/mm/yyyy" data-date-format="dd/mm/yyyy" id="txtFechaFinReporteAnatomiaPatologica" autocomplete="off">
                                        <span class="input-group-addon">
                                            <i class="fa fa-calendar "></i>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn text-white" style="background: #1D6F42;" id="btnGenerarReporteAnatomiaPatologica">Generar Reporte <i class="fa-solid fa-file-excel ml-1"></i></button>
                <button type="button" class="btn btn-secondary" id="btnCerrarReporteAnatomiaPatologica">Cerrar</button>
            </div>
        </div>
    </div>
</div>
