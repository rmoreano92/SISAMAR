<div class="modal fade" id="modalProcedimientos" role="dialog" aria-labelledby="exampleModalLabel2" aria-hidden="true" data-backdrop="static" style="background-color: rgba(0, 0, 0, 0.46);">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary">
                <h5 class="modal-title text-white" id="exampleModalLabel3">Busqueda de Servicios a Configurar</h5>
