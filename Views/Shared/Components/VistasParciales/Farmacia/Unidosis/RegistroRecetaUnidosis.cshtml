                                                            <input id="txtCAntidadFarmacia" autocomplete="off" placeholder="Cantidad" class="solo-numero form-control form-control-sm">
                                                        </div>
                                                    </div>
                                                    <div class="col-md-2">
                                                        <div class="form-group">
                                                            <label for="cboDosis">Dosis</label>
                                                            <select class="chzn-select" id="cboDosis" data-placeholder="Seleccione una opción"></select>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-2">
