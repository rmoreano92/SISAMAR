@using Microsoft.Extensions.Configuration;
@{
    var AppVistaOrdenesMedica = new ConfigurationBuilder().AddJsonFile("appsettings.json").Build().GetValue<string>("Configuraciones:TipoVistaOrdenesMedica");
    string VistaOrdenesMedica = AppVistaOrdenesMedica.ToString();
}
@* @VistaOrdenesMedica *@


<div data-backdrop="static" style="overflow-y: scroll;" data-keyboard="false" class="modal fade" id="modalReceta" role="dialog" aria-labelledby="modalLabelsuccess">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header bg-info">
                <h4 class="modal-title text-white" id="modalLabelsuccess">Registro de Receta Unidosis</h4>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-12">
                        <div class="card">
                            <div class="card-block pb-0">
                                <div class="row">
                                    <div class="col-lg-2">
                                        <div class="form-group">
                                            <label for="txtNroCuentaRegistro" class="form-control-label">N° Cuenta</label>
                                            <input id="txtNroCuentaRegistro" autocomplete="off" type="tel" placeholder="" class="solo-numero form-control form-control-sm searchCuentaReceta">
                                        </div>
                                    </div>
                                    <div class="col-lg-4">
                                        <div class="form-group">
                                            <label for="txtPacienteRegistro" class="form-control-label">Datos del Paciente</label>
                                            <input id="txtPacienteRegistro" disabled autocomplete="off" placeholder="" class="form-control form-control-sm">
                                        </div>
                                    </div>
                                    <div class="col-lg-3">
                                        <div class="form-group">
                                            <label for="txtDesFuenteFinan" class="form-control-label">Fte. Finaciamiento</label>
                                            <input id="txtDesPlan" disabled="disabled" autocomplete="off" placeholder="" class="form-control form-control-sm">
                                        </div>
                                    </div>
                                    <div class="col-lg-3">
                                        <div class="form-group">
                                            <label for="cboProcedencia" class="form-control-label">Servicio Actual</label>
                                            <select class="chzn-select campo" id="cboProcedencia" data-placeholder="Seleccione una opción" required></select>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>


                <div class="row mt-1">
                    <div class="col-md-12">

                        <div class="card bg-pink" style="padding-bottom: 0px;" id="ContOrdenesMedicas">
