                                                    <select class="chzn-select campo" id="cboMedicoReceta" data-placeholder="Seleccione una opción" required></select>
                                                </div>
                                            </div>

                                            <div class="col-lg-4">
                                                <div class="form-group m-0">
                                                    <label for="cboFarmacia">Farmacia</label>
                                                    <select class="chzn-select" id="cboFarmacia" data-placeholder="Seleccione una opción" disabled required></select>
                                                </div>
                                            </div>

                                            <div class="col-lg-4">
                                                <div class="form-group m-0">
                                                    <label for="txtFechaVigencia">Fecha de Vigencia</label>
                                                    <div class="input-group input-group-sm" style="max-width: 130px;">
                                                        <input type="text" autocomplete="off" class="form-control  form_val_popup_dp3 campo" placeholder="dd/mm/yyyy" data-date-format="dd/mm/yyyy" id="txtFechaVigencia">
                                                        <span class="input-group-addon">
                                                            <i class="fa fa-calendar "></i>
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-lg-3">
                                        <div class="form-group m-0">
                                            <label for="txtNroPreUnidosis" class="form-control-label">N° Pre-Unidosis</label>
                                            <input id="txtNroPreUnidosis" autocomplete="off" type="tel" placeholder="" class="form-control form-control-sm" disabled readonly>
                                        </div>
                                    </div>

                                    <div class="col-lg-12">
                                        <form>
                                            <fieldset class="m-0 mb-1 pb-1 m-t-5" style="border-color: #d5d5d5;">
