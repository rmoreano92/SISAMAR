@using Microsoft.AspNetCore.Http;

@{
    ViewData["Title"] = "Layout2";
}

@model CapaEntidades.User
@using CapaDatos
@using System.Data
@using Microsoft.Extensions.Configuration;
@using SiHospCrypKey;
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "--SISGALEN--";
    DataSet lsParametros;
    DalParametros dalParametros = new DalParametros();
    Encriptar objCripto = new Encriptar();
    string nombre, siglas, tipoBD, logo, imagen_fondo;
    int idIpressInt = 0;
    var idIpressStr = Context.Session.GetString("IdIPress");
    if (!string.IsNullOrEmpty(idIpressStr) && int.TryParse(idIpressStr, out int result)) idIpressInt = result;
    

    lsParametros = await dalParametros.SeleccionaFilaParametro2(205, idIpressInt);
    nombre = lsParametros.Tables[0].Rows[0]["valorTexto"].ToString();

    lsParametros = await dalParametros.SeleccionaFilaParametro2(1007);
    siglas = lsParametros.Tables[0].Rows[0]["valorTexto"].ToString();

    lsParametros = await dalParametros.SeleccionaParametroPorCodigo("TIPO_VERSION_DB"); //version BD
    tipoBD = lsParametros.Tables[0].Rows[0]["valorTexto"].ToString();

    lsParametros = await dalParametros.SeleccionaFilaParametro2(1070, idIpressInt);
    logo = lsParametros.Tables[0].Rows[0]["Base64"].ToString();

    lsParametros = await dalParametros.SeleccionaFilaParametro2(1071, idIpressInt);
    imagen_fondo = lsParametros.Tables[0].Rows[0]["Base64v2"].ToString();

    ViewBag.nombre = nombre;
    ViewBag.siglas = siglas;
    ViewBag.tipoBD = tipoBD;
    ViewBag.logo = logo;
    ViewBag.imagen_fondo = imagen_fondo;

    
    //ViewBag.version = "v3.5.111223";

    var version = new ConfigurationBuilder().AddJsonFile("appsettings.json").Build().GetValue<string>("Version");
    var usaLabs = new ConfigurationBuilder().AddJsonFile("appsettings.json").Build().GetValue<string>("Configuraciones:UsaLabs");

    var urlAppWeb = new ConfigurationBuilder().AddJsonFile("appsettings.json").Build().GetValue<string>("Configuraciones:UrlAppWeb");
    var urlAppSocket = new ConfigurationBuilder().AddJsonFile("appsettings.json").Build().GetValue<string>("Configuraciones:UrlAppSocket");
    var urlAppFiles = new ConfigurationBuilder().AddJsonFile("appsettings.json").Build().GetValue<string>("Configuraciones:UrlAppFiles");

    ViewBag.version = version.ToString();

    /////ACTAULIZACION DE CONTRASEÑA//////////////////////////////////////
    //string clave = objCripto.DesencriptarCadena(HttpContextAccessor.HttpContext?.Session.GetString("clave").ToString());
    string clave = HttpContextAccessor.HttpContext?.Session.GetString("clave").ToString();
    string fechaObligatorioCambioPassword = new ConfigurationBuilder().AddJsonFile("appsettings.json").Build().GetValue<string>("ActualizaionContraseña:FechaObligatorio");    
    DateTime fechaLimiteCambioPassword = DateTime.ParseExact(fechaObligatorioCambioPassword, "dd/MM/yyyy", System.Globalization.CultureInfo.InvariantCulture);
    bool esObligatorioCambiarPassword = DateTime.Today >= fechaLimiteCambioPassword;
    string descripcionCambioPassword = "";
    if (esObligatorioCambiarPassword)
    {
        descripcionCambioPassword = new ConfigurationBuilder().AddJsonFile("appsettings.json").Build().GetValue<string>("ActualizaionContraseña:DescripcionObligatoria").ToString();
    } else {
        descripcionCambioPassword = new ConfigurationBuilder().AddJsonFile("appsettings.json").Build().GetValue<string>("ActualizaionContraseña:DescripcionNoObligatoria").ToString();
    }
}




