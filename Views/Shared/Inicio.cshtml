@using Microsoft.AspNetCore.Http;

@{
    ViewData["Title"] = "Layout2";
}

@model CapaEntidades.User
@using CapaDatos
@using System.Data
@using Microsoft.Extensions.Configuration;
@using SiHospCrypKey;
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    DataSet lsParametros;
    DalParametros dalParametros = new DalParametros();
    string imagen_fondo;
    int idIpressInt = 0;
    var idIpressStr = Context.Session.GetString("IdIPress");
    if (!string.IsNullOrEmpty(idIpressStr) && int.TryParse(idIpressStr, out int result)) idIpressInt = result;

    lsParametros = await dalParametros.SeleccionaFilaParametro2(1071, idIpressInt);
    imagen_fondo = lsParametros.Tables[0].Rows[0]["Base64v2"].ToString();

    ViewBag.imagen_fondo = imagen_fondo;

}


@{
    var fondo = "data:image/jpeg;base64," + ViewBag.imagen_fondo;
}
<div class="row">
    <div class="col-lg-12 fondo-dashboard head" style="background-image:url('@fondo')">

        @*<img src="../../images/inicio.jpeg" alt="Inicio" />*@

    </div>

</div>

@await Html.PartialAsync("_AcuerdoConfidencialidad")

@section Scripts
    {
    <script type="text/javascript" src="~/AdmiRE/vendors/chosen/js/chosen.jquery.js"></script>
    <script type="text/javascript" src="~/AdmiRE/vendors/raphael/js/raphael-min.js"></script>
    <script type="text/javascript" src="~/AdmiRE/vendors/justgage/js/justgage.js"></script>
    <script type="text/javascript" src="~/AdmiRE/vendors/d3/js/d3.min.js"></script>
    <script type="text/javascript" src="~/AdmiRE/vendors/c3/js/c3.min.js"></script>
    <script type="text/javascript" src="~/AdmiRE/vendors/jquery-tagsinput/js/jquery.tagsinput.js"></script>
    <script type="text/javascript" src="~/AdmiRE/vendors/bootstrap-datetimepicker/js/bootstrap-datetimepicker.min.js"></script>
    <script type="text/javascript" src="~/AdmiRE/vendors/masked/masked.js"></script>
    <script type="text/javascript" src="~/AdmiRE/js/date.format.js"></script>


    <script type="text/javascript">
        $(document).ready(function () {
            console.log("ready!");
            $('.fondo-dashboard').height(($(window).height() - $("#top").height() - 30) + 'px');

            // ---- ACUERDO ---- INIO
            var acuerdoAceptado = '@(Context.Session.GetString("AcuerdoAceptado") ?? "0")';
            if (acuerdoAceptado !== "1") {
                mostrarAcuerdo();
            }

            function mostrarAcuerdo() {
                $('#acuerdoOverlay').fadeIn(150);
                $('#btnAceptarAcuerdo').prop('disabled', true);
                $('#acuerdoScroll').off('scroll').on('scroll', function () {
                    var el = this;
                    var llegoAlFinal = (el.scrollTop + el.clientHeight) >= (el.scrollHeight - 5);
                    if (llegoAlFinal) {
                        $('#btnAceptarAcuerdo').prop('disabled', false);
                    }
                });
            }

            $('#btnAceptarAcuerdo').off('click').on('click', function () {
                $.post('/Home/AceptarAcuerdo', function (r) {
                    if (r && r.ok) {
                        $('#acuerdoOverlay').fadeOut(150);
                    }
                });
            });

            $('#btnCancelarAcuerdo').off('click').on('click', function () {
                $.post('/Home/CancelarAcuerdo', function (r) {
                    if (r && r.ok) {
                        window.location.href = '/Home/Index';
                    }
                });
            });
            // ---- ACUERDO ---- FIN
        });
    </script>    
}
