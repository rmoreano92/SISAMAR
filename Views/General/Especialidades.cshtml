@using Microsoft.Extensions.Configuration;
@{
    var version = new ConfigurationBuilder().AddJsonFile("appsettings.json").Build().GetValue<string>("Version");
    // var usaLabs = new ConfigurationBuilder().AddJsonFile("appsettings.json").Build().GetValue<string>("Configuraciones:UsaLabs");
}

@* <input id="hdUsaLabs" value="@usaLabs" hidden> *@



@section Css {
    <!-- plugin css -->
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/chosen/css/chosen.css" />
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/bootstrap-datetimepicker/css/bootstrap-datetimepicker.min.css" />
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/radio_css/css/radiobox.min.css" />
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/css/pages/radio_checkbox.css" />
    <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/jquery-tagsinput/css/jquery.tagsinput.css" />
}

<header class="head">
    <div class="main-bar row">
        <div class="col-lg-6 col-md-4 col-sm-4">
            <h4 class="nav_top_align">
                <i class="fa fa-hand-holding-medical"></i>
                Especialidades
            </h4>
        </div>
        <div class="col-lg-6 col-md-8 col-sm-8">
            <ol class="breadcrumb float-xs-right nav_breadcrumb_top_align">
                <li class="breadcrumb-item">
                    <a href="index1.html">
                        <i class="fa fa-home" data-pack="default" data-tags=""></i> Home
                    </a>
                </li>
                <li class="breadcrumb-item">
                    <a href="#">@ViewBag.Area</a>
                </li>
                <li class="breadcrumb-item active">Especialidades</li>
            </ol>
        </div>
    </div>
</header>


<div class="row m-0">
    <div class="col-sm-12">
        <div class="tab-content border pt-1 pl-1 pr-1" id="myTabContent">
            <div class="row">
                <div class="col-lg-12">
                    <div class="card">
                        <div class="card-block pb-1">
                            <div class="row">
                                <div class="col-lg-3">
                                    <div class="form-group m-0">
                                        <label for="txtNombreBusqueda" class="form-control-label">Nombre</label>
                                        <div class="input-group input-group-sm m-0">
                                            <input type="text" autocomplete="off" class="form-control" id="txtNombreBusqueda">
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-3">
                                    <div class="form-group m-0">
                                        <label for="cboDepartamentoBusqueda" class="form-control-label">Departamento</label>
                                        <select class="chzn-select" id="cboDepartamentoBusqueda" data-placeholder="Seleccione una opción"></select>
                                    </div>
                                </div>

                                <div class="col-lg-2 d-flex align-items-end" style="height: 55px;">
                                    <div>
                                        <button class="btn btn-primary btn-sm layout_btn_prevent" style="padding-left: 2rem !important; padding-right: 2rem !important;" id="btnBuscarEspecialidades">Buscar</button>
                                        <button class="btn btn-secondary btn-sm layout_btn_prevent" style="padding-left: 2rem !important; padding-right: 2rem !important;" id="btnLimpiarBuscquedaEspecialidades">Limpiar</button>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 pt-2 pb-0">
                    @{
                        if (@ViewBag.Agregar)
                        {
                            <button class="btn btn-primary layout_btn_prevent" id="btnAgregar">Agregar</button>
                        }
                        if (@ViewBag.Modificar)
                        {
                            <button class="btn btn-info layout_btn_prevent" id="btnModificar">Modificar</button>
                        }
                        if (@ViewBag.Eliminar)
                        {
                            // <button class="btn btn-danger layout_btn_prevent" id="btnEliminar">Eliminar</button>
                        }
                        if (@ViewBag.Consultar)
                        {
                            <button class="btn btn-warning layout_btn_prevent" id="btnConsultar">Consultar</button>
                        }
                    }
                </div>


                <div class="col-lg-12 pb-2">
                    <table id="tblEspecialidades" width="100%" class="table table-sm table-content-md table-bordered">
                        <thead style="color: white;background: #434343;">
                            <tr>
                                <th>Nombre</th>
                                <th>Tiempo Promedio</th>
                                <th>Producto Consulta</th>
                                <th>Producto Interconsulta</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>

            </div>

        </div>
    </div>
</div>



<div data-backdrop="static" style="overflow-y: scroll;" data-keyboard="false" class="modal fade" id="modalEspecialidades" role="dialog" aria-labelledby="modalLabelsuccess">
    <div class="modal-dialog modal-md" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary">
                <h4 class="modal-title text-white" id="modalLabelsuccess">Agregar Especialidades</h4>
            </div>
            <div class="modal-body">

                <div class="card m-t-5 bg-green">
                    <div class="card-block p-t-0">

                        <div class="row mt-1">
                            <div class="col-lg-6">
                                <label for="cboDepartamentoEspecialidad" class="form-control-label">Departamento</label>
                                <div class="input-group input-group-sm">
                                    <select class="chzn-select" id="cboDepartamentoEspecialidad"></select>
                                </div>
                            </div>

                            <div class="col-lg-6">
                                <label for="txtNombreEspecialidad" class="form-control-label">Nombre</label>
                                <div class="input-group input-group-sm">
                                    <input id="txtNombreEspecialidad" autocomplete="off" class="form-control">
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-lg-12">
                                <label for="txtCodigoProductoConsultaEspecialidad" class="form-control-label">Producto Consulta</label>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <div class="d-flex">
                                        <input id="txtCodigoProductoConsultaEspecialidad" type="text" class="form-control form-control-sm m-auto" autocomplete="off" readonly="">
                                        <input id="hdIdProductoConsultaEspecialidad" type="hidden" class="form-control">
                                        <button type="button" class="btn btn-sm btn-outline-primary layout_btn_prevent ml-1" id="btnProductoConsulta" onclick="EspecialidadHosp.AbrirModalCatalogoServicios(1);">
                                            <i class="fa-solid fa-magnifying-glass-plus"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-9">
                                <div class="form-group">
                                    <input id="txtProductoConsultaEspecialidad" type="text" class="form-control form-control-sm m-auto" readonly="">
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-lg-12">
                                <label for="txtCodigoProductoInterconsultaEspecialidad" class="form-control-label">Producto Consulta</label>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <div class="d-flex">
                                        <input id="txtCodigoProductoInterconsultaEspecialidad" type="text" class="form-control form-control-sm m-auto" autocomplete="off" readonly="">
                                        <input id="hdIdProductoInterconsultaEspecialidad" type="hidden" class="form-control">
                                        <button type="button" class="btn btn-sm btn-outline-primary layout_btn_prevent ml-1" id="btnProductoInterConsulta" onclick="EspecialidadHosp.AbrirModalCatalogoServicios(2);">
                                            <i class="fa-solid fa-magnifying-glass-plus"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-9">
                                <div class="form-group">
                                    <input id="txtProductoInterconsultaEspecialidad" type="text" class="form-control form-control-sm m-auto" readonly="">
                                </div>
                            </div>
                        </div>

                        <div class="row mb-1">
                            <div class="col-lg-6">
                                <label for="txtTiempoPromedioAtencionEspecialidad" class="form-control-label">Tiempo Promedio Atención</label>
                                <div class="input-group input-group-sm">
                                    <input id="txtTiempoPromedioAtencionEspecialidad" autocomplete="off" class="form-control solo-numero">
                                </div>
                            </div>
                        </div>
                    </div>


                </div>
                
            </div>

            <div class="modal-footer">
                <button id="btnGuardarEspecialidad" target="_blank" class="btn btn-primary "> Guardar</button>
                <button id="btnCerrarModalEspecialidades" target="_blank" class="btn btn-secondary "> Cerrar</button>
            </div>
        </div>
    </div>
</div>

<div data-backdrop="static" style="background-color: rgba(0, 0, 0, 0.46); overflow-y: scroll;" data-keyboard="false" class="modal fade" id="modalCatalogoServicios" role="dialog" aria-labelledby="modalLabelsuccess">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary">
                <h4 class="modal-title text-white" id="modalLabelsuccess">Búsqueda de Catalogo de Servicios</h4>
            </div>
            <div class="modal-body">
                <div class="row">

                    <input id="hdTipoCatalogoServicios" autocomplete="off" class="form-control" hidden>

                    <div class="col-md-3">
                        <div class="form-group m-0">
                            <label for="txtCodigoProcedimientoBusqueda" class="form-control-label">Código</label>
                            <input type="text" autocomplete="off" class="form-control form-control-sm search" id="txtCodigoProcedimientoBusqueda">
                        </div>
                    </div>

                    <div class="col-md-9">
                        <div class="form-group m-0">
                            <label for="txtNombreProcedimientoBusqueda" class="form-control-label">Nombre</label>
                            <input type="text" autocomplete="off" class="form-control form-control-sm search" id="txtNombreProcedimientoBusqueda">
                        </div>
                    </div>

                </div>

                <div class="row mb-1">

                    <div class="col-md-2">
                        <div class="d-flex align-items-end" style="height: 55px;">
                            <button class="btn btn-sm btn-primary layout_btn_prevent mr-1" id="btnBuscarCatalogoServicios" style="padding-left: 2rem !important; padding-right: 2rem !important;">Buscar</button>
                            <button class="btn btn-sm btn-secondary layout_btn_prevent" id="btnLimpiarFiltroCatalogoServicios" style="padding-left: 2rem !important; padding-right: 2rem !important;">Limpiar</button>
                        </div>
                    </div>

                </div>

                <div class="row">
                    <div class="col-md-12">
                        <table id="tblCatalogoServicios" width="100%" class="table table-sm table-bordered table-content-sm" style="cursor: default;">
                            <thead style="color: white;background: #434343;">
                                <tr>
                                    <th style="width:15%">Código</th>
                                    <th style="width:85%">Nombre</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>


               
            </div>
            <div class="modal-footer">
                <button id="btnSeleccionarProcedimiento" target="_blank" class="btn btn-primary "> Aceptar</button>
                <button id="btnCerrarModalCatalogoServicios" target="_blank" class="btn btn-secondary "> Cerrar</button>
            </div>
        </div>
    </div>
</div>
@section Scripts
    {
    <script type="text/javascript" src="~/AdmiRE/vendors/chosen/js/chosen.jquery.js"></script>
    <script type="text/javascript" src="~/AdmiRE/vendors/raphael/js/raphael-min.js"></script>
    <script type="text/javascript" src="~/AdmiRE/vendors/justgage/js/justgage.js"></script>
    <script type="text/javascript" src="~/AdmiRE/vendors/d3/js/d3.min.js"></script>
    <script type="text/javascript" src="~/AdmiRE/vendors/c3/js/c3.min.js"></script>
    <script type="text/javascript" src="~/AdmiRE/vendors/jquery-tagsinput/js/jquery.tagsinput.js"></script>
    <script type="text/javascript" src="~/AdmiRE/vendors/bootstrap-datetimepicker/js/bootstrap-datetimepicker.min.js"></script>
    <script type="text/javascript" src="~/AdmiRE/vendors/masked/masked.js"></script>
    @*<script src="https://momentjs.com/downloads/moment-with-locales.js"></script>*@
    <script type="text/javascript" src="~/AdmiRE/js/moment-with-locales.js"></script>
    <script type="text/javascript" src="~/AdmiRE/js/date.format.js"></script>
    <script type="text/javascript" src="~/AdmiRE/js/html2canvas.min.js"></script>


    <script type="text/javascript" src=@Href("~/js/General/Especialidades.js?v=" + version)></script>

    <script>
        $(document).ready(function () {
            EspecialidadHosp.Init()
        })
    </script>





}

