<body style="background: white; width:793px; height:1122px;position:relative; /*border: 1px solid red;*/" class="">
    @*<body style="background: white">*@
    <img src="~/images/Logo.png" style="width: 65px; position:absolute;" />

    <h3 class="border-secondary align-top" id="cajaTitulo">SOLICITUD DE SALA PARA INTERVENCION QUIRURGICA  <span><b>FO-034</b></span></h3>

    <table class="table table-bordered border-secondary" style="margin-bottom: 2px;">
        <tbody>
            <tr>
                <th class="border-secondary table-active text-center " style="width: 200px;">Clase de intervención</th>
                <td class="border-secondary text-center " style="width: 200px;"> @ViewBag.ClaseIntervencionCQx</td>
                <th class="border-secondary table-active text-center " style="width: 200px;">Clase de paciente</th>
                <td class="border-secondary text-center " style="width: 200px;"> @ViewBag.ClasificacionPacienteCQx</td>
            </tr>
        </tbody>
    </table>

    <table class="table table-bordered border-secondary" style="margin-bottom: 10px;">
        <tbody>
            <tr>
                <th class="border-secondary table-active text-center ">N° HISTORIA</th>
                <th class="border-secondary table-active text-center ">APELLIDOS Y NOMBRES</th>
                <th class="border-secondary table-active text-center ">EDAD</th>
                <th class="border-secondary table-active text-center ">SEXO</th>
                <th class="border-secondary table-active text-center ">SERVICIO</th>
                <th class="border-secondary table-active text-center ">CAMA</th>
            </tr>
            <tr style="">
                <td class="border-secondary align-top text-center "> @ViewBag.Historia</td>
                <td class="border-secondary align-top text-center "> @ViewBag.Paciente</td>
                <td class="border-secondary align-top text-center "> @ViewBag.Edad</td>
                <td class="border-secondary align-top text-center "> @ViewBag.Sexo</td>
                <td class="border-secondary align-top text-center "> @ViewBag.Servicio</td>
                <td class="border-secondary align-top text-center "> @ViewBag.cama</td>
            </tr>
        </tbody>
    </table>

    @* <table class="table table-bordered border-secondary" style="margin-bottom: 10px;">
        <tbody>
            <tr>
                <th class="border-secondary table-active text-center ">Grupo Sanguineo</th>
                <th class="border-secondary table-active text-center ">Factor RH</th>
                <th class="border-secondary table-active text-center ">Hemoglobina </th>
                <th class="border-secondary table-active text-center ">Deposito de Sandre</th>
            </tr>
            <tr style="">
                <td class="border-secondary align-top text-center "> </td>
                <td class="border-secondary align-top text-center "> </td>
                <td class="border-secondary align-top text-center "> </td>
                <td class="border-secondary align-top text-center "> </td>
            </tr>
        </tbody>
    </table> *@

    <table class="table table-bordered border-secondary">
        <tbody>
            <tr>
                <th class="border-secondary table-active text-center  col-4">DIAGNÓSTICO PRE-OPERATORIO</th>
            </tr>
            <tr style="height: 80px">
                <td class="border-secondary align-top">
                    @{
                        int index = 1;
                    }
                    @foreach (System.Data.DataRow row in ViewBag.Dx.Rows)
                    {
                        if (@row["idTipoDiagnosticoCQx"].ToString() == "1")
                        {
                            <span style="font-weight: bold;">DX @index</span>
                            <span>@row["codigoCIE10"] - @row["descripcion"] <b>(@row["tipoDiagnostico"])</b></span>
                            <br />
                        }

                        index++;
                    }
                </td>
            </tr>
