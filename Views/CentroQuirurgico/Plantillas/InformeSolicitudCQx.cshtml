                    {
                    <span style="font-weight: bold;">Proc @index</span>
                    <span>@row["Codigo"] - @row["Nombre"]</span>
                    <br />
                    index++;
                    } *@
                </td>
            </tr>
        </tbody>
    </table>

    <table class="table table-bordered border-secondary" style="margin-bottom: 2px;">
        <tbody>
            <tr>
                <th class="border-secondary table-active text-center " style="width: 200px;">APELLIDOS Y NOMBRES DEL CIRUJANO</th>
