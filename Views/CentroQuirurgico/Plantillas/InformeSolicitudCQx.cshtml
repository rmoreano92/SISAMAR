    </table>

    <table class="table table-bordered border-secondary" style="margin-bottom: 10px;">
        <tbody>
            <tr>
                <th class="border-secondary table-active text-center ">FECHA SUGERIDA PARA LA IQ</th>
                <th class="border-secondary table-active text-center ">HORA SUGERIDA PARA LA IQ</th>
                <th class="border-secondary table-active text-center ">FECHA SOLICITUD </th>
                <th class="border-secondary table-active text-center ">HORA SOLICITUD</th>
                <th class="border-secondary table-active text-center ">FECHA ACEPTADA </th>
                <th class="border-secondary table-active text-center ">HORA ACEPTADA</th>
            </tr>
            <tr style="">
                <td class="border-secondary align-top text-center "> @ViewBag.FechaSugerida</td>
                <td class="border-secondary align-top text-center "> @ViewBag.HoraSugerida</td>
                <td class="border-secondary align-top text-center "> @ViewBag.FechaSolicitud</td>
                <td class="border-secondary align-top text-center "> @ViewBag.HoraSolicitud</td>
                <td class="border-secondary align-top text-center "> @ViewBag.FechaAceptada</td>
                <td class="border-secondary align-top text-center "> @ViewBag.HoraAceptada</td>
