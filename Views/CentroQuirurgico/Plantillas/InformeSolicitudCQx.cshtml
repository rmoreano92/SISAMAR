                        <tbody>
                            <tr>
                                <th class="border-secondary table-active text-center " style="width: 200px;">Anestesiologo</th>
                                <td class="border-secondary text-center " style="width: 300px;"> @ViewBag.RenaesIpress</td>
                                <th class="border-secondary table-active text-center " style="width: 50px;">Sala</th>
                                <td class="border-secondary text-center " style="width: 100px;"> @ViewBag.RenaesIpress</td>
                            </tr>
                        </tbody>
                    </table>
                </td>
                <td style="vertical-align: top !important; width: 30%;" class="align-text-bottom">
                    <table style="width: 100%;" class="table table-bordered ">
                        <tr style="height: 50px">
                            <td style="vertical-align: top !important; width: 70%; height: 50px !important;">
                            </td>
                        </tr>
                        <tr style="height: 30px">
                            <td class="text-center table-active ">Firma y Sello</td>
