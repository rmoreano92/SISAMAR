@using Microsoft.Extensions.Configuration;
@{
    var version = new ConfigurationBuilder().AddJsonFile("appsettings.json").Build().GetValue<string>("Version");
    var usaLabs = new ConfigurationBuilder().AddJsonFile("appsettings.json").Build().GetValue<string>("Configuraciones:UsaLabs");
}

<div>
    <div>
        <div>
            @section Css
            {
                <!-- plugin css -->
                <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/chosen/css/chosen.css" />
                <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/bootstrap-datetimepicker/css/bootstrap-datetimepicker.min.css" />
                <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/radio_css/css/radiobox.min.css" />
                <link type="text/css" rel="stylesheet" href="~/AdmiRE/css/pages/radio_checkbox.css" />
                <link type="text/css" rel="stylesheet" href="~/AdmiRE/vendors/jquery-tagsinput/css/jquery.tagsinput.css" />
                <link type="text/css" rel="stylesheet" href="~/AdmiRE/css/pages/bootstrap.vertical-tabs.css" />



            }
            <header class="head">
                <div class="main-bar row">
                    <div class="col-lg-6 col-md-4 col-sm-4">
                        <h4 class="nav_top_align">
                            <i class="fa fa-th"></i>
                            @ViewBag.Area
                        </h4>
                    </div>
                    <div class="col-lg-6 col-md-8 col-sm-8">
                        <ol class="breadcrumb float-xs-right nav_breadcrumb_top_align">
                            <li class="breadcrumb-item">
                                <a href="index1.html">
                                    <i class="fa fa-home" data-pack="default" data-tags=""></i> Home
                                </a>
                            </li>
                            <li class="breadcrumb-item">
                                <a href="#">@ViewBag.Area</a>
                            </li>
                            <li class="breadcrumb-item active">Reporte Operatorio </li>
                        </ol>
                    </div>
                </div>
            </header>

            <div class="outer">
                <div class="inner bg-light lter bg-container">
                    <div class="row">
                        <div class="col-xs-12 data_tables">
                            <div class="card">
                                <div class="card-header bg-white">
                                    <i class="fa fa-pencil-square-o"></i>Reporte Operatorio
                                    
                                </div>
                                <input hidden="hidden" id="hditembar" name="hditembar" value="@ViewBag.itemBar" type="text" class="form-control">
                                <input hidden="hidden" id="idGrupo" name="idGrupo" type="text" class="form-control" value="@ViewBag.Vista">
                                <input hidden="hidden" id="idServicio" name="idServicio" type="text" class="form-control" value="@ViewBag.Servicio">
                                <input hidden="hidden" id="hdIdPaciente" name="hdIdPaciente" type="text" class="form-control">
                                <input hidden="hidden" id="hdIdCuentaAtencion" name="hdIdCuentaAtencion" type="text" class="form-control">
                                <input hidden="hidden" id="hdIdNumero" name="hdIdNumero" type="text" class="form-control">
                                <input hidden="hidden" id="hdIdNumeroSiguiente" name="hdIdNumeroSiguiente" type="text" class="form-control">
                                <input hidden="hidden" id="hdestadoBtn" name="hdestadoBtn" type="text" class="form-control">
                                <div class="card-block p-t-5">
                                    <div class="row">
                                        <div class="col-lg-12">
                                            <div class="card m-t-5">
                                                <div class="card-block">
                                                    <div class="row mt-1">
                                                        <div class="col-lg-10">
                                                            <div class="row">
                                                                <div class="col-lg-2">
                                                                    <div class="form-group">
                                                                        <label for="txtHistoriaBusq" class="form-control-label">Historia Clinica</label>
                                                                        <div class="input-group input-group-sm">
                                                                            <input id="txtHistoriaBusq" autocomplete="off" placeholder="" class="form-control">
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                @*<div class="col-lg-2">
                                                                <div class="form-group">
                                                                <label for="txtNroCuenta" class="form-control-label">N° Cuenta</label>
                                                                <div class="input-group">
                                                                <input id="txtNroCuenta" autocomplete="off" placeholder="" class="form-control">
                                                                </div>
                                                                </div>
                                                                </div>*@
                                                                <div class="col-lg-2">
                                                                    <div class="form-group">
                                                                        <label for="txtNroDocumentoBusq" class="form-control-label">N° Documento</label>
                                                                        <div class="input-group input-group-sm">
                                                                            <input id="txtNroDocumentoBusq" autocomplete="off" placeholder="" class="form-control">
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <div class="col-lg-2">
                                                                    <div class="form-group">
                                                                        <label for="txtApPaternoBusq" class="form-control-label">Apellido Paterno</label>
                                                                        <div class="input-group input-group-sm">
                                                                            <input id="txtApPaternoBusq" autocomplete="off" placeholder="" class="form-control">
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <div class="col-lg-2">
                                                                    <div class="form-group">
                                                                        <label for="txtApMaternoBusq" class="form-control-label">Apellido Materno</label>
                                                                        <div class="input-group input-group-sm">
                                                                            <input id="txtApMaternoBusq" autocomplete="off" placeholder="" class="form-control">
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <div class="col-lg-2">
                                                                    <div class="form-group">
                                                                        <label for="txtFechaSolicitudBusq" class="form-control-label">Fecha Solicitud</label>
                                                                        <div class="input-group input-group-sm">
                                                                            <input id="txtFechaSolicitudBusq" autocomplete="off" placeholder="dd/mm/yyyy" data-date-format="dd/mm/yyyy" class=" form-control">
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <div class="col-lg-2">
                                                                    <div class="form-group">
                                                                        <label for="cboServicio" class="form-control-label">Servicio</label>
                                                                        <div class="input-group input-group-sm">

                                                                            <select class="chzn-select" data-placeholder="Seleccionar una opcion" id="cboServicio"></select>

                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-lg-2" style="margin-top: 27px;">
                                                            <button class="btn btn-sm btn-primary layout_btn_prevent pl-1 pr-1" id="btnBuscarPacientes">Buscar</button>
                                                            <button class="btn btn-sm  btn-default layout_btn_prevent pl-1 pr-1" id="btnLimpiarFiltro">Limpiar</button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-lg-6 pt-2 pb-0">
                                            @{
                                                if (@ViewBag.Agregar)
                                                {
                                                    <button class="btn btn-success layout_btn_prevent" id="btnAgregarReporte">Agregar</button>
                                                }
                                                if (@ViewBag.Modificar)
                                                {
                                                    <button class="btn btn-info layout_btn_prevent" id="btnModificarRegistro">Modificar</button>
                                                }
                                                if (@ViewBag.Consultar)
                                                {
                                                    <button class="btn btn-warning layout_btn_prevent" id="btnConsultar">Consultar</button>
                                                }
                                                if (@ViewBag.Eliminar)
                                                {
                                                    <button class="btn btn-danger layout_btn_prevent" id="btnEliminar">Eliminar</button>
                                                }
                                            }
                                        </div>
                                    </div>

                                    <table id="tblReporteOperatorio" width="100%" class="table table-sm table-content-md table-bordered">
                                        <thead style="color: white;background: #434343;">
                                            <tr>

                                                <th>N° Solicitud</th>
                                                <th>N° Reporte</th>
                                                <th>N° Folio</th>
                                                <th>N° Cuenta</th>
                                                <th>N° Historia</th>
                                                <th>Paciente</th>
                                                <th>Estado</th>
                                                <th>Informe</th>

                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <partial name="~/Views/Shared/Components/VistasParciales/CentroQuirurgico/RegistroReporteOperatorio.cshtml" />

