    ListaPaises: () => {
        fetch('/Utilitario/ListaPaises?area=Comun', {
            method: 'GET'
        })
            .then(res => res.json())
            .catch(error => console.error('Error:', error))
            .then(res => {


                $('#cboPaisNacimiento').empty()
                $('#cboPaisProcedencia').empty()
                $('#cboPaisDomicilio').empty()
                $(res.data.table).each(function (i, obj) {
                    $('#cboPaisNacimiento').append(`<option value="${obj.idPais}">${obj.nombre}</option>`)
                    $('#cboPaisProcedencia').append(`<option value="${obj.idPais}">${obj.nombre}</option>`)
                    $('#cboPaisDomicilio').append(`<option value="${obj.idPais}">${obj.nombre}</option>`)
                })
                $('.chzn-select').chosen().trigger("chosen:updated")
                $(`#cboPaisNacimiento`).val(166)
                $(`#cboPaisProcedencia`).val(166)
                $(`#cboPaisDomicilio`).val(166)



                $('.chzn-select').chosen().trigger("chosen:updated")

                $(`#cboPaisNacimiento`).trigger('change')
                $(`#cboPaisProcedencia`).trigger('change')
                $(`#cboPaisDomicilio`).trigger('change')
            })
    },
    ListaDepartamentos: async () => {

        await fetch('/Utilitario/ListaDepartamentos?area=Comun', {
            method: 'GET',
            headers: {
                'Content-Type': 'application/json'
            }
        })
            .then(res => res.json())
            .catch(error => console.error('Error:', error))
            .then(response => {
                $('#cboDepartamentoDomicilio').empty();
                $('#cboDepartamentoProcedencia').empty();
                $('#cboDepartamentoNacimiento').empty();

                $('#cboDepartamentoDomicilio').append(`<option value="0">--Seleccionar--</option>`)
                $('#cboDepartamentoProcedencia').append(`<option value="0">--Seleccionar--</option>`)
                $('#cboDepartamentoNacimiento').append(`<option value="0">--Seleccionar--</option>`)
                $(response.lsDeparta.table).each(function (i, obj) {
                    $('#cboDepartamentoDomicilio').append(`<option value="${obj.idDepartamento}">${obj.descripcionLarga}</option>`)
                    $('#cboDepartamentoProcedencia').append(`<option value="${obj.idDepartamento}">${obj.descripcionLarga}</option>`)
                    $('#cboDepartamentoNacimiento').append(`<option value="${obj.idDepartamento}">${obj.descripcionLarga}</option>`)
                })
                $('#cboDepartamentoDomicilio').val(15)
                $('.chzn-select').chosen().trigger("chosen:updated");

            })
    },

    ListaDepartamentosSeleccionarPorIdPais: async (idPais, cboDepartamento) => {

        let formData = new FormData()

        formData.append('IdPais', idPais)

        await fetch('/Utilitario/ListaDepartamentosSeleccionarPorIdPais?area=Comun', {
            method: 'POST',
            //headers: {
            //    'Content-Type': 'application/json'
            //},
            body: formData
        })
            .then(res => res.json())
            .catch(error => console.error('Error:', error))
            .then(response => {

                $('#' + cboDepartamento).empty();

                $('#' + cboDepartamento).append(`<option value="0">--Seleccionar--</option>`)

                $(response.lsDeparta.table).each(function (i, obj) {
                    $('#' + cboDepartamento).append(`<option value="${obj.idDepartamento}">${obj.nombre}</option>`)
                })
                //$('#cboDepartamentoDomicilio').val(15)
                $('.chzn-select').chosen().trigger("chosen:updated");

            })
    },

