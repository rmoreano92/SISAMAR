        [HttpPost]
        public ActionResult CrearModificarHistoria(Paciente objPaciente)
        {
            if (HttpContext.User.Identity.IsAuthenticated == false)
            {
                return Json(new { session = false });
            }
            int respuest = 0, nroHistoria;
            //DataSet dataSet = null;
            DalPaciente dalPaciente = new DalPaciente();

            string actionName = this.ControllerContext.RouteData.Values["action"].ToString();
            string controllerName = this.ControllerContext.RouteData.Values["controller"].ToString();

            try
            {
                if (objPaciente.IdPaciente == 0 && objPaciente.NroHistoriaClinica == 0)
                {
                    nroHistoria = dalPaciente.generaNroHistoria(objPaciente.IdTipoNumeracion);
                    objPaciente.NroHistoriaClinica = nroHistoria;
                }
                respuest = dalPaciente.registrarPaciente(objPaciente);
                return Json(new { session = true, estado = true, msg = "", data = respuest });
            }
            catch (Exception e)
            {
                return Json(new { session = true, estado = false, msg = "¡Error! \n [" + controllerName + "Controller / " + actionName + "] \n " + e, data = respuest });
            }

        }
