        [HttpPost]
        public ActionResult PacientesSeleccionarPorNroHistoriaClinica(int nroHistoria)
        {
            
            if (HttpContext.User.Identity.IsAuthenticated == false)
            {
                return Json(new { session = false });
            }

            DataSet lsPacientes;
            DalPaciente dalPaciente = new DalPaciente();
            lsPacientes = dalPaciente.PacientesSeleccionarPorNroHistoriaClinica(nroHistoria);

            return Json(new { session = true, estado = true, lsPacientes });

        }

        [HttpPost]
        public ActionResult PacienteBuscarPorFiltro(int nroHistoria, string nroDocumento)
        {

            if (HttpContext.User.Identity.IsAuthenticated == false)
            {
                return Json(new { session = false });
            }

            DataSet lsPacientes;
            DalPaciente dalPaciente = new DalPaciente();
            if (nroHistoria > 0)
            {
                lsPacientes = dalPaciente.PacientesSeleccionarPorNroHistoriaClinica(nroHistoria);
            }
            else
            {
                lsPacientes = dalPaciente.PacientesSeleccionarPorNroDocumento(nroDocumento);
            }

            return Json(new { session = true, estado = true, lsPacientes });

        }

