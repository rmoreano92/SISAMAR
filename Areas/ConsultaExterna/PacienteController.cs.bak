        [HttpPost]
        public async Task<ActionResult> SeleccionarAntecedentesFamiliares(int idPaciente)
        {
            if (HttpContext.User.Identity.IsAuthenticated == false)
            {
                return Json(new { session = false });
            }

            DataSet ds;
            DalPaciente dao = new DalPaciente();
            //Boolean hoja;

            int idUsuario;
            idUsuario = int.Parse(HttpContext.Session.GetString("idusu"));
            ds = await dao.PacienteAntecedenteFamiliarSeleccionar(idPaciente, idUsuario);
            //hoja = await GenerarHojaRefCon(objRef.IdCuentaAtencion, Convert.ToInt32(ds.Tables[0].Rows[0]["IdReferencia"].ToString()), 1, "RF");

            return Json(new { respuesta = ds, session = true });
        }

        [HttpPost]
        public async Task<ActionResult> GuardarAntecedentesFamiliares(PacienteAntecedenteFamiliar antecedente)
        {
            if (HttpContext.User.Identity.IsAuthenticated == false)
            {
                return Json(new { session = false });
            }

            bool resp;
            DalPaciente dao = new DalPaciente();
            //Boolean hoja;

            try
            {
                int idUsuario;
                idUsuario = int.Parse(HttpContext.Session.GetString("idusu"));
                resp = await dao.PacienteAntecedenteFamiliarModificar(antecedente, idUsuario);

                return Json(new { respuesta = resp, session = true, estado = true });
            }
            catch (Exception ex)
            {
                return Json(new { session = true, estado = false, msj = "Errr en (GuardarSintomasNeonatal): " + ex });
            }
        }
